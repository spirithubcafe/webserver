@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using SpirithubCafe.Web.Data
@using SpirithubCafe.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger
@inject IHttpContextAccessor HttpContextAccessor
@inject TranslationLocalizer Localizer

<PageTitle>@Localizer["Disable2FA.PageTitle"] - SpirithubCafe</PageTitle>

<div class="max-w-3xl mx-auto p-6 space-y-8">
    <!-- Page Header -->
    <div class="bg-orange-600 rounded-2xl p-8 text-white">
        <div class="flex items-center space-x-3">
            <div class="p-3 bg-white/20 rounded-xl">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0h-2m9-7a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-bold">@Localizer["Disable2FA.Title"]</h1>
                <p class="text-red-100 mt-1">@Localizer["Disable2FA.Subtitle"]</p>
            </div>
        </div>
    </div>

    <StatusMessage />

    <!-- Warning Section -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-lg font-medium text-yellow-800 mb-3">⚠️ @Localizer["Disable2FA.ImportantInfo"]</h3>
                <div class="text-yellow-700 space-y-2">
                    <p class="font-semibold">
                        @Localizer["Disable2FA.OnlyDisables"]
                    </p>
                    <ul class="list-disc pl-5 space-y-1">
                        <li>@Localizer["Disable2FA.KeysRemain"]</li>
                        <li>@Localizer["Disable2FA.CanReEnable"]</li>
                        <li>@Localizer["Disable2FA.ChangeKeys"] <a href="Account/Manage/ResetAuthenticator" class="text-yellow-600 hover:text-yellow-800 underline font-medium">@Localizer["Disable2FA.ResetKeys"]</a></li>
                        <li>@Localizer["Disable2FA.RecoveryValid"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Impact -->
    <div class="bg-red-50 border border-red-200 rounded-xl p-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-lg font-medium text-red-800 mb-3">@Localizer["Disable2FA.SecurityImpact"]</h3>
                <div class="text-red-700 space-y-2">
                    <p>@Localizer["Disable2FA.ReduceSecurity"]:</p>
                    <ul class="list-disc pl-5 space-y-1">
                        <li>@Localizer["Disable2FA.OnlyPassword"]</li>
                        <li>@Localizer["Disable2FA.NoSecondStep"]</li>
                        <li>@Localizer["Disable2FA.MoreVulnerable"]</li>
                        <li>@Localizer["Disable2FA.RecommendKeep"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Disable Action -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-xl font-semibold text-red-900 mb-4">@Localizer["Disable2FA.DisableTitle"]</h2>
        
        <div class="space-y-4">
            <p class="text-gray-600">
                @Localizer["Disable2FA.AreYouSure"]
            </p>
            
            <div class="bg-gray-50 rounded-xl p-4">
                <div class="space-y-3">
                    <div class="flex items-start space-x-3">
                        <div class="w-2 h-2 bg-orange-500 rounded-full mt-2"></div>
                        <span class="text-gray-700">@Localizer["Disable2FA.TurnedOffImmediately"]</span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <div class="w-2 h-2 bg-orange-500 rounded-full mt-2"></div>
                        <span class="text-gray-700">@Localizer["Disable2FA.ReEnableAnytime"]</span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <div class="w-2 h-2 bg-green-500 rounded-full mt-2"></div>
                        <span class="text-gray-700">@Localizer["Disable2FA.AppSettingsPreserved"]</span>
                    </div>
                    <div class="flex items-start space-x-3">
                        <div class="w-2 h-2 bg-green-500 rounded-full mt-2"></div>
                        <span class="text-gray-700">@Localizer["Disable2FA.RecoveryCodesRemain"]</span>
                    </div>
                </div>
            </div>
            
            <div class="pt-6 border-t border-gray-200">
                <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
                    <AntiforgeryToken />
                    
                    <div class="flex justify-between items-center">
                        <div>
                            <p class="text-sm text-gray-600 mb-2">
                                @Localizer["Disable2FA.ConsiderRisks"]
                            </p>
                        </div>
                        <div class="flex space-x-3">
                            <a href="/Account/Manage/TwoFactorAuthentication" 
                               class="px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-300">
                                @Localizer["Disable2FA.Cancel"]
                            </a>
                            <button type="submit" 
                                    class="px-6 py-3 bg-orange-600 text-white font-semibold rounded-xl hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 transition-all duration-300">
                                @Localizer["Disable2FA.DisableButton"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Re-enable Information -->
    <div class="bg-blue-50 rounded-xl border border-blue-200 p-6">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800 mb-2">@Localizer["Disable2FA.ReEnabling"]</h3>
                <p class="text-sm text-blue-700">
                    @Localizer["Disable2FA.ReEnableInfo"]
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationUser user = default!;

    private HttpContext? HttpContext => HttpContextAccessor.HttpContext;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            user = await UserAccessor.GetRequiredUserAsync(HttpContext);

            if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
            {
                throw new InvalidOperationException("Cannot disable 2FA for user as it's not currently enabled.");
            }
        }
    }

    private async Task OnSubmitAsync()
    {
        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred disabling 2FA.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        if (HttpContext is not null)
        {
            var successMessage = Localizer["Disable2FA.SuccessMessage"];
            RedirectManager.RedirectToWithStatus(
                "Account/Manage/TwoFactorAuthentication",
                successMessage,
                HttpContext);
        }
    }
}
