@page "/Account/Lockout"

@inject TranslationLocalizer Localizer

<PageTitle>@Localizer["AccountLocked"]</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-[#f5f5f5] via-white to-[#e8e8e8] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        
        <!-- Site Logo -->
        <div class="w-32 h-32 mx-auto bg-white rounded-full flex items-center justify-center p-4 shadow-lg">
            <img src="/images/logo.png" alt="@Localizer["SiteTitle"]" class="w-full h-full object-contain" />
        </div>

        <!-- Content -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
            <div class="flex flex-col items-center text-center space-y-6">
                <div class="w-16 h-16 bg-[#D3DAD9] rounded-full flex items-center justify-center">
                    <svg class="h-10 w-10 text-[#715A5A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">@Localizer["AccountLocked"]</h3>
                    <p class="text-gray-600 mb-2" role="alert">
                        @Localizer["AccountLockedMultipleAttempts"]
                    </p>
                    <p class="text-sm text-gray-500 mb-6">
                        @Localizer["TryAgainLaterContact"]
                    </p>
                    <div class="space-y-3">
                        <a href="/Account/Login" 
                           class="block w-full px-6 py-3 bg-gradient-to-r from-[#715A5A] to-[#715A5A] text-white font-semibold rounded-lg hover:from-[#5d4a4a] hover:to-[#5d4a4a] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#715A5A] transform transition duration-200 hover:scale-[1.02] shadow-lg">
                            @Localizer["TryAgain"]
                        </a>
                        <a href="/Account/ForgotPassword" 
                           class="block w-full px-6 py-3 bg-white text-[#715A5A] font-semibold rounded-lg border-2 border-[#715A5A] hover:bg-[#f5f5f5] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#715A5A] transition duration-200">
                            @Localizer["ResetPassword"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center">
            <p class="text-sm text-gray-600">
                @Localizer["NeedHelp"]? <a href="/contact" class="font-semibold text-[#715A5A] hover:text-[#5d4a4a] transition duration-200">@Localizer["ContactSupport"]</a>
            </p>
        </div>

    </div>
</div>
