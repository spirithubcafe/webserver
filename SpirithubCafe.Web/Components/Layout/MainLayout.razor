@inherits LayoutComponentBase
@inject TranslationLocalizer Localizer
@inject CartService CartService
@inject NavigationManager Navigation
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@inject SpirithubCafe.Web.Services.CategoryService CategoryService
@inject AssetVersioningService AssetVersioning
@using System.Globalization
@using SpirithubCafe.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using SpirithubCafe.Web
@using SpirithubCafe.Web.Components.Layout
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Web.Components
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html data-theme="light" lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
    dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" class="h-full bg-gray-50">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="@Localizer["SiteDescription"]" />
    <meta name="theme-color" content="#715A5A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@Localizer["SiteTitle"]" />
    <base href="/" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="72x72" href="/images/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="96x96" href="/images/icon-96x96.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/images/icon-128x128.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/images/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/images/icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/images/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="384x384" href="/images/icon-384x384.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/images/icon-512x512.png" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    
    <!-- Beautiful Arabic Fonts with Vazir Matn -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100;200;300;400;500;600;700;800;900&family=Tajawal:wght@200;300;400;500;700;800;900&family=Almarai:wght@300;400;700;800&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    
    <!-- Critical CSS -->
    <link rel="stylesheet" href="@AssetVersioning.GetVersionedCssUrl("dist.css")" />
    <link rel="stylesheet" href="@Assets["SpirithubCafe.Web.styles.css"]" />
    
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <PageTitle>@Localizer["SiteTitle"]</PageTitle>
    
 
</head>

<body class="h-full font-arabic">
    <div class="min-h-screen flex flex-col">
        <!-- Top Navigation -->
        <nav class="@GetNavigationClasses() @GetNavigationPositionClasses() z-[99] flex-shrink-0 transition-all duration-300">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-20">
                    <!-- Logo and Brand -->
                    <div class="flex items-center ltr:space-x-4 rtl:space-x-reverse">
                        <div class="flex-shrink-0 flex items-center">
                            @if (GetCurrentLogoType() == "image" && !string.IsNullOrEmpty(GetCurrentLogoImage()))
                            {
                                <!-- Dynamic Image Logo -->
                                <NavLink href="/" class="flex items-center cursor-pointer">
                                    <img src="@GetCurrentLogoImage()" alt="@(GetCurrentLogoText() ?? Localizer["SiteTitle"])" class="h-12 w-auto ltr:mr-3 rtl:ml-3" />
                                </NavLink>
                            }
                            else
                            {
                                <!-- Text Logo with Coffee Bean Icon -->
                                <div
                                    class="w-10 h-10 bg-gradient-to-br from-[#715A5A] to-[#37353E] rounded-full flex items-center justify-center ltr:mr-3 rtl:ml-3 shadow-md cursor-pointer">
                                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M18.5 3H6c-1.1 0-2 .9-2 2v5.71c0 3.83 2.95 7.18 6.78 7.29 3.96.12 7.22-3.06 7.22-7v-1h.5c1.93 0 3.5-1.57 3.5-3.5S20.43 3 18.5 3zM16 5v3h1.5c.83 0 1.5-.67 1.5-1.5S17.83 5 17 5h-1zM6 5h8v8.58c0 2.4-1.9 4.42-4.29 4.42S5.42 15.98 5.42 13.58V5z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <NavLink href="/" class="@($"{GetLogoTextClasses()} text-2xl font-bold hover:text-[#715A5A] transition-colors cursor-pointer")">
                                        @{
                                            var currentLogoText = GetCurrentLogoText();
                                        }
                                        @(string.IsNullOrEmpty(currentLogoText) ? Localizer["SpirithubCafeDefaultName"] : currentLogoText)
                                    </NavLink>
                                    <span class="@GetSubtitleClasses() text-xs font-medium cursor-pointer">@Localizer["SiteSubtitle"]</span>
                                </div>
                            }
                        </div>
                    </div>



                    <!-- Right Side Actions -->
                    <div class="flex items-center ltr:space-x-6 rtl:space-x-reverse rtl:gap-6">
                        <!-- Products Icon - Always visible -->
                        <div class="hidden md:block cursor-pointer">  
                                               <ProductsIcon />

                        </div>

                        <!-- Language Icon - Always visible -->
                        <div class="cursor-pointer">
                            <LanguageIcon />
                        </div>

                        <!-- Cart Button - Always visible -->
                        <div class="cursor-pointer">
                            <CartIcon />
                        </div>

                        <!-- Modern Minimal Profile Menu -->
                        <div class="relative">
                            <AuthorizeView>
                                <Authorized>
                                    <!-- Minimal User Avatar -->
                                    <button @onclick="ToggleUserMenu"
                                            class="relative w-10 h-10 bg-gradient-to-br from-amber-600 to-amber-700
                                                   hover:from-amber-500 hover:to-amber-600
                                                   rounded-full flex items-center justify-center text-white 
                                                   shadow-md hover:shadow-lg transform hover:scale-105
                                                   transition-all duration-200 ease-out cursor-pointer 
                                                   focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2">
                                        <span class="text-sm font-semibold">@(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                                        
                                        <!-- Online Status -->
                                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-500 border-2 border-white rounded-full"></div>
                                    </button>
                                </Authorized>
                                <NotAuthorized>
                                    <!-- Minimal Guest Icon -->
                                    <button @onclick="ToggleUserMenu" 
                                            class="relative w-10 h-10 bg-gray-100 hover:bg-gray-200
                                                   rounded-full flex items-center justify-center text-gray-700
                                                   shadow-sm hover:shadow-md transform hover:scale-105
                                                   transition-all duration-200 ease-out cursor-pointer 
                                                   focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                    </button>
                                </NotAuthorized>
                            </AuthorizeView>

                            <!-- Minimal Dropdown Menu -->
                            @if (isUserMenuOpen)
                            {
                                <!-- Subtle Backdrop -->
                                <div class="fixed inset-0 z-[55]" @onclick="CloseUserMenu" aria-hidden="true"></div>
                                
                                <!-- Menu Container -->
                                <div class="absolute ltr:right-0 rtl:left-0 mt-2 z-[60]" @onclick:stopPropagation="true">
                                    <div class="bg-white rounded-xl shadow-xl border border-gray-100
                                                w-64 overflow-hidden transform transition-all duration-200 ease-out
                                                @(isUserMenuOpen ? "opacity-100 translate-y-0" : "opacity-0 -translate-y-2")">
                                        
                                        <!-- User Info Header -->
                                        <AuthorizeView>
                                            <Authorized>
                                                <div class="px-4 py-3 border-b border-gray-100">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 bg-gradient-to-br from-amber-600 to-amber-700 rounded-full flex items-center justify-center text-white shadow-sm">
                                                            <span class="text-sm font-semibold">@(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <p class="text-sm font-medium text-gray-900 truncate">@context.User.Identity?.Name</p>
                                                            <p class="text-xs text-gray-500">@Localizer["Customer"]</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </Authorized>
                                            <NotAuthorized>
                                                <div class="px-4 py-3 border-b border-gray-100 bg-gray-50">
                                                    <p class="text-sm font-medium text-gray-700">@Localizer["WelcomeGuest"]</p>
                                                    <p class="text-xs text-gray-500">@Localizer["PleaseSignIn"]</p>
                                                </div>
                                            </NotAuthorized>
                                        </AuthorizeView>

                                        <!-- Menu Items -->
                                        <div class="py-2">
                                            <AuthorizeView>
                                                <Authorized>
                                                    <div class="px-2 space-y-0.5">
                                                        <a href="/Account/Manage" @onclick="CloseUserMenu"
                                                           class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 rounded-lg transition-colors group">
                                                            <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                                            </svg>
                                                            <span class="font-medium">@Localizer["MyProfile"]</span>
                                                        </a>

                                                        <a href="/orders" @onclick="CloseUserMenu"
                                                           class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 rounded-lg transition-colors group">
                                                            <svg class="w-4 h-4 text-gray-400 group-hover:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                                            </svg>
                                                            <span class="font-medium">@Localizer["MyOrders"]</span>
                                                        </a>

                                                        <a href="/favorites" @onclick="CloseUserMenu"
                                                           class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 rounded-lg transition-colors group">
                                                            <svg class="w-4 h-4 text-gray-400 group-hover:text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                                            </svg>
                                                            <span class="font-medium">@Localizer["Favorites"]</span>
                                                        </a>
                                                    </div>

                                                    @if (context.User.IsInRole("Admin"))
                                                    {
                                                        <div class="my-2 border-t border-gray-100"></div>
                                                        <div class="px-2">
                                                            <a href="/admin/dashboard" @onclick="CloseUserMenu"
                                                               class="flex items-center gap-3 px-3 py-2.5 text-sm text-purple-700 hover:bg-purple-50 rounded-lg transition-colors group">
                                                                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                                </svg>
                                                                <span class="font-medium">@Localizer["AdminPanel"]</span>
                                                            </a>
                                                        </div>
                                                    }

                                                    <div class="my-2 border-t border-gray-100"></div>
                                                    <div class="px-2">
                                                        <button @onclick="SignOutAsync" type="button"
                                                                class="flex items-center gap-3 px-3 py-2.5 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors group w-full">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                                            </svg>
                                                            <span class="font-medium">@Localizer["SignOut"]</span>
                                                        </button>
                                                    </div>
                                                </Authorized>
                                                <NotAuthorized>
                                                    <div class="px-2 space-y-1">
                                                        <a href="/Account/Login" @onclick="@(() => CloseUserMenuWithNavigation("/Account/Login"))"
                                                           class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
                                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                                                            </svg>
                                                            <span class="font-medium">@Localizer["Login"]</span>
                                                        </a>
                                                        
                                                        <a href="/Account/Register" @onclick="@(() => CloseUserMenuWithNavigation("/Account/Register"))"
                                                           class="flex items-center gap-3 px-3 py-2.5 text-sm text-white bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 rounded-lg transition-colors shadow-sm">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                                                            </svg>
                                                            <span class="font-semibold">@Localizer["Register"]</span>
                                                        </a>
                                                    </div>
                                                </NotAuthorized>
                                            </AuthorizeView>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>


        </nav>



        <!-- Main Content -->
        <main class="flex-1 flex flex-col pb-20 md:pb-0" data-blazor-loaded="true">
            <div class="flex-1">
                <CustomErrorBoundary>
                    @Body
                </CustomErrorBoundary>
            </div>
        </main>

        <!-- Chat Widget -->
        <ChatWidget />

        <!-- Dynamic Footer -->
        <DynamicFooter />

        <!-- Mobile Bottom Navigation -->
        <MobileBottomNavigation />
        
        <!-- Toast Messages -->
        <Toast />
    </div>

    @code {
        private string logoType = "text";
        private string logoText = "SpirithubCafe";
        private string logoImage = "";
        private string homeLogoType = "inherit";
        private string homeLogoText = "";
        private string homeLogoTextAr = "";
        private string homeLogoImage = "";
        private List<SpirithubCafe.Domain.Entities.Category> categories = new();
        private int cartItemCount = 0;
        private bool isUserMenuOpen = false;
        
        private void ToggleUserMenu()
        {
            isUserMenuOpen = !isUserMenuOpen;
        }
        

        
        private void CloseUserMenu()
        {
            isUserMenuOpen = false;
            StateHasChanged();
        }
        
        private void CloseUserMenuWithNavigation(string url)
        {
            isUserMenuOpen = false;
            Navigation.NavigateTo(url);
        }
        
        private void SignOutAsync()
        {
            // Close the menu first
            isUserMenuOpen = false;
            
            // Navigate to logout endpoint
            Navigation.NavigateTo("/Account/Logout", forceLoad: true);
        }
        
        private bool IsHomePage()
        {
            var currentUrl = Navigation.Uri;
            var baseUrl = Navigation.BaseUri;
            var relativePath = currentUrl.Replace(baseUrl, "");
            
            return string.IsNullOrEmpty(relativePath) || relativePath == "/" || relativePath.StartsWith("/?");
        }
        
        private string GetNavigationClasses()
        {
            if (IsHomePage())
            {
                return "bg-transparent border-white/20";
            }
            else
            {
                return "bg-white shadow-lg border-b border-gray-100";
            }
        }
        
        private string GetNavigationPositionClasses()
        {
            if (IsHomePage())
            {
                return "absolute top-0 w-full";
            }
            else
            {
                return "sticky top-0";
            }
        }
        
        private string GetLogoTextClasses()
        {
            if (IsHomePage())
            {
                return "text-white drop-shadow-lg";
            }
            else
            {
                return "text-gray-900";
            }
        }
        
        private string GetSubtitleClasses()
        {
            if (IsHomePage())
            {
                return "text-white/80 drop-shadow-md";
            }
            else
            {
                return "text-gray-500";
            }
        }
        
        private string GetProductsButtonClasses()
        {
            if (IsHomePage())
            {
                return "text-white hover:text-amber-200 hover:bg-white/10 hover:border-white/30 drop-shadow-md";
            }
            else
            {
                return "text-[#44444E] hover:text-[#37353E] hover:bg-[#f5f5f5] hover:border-[#D3DAD9]";
            }
        }
        


        protected override async Task OnInitializedAsync()
        {
            // Load data in parallel for better performance
            var logoTask = LoadLogoSettings();
            var categoriesTask = LoadCategories();
            var cartTask = CartService.InitializeAsync();
            
            await Task.WhenAll(logoTask, categoriesTask, cartTask);
            
            UpdateCartItemCount();
            CartService.OnCartChanged += UpdateCartItemCount;
        }
        
        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("hideLoadingScreen");
                }
                catch
                {
                    // Ignore JS interop errors during first render
                }
            }
        }
        
        private void UpdateCartItemCount()
        {
            cartItemCount = CartService.ItemCount;
            InvokeAsync(StateHasChanged);
        }

        private async Task LoadCategories()
        {
            try
            {
                categories = await CategoryService.GetActiveCategoriesAsync();
            }
            catch (Exception)
            {
                // If category service fails, use empty list
                categories = new();
            }
        }

        private async Task LoadLogoSettings()
        {
            try
            {
                logoType = await SettingService.GetValueAsync("logo_type", "text");
                logoText = await SettingService.GetValueAsync("logo_text", "SpirithubCafe");
                logoImage = await SettingService.GetValueAsync("logo_image", "");
                
                // Load home page logo settings
                homeLogoType = await SettingService.GetValueAsync("home_logo_type", "inherit");
                homeLogoText = await SettingService.GetValueAsync("home_logo_text", "");
                homeLogoTextAr = await SettingService.GetValueAsync("home_logo_text_ar", "");
                homeLogoImage = await SettingService.GetValueAsync("home_logo_image", "");
            }
            catch (Exception)
            {
                // If settings service fails, use defaults
                logoType = "text";
                logoText = "SpirithubCafe";
                logoImage = "";
                homeLogoType = "inherit";
                homeLogoText = "";
                homeLogoTextAr = "";
                homeLogoImage = "";
            }
        }

        private string GetCurrentLogoType()
        {
            if (IsHomePage() && homeLogoType != "inherit")
            {
                return homeLogoType;
            }
            return logoType;
        }
        
        private string GetCurrentLogoText(bool isArabic = false)
        {
            if (IsHomePage() && homeLogoType == "text")
            {
                if (isArabic && !string.IsNullOrWhiteSpace(homeLogoTextAr))
                {
                    return homeLogoTextAr;
                }
                if (!string.IsNullOrWhiteSpace(homeLogoText))
                {
                    return homeLogoText;
                }
            }
            return logoText;
        }
        
        private string GetCurrentLogoImage()
        {
            if (IsHomePage() && homeLogoType == "image" && !string.IsNullOrWhiteSpace(homeLogoImage))
            {
                return homeLogoImage;
            }
            return logoImage;
        }

        private void NavigateToCart()
        {
            Navigation.NavigateTo("/cart", forceLoad: true);
        }

        public void Dispose()
        {
            CartService.OnCartChanged -= UpdateCartItemCount;
        }
    }
</body>

</html>