@using SpirithubCafe.Web.Services
@inject CartService CartService
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@implements IDisposable
@rendermode InteractiveServer

<!-- Mobile Bottom Navigation - Only visible on mobile -->
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-lg z-50 md:hidden">
    <div class="flex items-center justify-around py-2 px-2">
        <!-- Home -->
        <a href="/" class="@GetNavItemClasses("/")">
            <div class="flex flex-col items-center py-2 px-4">
                <svg class="w-7 h-7 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="text-xs font-semibold">@Localizer["Home"]</span>
            </div>
        </a>

        <!-- Products -->
        <a href="/products" class="@GetNavItemClasses("/products")">
            <div class="flex flex-col items-center py-2 px-4">
                <svg class="w-7 h-7 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="text-xs font-semibold">@Localizer["Products"]</span>
            </div>
        </a>

        <!-- Cart -->
        <button @onclick="NavigateToCart" class="@GetCartItemClasses()">
            <div class="flex flex-col items-center py-2 px-4 relative">
                <div class="relative">
                    <svg class="w-7 h-7 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    
                    @if (itemCount > 0)
                    {
                        <div class="absolute -top-1 -right-2 bg-gradient-to-br from-red-500 to-red-600 text-white rounded-full text-[10px] font-bold min-w-[20px] h-[20px] flex items-center justify-center px-1.5 shadow-lg border-2 border-white">
                            @(itemCount > 99 ? "99+" : itemCount.ToString())
                        </div>
                    }
                </div>
                <span class="text-xs font-semibold">@Localizer["Cart"]</span>
            </div>
        </button>

        <!-- Profile/Account -->
        <a href="/Account/Manage" class="@GetNavItemClasses("/Account/Manage")">
            <div class="flex flex-col items-center py-2 px-4">
                <svg class="w-7 h-7 mb-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-xs font-semibold">@Localizer["Account"]</span>
            </div>
        </a>
    </div>
</div>

@code {
    private int itemCount = 0;
    private decimal totalPrice = 0;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeAsync();
        UpdateCartInfo();
        CartService.OnCartChanged += UpdateCartInfo;
    }

    private void UpdateCartInfo()
    {
        itemCount = CartService.ItemCount;
        totalPrice = CartService.TotalPrice;
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void NavigateToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private string GetNavItemClasses(string href)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = (href == "/" && currentPath == "") || 
                       (href != "/" && currentPath.StartsWith(href.TrimStart('/')));
        
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    private string GetCartItemClasses()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = currentPath.StartsWith("cart");
        
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    public void Dispose()
    {
        _disposed = true;
        CartService.OnCartChanged -= UpdateCartInfo;
    }
}