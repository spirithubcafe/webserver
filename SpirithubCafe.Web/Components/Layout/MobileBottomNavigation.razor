@using SpirithubCafe.Web.Services
@inject CartService CartService
@inject NavigationManager Navigation
@inject IStringLocalizer<Resources> Localizer
@implements IDisposable
@rendermode InteractiveServer

<!-- Mobile Bottom Navigation - Only visible on mobile -->
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-lg z-50 md:hidden">
    <div class="flex items-center justify-around py-2 px-4">
        <!-- Home -->
        <a href="/" class="@GetNavItemClasses("/")">
            <div class="flex flex-col items-center py-2 px-3">
                <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
                <span class="text-xs font-medium">@Localizer["Home"]</span>
            </div>
        </a>

        <!-- Products -->
        <a href="/products" class="@GetNavItemClasses("/products")">
            <div class="flex flex-col items-center py-2 px-3">
                <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zM10 6a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z"/>
                </svg>
                <span class="text-xs font-medium">@Localizer["Products"]</span>
            </div>
        </a>

        <!-- Categories -->
        <a href="/categories" class="@GetNavItemClasses("/categories")">
            <div class="flex flex-col items-center py-2 px-3">
                <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
                </svg>
                <span class="text-xs font-medium">@Localizer["Categories"]</span>
            </div>
        </a>

        <!-- Cart -->
        <button @onclick="NavigateToCart" class="@GetCartItemClasses()">
            <div class="flex flex-col items-center py-2 px-3 relative">
                <div class="relative">
                    <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M7 4V2C7 1.45 7.45 1 8 1H16C16.55 1 17 1.45 17 2V4H20C20.55 4 21 4.45 21 5S20.55 6 20 6H19V19C19 20.1 18.1 21 17 21H7C5.9 21 5 20.1 5 19V6H4C3.45 6 3 5.55 3 5S3.45 4 4 4H7ZM9 3V4H15V3H9ZM7 6V19H17V6H7Z"/>
                    </svg>
                    
                    @if (itemCount > 0)
                    {
                        <div class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full text-xs font-bold min-w-[18px] h-[18px] flex items-center justify-center px-1">
                            @(itemCount > 99 ? "99+" : itemCount.ToString())
                        </div>
                    }
                </div>
                <span class="text-xs font-medium">@Localizer["Cart"]</span>
            </div>
        </button>

        <!-- Profile/Account -->
        <a href="/Account/Manage" class="@GetNavItemClasses("/Account/Manage")">
            <div class="flex flex-col items-center py-2 px-3">
                <svg class="w-6 h-6 mb-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
                <span class="text-xs font-medium">@Localizer["Account"]</span>
            </div>
        </a>
    </div>
</div>

@code {
    private int itemCount = 0;
    private decimal totalPrice = 0;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeAsync();
        UpdateCartInfo();
        CartService.OnCartChanged += UpdateCartInfo;
    }

    private void UpdateCartInfo()
    {
        itemCount = CartService.ItemCount;
        totalPrice = CartService.TotalPrice;
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void NavigateToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private string GetNavItemClasses(string href)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = (href == "/" && currentPath == "") || 
                       (href != "/" && currentPath.StartsWith(href.TrimStart('/')));
        
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    private string GetCartItemClasses()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = currentPath.StartsWith("cart");
        
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    public void Dispose()
    {
        _disposed = true;
        CartService.OnCartChanged -= UpdateCartInfo;
    }
}