<style>
    /* Minimal Navigation Styles */
    .animate-pulse-slow {
        animation: pulse-slow 2s ease-in-out infinite;
    }

    .animate-bounce-gentle {
        animation: bounce-gentle 1s ease-in-out infinite;
    }

    .animate-glow-pulse {
        animation: glow-pulse 2s ease-in-out infinite;
    }

    /* Mobile Navigation Safe Areas */
    .h-safe-area {
        height: env(safe-area-inset-bottom, 0px);
        max-height: 20px;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-2px);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -200% center;
        }
        100% {
            background-position: 200% center;
        }
    }

    @@keyframes ripple-effect {
        0% {
            transform: scale(0);
            opacity: 0.8;
        }
        100% {
            transform: scale(4);
            opacity: 0;
        }
    }

    /* Animation Classes */
    .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
    }

    .animate-bounce-gentle {
        animation: bounce-gentle 2s ease-in-out infinite;
    }

    .animate-glow {
        animation: glow-pulse 2s ease-in-out infinite;
    }

    .animate-float {
        animation: float 3s ease-in-out infinite;
    }

    /* Professional Hover Effects */
    .group:hover .icon-container {
        animation: float 0.6s ease-in-out;
    }

    .group:active .icon-container {
        transform: scale(0.95);
        transition: transform 0.1s ease-out;
    }

    /* Glass Morphism Effects */
    .glass-morphism {
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
    }

    /* Enhanced Drop Shadows */
    .nav-shadow {
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    }

    .active-shadow {
        filter: drop-shadow(0 2px 8px rgba(113, 90, 90, 0.3));
    }

    /* Gradient Badge Effect */
    .badge-gradient {
        background: linear-gradient(135deg, #ef4444, #dc2626, #b91c1c);
        position: relative;
        overflow: hidden;
    }

    .badge-gradient::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        animation: shimmer 2s infinite;
    }

    /* Safe Area Support */
    .h-safe-area {
        height: env(safe-area-inset-bottom);
        min-height: 8px;
    }

    /* RTL Support */
    [dir="rtl"] .nav-item {
        transform: scaleX(-1);
    }

    [dir="rtl"] .nav-item svg {
        transform: scaleX(-1);
    }

    /* Enhanced Touch Targets */
    .touch-target {
        min-width: 44px;
        min-height: 44px;
    }

    /* Professional Transitions */
    .professional-transition {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Micro-interactions */
    .micro-bounce:active {
        transform: scale(0.98);
        transition: transform 0.1s ease-out;
    }

    /* Enhanced Focus States */
    .nav-focus:focus-visible {
        outline: 2px solid #f59e0b;
        outline-offset: 2px;
        border-radius: 16px;
    }

    /* Status Indicators */
    .status-online {
        background: radial-gradient(circle, #10b981 0%, #059669 100%);
        animation: pulse-slow 2s infinite;
    }

    /* Coffee Theme Gradients */
    .coffee-gradient-primary {
        background: linear-gradient(135deg, #715A5A 0%, #8B6B3A 50%, #A0522D 100%);
    }

    .coffee-gradient-secondary {
        background: linear-gradient(135deg, rgba(113, 90, 90, 0.1) 0%, rgba(245, 158, 11, 0.1) 50%, rgba(160, 82, 45, 0.1) 100%);
    }

    /* Badge Pulse Animation */
    .badge-pulse {
        animation: bounce-gentle 2s ease-in-out infinite;
    }

    .badge-pulse::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        background: inherit;
        border-radius: inherit;
        transform: translate(-50%, -50%);
        animation: ripple-effect 2s infinite;
        opacity: 0.6;
    }

    /* Professional Accessibility Enhancements */
    .nav-item:focus-within {
        transform: scale(1.05);
        z-index: 10;
    }

    /* Professional Loading States */
    .loading-shimmer {
        background: linear-gradient(90deg, 
            transparent 0%, 
            rgba(255,255,255,0.4) 50%, 
            transparent 100%
        );
        background-size: 200px 100%;
        animation: shimmer 1.5s infinite;
    }

    /* Professional Dark Mode Adaptations */
    @@media (prefers-color-scheme: dark) {
        .glass-morphism {
            background: rgba(30, 30, 30, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        
        .coffee-gradient-secondary {
            background: linear-gradient(135deg, 
                rgba(113, 90, 90, 0.2) 0%, 
                rgba(245, 158, 11, 0.15) 50%, 
                rgba(160, 82, 45, 0.2) 100%
            );
        }
    }

    /* Professional Reduced Motion Support */
    @@media (prefers-reduced-motion: reduce) {
        .animate-pulse-slow,
        .animate-bounce-gentle,
        .animate-glow,
        .animate-float,
        .badge-pulse,
        .professional-transition {
            animation: none !important;
        }
        
        .professional-transition {
            transition: transform 0.1s ease, opacity 0.1s ease !important;
        }
    }

    /* Professional Small Screen Optimizations */
    @@media (max-width: 320px) {
        .mobile-nav-container {
            height: 68px;
            padding: 6px 8px;
        }
        
        .nav-item {
            padding: 6px;
        }
        
        .nav-item span {
            font-size: 9px;
        }
        
        .nav-item .icon-container {
            width: 24px;
            height: 24px;
        }
        
        .nav-item svg {
            width: 14px;
            height: 14px;
        }
    }

    /* Professional High Contrast Mode */
    @@media (prefers-contrast: high) {
        .glass-morphism {
            background: rgba(255, 255, 255, 0.95);
            border: 2px solid #000000;
        }
        
        .coffee-gradient-primary {
            background: #000000;
        }
        
        .nav-item {
            border: 1px solid #000000;
        }
    }
</style>

@code {
    // Professional State Management
    private int itemCount = 0;
    private decimal totalPrice = 0;
    private bool _disposed = false;
    private string? lastClickedNav = null;
    private DateTime lastClickTime = DateTime.MinValue;

    protected override void OnInitialized()
    {
        CartService.OnCartChanged += UpdateCartInfo;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartService.InitializeAsync();
            UpdateCartInfo();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void UpdateCartInfo()
    {
        itemCount = CartService.ItemCount;
        totalPrice = CartService.TotalPrice;
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    // Professional Navigation Methods
    private bool IsActive(string href)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return (href == "/" && currentPath == "") || 
               (href != "/" && currentPath.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
    }

    private void HandleNavClick(string href)
    {
        // Professional click handling with debouncing
        var now = DateTime.Now;
        if (lastClickedNav == href && (now - lastClickTime).TotalMilliseconds < 300)
        {
            return; // Prevent rapid clicks
        }
        
        lastClickedNav = href;
        lastClickTime = now;
        
        // Add haptic feedback for better UX (if supported)
        InvokeAsync(StateHasChanged);
    }

    private string GetIndicatorPosition()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        bool isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
        
        // Calculate precise positions for smooth animation
        var positions = GetNavigationPositions(isRtl);
        
        if (currentPath == "" || currentPath == "/")
            return positions["home"];
        if (currentPath.StartsWith("products", StringComparison.OrdinalIgnoreCase))
            return positions["products"];
        if (currentPath.StartsWith("cart", StringComparison.OrdinalIgnoreCase))
            return positions["cart"];
        if (currentPath.StartsWith("Account", StringComparison.OrdinalIgnoreCase))
            return positions["account"];
            
        return positions["home"];
    }

    private string GetIndicatorWidth()
    {
        // Compact width for ultra-minimal design
        return "calc(25% - 8px)";
    }

    private string GetIndicatorOffset()
    {
        // Minimal offset for compact design
        return "4px";
    }

    private Dictionary<string, string> GetNavigationPositions(bool isRtl)
    {
        if (isRtl)
        {
            return new Dictionary<string, string>
            {
                ["account"] = "0%",
                ["cart"] = "25%",
                ["products"] = "50%",
                ["home"] = "75%"
            };
        }
        else
        {
            return new Dictionary<string, string>
            {
                ["home"] = "0%",
                ["products"] = "25%",
                ["cart"] = "50%",
                ["account"] = "75%"
            };
        }
    }

    private string GetNavItemClasses(string href)
    {
        var isActive = IsActive(href);
        return $"flex-1 professional-transition micro-bounce nav-focus touch-target {(isActive ? "active-shadow" : "nav-shadow")}";
    }

    private string GetActiveStateClasses(string href)
    {
        return IsActive(href) 
            ? "coffee-gradient-primary text-white shadow-lg animate-glow" 
            : "bg-gray-200/50 text-gray-600 hover:bg-amber-200/70 hover:text-amber-700";
    }

    private string GetLabelClasses(string href)
    {
        return IsActive(href)
            ? "text-[#715A5A] font-bold tracking-wide"
            : "text-gray-600 group-hover:text-amber-700 font-semibold";
    }

    private string GetBadgeClasses()
    {
        return itemCount > 0 
            ? "badge-gradient badge-pulse animate-bounce-gentle transform hover:scale-110" 
            : "hidden";
    }

    // Professional Helper Methods
    private string GetCartBadgePosition()
    {
        bool isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
        return isRtl ? "-left-2" : "-right-2";
    }

    private string GetCartBadgeText()
    {
        if (itemCount == 0) return "";
        return itemCount > 99 ? "99+" : itemCount.ToString();
    }

    private bool ShouldShowBadge()
    {
        return itemCount > 0;
    }

    // Professional Animation Methods
    private string GetIconAnimationClasses(string href)
    {
        var baseClasses = "w-4 h-4 transition-all duration-300 professional-transition";
        if (IsActive(href))
        {
            return $"{baseClasses} text-white scale-110 animate-float";
        }
        return $"{baseClasses} text-gray-600 group-hover:text-amber-700 group-hover:scale-110";
    }

    private string GetContainerAnimationClasses(string href)
    {
        var baseClasses = "flex flex-col items-center p-3 rounded-2xl professional-transition transform touch-target";
        if (IsActive(href))
        {
            return $"{baseClasses} coffee-gradient-secondary scale-105 animate-glow";
        }
        return $"{baseClasses} hover:bg-gray-100/70 hover:scale-105 active:scale-95";
    }

    // Professional Cleanup
    public void Dispose()
    {
        _disposed = true;
