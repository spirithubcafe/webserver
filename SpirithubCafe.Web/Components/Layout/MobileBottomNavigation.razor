@using SpirithubCafe.Web.Services
@inject CartService CartService
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@implements IDisposable



<!-- Mobile Bottom Navigation - Only visible on mobile -->
<div class="fixed bottom-0 left-0 right-0 bg-white shadow-lg z-50 md:hidden">
    <div class="flex items-center justify-around py-2 px-2 relative">
    <!-- Animated Background Indicator -->
    <div class="absolute inset-x-0 top-0 h-full pointer-events-none">
        <div class="absolute h-full bg-gradient-to-r from-[#715A5A] to-[#5d4a4a] shadow-xl transition-all duration-500 ease-out"
             style="left: @GetIndicatorPosition(); width: 25%; top: 0; bottom: 0;"></div>
    </div>
        
        <!-- Home -->
        <a href="/" class="relative flex-1 group z-10">
            <div class="flex flex-col items-center py-2 px-4 relative transition-all duration-300">
                <svg class="w-7 h-7 mb-1.5 transition-all duration-300 @(IsActive("/") ? "text-white scale-110" : "text-gray-600 group-hover:scale-110 group-hover:text-amber-700")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="text-xs transition-all duration-300 @(IsActive("/") ? "font-bold text-white" : "font-semibold text-gray-600")">@Localizer["Home"]</span>
            </div>
        </a>

        <!-- Products -->
        <a href="/products" class="relative flex-1 group z-10">
            <div class="flex flex-col items-center py-2 px-4 relative transition-all duration-300">
                <svg class="w-7 h-7 mb-1.5 transition-all duration-300 @(IsActive("/products") ? "text-white scale-110" : "text-gray-600 group-hover:scale-110 group-hover:text-amber-700")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="text-xs transition-all duration-300 @(IsActive("/products") ? "font-bold text-white" : "font-semibold text-gray-600")">@Localizer["Products"]</span>
            </div>
        </a>

        <!-- Cart -->
        <a href="/cart" class="relative flex-1 group z-10 block">
            <div class="flex flex-col items-center py-2 px-4 relative transition-all duration-300">
                <div class="relative">
                    <svg class="w-7 h-7 mb-1.5 transition-all duration-300 @(IsActive("/cart") ? "text-white scale-110" : "text-gray-600 group-hover:scale-110 group-hover:text-amber-700")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    
                    @if (itemCount > 0)
                    {
                        <div class="absolute -top-1 -right-2 bg-gradient-to-br from-red-500 to-red-600 text-white rounded-full text-[10px] font-bold min-w-[20px] h-[20px] flex items-center justify-center px-1.5 shadow-lg border-2 border-white animate-bounce-subtle">
                            @(itemCount > 99 ? "99+" : itemCount.ToString())
                        </div>
                    }
                </div>
                <span class="text-xs transition-all duration-300 @(IsActive("/cart") ? "font-bold text-white" : "font-semibold text-gray-600")">@Localizer["Cart"]</span>
            </div>
        </a>

        <!-- Profile/Account -->
        <a href="/Account/Manage" class="relative flex-1 group z-10">
            <div class="flex flex-col items-center py-2 px-4 relative transition-all duration-300">
                <svg class="w-7 h-7 mb-1.5 transition-all duration-300 @(IsActive("/Account/Manage") ? "text-white scale-110" : "text-gray-600 group-hover:scale-110 group-hover:text-amber-700")" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-xs transition-all duration-300 @(IsActive("/Account/Manage") ? "font-bold text-white" : "font-semibold text-gray-600")">@Localizer["Account"]</span>
            </div>
        </a>
    </div>
</div>

<style>
    @@keyframes fade-in {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes bounce-subtle {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-3px);
        }
    }

    @@keyframes liquid-flow {
        0% {
            background-position: 0% 50%;
            transform: scale(1) rotate(0deg);
        }
        25% {
            background-position: 50% 100%;
            transform: scale(1.1) rotate(2deg);
        }
        50% {
            background-position: 100% 50%;
            transform: scale(1.15) rotate(-1deg);
        }
        75% {
            background-position: 50% 0%;
            transform: scale(1.1) rotate(1deg);
        }
        100% {
            background-position: 0% 50%;
            transform: scale(1) rotate(0deg);
        }
    }

    @@keyframes ripple {
        0% {
            transform: scale(0);
            opacity: 0.8;
        }
        50% {
            opacity: 0.4;
        }
        100% {
            transform: scale(2.5);
            opacity: 0;
        }
    }

    @@keyframes wave {
        0% {
            transform: translateX(-100%) skewX(-15deg);
            opacity: 0;
        }
        50% {
            opacity: 0.6;
        }
        100% {
            transform: translateX(200%) skewX(-15deg);
            opacity: 0;
        }
    }

    .animate-fade-in {
        animation: fade-in 0.3s ease-out;
    }

    .animate-bounce-subtle {
        animation: bounce-subtle 2s ease-in-out infinite;
    }

    .liquid-bg {
        background: linear-gradient(
            135deg,
            rgba(245, 158, 11, 0.1) 0%,
            rgba(217, 119, 6, 0.15) 25%,
            rgba(245, 158, 11, 0.2) 50%,
            rgba(217, 119, 6, 0.15) 75%,
            rgba(245, 158, 11, 0.1) 100%
        );
        background-size: 400% 400%;
        animation: liquid-flow 4s ease-in-out infinite;
        backdrop-filter: blur(2px);
    }

    .liquid-bg::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.3) 0%, transparent 70%);
        transform: translate(-50%, -50%) scale(0);
        animation: ripple 2s ease-out infinite;
        border-radius: 50%;
    }

    .liquid-bg::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 200%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(245, 158, 11, 0.2) 50%,
            transparent 100%
        );
        animation: wave 3s linear infinite;
    }

    /* Add smooth filter transition for glow effect */
    .group:hover svg {
        filter: drop-shadow(0 2px 4px rgba(245, 158, 11, 0.3));
        transition: filter 0.3s ease;
    }

    /* Enhance active state with glow */
    .group:has(.animate-fade-in) svg {
        filter: drop-shadow(0 2px 6px rgba(245, 158, 11, 0.5));
    }
</style>

@code {
    private int itemCount = 0;
    private decimal totalPrice = 0;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        await CartService.InitializeAsync();
        UpdateCartInfo();
        CartService.OnCartChanged += UpdateCartInfo;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void UpdateCartInfo()
    {
        itemCount = CartService.ItemCount;
        totalPrice = CartService.TotalPrice;
        InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private bool IsActive(string href)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return (href == "/" && currentPath == "") || 
               (href != "/" && currentPath.StartsWith(href.TrimStart('/')));
    }

    private string GetIndicatorPosition()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        
        // Home (0%)
        if (currentPath == "" || currentPath == "/")
            return "0%";
        
        // Products (25%)
        if (currentPath.StartsWith("products"))
            return "25%";
        
        // Cart (50%)
        if (currentPath.StartsWith("cart"))
            return "50%";
        
        // Account (75%)
        if (currentPath.StartsWith("Account"))
            return "75%";
        
        return "0%";
    }

    private string GetNavItemClasses(string href)
    {
        var isActive = IsActive(href);
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    private string GetCartItemClasses()
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = currentPath.StartsWith("cart");
        
        return isActive 
            ? "text-[#715A5A] hover:text-[#37353E] transition-colors duration-200" 
            : "text-gray-500 hover:text-[#715A5A] transition-colors duration-200";
    }

    public void Dispose()
    {
        _disposed = true;
        CartService.OnCartChanged -= UpdateCartInfo;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}