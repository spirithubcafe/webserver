@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@implements IDisposable
@rendermode InteractiveServer

<style>
    .admin-bg-primary { background-color: #37353E; }
    .admin-bg-secondary { background-color: #44444E; }
    .admin-text-primary { color: #D3DAD9; }
    .admin-text-secondary { color: #b1b9b8ff; }
    .admin-hover:hover { background-color: #44444E; }
    .admin-focus:focus { 
        outline: none; 
        box-shadow: 0 0 0 2px #715A5A; 
    }
    .admin-scrollbar::-webkit-scrollbar-thumb { 
        background-color: #715A5A; 
    }
    .admin-scrollbar::-webkit-scrollbar-track { 
        background-color: #37353E; 
    }
</style>

<!-- Mobile menu button -->
<div class="lg:hidden fixed top-4 ltr:left-4 rtl:right-4 z-50">
    <button @onclick="ToggleMobileMenu" type="button" 
            class="admin-bg-primary text-white p-2 rounded-md shadow-lg admin-hover transition-colors admin-focus">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>
</div>

@if (isMobileMenuOpen)
{
    <!-- Mobile overlay -->
    <div @onclick="CloseMobileMenu" 
         class="lg:hidden fixed inset-0 bg-black bg-opacity-50 z-40">
    </div>
}

<!-- Sidebar -->
<div class="@GetSidebarClasses()"
     @key="@("admin-sidebar")">
     
    <!-- Logo -->
    <div class="flex items-center justify-between h-16 admin-bg-secondary px-4 flex-shrink-0">
        <div class="flex items-center space-x-3 rtl:space-x-reverse">
            <svg class="w-8 h-8 admin-text-secondary" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm-5 10c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2V5h10v8z"/>
                <circle cx="15.5" cy="8.5" r="1.5"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
            </svg>
            <span class="text-xl font-bold text-white">@Localizer["Admin Panel"]</span>
        </div>
        
        <!-- Close button for mobile -->
        <button @onclick="CloseMobileMenu" class="lg:hidden admin-text-secondary hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Navigation - Scrollable Area -->
    <div class="flex-1 overflow-y-auto admin-scrollbar" style="padding-bottom: 80px;">
        <nav class="mt-8">
            <ul class="space-y-2 px-4">
            <!-- Dashboard -->
            <li>
                <a href="/admin" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span>@Localizer["Dashboard"]</span>
                </a>
            </li>

            <!-- Products -->
            <li>
                <a href="/admin/products" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                    <span>@Localizer["Products"]</span>
                </a>
            </li>

            <!-- Categories -->
            <li>
                <a href="/admin/categories" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    <span>@Localizer["Categories"]</span>
                </a>
            </li>

            <!-- Orders -->
            <li>
                <a href="/admin/orders" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                    </svg>
                    <span>Orders</span>
                </a>
            </li>

            <!-- Shipping -->
            <li>
                <div class="relative">
                    <button @onclick="ToggleShippingMenu" class="flex items-center justify-between w-full p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                        <div class="flex items-center space-x-3 rtl:space-x-reverse">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                            </svg>
                            <span>Shipping</span>
                        </div>
                        <svg class="w-4 h-4 transform transition-transform @(isShippingMenuOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    
                    @if (isShippingMenuOpen)
                    {
                        <div class="mt-2 space-y-1 ltr:pl-6 rtl:pr-6">
                            <a href="/admin/shipping" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-2 rounded-lg admin-text-secondary admin-hover hover:text-white transition-colors text-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>Countries & Cities</span>
                            </a>
                            <a href="/admin/shipping-methods" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-2 rounded-lg admin-text-secondary admin-hover hover:text-white transition-colors text-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                <span>Shipping Methods</span>
                            </a>
                            <a href="/admin/aramex-settings" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-2 rounded-lg admin-text-secondary admin-hover hover:text-white transition-colors text-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>Aramex Settings</span>
                            </a>
                        </div>
                    }
                </div>
            </li>

            <!-- Users -->
            <li>
                <a href="/admin/users" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                    </svg>
                    <span>@Localizer["Users"]</span>
                </a>
            </li>

            <!-- Chat Management -->
            <li>
                <a href="/admin/chat-management" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    <span>@Localizer["ChatManagement"]</span>
                </a>
            </li>

            <!-- Reviews Management -->
            <li>
                <a href="/admin/reviews" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                    <span>@Localizer["ManageReviews"]</span>
                </a>
            </li>

            <!-- Reports -->
            <li>
                <a href="/admin/reports" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2-2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    <span>@Localizer["Reports"]</span>
                </a>
            </li>

            <!-- Pages -->
            <li>
                <button @onclick="TogglePagesMenu" class="w-full flex items-center justify-between space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <div class="flex items-center space-x-3 rtl:space-x-reverse">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span>Pages</span>
                    </div>
                    <svg class="w-4 h-4 transform @(isPagesMenuOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                
                @if (isPagesMenuOpen)
                {
                    <ul class="mt-2 ltr:ml-6 rtl:mr-6 space-y-1">
                        <li>
                            <a href="/admin/pages/home" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                                </svg>
                                <span>Home</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/shop" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                </svg>
                                <span>Shop</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/about" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>About Us</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/contact" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                                <span>Contact Us</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/privacy" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                                <span>Privacy Policy</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/terms" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <span>Terms & Conditions</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/delivery" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                </svg>
                                <span>Delivery Policy</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/refund" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                                </svg>
                                <span>Refund Policy</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/pages/faq" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>FAQ</span>
                            </a>
                        </li>
                        <li>
                            <a href="/admin/footer" @onclick="OnMenuItemClick" class="flex items-center space-x-2 rtl:space-x-reverse p-2 rounded text-sm admin-text-secondary admin-hover hover:text-white transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                                </svg>
                                <span>@Localizer["FooterManagement"]</span>
                            </a>
                        </li>
                    </ul>
                }
            </li>

            <!-- Settings -->
            <li>
                <a href="/admin/settings" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>@Localizer["Settings"]</span>
                </a>
            </li>

            <!-- Footer Settings -->
            <li>
                <a href="/admin/footer" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                    </svg>
                    <span>Footer Settings</span>
                </a>
            </li>

            <!-- Payment Gateway Settings -->
            <li>
                <a href="/admin/payment-gateway-settings" @onclick="OnMenuItemClick" class="flex items-center space-x-3 rtl:space-x-reverse p-3 rounded-lg admin-text-primary admin-hover hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                    <span>@Localizer["PaymentGatewaySettings"]</span>
                </a>
            </li>
            </ul>
        </nav>
    </div>

    <!-- User info at bottom -->
    <div class="absolute bottom-0 left-0 right-0 p-4 admin-bg-secondary flex-shrink-0 z-10 border-t" style="border-color: #715A5A;">
        <div class="flex items-center space-x-3 rtl:space-x-reverse w-full">
            <div class="w-8 h-8 admin-bg-primary rounded-full flex items-center justify-center flex-shrink-0 shadow-md">
                <span class="text-white text-sm font-medium">A</span>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-white truncate">Administrator</p>
                <p class="text-xs admin-text-secondary">@Localizer["Administrator"]</p>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private bool isPagesMenuOpen = false;
    private bool isShippingMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private void TogglePagesMenu()
    {
        isPagesMenuOpen = !isPagesMenuOpen;
    }

    private void ToggleShippingMenu()
    {
        isShippingMenuOpen = !isShippingMenuOpen;
    }

    private void OnMenuItemClick()
    {
        if (isMobileMenuOpen)
        {
            isMobileMenuOpen = false;
        }
    }

    private string GetSidebarClasses()
    {
        var baseClasses = "fixed inset-y-0 z-50 w-64 admin-bg-primary text-white flex flex-col transition-transform duration-300 ease-in-out";
        var positionClasses = "ltr:left-0 rtl:right-0";
        var visibilityClasses = "";

        // Desktop: always visible
        // Mobile: show/hide based on menu state
        if (isMobileMenuOpen)
        {
            visibilityClasses = "translate-x-0";
        }
        else
        {
            visibilityClasses = "ltr:-translate-x-full rtl:translate-x-full lg:ltr:translate-x-0 lg:rtl:translate-x-0";
        }

        return $"{baseClasses} {positionClasses} {visibilityClasses}";
    }

    public void Dispose()
    {
    }
}