    private string FormatWeight(decimal weight, string weightUnit)
    {
        // Convert 1000 grams to 1 kilogram for display
        if ((weightUnit.ToLower() == "g" || weightUnit.ToLower() == "gram" || weightUnit.ToLower() == "grams") && weight == 1000)
        {
            var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
            if (currentCulture.StartsWith("ar"))
            {
                return "1 كيلوغرام";
            }
            return "1 kg";
        }
        
        return $"{weight} {weightUnit}";
    }
