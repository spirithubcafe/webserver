

@inject SpirithubCafe.Application.Services.ISlideService SlideService
@inject TranslationLocalizer Localizer
@using SpirithubCafe.Application.DTOs
@using System.Globalization
@implements IDisposable

<!-- Professional Hero Slideshow Section -->
<div class="hero-slideshow" id="heroSlideshow">
    @if (slides.Any())
    {
        <!-- Slides Container -->
        <div class="slides-container">
            @for (int i = 0; i < slides.Count; i++)
            {
                var slide = slides[i];
                var isActive = i == currentSlideIndex;
                
                <div class="slide @(isActive ? "active" : "")" data-slide="@i">
                    <!-- Background Image -->
                    <div class="slide-background">
                        <img src="@slide.ImagePath" alt="@slide.GetLocalizedTitle(CultureInfo.CurrentUICulture.Name)" 
                             class="slide-image" loading="@(isActive ? "eager" : "lazy")" />
                        <div class="slide-overlay"></div>
                    </div>
                    
                    <!-- Content -->
                    <div class="slide-content">
                        <div class="content-wrapper">
                            <!-- Title -->
                            <h1 class="slide-title @slide.TextColor">
                                @slide.GetLocalizedTitle(CultureInfo.CurrentUICulture.Name)
                            </h1>
                            
                            <!-- Subtitle -->
                            <p class="slide-subtitle @slide.TextColor">
                                @slide.GetLocalizedSubtitle(CultureInfo.CurrentUICulture.Name)
                            </p>
                            
                            <!-- Call to Action Button -->
                            @if (!string.IsNullOrEmpty(slide.ButtonText) && !string.IsNullOrEmpty(slide.ButtonUrl))
                            {
                                <div class="slide-actions">
                                    <a href="@slide.ButtonUrl" class="cta-button">
                                        @slide.GetLocalizedButtonText(CultureInfo.CurrentUICulture.Name)
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Navigation Controls -->
        <div class="slideshow-controls">
            <!-- Previous Button -->
            <button class="nav-button prev-button" @onclick="PrevSlide" aria-label="@Localizer["PreviousSlide"]">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            
            <!-- Next Button -->
            <button class="nav-button next-button" @onclick="NextSlide" aria-label="@Localizer["NextSlide"]">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>

    }
    else
    {
        <!-- Default Hero when no slides -->
        <div class="slide active default-slide">
            <div class="slide-background">
                <div class="default-background"></div>
                <div class="slide-overlay"></div>
            </div>
            <div class="slide-content">
                <div class="content-wrapper">
                    <h1 class="slide-title text-white">
                        SpirithubCafe
                    </h1>
                    <p class="slide-subtitle text-white">
                        @Localizer["Welcome to our premium coffee experience"]
                    </p>
                    <div class="slide-actions">
                        <a href="/products" class="cta-button cta-outline">
                            @Localizer["Explore Products"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Simple C# Slideshow - No JavaScript -->

<style>
    /* Professional Hero Slideshow Styles */
    .hero-slideshow {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background: #000;
    }
    
    .slides-container {
        position: relative;
        width: 100%;
        height: 100%;
    }
    
    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
        z-index: 1;
    }
    
    .slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
    }
    
    .slide-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
    
    .slide-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transform: scale(1.02);
        transition: transform 8s ease-out;
    }
    
    .slide.active .slide-image {
        transform: scale(1);
    }
    
    .slide-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            rgba(0, 0, 0, 0.4) 0%,
            rgba(0, 0, 0, 0.2) 50%,
            rgba(0, 0, 0, 0.6) 100%
        );
        z-index: 1;
    }
    
    .default-background {
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            #ff6b35 0%,
            #f7931e 25%,
            #8b4513 75%,
            #5d2a0a 100%
        );
    }
    
    .slide-content {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        padding: 2rem;
    }
    
    .content-wrapper {
        text-align: center;
        max-width: 1200px;
        width: 100%;
    }
    
    .slide-title {
        font-size: clamp(1.5rem, 4vw, 2.5rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: translateY(50px);
        animation: slideInUp 1s ease-out 0.5s forwards;
    }
    
    .slide-subtitle {
        font-size: clamp(0.875rem, 1.5vw, 1rem);
        line-height: 1.6;
        margin-bottom: 2rem;
        opacity: 0.95;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        opacity: 0;
        transform: translateY(30px);
        animation: slideInUp 1s ease-out 0.8s forwards;
    }
    
    .slide-actions {
        opacity: 0;
        transform: translateY(20px);
        animation: slideInUp 1s ease-out 1.1s forwards;
    }
    
    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 2rem;
        background: #443939ff;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(113, 90, 90, 0.3);
        border: 2px solid transparent;
    }
    
    .cta-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(113, 90, 90, 0.4);
        background: #5d4a4a;
    }
    
    .cta-outline {
        background: transparent;
        border: 2px solid white;
        box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
    }
    
    .cta-outline:hover {
        background: white;
        color: #715A5A;
        box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
    }
    
    /* Navigation Controls */
    .slideshow-controls {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        transform: translateY(-50%);
        display: flex;
        justify-content: space-between;
        padding: 0 1rem;
        z-index: 10;
        pointer-events: none;
        opacity: 0.6;
        transition: opacity 0.5s ease;
    }
    
    .slideshow-controls:hover {
        opacity: 1;
    }
    
    .slideshow-controls.hidden {
        opacity: 0;
    }
    
    .nav-button {
        width: 40px;
        height: 40px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(0, 0, 0, 0.2);
        color: white;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
        pointer-events: auto;
    }
    
    .nav-button:hover {
        background: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.6);
        transform: scale(1.05);
    }
    
    .nav-button svg {
        width: 18px;
        height: 18px;
    }
    
    /* Ensure navigation arrows maintain consistent position in RTL/LTR */
    [dir="rtl"] .nav-button svg,
    [dir="ltr"] .nav-button svg {
        transform: none !important;
    }
    
    [dir="rtl"] .nav-button,
    [dir="ltr"] .nav-button {
        transform: none !important;
    }
    
    [dir="rtl"] .nav-button:hover,
    [dir="ltr"] .nav-button:hover {
        transform: scale(1.05) !important;
    }
    
    /* Ensure slideshow controls maintain consistent spacing in RTL/LTR */
    [dir="rtl"] .slideshow-controls,
    [dir="ltr"] .slideshow-controls {
        display: flex;
        justify-content: space-between;
        padding: 0 1rem;
    }
    
    @@media (max-width: 768px) {
        [dir="rtl"] .slideshow-controls,
        [dir="ltr"] .slideshow-controls {
            padding: 0 0.5rem;
        }
    }
    
    @@media (max-width: 480px) {
        [dir="rtl"] .slideshow-controls,
        [dir="ltr"] .slideshow-controls {
            padding: 0 0.25rem;
        }
    }
    
    /* Progress Bar */
    .progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.2);
        z-index: 10;
    }
    
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #ff6b35, #f7931e);
        width: 0;
    }
    
    /* Animations */
    @@keyframes slideInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @@keyframes progress {
        from { width: 0; }
        to { width: 100%; }
    }
    
    /* Text Color Classes */
    .text-white { color: white; }
    .text-black { color: #333; }
    .text-amber-100 { color: #fef3c7; }
    .text-amber-200 { color: #fde68a; }
    
    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .slide-content {
            padding: 1rem;
        }
        
        .slide-title {
            margin-bottom: 1rem;
            font-size: clamp(1.25rem, 3.5vw, 2rem);
        }
        
        .slide-subtitle {
            margin-bottom: 1.5rem;
            font-size: clamp(0.75rem, 1.2vw, 0.9rem);
        }
        
        .cta-button {
            padding: 0.75rem 1.5rem;
            font-size: 0.875rem;
        }
        
        .nav-button {
            width: 35px;
            height: 35px;
            background: rgba(0, 0, 0, 0.25);
            border-width: 1px;
        }
        
        .nav-button svg {
            width: 16px;
            height: 16px;
        }
        
        .slideshow-controls {
            padding: 0 0.5rem;
            opacity: 0.5;
        }
        
        .slideshow-controls:hover {
            opacity: 0.8;
        }
    }
    
    @@media (max-width: 480px) {
        .slide-content {
            padding: 0.75rem 0.5rem;
        }
        
        .slide-title {
            font-size: clamp(1rem, 3vw, 1.5rem);
            margin-bottom: 0.75rem;
        }
        
        .slide-subtitle {
            font-size: clamp(0.7rem, 1vw, 0.8rem);
            margin-bottom: 1.25rem;
            line-height: 1.4;
        }
        
        .cta-button {
            padding: 0.65rem 1.25rem;
            font-size: 0.75rem;
            letter-spacing: 0.3px;
        }
        
        .slideshow-controls {
            padding: 0 0.25rem;
            opacity: 0.4;
        }
        
        .slideshow-controls:hover {
            opacity: 0.7;
        }
        
        .nav-button {
            width: 30px;
            height: 30px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 4px;
        }
        
        .nav-button svg {
            width: 14px;
            height: 14px;
        }
    }
</style>

<script>
    // Mouse movement handler for navigation controls
    (function() {
        let hideControlsTimeout;
        
        document.addEventListener('DOMContentLoaded', function() {
            const slideshow = document.getElementById('heroSlideshow');
            const controls = document.querySelector('.slideshow-controls');
            
            if (!slideshow || !controls) return;
            
            // Function to show controls
            function showControls() {
                controls.classList.remove('hidden');
            }
            
            // Function to hide controls
            function hideControls() {
                controls.classList.add('hidden');
            }
            
            // Function to reset the hide timer
            function resetHideTimer() {
                showControls();
                clearTimeout(hideControlsTimeout);
                hideControlsTimeout = setTimeout(hideControls, 3000);
            }
            
            // Listen for mouse movement on the slideshow
            slideshow.addEventListener('mousemove', resetHideTimer);
            slideshow.addEventListener('mouseenter', resetHideTimer);
            
            // Listen for mouse leave to hide immediately
            slideshow.addEventListener('mouseleave', function() {
                clearTimeout(hideControlsTimeout);
                hideControlsTimeout = setTimeout(hideControls, 1000);
            });
            
            // Touch support for mobile
            slideshow.addEventListener('touchstart', resetHideTimer);
            
            // Initially hide controls after 3 seconds
            hideControlsTimeout = setTimeout(hideControls, 3000);
        });
    })();
</script>

@code {
    private List<SlideDto> slides = new();
    private int currentSlideIndex = 0;
    private Timer? slideTimer;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await SlideService.GetActiveSlidesAsync();
            if (result.Success)
            {
                slides = result.Slides.ToList();
                if (slides.Count > 1)
                {
                    StartSlideshow();
                }
            }
        }
        catch (Exception ex)
        {
            // Log error but don't break the component
            Console.WriteLine($"Error loading slides: {ex.Message}");
        }
    }

    private void StartSlideshow()
    {
        slideTimer = new Timer(async _ =>
        {
            currentSlideIndex = (currentSlideIndex + 1) % slides.Count;
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void NextSlide()
    {
        currentSlideIndex = (currentSlideIndex + 1) % slides.Count;
        RestartTimer();
    }

    private void PrevSlide()
    {
        currentSlideIndex = (currentSlideIndex - 1 + slides.Count) % slides.Count;
        RestartTimer();
    }

    private void RestartTimer()
    {
        slideTimer?.Dispose();
        if (slides.Count > 1)
        {
            StartSlideshow();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        slideTimer?.Dispose();
    }
}