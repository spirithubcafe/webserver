9 19.2063C13.3646 19.4441 13.1864 19.7468 12.9833 20.0898L14.2742 20.8539ZM16.1975 18.2416C15.7862 18.2487 15.4266 18.2541 15.129 18.287C14.8175 18.3215 14.5129 18.3912 14.2201 18.5615L14.9742 19.8582C15.0192 19.832 15.096 19.7999 15.2941 19.7779C15.5061 19.7545 15.7842 19.7489 16.2233 19.7413L16.1975 18.2416Z" fill="#1C274C"/>
<path d="M8 9H16" stroke="#1C274C" stroke-width="1.5" stroke-linecap="round"/>
<path d="M8 12.5H13.5" stroke="#1C274C" stroke-width="1.5" stroke-linecap="round"/>
</svg>
        </button>
    }
    else
    {
        <div class="bg-white rounded-lg shadow-xl w-80 h-96 flex flex-col border border-gray-200">
            <!-- Header -->
            <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white p-4 rounded-t-lg flex justify-between items-center">
                <h3 class="font-semibold">@Localizer["ChatWithUs"]</h3>
                <button @onclick="ToggleChat" class="text-white hover:text-gray-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 flex flex-col">
                @if (currentSession == null)
                {
                    <!-- Start Chat Form -->
                    <div class="p-4 flex-1 flex flex-col justify-center">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["YourName"] *</label>
                                <input @bind="chatForm.VisitorName" 
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500" 
                                       required />
                            </div>
                        
                            <div>
                                <input @bind="chatForm.VisitorEmail" 
                                       placeholder="@(Localizer["YourEmail"] + " (" + Localizer["Optional"] + ")")"
                                       type="email"
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500" />
                            </div>
                        
                            <button @onclick="StartChatSession" 
                                    disabled="@isLoading"
                                    class="w-full bg-gradient-to-r from-amber-500 to-orange-500 text-white py-2 rounded-lg hover:from-amber-600 hover:to-orange-600 transition-colors disabled:opacity-50">
                                @if (isLoading)
                                {
                                    <span>@Localizer["Loading"]...</span>
                                }
                                else
                                {
                                    <span>@Localizer["StartChat"]</span>
                                }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Chat Messages -->
                    <div class="flex-1 p-4 overflow-y-auto bg-gray-50" @ref="messagesContainer">
                        @if (messages.Any())
                        {
                            @foreach (var message in messages)
                            {
                                <div class="mb-3 @(message.SenderType == ChatSenderType.Visitor ? "text-right" : "text-left")">
                                    <div class="inline-block max-w-xs lg:max-w-md px-3 py-2 rounded-lg @(message.SenderType == ChatSenderType.Visitor ? "bg-amber-500 text-white" : "bg-white text-gray-800 border")">
                                        <div class="text-sm">@message.Content</div>
                                        <div class="text-xs opacity-70 mt-1">@message.CreatedAt.ToString("HH:mm")</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-gray-500 text-sm">
                                @Localizer["TypeYourMessage"]...
                            </div>
                        }
                    </div>

                    <!-- Message Input -->
                    <div class="p-4 border-t bg-white rounded-b-lg">
                        <div class="flex gap-2">
                            <input @bind="messageForm.Content" 
                                   @onkeypress="@(async (e) => { if (e.Key == "Enter") await SendMessage(); })"
                                   placeholder="@Localizer["TypeYourMessage"]..."
                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500"
                                   disabled="@isLoading" />
                            <button @onclick="SendMessage" 
                                    disabled="@(isLoading || string.IsNullOrWhiteSpace(messageForm.Content))"
                                    class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600 transition-colors disabled:opacity-50">
                                @Localizer["Send"]
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isExpanded = false;
    private bool isLoading = false;
    private ChatSession? currentSession;
    private List<ChatMessage> messages = new();
    private ElementReference messagesContainer;
    private ChatForm chatForm = new();
    private MessageForm messageForm = new();
    private Timer? refreshTimer;
    private DateTime lastMessageCheck = DateTime.UtcNow;

    public class ChatForm
    {
        [Required]
        public string VisitorName { get; set; } = string.Empty;
        public string? VisitorEmail { get; set; }
    }

    public class MessageForm
    {
        [Required]
        public string Content { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        // Setup refresh timer for checking new messages
        refreshTimer = new Timer(3000); // Check every 3 seconds
        refreshTimer.Elapsed += async (sender, e) => await CheckForNewMessages();
        refreshTimer.AutoReset = true;
    }

    private async Task CheckForNewMessages()
    {
        if (currentSession == null || !isExpanded) return;
        
        try
        {
            var allMessages = await ChatService.GetMessagesAsync(currentSession.Id);
            var newMessages = allMessages.Where(m => m.CreatedAt > lastMessageCheck).ToList();
            
            if (newMessages.Any())
            {
                foreach (var msg in newMessages)
                {
                    if (!messages.Any(m => m.Id == msg.Id))
                    {
                        messages.Add(msg);
                    }
                }
                lastMessageCheck = DateTime.UtcNow;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking for new messages: {ex.Message}");
        }
    }

    private void ToggleChat()
    {
        isExpanded = !isExpanded;
        
        if (isExpanded && refreshTimer != null)
        {
            refreshTimer.Enabled = true;
        }
        else if (refreshTimer != null)
        {
            refreshTimer.Enabled = false;
        }
        
        StateHasChanged();
    }

    private async Task StartChatSession()
    {
        if (isLoading) return;
        
        isLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(chatForm.VisitorName))
            {
                ToastService.ShowError(Localizer["PleaseEnterYourName"]);
                return;
            }

            // Use a simple IP detection or default value
            var ipAddress = "127.0.0.1"; // Default for now
            
            currentSession = await ChatService.CreateChatSessionAsync(
                chatForm.VisitorName, 
                chatForm.VisitorEmail, 
                ipAddress);

            if (currentSession != null)
            {
                await LoadMessages();
                refreshTimer!.Enabled = true;
                ToastService.ShowSuccess(Localizer["ChatStartedSuccessfully"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (currentSession == null || isLoading || string.IsNullOrWhiteSpace(messageForm.Content))
            return;

        isLoading = true;
        var content = messageForm.Content.Trim();
        messageForm.Content = string.Empty;
        StateHasChanged();

        try
        {
            var message = await ChatService.SendMessageAsync(
                currentSession.Id,
                ChatSenderType.Visitor,
                currentSession.VisitorName,
                content);

            if (message != null)
            {
                messages.Add(message);
                lastMessageCheck = DateTime.UtcNow;
                ToastService.ShowSuccess(Localizer["MessageSentSuccessfully"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Localizer["ErrorSendingMessage"]);
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMessages()
    {
        if (currentSession == null) return;
        
        try
        {
            messages = (await ChatService.GetMessagesAsync(currentSession.Id)).ToList();
            lastMessageCheck = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}