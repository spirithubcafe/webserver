@using SpirithubCafe.Web.Services
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Application.Services
@using System.Timers
@using Microsoft.JSInterop
@inject IChatService ChatService
@inject ISettingService SettingService
@inject IStringLocalizer<Resources> Localizer
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer

@if (isChatWidgetEnabled)
{
<div class="fixed bottom-4 right-4 z-50">
    @if (!isExpanded)
    {
        <button @onclick="ToggleChat" 
                class="bg-gradient-to-r from-amber-500 to-orange-500 text-white p-4 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 animate-pulse-slow">
            @if (hasUnreadMessages)
            {
                <div class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center animate-bounce">
                    !
                </div>
            }
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
</svg>
        </button>
    }
    else
    {
        <div class="bg-white rounded-lg shadow-2xl w-80 h-[500px] flex flex-col border border-gray-200 overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white p-4 flex justify-between items-center">
                <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
                    <h3 class="font-semibold">@Localizer["ChatWithUs"]</h3>
                </div>
                <div class="flex items-center space-x-2">
                    @if (currentSession != null)
                    {
                        <button @onclick="EndChatSession" class="text-white hover:text-gray-200 text-xs px-2 py-1 bg-black bg-opacity-20 rounded">
                            End Chat
                        </button>
                    }
                    <button @onclick="ToggleChat" class="text-white hover:text-gray-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="flex-1 flex flex-col">
                @if (currentSession == null)
                {
                    <!-- Start Chat Form -->
                    <div class="chat-form-container p-6 flex-1 flex flex-col justify-center overflow-y-auto">
                        <style>
                            .chat-form-container {
                                scrollbar-width: thin;
                                scrollbar-color: #d97706 #f3f4f6;
                            }
                            .chat-form-container::-webkit-scrollbar {
                                width: 8px;
                            }
                            .chat-form-container::-webkit-scrollbar-track {
                                background: #f3f4f6;
                                border-radius: 4px;
                            }
                            .chat-form-container::-webkit-scrollbar-thumb {
                                background: linear-gradient(to bottom, #f59e0b, #d97706);
                                border-radius: 4px;
                            }
                            .chat-form-container::-webkit-scrollbar-thumb:hover {
                                background: linear-gradient(to bottom, #d97706, #b45309);
                            }
                            .chat-messages-container {
                                scrollbar-width: thin;
                                scrollbar-color: #d97706 #f3f4f6;
                            }
                            .chat-messages-container::-webkit-scrollbar {
                                width: 8px;
                            }
                            .chat-messages-container::-webkit-scrollbar-track {
                                background: #f3f4f6;
                                border-radius: 4px;
                            }
                            .chat-messages-container::-webkit-scrollbar-thumb {
                                background: linear-gradient(to bottom, #f59e0b, #d97706);
                                border-radius: 4px;
                            }
                            .chat-messages-container::-webkit-scrollbar-thumb:hover {
                                background: linear-gradient(to bottom, #d97706, #b45309);
                            }
                        </style>
                        <div class="text-center mb-6">
                            <div class="w-16 h-16 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full flex items-center justify-center mx-auto mb-3">
                                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                                </svg>
                            </div>
                            <h4 class="text-lg font-semibold text-gray-800">@Localizer["StartChat"]</h4>
                            <p class="text-sm text-gray-600">We're here to help! Start a conversation with us.</p>
                        </div>
                        
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["YourName"] *</label>
                                <input @bind="chatForm.VisitorName" 
                                       class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" 
                                       required />
                            </div>
                        
                            <div class="grid grid-cols-1 gap-3">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["YourEmail"]</label>
                                    <input @bind="chatForm.VisitorEmail" 
                                           placeholder="example@email.com"
                                           type="email"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                                </div>
                                
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["PhoneNumber"]</label>
                                    <input @bind="chatForm.PhoneNumber" 
                                           placeholder="+1 234 567 8900"
                                           type="tel"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent" />
                                </div>
                            </div>
                            
                            <div class="text-xs text-gray-500 text-center bg-amber-50 p-2 rounded">
                                ℹ️ @Localizer["EmailOrPhoneRequired"]
                            </div>
                        
                            <button @onclick="StartChatSession" 
                                    disabled="@(isLoading || !chatForm.IsContactInfoValid || string.IsNullOrWhiteSpace(chatForm.VisitorName))"
                                    class="w-full bg-gradient-to-r from-amber-500 to-orange-500 text-white py-3 rounded-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed font-medium">
                                @if (isLoading)
                                {
                                    <div class="flex items-center justify-center">
                                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                        </svg>
                                        <span>@Localizer["Loading"]...</span>
                                    </div>
                                }
                                else
                                {
                                    <span>💬 @Localizer["StartChat"]</span>
                                }
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Chat Messages -->
                    <div class="chat-messages-container flex-1 p-3 overflow-y-auto bg-gradient-to-b from-gray-50 to-gray-100" @ref="messagesContainer" style="max-height: 350px;">
                        @if (messages.Any())
                        {
                            @foreach (var message in messages)
                            {
                                <div class="mb-4 @(message.SenderType == ChatSenderType.Visitor ? "text-right" : "text-left")">
                                    <div class="inline-block max-w-[240px] px-4 py-3 rounded-2xl shadow-sm @(message.SenderType == ChatSenderType.Visitor ? "bg-gradient-to-r from-amber-500 to-orange-500 text-white" : "bg-white text-gray-800 border border-gray-200")">
                                        <div class="text-sm leading-relaxed">@message.Content</div>
                                        <div class="text-xs opacity-70 mt-2 @(message.SenderType == ChatSenderType.Visitor ? "text-amber-100" : "text-gray-500")">
                                            @message.SenderName • @message.CreatedAt.ToString("HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (isTyping)
                            {
                                <div class="mb-4 text-left">
                                    <div class="inline-block bg-white border border-gray-200 px-4 py-3 rounded-2xl shadow-sm">
                                        <div class="flex space-x-1">
                                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
                                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                                            <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-gray-500 text-sm py-8">
                                <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-3">
                                    💬
                                </div>
                                <p>@Localizer["TypeYourMessage"]...</p>
                            </div>
                        }
                    </div>

                    <!-- Message Input -->
                    <div class="p-3 border-t bg-white">
                        <div class="flex gap-2 items-end">
                            <div class="flex-1">
                                <textarea @bind="messageForm.Content" 
                                         @onkeypress="@HandleKeyPress"
                                         placeholder="@Localizer["TypeYourMessage"]..."
                                         rows="1"
                                         class="w-full px-4 py-2.5 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent resize-none"
                                         disabled="@isLoading"
                                         style="max-height: 80px; min-height: 38px;"></textarea>
                            </div>
                            <button @onclick="SendMessage" 
                                    disabled="@(isLoading || string.IsNullOrWhiteSpace(messageForm.Content))"
                                    class="w-10 h-10 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-full hover:from-amber-600 hover:to-orange-600 transition-all duration-200 disabled:opacity-50 flex items-center justify-center">
                                @if (isLoading)
                                {
                                    <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
}

@code {
    private bool isExpanded = false;
    private bool isLoading = false;
    private bool isChatWidgetEnabled = true;
    private bool hasUnreadMessages = false;
    private bool isTyping = false;
    private ChatSession? currentSession;
    private List<ChatMessage> messages = new();
    private ElementReference messagesContainer;
    private ChatForm chatForm = new();
    private MessageForm messageForm = new();
    private Timer? refreshTimer;
    private Timer? typingTimer;
    private DateTime lastMessageCheck = DateTime.Now;
    private string? storedSessionId;

    public class ChatForm
    {
        [Required]
        public string VisitorName { get; set; } = string.Empty;
        public string? VisitorEmail { get; set; }
        public string? PhoneNumber { get; set; }

        // Custom validation: Either email or phone must be provided
        public bool IsContactInfoValid => !string.IsNullOrWhiteSpace(VisitorEmail) || !string.IsNullOrWhiteSpace(PhoneNumber);
    }

    public class MessageForm
    {
        [Required]
        public string Content { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        // Check if chat widget is enabled
        var chatWidgetSetting = await SettingService.GetValueAsync("ChatWidgetEnabled", "true");
        isChatWidgetEnabled = chatWidgetSetting.Equals("true", StringComparison.OrdinalIgnoreCase);
        
        if (isChatWidgetEnabled)
        {
            // Try to restore existing session
            await RestoreSession();
            
            // Setup refresh timer for checking new messages
            refreshTimer = new Timer(3000); // Check every 3 seconds
            refreshTimer.Elapsed += async (sender, e) => await CheckForNewMessages();
            refreshTimer.AutoReset = true;
            refreshTimer.Enabled = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isChatWidgetEnabled)
        {
            // Restore expanded state
            try
            {
                var expanded = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "chatWidget_expanded");
                if (!string.IsNullOrEmpty(expanded) && bool.TryParse(expanded, out var isExpandedStored))
                {
                    isExpanded = isExpandedStored;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error restoring expanded state: {ex.Message}");
            }
        }
    }

    private async Task RestoreSession()
    {
        try
        {
            storedSessionId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "chatWidget_sessionId");
            if (!string.IsNullOrEmpty(storedSessionId) && Guid.TryParse(storedSessionId, out var parsedSessionId))
            {
                // Try to get the session from the service
                var sessions = await ChatService.GetActiveSessionsAsync();
                currentSession = sessions.FirstOrDefault(s => s.Id == storedSessionId);
                
                if (currentSession != null)
                {
                    // Restore chat form data
                    chatForm.VisitorName = currentSession.VisitorName;
                    chatForm.VisitorEmail = currentSession.VisitorEmail;
                    chatForm.PhoneNumber = currentSession.PhoneNumber;
                    
                    await LoadMessages();
                }
                else
                {
                    // Session doesn't exist anymore, clear localStorage
                    await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "chatWidget_sessionId");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error restoring session: {ex.Message}");
        }
    }

    private async Task CheckForNewMessages()
    {
        if (currentSession == null) return;
        
        try
        {
            var allMessages = await ChatService.GetMessagesAsync(currentSession.Id);
            var messagesList = allMessages.ToList();
            
            // Check for new admin messages
            var newAdminMessages = messagesList.Where(m => 
                m.SenderType == ChatSenderType.Admin && 
                m.CreatedAt > lastMessageCheck &&
                !messages.Any(existing => existing.Id == m.Id)
            ).ToList();
            
            if (newAdminMessages.Any())
            {
                foreach (var msg in newAdminMessages)
                {
                    messages.Add(msg);
                }
                
                // Show notification if chat is not expanded
                if (!isExpanded)
                {
                    hasUnreadMessages = true;
                }
                
                lastMessageCheck = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                
                // Auto scroll to bottom
                await ScrollToBottom();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking for new messages: {ex.Message}");
        }
    }

    private async Task ToggleChat()
    {
        isExpanded = !isExpanded;
        
        if (isExpanded)
        {
            hasUnreadMessages = false;
            await ScrollToBottom();
        }
        
        // Save expanded state to localStorage
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chatWidget_expanded", isExpanded.ToString());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving expanded state: {ex.Message}");
        }
        
        StateHasChanged();
    }

    private async Task EndChatSession()
    {
        try
        {
            // Clear localStorage
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "chatWidget_sessionId");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "chatWidget_expanded");
            
            // Reset state
            currentSession = null;
            messages.Clear();
            chatForm = new ChatForm();
            messageForm = new MessageForm();
            hasUnreadMessages = false;
            
            ToastService.ShowSuccess("Chat session ended");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error ending chat session: {ex.Message}");
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(100); // Small delay to ensure DOM is updated
            await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error scrolling to bottom: {ex.Message}");
        }
    }

    private async Task StartChatSession()
    {
        if (isLoading) return;
        
        isLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(chatForm.VisitorName))
            {
                ToastService.ShowError(Localizer["PleaseEnterYourName"]);
                return;
            }

            if (!chatForm.IsContactInfoValid)
            {
                ToastService.ShowError(Localizer["EmailOrPhoneRequired"]);
                return;
            }

            // Use a simple IP detection or default value
            var ipAddress = "127.0.0.1"; // Default for now
            
            currentSession = await ChatService.CreateChatSessionAsync(
                chatForm.VisitorName, 
                chatForm.VisitorEmail,
                chatForm.PhoneNumber,
                ipAddress);

            if (currentSession != null)
            {
                // Save session ID to localStorage
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chatWidget_sessionId", currentSession.Id.ToString());
                
                await LoadMessages();
                ToastService.ShowSuccess(Localizer["ChatStartedSuccessfully"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (currentSession == null || isLoading || string.IsNullOrWhiteSpace(messageForm.Content))
            return;

        isLoading = true;
        var content = messageForm.Content.Trim();
        messageForm.Content = string.Empty;
        StateHasChanged();

        try
        {
            var message = await ChatService.SendMessageAsync(
                currentSession.Id,
                ChatSenderType.Visitor,
                currentSession.VisitorName,
                content);

            if (message != null)
            {
                messages.Add(message);
                lastMessageCheck = DateTime.Now;
                await ScrollToBottom();
                
                // Simulate typing indicator for admin response
                await SimulateTyping();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Localizer["ErrorSendingMessage"]);
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SimulateTyping()
    {
        isTyping = true;
        StateHasChanged();
        
        typingTimer?.Dispose();
        typingTimer = new Timer(3000); // Hide typing indicator after 3 seconds
        typingTimer.Elapsed += (sender, e) =>
        {
            isTyping = false;
            InvokeAsync(StateHasChanged);
            typingTimer?.Dispose();
        };
        typingTimer.AutoReset = false;
        typingTimer.Enabled = true;
    }

    private async Task LoadMessages()
    {
        if (currentSession == null) return;
        
        try
        {
            messages = (await ChatService.GetMessagesAsync(currentSession.Id)).ToList();
            lastMessageCheck = DateTime.Now;
            await ScrollToBottom();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading messages: {ex.Message}");
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
        typingTimer?.Dispose();
    }
}