@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Application.Interfaces
@inject TranslationLocalizer Localizer
@inject IFooterService FooterService
@rendermode @(new InteractiveServerRenderMode(prerender: false))


@if (settings != null && settings.ShowFooter)
{
    <footer class="@GetFooterClasses() footer-modern" style="@GetFooterStyles()">
        @* Background Video - Enhanced for cross-browser compatibility *@
        @if (settings.BgType == "video" && !string.IsNullOrEmpty(settings.BgValue))
        {
            <div class="absolute inset-0 w-full h-full overflow-hidden z-behind" 
                 style="z-index: -1; pointer-events: none;">
                <video id="footer-bg-video" 
                       autoplay 
                       muted 
                       loop 
                       playsinline 
                       preload="auto"
                       disablepictureinpicture
                       webkit-playsinline="true"
                       class="absolute inset-0 w-full h-full object-cover"
                       style="min-width: 100%; min-height: 100%; 
                              pointer-events: none; 
                              -webkit-transform: translateZ(0); 
                              transform: translateZ(0);"
                       onloadeddata="this.play().catch(e => console.log('Auto-play prevented:', e));"
                       oncanplaythrough="this.play().catch(e => console.log('Play failed:', e));">
                    <source src="@settings.BgValue" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        }
        
        @* Background Image with potential blur overlay *@
        @if (settings.BgType == "image" && !string.IsNullOrEmpty(settings.BgValue))
        {
            <div class="absolute inset-0 z-behind" style="background-image: url('@settings.BgValue'); background-size: cover; background-position: center;"></div>
        }
        
        @* Overlay for blur/mask/gradient effects *@
        @if (settings.BgType != "color" && settings.EnableOverlay)
        {
            <div class="@GetOverlayClasses()" style="@GetOverlayStyles()"></div>
        }
        
        <div class="relative z-10 max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
                
                <!-- Column 1: Company Information (Double Width) -->
                <div class="md:col-span-2">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="Logo" class="h-12 mb-4">
                    }
                    
                    @if (!string.IsNullOrEmpty(settings.CompanyName))
                    {
                        <h3 class="text-2xl font-bold mb-4 footer-text">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.CompanyNameAr) 
                                ? settings.CompanyNameAr 
                                : settings.CompanyName)
                        </h3>
                    }
                    
                    @if (!string.IsNullOrEmpty(settings.Description))
                    {
                        <p class="max-w-md footer-text-muted">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.DescriptionAr) 
                                ? settings.DescriptionAr 
                                : settings.Description)
                        </p>
                    }
                </div>

                <!-- Column 2: Quick Links -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowQuickLinks && quickLinks.Any())
                    {
                        <h4 class="text-lg font-semibold mb-4 footer-text">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.QuickLinksTitleAr) 
                                ? settings.QuickLinksTitleAr 
                                : settings.QuickLinksTitle)
                        </h4>
                        <ul class="space-y-2">
                            @foreach (var link in quickLinks.Where(l => l.IsActive))
                            {
                                <li>
                                    <a href="@link.Url" 
                                       target="@(link.OpenInNewTab ? "_blank" : "_self")"
                                       class="footer-link footer-text hover:transition-colors"
                                       style="text-decoration: none;">
                                        @if (!string.IsNullOrEmpty(link.IconClass))
                                        {
                                            <i class="@link.IconClass mr-2"></i>
                                        }
                                        @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(link.TitleAr) 
                                            ? link.TitleAr 
                                            : link.Title)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 3: Legal Pages -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowLegalPages && legalPages.Any())
                    {
                        <h4 class="text-lg font-semibold mb-4 footer-text">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.LegalPagesTitleAr) 
                                ? settings.LegalPagesTitleAr 
                                : settings.LegalPagesTitle)
                        </h4>
                        <ul class="space-y-2">
                            @foreach (var link in legalPages.Where(l => l.IsActive))
                            {
                                <li>
                                    <a href="@link.Url" 
                                       target="@(link.OpenInNewTab ? "_blank" : "_self")"
                                       class="footer-link footer-text hover:transition-colors"
                                       style="text-decoration: none;">
                                        @if (!string.IsNullOrEmpty(link.IconClass))
                                        {
                                            <i class="@link.IconClass mr-2"></i>
                                        }
                                        @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(link.TitleAr) 
                                            ? link.TitleAr 
                                            : link.Title)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 4: Contact Information -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowContactInfo)
                    {
                        <h4 class="text-lg font-semibold mb-4 footer-text">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.ContactTitleAr) 
                                ? settings.ContactTitleAr 
                                : settings.ContactTitle)
                        </h4>
                        <ul class="space-y-2">
                            @if (!string.IsNullOrEmpty(settings.Address))
                            {
                                <li class="flex items-start footer-text">
                                    <svg class="w-4 h-4 mr-2 mt-1 flex-shrink-0" style="color: @settings.TextColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                                    </svg>
                                    @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.AddressAr) 
                                        ? settings.AddressAr 
                                        : settings.Address)
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Phone1))
                            {
                                <li class="flex items-center footer-text">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.TextColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                    </svg>
                                    @settings.Phone1
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Phone2))
                            {
                                <li class="flex items-center footer-text">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.TextColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                    </svg>
                                    @settings.Phone2
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Email))
                            {
                                <li class="flex items-start footer-text">
                                    <svg class="w-4 h-4 mr-2 mt-1 flex-shrink-0" style="color: @settings.TextColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                                        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                                    </svg>
                                    <span style="word-break: break-all; overflow-wrap: break-word;">@settings.Email</span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.WorkingHours))
                            {
                                <li class="flex items-center footer-text">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.TextColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                    </svg>
                                    @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.WorkingHoursAr) 
                                        ? settings.WorkingHoursAr 
                                        : settings.WorkingHours)
                                </li>
                            }
                        </ul>
                    }
                </div>
                
            </div>

            <!-- Social Media Links -->
            @if (settings.ShowSocialMedia && HasSocialLinks())
            {
                <div class="mt-8 pt-8 border-t border-opacity-10 footer-border">
                    <div class="text-center">
                        <h4 class="text-lg font-semibold mb-4 footer-text">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.SocialMediaTitleAr) 
                                ? settings.SocialMediaTitleAr 
                                : settings.SocialMediaTitle)
                        </h4>
                        <div class="flex justify-center space-x-4 rtl:space-x-reverse">
                            @if (!string.IsNullOrEmpty(settings.FacebookUrl))
                            {
                                <a href="@settings.FacebookUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.InstagramUrl))
                            {
                                <a href="@settings.InstagramUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">

                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 32 32"><path d="M20.445 5h-8.891A6.559 6.559 0 0 0 5 11.554v8.891A6.559 6.559 0 0 0 11.554 27h8.891a6.56 6.56 0 0 0 6.554-6.555v-8.891A6.557 6.557 0 0 0 20.445 5zm4.342 15.445a4.343 4.343 0 0 1-4.342 4.342h-8.891a4.341 4.341 0 0 1-4.341-4.342v-8.891a4.34 4.34 0 0 1 4.341-4.341h8.891a4.342 4.342 0 0 1 4.341 4.341l.001 8.891z"/><path d="M16 10.312c-3.138 0-5.688 2.551-5.688 5.688s2.551 5.688 5.688 5.688 5.688-2.551 5.688-5.688-2.55-5.688-5.688-5.688zm0 9.163a3.475 3.475 0 1 1-.001-6.95 3.475 3.475 0 0 1 .001 6.95zM21.7 8.991a1.363 1.363 0 1 1-1.364 1.364c0-.752.51-1.364 1.364-1.364z"/></svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.TwitterUrl))
                            {
                                <a href="@settings.TwitterUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.LinkedInUrl))
                            {
                                <a href="@settings.LinkedInUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.WhatsAppUrl))
                            {
                                <a href="@settings.WhatsAppUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.YouTubeUrl))
                            {
                                <a href="@settings.YouTubeUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.TikTokUrl))
                            {
                                <a href="@settings.TikTokUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.SnapchatUrl))
                            {
                                <a href="@settings.SnapchatUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 6.618 5.367 11.987 11.988 11.987 6.618 0 11.987-5.369 11.987-11.987C24.014 5.367 18.635.001 12.017.001zM17.633 9.33c-.32 0-.615-.098-.863-.27-.248-.17-.441-.413-.562-.706-.086-.208-.129-.432-.129-.673 0-.241.043-.465.129-.673.121-.293.314-.536.562-.706.248-.172.543-.27.863-.27.321 0 .615.098.863.27.248.17.441.413.562.706.086.208.129.432.129.673 0 .241-.043.465-.129.673-.121.293-.314.536-.562.706-.248.172-.542.27-.863.27zm-11.272 0c-.321 0-.615-.098-.863-.27-.248-.17-.441-.413-.562-.706C4.851 8.146 4.808 7.922 4.808 7.681c0-.241.043-.465.129-.673.121-.293.314-.536.562-.706.248-.172.542-.27.863-.27.32 0 .615.098.863.27.248.17.441.413.562.706.086.208.129.432.129.673 0 .241-.043.465-.129.673-.121.293-.314.536-.562.706-.248.172-.543.27-.863.27z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.PinterestUrl))
                            {
                                <a href="@settings.PinterestUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.136.889 2.741a.36.36 0 0 1 .083.343c-.091.378-.293 1.164-.332 1.327-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.746-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012 12.017.001z"/>
                                    </svg>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.TelegramUrl))
                            {
                                <a href="@settings.TelegramUrl" target="_blank" 
                                   class="social-link inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="color: @settings.TextColor">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
