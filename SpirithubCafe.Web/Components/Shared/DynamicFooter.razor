@using Microsoft.Extensions.Localization
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Application.Interfaces
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer
@inject IFooterService FooterService
@rendermode InteractiveServer

@if (settings != null && settings.ShowFooter)
{
    <footer class="@GetFooterClasses()" style="@GetFooterStyles()">
        @* Background Video *@
        @if (settings.BgType == "video" && !string.IsNullOrEmpty(settings.BgValue))
        {
            <video id="footer-bg-video" 
                   autoplay 
                   muted 
                   loop 
                   playsinline 
                   preload="metadata"
                   class="absolute inset-0 w-full h-full object-cover z-behind"
                   onloadstart="console.log('Video loading started:', '@settings.BgValue')"
                   oncanplay="console.log('Video can play'); this.play();"
                   onerror="console.error('Video error:', this.error); this.style.display='none';">
                <source src="@settings.BgValue" type="video/mp4">
                <source src="@settings.BgValue" type="video/webm">
                <source src="@settings.BgValue" type="video/ogg">
                Your browser does not support the video tag.
            </video>
        }
        
        @* Background Image with potential blur overlay *@
        @if (settings.BgType == "image" && !string.IsNullOrEmpty(settings.BgValue))
        {
            <div class="absolute inset-0 z-behind" style="background-image: url('@settings.BgValue'); background-size: cover; background-position: center;"></div>
        }
        
        @* Overlay for blur/mask/gradient effects *@
        @if (settings.BgType != "color" && settings.EnableOverlay)
        {
            <div class="@GetOverlayClasses()" style="@GetOverlayStyles()"></div>
        }
        
        <div class="relative z-10 max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
                
                <!-- Column 1: Company Information (Double Width) -->
                <div class="md:col-span-2">
                    @if (!string.IsNullOrEmpty(settings.LogoUrl))
                    {
                        <img src="@settings.LogoUrl" alt="Logo" class="h-12 mb-4">
                    }
                    
                    @if (!string.IsNullOrEmpty(settings.CompanyName))
                    {
                        <h3 class="text-2xl font-bold mb-4" style="color: @settings.AccentColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.CompanyNameAr) 
                                ? settings.CompanyNameAr 
                                : settings.CompanyName)
                        </h3>
                    }
                    
                    @if (!string.IsNullOrEmpty(settings.Description))
                    {
                        <p class="max-w-md" style="color: @settings.TextColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.DescriptionAr) 
                                ? settings.DescriptionAr 
                                : settings.Description)
                        </p>
                    }
                </div>

                <!-- Column 2: Quick Links -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowQuickLinks && quickLinks.Any())
                    {
                        <h4 class="text-lg font-semibold mb-4" style="color: @settings.TextColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.QuickLinksTitleAr) 
                                ? settings.QuickLinksTitleAr 
                                : settings.QuickLinksTitle)
                        </h4>
                        <ul class="space-y-2">
                            @foreach (var link in quickLinks.Where(l => l.IsActive))
                            {
                                <li>
                                    <a href="@link.Url" 
                                       target="@(link.OpenInNewTab ? "_blank" : "_self")"
                                       class="hover:transition-colors"
                                       style="color: @settings.TextColor; text-decoration: none;"
                                       onmouseover="this.style.color='@settings.AccentColor'"
                                       onmouseout="this.style.color='@settings.TextColor'">
                                        @if (!string.IsNullOrEmpty(link.IconClass))
                                        {
                                            <i class="@link.IconClass mr-2"></i>
                                        }
                                        @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(link.TitleAr) 
                                            ? link.TitleAr 
                                            : link.Title)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 3: Legal Pages -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowLegalPages && legalPages.Any())
                    {
                        <h4 class="text-lg font-semibold mb-4" style="color: @settings.TextColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.LegalPagesTitleAr) 
                                ? settings.LegalPagesTitleAr 
                                : settings.LegalPagesTitle)
                        </h4>
                        <ul class="space-y-2">
                            @foreach (var link in legalPages.Where(l => l.IsActive))
                            {
                                <li>
                                    <a href="@link.Url" 
                                       target="@(link.OpenInNewTab ? "_blank" : "_self")"
                                       class="hover:transition-colors"
                                       style="color: @settings.TextColor; text-decoration: none;"
                                       onmouseover="this.style.color='@settings.AccentColor'"
                                       onmouseout="this.style.color='@settings.TextColor'">
                                        @if (!string.IsNullOrEmpty(link.IconClass))
                                        {
                                            <i class="@link.IconClass mr-2"></i>
                                        }
                                        @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(link.TitleAr) 
                                            ? link.TitleAr 
                                            : link.Title)
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <!-- Column 4: Contact Information -->
                <div class="mt-8 md:mt-16">
                    @if (settings.ShowContactInfo)
                    {
                        <h4 class="text-lg font-semibold mb-4" style="color: @settings.TextColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.ContactTitleAr) 
                                ? settings.ContactTitleAr 
                                : settings.ContactTitle)
                        </h4>
                        <ul class="space-y-2">
                            @if (!string.IsNullOrEmpty(settings.Address))
                            {
                                <li class="flex items-start" style="color: @settings.TextColor">
                                    <svg class="w-4 h-4 mr-2 mt-1 flex-shrink-0" style="color: @settings.AccentColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                                    </svg>
                                    @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.AddressAr) 
                                        ? settings.AddressAr 
                                        : settings.Address)
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Phone1))
                            {
                                <li class="flex items-center" style="color: @settings.TextColor">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.AccentColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                    </svg>
                                    @settings.Phone1
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Phone2))
                            {
                                <li class="flex items-center" style="color: @settings.TextColor">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.AccentColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                    </svg>
                                    @settings.Phone2
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.Email))
                            {
                                <li class="flex items-center" style="color: @settings.TextColor">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.AccentColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                                        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                                    </svg>
                                    @settings.Email
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(settings.WorkingHours))
                            {
                                <li class="flex items-center" style="color: @settings.TextColor">
                                    <svg class="w-4 h-4 mr-2" style="color: @settings.AccentColor" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                                    </svg>
                                    @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.WorkingHoursAr) 
                                        ? settings.WorkingHoursAr 
                                        : settings.WorkingHours)
                                </li>
                            }
                        </ul>
                    }
                </div>
                
            </div>

            <!-- Social Media Links -->
            @if (settings.ShowSocialMedia && HasSocialLinks())
            {
                <div class="mt-8 pt-8 border-t border-opacity-10" style="border-color: @settings.TextColor">
                    <div class="text-center">
                        <h4 class="text-lg font-semibold mb-4" style="color: @settings.TextColor">
                            @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.SocialMediaTitleAr) 
                                ? settings.SocialMediaTitleAr 
                                : settings.SocialMediaTitle)
                        </h4>
                        <div class="flex justify-center space-x-4 rtl:space-x-reverse">
                            @if (!string.IsNullOrEmpty(settings.FacebookUrl))
                            {
                                <a href="@settings.FacebookUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-facebook"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.InstagramUrl))
                            {
                                <a href="@settings.InstagramUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-instagram"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.TwitterUrl))
                            {
                                <a href="@settings.TwitterUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-twitter"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.LinkedInUrl))
                            {
                                <a href="@settings.LinkedInUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-linkedin"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.WhatsAppUrl))
                            {
                                <a href="@settings.WhatsAppUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-whatsapp"></i>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(settings.YouTubeUrl))
                            {
                                <a href="@settings.YouTubeUrl" target="_blank" 
                                   class="inline-flex items-center justify-center w-10 h-10 rounded-full transition-colors hover:scale-110 transform transition-transform"
                                   style="background-color: @(settings.AccentColor ?? "#f59e0b"); color: white">
                                    <i class="fab fa-youtube"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Copyright -->
            <div class="mt-8 pt-8 border-t border-opacity-10 text-center" style="border-color: @settings.TextColor; color: @settings.TextColor">
                <p>&copy; @(Localizer.GetString("Language") == "ar" && !string.IsNullOrEmpty(settings.CopyrightTextAr) 
                        ? settings.CopyrightTextAr 
                        : settings.CopyrightText)</p>
            </div>
        </div>
    </footer>
}

@code {
    private FooterSettings? settings;
    private List<FooterMenu> quickLinks = new();
    private List<FooterMenu> legalPages = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFooterData();
    }

    private async Task LoadFooterData()
    {
        try
        {
            settings = await FooterService.GetFooterSettingsAsync();
            quickLinks = await FooterService.GetFooterMenusByTypeAsync(FooterMenuType.QuickLinks);
            legalPages = await FooterService.GetFooterMenusByTypeAsync(FooterMenuType.LegalPages);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading footer data: {ex.Message}");
        }
    }

    private string GetFooterClasses()
    {
        var classes = "relative flex-shrink-0 mt-auto";
        
        if (settings?.BgType == "color")
        {
            classes += " text-white";
        }
        
        return classes;
    }

    private string GetFooterStyles()
    {
        if (settings == null) return "";
        
        var styles = new List<string>();
        
        if (settings.BgType == "color")
        {
            styles.Add($"background-color: {settings.BgValue}");
        }
        
        // For image and video backgrounds, we need relative positioning and overflow hidden
        if (settings.BgType == "image" || settings.BgType == "video")
        {
            styles.Add("position: relative");
            styles.Add("overflow: hidden");
        }
        
        return string.Join("; ", styles);
    }

    private string GetOverlayClasses()
    {
        return "absolute inset-0 z-0";
    }

    private string GetOverlayStyles()
    {
        if (settings == null || !settings.EnableOverlay) return "";
        
        var styles = new List<string>();
        
        if (settings.OverlayType == "blur")
        {
            // For blur effect, we use backdrop-filter which blurs what's behind this element
            styles.Add($"backdrop-filter: blur({settings.OverlayValue ?? "5px"})");
            styles.Add("-webkit-backdrop-filter: blur(" + (settings.OverlayValue ?? "5px") + ")"); // Safari support
            
            // If it's an image background and blur is applied, we need a semi-transparent background
            if (settings.BgType == "image")
            {
                styles.Add("background-color: rgba(255, 255, 255, 0.1)");
            }
        }
        else if (settings.OverlayType == "mask")
        {
            var opacity = settings.OverlayValue ?? "0.5";
            styles.Add($"background-color: rgba(0, 0, 0, {opacity})");
        }
        else if (settings.OverlayType == "gradient")
        {
            styles.Add("background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7))");
        }
        
        return string.Join("; ", styles);
    }

    private bool HasSocialLinks()
    {
        return settings != null && (
            !string.IsNullOrEmpty(settings.FacebookUrl) ||
            !string.IsNullOrEmpty(settings.InstagramUrl) ||
            !string.IsNullOrEmpty(settings.TwitterUrl) ||
            !string.IsNullOrEmpty(settings.LinkedInUrl) ||
            !string.IsNullOrEmpty(settings.WhatsAppUrl) ||
            !string.IsNullOrEmpty(settings.YouTubeUrl) ||
            !string.IsNullOrEmpty(settings.TikTokUrl) ||
            !string.IsNullOrEmpty(settings.SnapchatUrl) ||
            !string.IsNullOrEmpty(settings.PinterestUrl) ||
            !string.IsNullOrEmpty(settings.TelegramUrl)
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && settings?.BgType == "video")
        {
            await Task.Delay(100); // Give video element time to load
            await InvokeAsync(StateHasChanged);
        }
    }
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const video = document.getElementById('footer-bg-video');
        if (video) {
            video.addEventListener('loadeddata', function() {
                console.log('Video loaded successfully');
                this.play().catch(e => console.log('Auto-play prevented:', e));
            });
            
            video.addEventListener('error', function(e) {
                console.error('Video failed to load:', e);
                console.error('Video src:', this.currentSrc);
                this.style.display = 'none';
            });

            // Force play after a delay
            setTimeout(() => {
                if (video.paused) {
                    video.play().catch(e => console.log('Manual play prevented:', e));
                }
            }, 1000);
        }
    });
</script>
