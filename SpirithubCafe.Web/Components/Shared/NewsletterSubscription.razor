@using SpirithubCafe.Application.Services
@inject INewsletterService NewsletterService
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<!-- Toast Component -->
<Toast />
<div class="newsletter-subscription">
    <form @onsubmit="HandleSubmitAsync" class="flex flex-col sm:flex-row gap-3">
        <input 
            type="email" 
            @bind="email" 
            placeholder="@Localizer["EnterYourEmail"]"
            disabled="@isSubmitting"
            class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent disabled:bg-gray-100 disabled:cursor-not-allowed bg-white/90"
            required />
        
        <button 
            type="submit" 
            disabled="@isSubmitting"
            class="bg-amber-600 hover:bg-amber-700 disabled:bg-gray-400 text-white px-6 py-3 rounded-lg font-semibold transition-colors flex items-center justify-center disabled:cursor-not-allowed">
            @if (isSubmitting)
            {
                <span class="flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    @Localizer["Subscribe"]
                </span>
            }
            else
            {
                @Localizer["Subscribe"]
            }
        </button>
    </form>
</div>

@code {
    private string email = "";
    private bool isSubmitting = false;

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            ToastService.ShowWarning(Localizer["EmailRequired"]);
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var (success, message) = await NewsletterService.SubscribeAsync(email);

            if (success)
            {
                ToastService.ShowSuccess(Localizer[message]);
                email = ""; // Clear the input
            }
            else
            {
                ToastService.ShowWarning(Localizer[message]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Localizer["AnErrorOccurred"]);
            Console.WriteLine($"Newsletter subscription error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
