@page "/favorites"
@layout PublicLayout
@inject TranslationLocalizer Localizer
@inject IJSRuntime JSRuntime
@inject FavoriteService FavoriteService
@inject ProductService ProductService
@inject NavigationManager Navigation
@inject CartService CartService
@inject ToastService ToastService


<PageTitle>@Localizer["Favorites"] - @Localizer["SiteTitle"]</PageTitle>

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">My Favorites</h1>
            <p class="mt-2 text-gray-600">Your saved products</p>
        </div>

        @if (isLoading)
        {
            <!-- Loading State -->
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-orange-600"></div>
            </div>
        }
        else if (!favoriteProducts.Any())
        {
            <!-- Empty State -->
            <div class="text-center py-20">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                </div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-3">No Favorites Yet</h2>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">Start exploring our products and add your favorites here by clicking the heart icon.</p>
                <button @onclick="@(() => Navigation.NavigateTo("/products"))" 
                        class="inline-flex items-center px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white font-medium rounded-lg transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    Browse Products
                </button>
            </div>
        }
        else
        {
            <!-- Favorites Count -->
            <div class="mb-6 flex items-center justify-between">
                <p class="text-gray-600">
                    <span class="font-semibold text-gray-900">@favoriteProducts.Count</span> 
                    @(favoriteProducts.Count == 1 ? "product" : "products") in your favorites
                </p>
                @if (favoriteProducts.Any())
                {
                    <button @onclick="ClearAllFavorites" 
                            class="text-sm text-red-600 hover:text-red-700 font-medium">
                        Clear All
                    </button>
                }
            </div>

            <!-- Favorites Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var product in favoriteProducts)
                {
                    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                        <!-- Product Image -->
                        <div class="relative aspect-square bg-gray-100 cursor-pointer" @onclick="@(() => Navigation.NavigateTo($"/product/{product.Slug}"))">
                            @if (product.MainImage != null && !string.IsNullOrEmpty(product.MainImage.ImagePath))
                            {
                                <img src="@product.MainImage.ImagePath" 
                                     alt="@GetProductName(product)" 
                                     class="w-full h-full object-cover">
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center bg-gray-200">
                                    <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                            }
                            
                            <!-- Remove from Favorites Button -->
                            <button @onclick="@(() => RemoveFromFavorites(product.Id))" 
                                    @onclick:stopPropagation="true"
                                    class="absolute top-3 right-3 p-2 bg-white rounded-full shadow-md hover:bg-red-50 transition-colors group">
                                <svg class="w-5 h-5 text-red-500 fill-current" viewBox="0 0 24 24">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </svg>
                            </button>

                            @if (product.IsOrganic)
                            {
                                <span class="absolute top-3 left-3 bg-green-600 text-white text-xs px-2 py-1 rounded-full font-medium">
                                    Organic
                                </span>
                            }
                        </div>

                        <!-- Product Info -->
                        <div class="p-4">
                            <h3 class="text-sm font-medium text-gray-900 mb-1 line-clamp-2 cursor-pointer hover:text-orange-600"
                                @onclick="@(() => Navigation.NavigateTo($"/product/{product.Slug}"))">
                                @GetProductName(product)
                            </h3>
                            
                            <!-- Price & Actions -->
                            <div class="flex items-center justify-between mt-4">
                                @if (product.Variants != null && product.Variants.Any(v => v.IsActive))
                                {
                                    var defaultVariant = product.Variants.FirstOrDefault(v => v.IsDefault) ?? product.Variants.First(v => v.IsActive);
                                    <div class="flex flex-col">
                                        @if (defaultVariant.DiscountPrice.HasValue && defaultVariant.DiscountPrice.Value < defaultVariant.Price)
                                        {
                                            <span class="text-sm text-gray-400 line-through">@defaultVariant.Price.ToString("F3") OMR</span>
                                            <span class="text-lg font-bold text-orange-600">@defaultVariant.DiscountPrice.Value.ToString("F3") OMR</span>
                                        }
                                        else
                                        {
                                            <span class="text-lg font-bold text-gray-900">@defaultVariant.Price.ToString("F3") OMR</span>
                                        }
                                    </div>
                                    
                                    <button @onclick="@(() => AddToCart(product, defaultVariant))"
                                            class="flex items-center justify-center px-4 py-2 bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium rounded-lg transition-colors">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                        </svg>
                                        Add
                                    </button>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-500">Out of Stock</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private List<Product> favoriteProducts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch { }
        }
    }

    private async Task LoadFavorites()
    {
        try
        {
            isLoading = true;
            var favoriteIds = await FavoriteService.GetFavoriteIdsAsync();
            
            if (favoriteIds.Any())
            {
                // Load products from database one by one
                foreach (var id in favoriteIds)
                {
                    var product = await ProductService.GetProductByIdAsync(id);
                    if (product != null && product.IsActive)
                    {
                        favoriteProducts.Add(product);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading favorites: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RemoveFromFavorites(int productId)
    {
        try
        {
            await FavoriteService.RemoveFavoriteAsync(productId);
            favoriteProducts.RemoveAll(p => p.Id == productId);
            ToastService.ShowSuccess("Removed from favorites");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error removing from favorites: {ex.Message}");
        }
    }

    private async Task ClearAllFavorites()
    {
        try
        {
            await FavoriteService.ClearFavoritesAsync();
            favoriteProducts.Clear();
            ToastService.ShowSuccess("All favorites cleared");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error clearing favorites: {ex.Message}");
        }
    }

    private async Task AddToCart(Product product, ProductVariant variant)
    {
        try
        {
            var productName = GetProductName(product);
            var price = variant.DiscountPrice ?? variant.Price;
            var imageUrl = product.MainImage?.ImagePath ?? "";
            var variantInfo = $"{variant.Weight} {variant.WeightUnit}";
            
            await CartService.AddToCartAsync(
                product.Id, 
                productName, 
                price, 
                imageUrl, 
                1, 
                variant.Id, 
                variantInfo,
                variant.Weight,
                variant.WeightUnit
            );
            
            ToastService.ShowSuccess($"{productName} added to cart");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error adding to cart: {ex.Message}");
        }
    }

    private string GetProductName(Product product)
    {
        var language = Localizer.GetString("Language").Value;
        if (language == "ar" && !string.IsNullOrEmpty(product.NameAr))
        {
            return product.NameAr;
        }
        return product.Name;
    }

    private string GetProductDescription(Product product)
    {
        var language = Localizer.GetString("Language").Value;
        if (language == "ar" && !string.IsNullOrEmpty(product.DescriptionAr))
        {
            return product.DescriptionAr;
        }
        return product.Description ?? "";
    }
}
