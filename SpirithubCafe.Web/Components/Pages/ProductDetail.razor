@page "/product/{id:int}"
@page "/product/{slug}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SpirithubCafe.Application.DTOs
@using SpirithubCafe.Application.Interfaces
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Components.Shared
@using System.ComponentModel.DataAnnotations
@layout SpirithubCafe.Web.Components.Layout.MainLayout

@inject ProductService ProductService
@inject IReviewService ReviewService
@inject CartService CartService
@inject ToastService ToastService
@inject FavoriteService FavoriteService
@inject TranslationLocalizer Loc
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>@(product?.Name ?? Loc["Product"]) - @Loc["SiteTitle"]</PageTitle>

<HeadContent>
    @if (product != null)
    {
        var description = GetCurrentCulture().StartsWith("ar") && !string.IsNullOrEmpty(product.DescriptionAr) 
            ? product.DescriptionAr 
            : product.Description;
        var truncatedDescription = description?.Length > 160 
            ? description.Substring(0, 157) + "..." 
            : description ?? Loc["Product.DefaultMetaDescription"];
        
        <meta name="description" content="@truncatedDescription" />
        <meta property="og:title" content="@product.Name - @Loc["SiteTitle"]" />
        <meta property="og:description" content="@truncatedDescription" />
        <meta property="og:type" content="product" />
        @if (product.MainImage?.ImagePath != null)
        {
            <meta property="og:image" content="@product.MainImage.ImagePath" />
        }
    }
    else
    {
        <meta name="description" content="@Loc["Product.DefaultMetaDescription"]" />
    }
</HeadContent>

@if (isLoading)
{
    <div class="flex justify-center items-center min-h-screen">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-amber-600"></div>
    </div>
}
else if (product == null)
{
    <div class="container mx-auto px-4 py-8">
        <div class="text-center">
            <div class="mb-8">
                <svg class="mx-auto h-24 w-24 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2 2v-5m16 0H4m16 0l-2-2m-16 2l2-2"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-4">@Loc["ProductNotFound"]</h1>
            <p class="text-gray-600 mb-6">@Loc["ProductNotFoundDescription"]</p>
            <a href="/products" 
               class="inline-flex items-center px-4 py-2 border border-transparent text-base font-medium rounded-md text-white bg-amber-600 hover:bg-amber-700 transition-colors">
                @Loc["BackToProducts"]
            </a>
        </div>
    </div>
}
else
{
    <!-- Product Header Section -->
    <div class="bg-[#715A5A] text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center">
                <div class="flex-1">
                    <div class="flex items-center space-x-2 text-amber-100 text-sm">
                        <a href="/" class="hover:text-white transition-colors">@Loc["Home"]</a>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <a href="/products" class="hover:text-white transition-colors">@Loc["Products"]</a>
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span>@GetLocalizedProductName()</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 py-4 sm:py-6 lg:py-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-10 xl:gap-12 mb-8 sm:mb-10 lg:mb-12">
            <!-- Product Images -->
            <div class="space-y-3 sm:space-y-4">
                <!-- Main Image - Enhanced Responsive Square -->
                <div class="relative bg-white rounded-xl sm:rounded-2xl shadow-lg sm:shadow-xl overflow-hidden group">
                    <div class="aspect-square">
                        <img src="@currentImagePath" 
                             alt="@GetLocalizedText(product.ImageAlt, product.ImageAltAr)"
                             class="w-full h-full object-cover cursor-zoom-in transition-transform duration-700 group-hover:scale-110"
                             @onclick="OpenImageModal" />
                    </div>
                    
                    <!-- Product Badges - Responsive Positioning -->
                    <div class="absolute top-2 sm:top-3 lg:top-4 left-2 sm:left-3 lg:left-4 right-2 sm:right-3 lg:right-4 flex justify-between items-start gap-2">
                        <div class="flex flex-col space-y-1.5 sm:space-y-2">
                            @if (product.IsOrganic)
                            {
                                <div class="bg-green-500/95 backdrop-blur-sm text-white px-2 sm:px-2.5 lg:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium flex items-center shadow-lg hover:scale-105 transition-transform">
                                    <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1 sm:mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                    @Loc["Organic"]
                                </div>
                            }
                            @if (product.IsFairTrade)
                            {
                                <div class="bg-blue-500/95 backdrop-blur-sm text-white px-2 sm:px-2.5 lg:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium shadow-lg hover:scale-105 transition-transform">
                                    @Loc["FairTrade"]
                                </div>
                            }
                        </div>
                        
                        <div class="flex flex-col space-y-1.5 sm:space-y-2">
                            <!-- Favorite Button - Responsive Size -->
                            <button @onclick="ToggleFavorite" 
                                    class="bg-white/95 backdrop-blur-sm hover:bg-white p-1.5 sm:p-2 lg:p-2.5 rounded-full shadow-lg hover:shadow-xl transition-all duration-200 group/fav hover:scale-110">
                                @if (isFavorite)
                                {
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-500 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-600 group-hover/fav:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                    </svg>
                                }
                            </button>
                            
                            @if (product.IsFeatured)
                            {
                                <div class="bg-amber-500/95 backdrop-blur-sm text-white px-2 sm:px-2.5 lg:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium shadow-lg hover:scale-105 transition-transform">
                                    ⭐ @Loc["Featured"]
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Zoom Icon - Responsive Position & Size -->
                    <div class="absolute bottom-2 sm:bottom-3 lg:bottom-4 right-2 sm:right-3 lg:right-4">
                        <button @onclick="OpenImageModal" 
                                class="bg-white/95 backdrop-blur-sm hover:bg-white text-gray-700 p-1.5 sm:p-2 rounded-full shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-110">
                            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Thumbnail Gallery - Enhanced Responsive Grid -->
                @if (product.GalleryImages?.Any() == true)
                {
                    <div class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-4 xl:grid-cols-5 gap-2 sm:gap-3">
                        @foreach (var image in product.GalleryImages.Take(8))
                        {
                            <div class="aspect-square bg-gray-100 rounded-lg sm:rounded-xl overflow-hidden cursor-pointer transform hover:scale-110 transition-all duration-300 @(currentImagePath == image.ImagePath ? "ring-2 sm:ring-3 ring-amber-500 ring-offset-1 sm:ring-offset-2 shadow-lg" : "hover:shadow-md")"
                                 @onclick="() => SelectImage(image.ImagePath)">
                                <img src="@image.ImagePath" 
                                     alt="@image.AltText"
                                     class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Product Info - Enhanced Responsive Card -->
            <div class="bg-white rounded-lg shadow-md p-3 h-fit sticky top-4">
                <!-- Product Title -->
                <div class="mb-3">
                    <h1 class="text-base font-bold text-gray-900">@GetLocalizedProductName()</h1>
                </div>

                <!-- Rating & Reviews -->
                @if (reviewsResponse != null)
                {
                    <div class="flex items-center gap-2 mb-3 p-2 bg-[#f5f5f5] rounded-lg">
                        <div class="flex">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <svg class="w-3.5 h-3.5 @(i <= reviewsResponse.AverageRating ? "text-[#715A5A]" : "text-gray-300")" 
                                     fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            }
                        </div>
                        <div class="text-xs text-gray-600">
                            <span class="font-bold text-gray-900">@reviewsResponse.AverageRating.ToString("F1")</span>
                            <span class="mx-1">·</span>
                            <span>@reviewsResponse.TotalCount @Loc["reviews"]</span>
                        </div>
                    </div>
                }
                
                <!-- Coffee Information Card -->
                <div class="mb-3 bg-[#f5f5f5] rounded-lg p-2.5 border border-[#D3DAD9]">
                    <div class="flex items-center gap-1.5 mb-2">
                        <svg class="w-3.5 h-3.5 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2.93 17.07A10 10 0 1 1 17.07 2.93 10 10 0 0 1 2.93 17.07zm12.73-1.41A8 8 0 1 0 4.34 4.34a8 8 0 0 0 11.32 11.32zM9 11V9h2v6H9v-4zm0-6h2v2H9V5z"/>
                        </svg>
                        <h3 class="text-sm font-bold text-gray-900">@Loc["CoffeeInformation"]</h3>
                    </div>
                    <div class="space-y-1">
                        @if (!string.IsNullOrEmpty(product.RoastLevel))
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["RoastLevel"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold">@GetLocalizedText(product.RoastLevel, product.RoastLevelAr)</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(product.Process))
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["Process"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold">@GetLocalizedText(product.Process, product.ProcessAr)</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(product.Variety))
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["Variety"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold">@GetLocalizedText(product.Variety, product.VarietyAr)</span>
                            </div>
                        }
                        
                        @if (product.Altitude.HasValue)
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["Altitude"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold">@product.Altitude.Value @Loc["masl"]</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(product.TastingNotes))
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["TastingNotes"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold text-right">@GetLocalizedText(product.TastingNotes, product.TastingNotesAr)</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(product.Farm))
                        {
                            <div class="flex items-center justify-between py-1 border-b border-[#D3DAD9]/50 last:border-0">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["Farm"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold text-right">@GetLocalizedText(product.Farm, product.FarmAr)</span>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(product.Uses))
                        {
                            <div class="flex items-center justify-between py-1">
                                <div class="flex items-center gap-1.5">
                                    <svg class="w-3 h-3 text-[#715A5A]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
                                    </svg>
                                    <span class="text-xs text-gray-600">@Loc["Uses"]</span>
                                </div>
                                <span class="text-xs text-gray-900 font-semibold text-right">@GetLocalizedText(product.Uses, product.UsesAr)</span>
                            </div>
                        }
                    </div>
                </div>
                


                <!-- Price Section -->
                <div class="mb-4 p-3 bg-[#f5f5f5] rounded-lg border border-[#D3DAD9]">
                    @if (selectedVariant != null)
                    {
                        <div class="flex items-center justify-between">
                            <div>
                                @if (selectedVariant.DiscountPrice.HasValue && selectedVariant.DiscountPrice > 0)
                                {
                                    var discountPercent = Math.Round((selectedVariant.Price - selectedVariant.DiscountPrice.Value) / selectedVariant.Price * 100);
                                    <div class="flex items-baseline gap-2 mb-1">
                                        <span class="text-xl font-bold text-red-600">@selectedVariant.DiscountPrice.Value.ToString("F3") OMR</span>
                                        <span class="text-sm text-gray-400 line-through">@selectedVariant.Price.ToString("F3")</span>
                                        <span class="inline-block px-2 py-0.5 rounded text-xs font-bold bg-red-600 text-white">
                                            @discountPercent% OFF
                                        </span>
                                    </div>
                                    <span class="inline-block px-1.5 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                        Save @((selectedVariant.Price - selectedVariant.DiscountPrice.Value).ToString("F3")) OMR
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xl font-bold text-gray-900">@selectedVariant.Price.ToString("F3") OMR</span>
                                }
                            </div>
                            <div class="text-right">
                                <div class="text-xs text-gray-600">@Loc["Size"]</div>
                                <div class="text-sm font-bold text-[#715A5A]">@FormatWeight(selectedVariant.Weight, selectedVariant.WeightUnit)</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var defaultVariant = product.Variants?.FirstOrDefault(v => v.IsDefault) ?? product.Variants?.FirstOrDefault();
                        if (defaultVariant != null)
                        {
                            <span class="text-xl font-bold text-gray-900">@defaultVariant.Price.ToString("F3") OMR</span>
                        }
                    }
                </div>

                <!-- Size Selection -->
                @if (product.Variants?.Any() == true)
                {
                    <div class="mb-4">
                        <h3 class="text-sm font-bold text-gray-900 mb-2">@Loc["ChooseSize"]</h3>
                        <div class="space-y-1.5">
                            @foreach (var variant in product.Variants.Where(v => v.IsActive).OrderBy(v => v.DisplayOrder).ThenBy(v => v.Weight))
                            {
                                <button type="button"
                                        @onclick="() => SelectVariant(variant)"
                                        disabled="@(variant.StockQuantity <= 0)"
                                        class="w-full p-2 sm:p-2.5 border-2 rounded-lg text-left transition-all
                                               @(selectedVariant?.Id == variant.Id ? "border-[#715A5A] bg-[#f5f5f5] ring-1 ring-[#D3DAD9]" : 
                                                 variant.StockQuantity <= 0 ? "border-gray-200 bg-gray-50 cursor-not-allowed opacity-60" :
                                                 "border-gray-200 bg-white hover:bg-[#f5f5f5] hover:border-[#715A5A]")">
                                    <div class="flex items-center justify-between gap-2 sm:gap-3 w-full">
                                        <div class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0">
                                            <div class="flex-shrink-0">
                                                @if (selectedVariant?.Id == variant.Id)
                                                {
                                                    <div class="w-4 h-4 bg-[#715A5A] rounded-full flex items-center justify-center">
                                                        <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                                        </svg>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-4 h-4 border-2 border-gray-300 rounded-full"></div>
                                                }
                                            </div>
                                            <div class="min-w-0 flex-shrink">
                                                <div class="text-xs sm:text-sm font-bold text-gray-900 whitespace-nowrap">
                                                    @FormatWeight(variant.Weight, variant.WeightUnit)
                                                </div>
                                                @if (variant.StockQuantity <= 0)
                                                {
                                                    <span class="text-[9px] sm:text-[10px] text-red-600 font-medium whitespace-nowrap">@Loc["OutofStock"]</span>
                                                }
                                                else if (variant.StockQuantity <= variant.LowStockThreshold)
                                                {
                                                    <span class="text-[9px] sm:text-[10px] text-orange-600 font-medium whitespace-nowrap">@Loc["Only"] @variant.StockQuantity @Loc["LeftInStock"]</span>
                                                }
                                                else
                                                {
                                                    <span class="text-[9px] sm:text-[10px] text-green-600 font-medium whitespace-nowrap">@Loc["InStock"]</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="ltr:text-right rtl:text-left flex-shrink-0 ltr:ml-auto rtl:mr-auto">
                                            @if (variant.DiscountPrice.HasValue && variant.DiscountPrice > 0)
                                            {
                                                <div class="text-xs sm:text-sm font-bold text-red-600 whitespace-nowrap">
                                                    @variant.DiscountPrice.Value.ToString("F3")
                                                </div>
                                                <div class="text-[9px] sm:text-[10px] text-gray-400 line-through whitespace-nowrap">
                                                    @variant.Price.ToString("F3")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-xs sm:text-sm font-bold text-gray-900 whitespace-nowrap">
                                                    @variant.Price.ToString("F3")
                                                </div>
                                            }
                                            <div class="text-[10px] text-gray-500 mt-0.5">OMR</div>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Add to Cart Button -->
                <div class="sticky bottom-0 bg-white pt-3 border-t border-gray-200">
                    @{
                        var isOutOfStock = selectedVariant?.StockQuantity <= 0;
                        var isButtonDisabled = isAddingToCart || isOutOfStock;
                    }
                    <button type="button" 
                            @onclick="AddToCart"
                            disabled="@isButtonDisabled"
                            class="w-full px-6 py-3 rounded-lg font-bold text-base transition-all flex items-center justify-center shadow
                                   @(isOutOfStock ? "bg-gray-400 text-white cursor-not-allowed" : 
                                     "bg-[#715A5A] text-white hover:bg-[#5d4a4a] hover:shadow-lg") 
                                   @(isButtonDisabled ? "opacity-50 cursor-not-allowed" : "")">
                        @if (isAddingToCart)
                        {
                            <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
                            <span>@Loc["Adding"]...</span>
                        }
                        else if (isOutOfStock)
                        {
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>@Loc["OutOfStock"]</span>
                        }
                        else
                        {
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v5m0-5h4m-4 0V8m0 5H9"/>
                            </svg>
                            <span>@Loc["AddToCart"]</span>
                        }
                    </button>
                </div>

                <!-- Stock Information -->
                @if (selectedVariant != null && selectedVariant.StockQuantity > 0 && selectedVariant.StockQuantity <= 10)
                {
                    <div class="mt-1.5 text-xs text-center">
                        @if (selectedVariant.StockQuantity <= selectedVariant.LowStockThreshold)
                        {
                            <span class="text-orange-600">@Loc["Only"] @selectedVariant.StockQuantity @Loc["LeftInStock"]</span>
                        }
                        else
                        {
                            <span class="text-green-600">@selectedVariant.StockQuantity @Loc["InStock"]</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Tabs Section -->
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8">
                <button type="button" 
                        @onclick="() => activeTab = TabType.Details"
                        class="py-2 px-1 border-b-2 font-medium text-sm @(activeTab == TabType.Details ? "border-[#715A5A] text-amber-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    @Loc["Description"]
                </button>
                <button type="button" 
                        @onclick="() => activeTab = TabType.Reviews"
                        class="py-2 px-1 border-b-2 font-medium text-sm @(activeTab == TabType.Reviews ? "border-[#715A5A] text-amber-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
                    @Loc["Reviews"] (@(reviewsResponse?.TotalCount ?? 0))
                </button>
            </nav>
        </div>

        <!-- Tab Content -->
        <div class="py-8">
            @if (activeTab == TabType.Details)
            {
                <div class="max-w-4xl mx-auto">
                    <!-- Product Description with HTML/Markdown Support -->
                    @if (!string.IsNullOrEmpty(GetLocalizedText(product.Description, product.DescriptionAr)))
                    {
                        <div class="prose prose-lg max-w-none bg-white rounded-2xl p-8 lg:p-10 border border-gray-100 shadow-sm">
                            <div class="product-description text-gray-700 leading-relaxed">
                                @((MarkupString)GetLocalizedText(product.Description, product.DescriptionAr)!)
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-12 bg-gray-50 rounded-2xl">
                            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <p class="text-gray-500 text-lg">@Loc["NoDescriptionAvailable"]</p>
                        </div>
                    }

                    <!-- Additional Notes - if exists -->
                    @if (!string.IsNullOrEmpty(GetLocalizedText(product.Notes, product.NotesAr)))
                    {
                        <div class="mt-6 bg-[#f5f5f5] rounded-2xl p-6 lg:p-8 border border-[#D3DAD9]">
                            <h4 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                                <svg class="w-6 h-6 mr-2 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                </svg>
                                @Loc["AdditionalNotes"]
                            </h4>
                            <div class="product-notes text-gray-700">
                                @((MarkupString)GetLocalizedText(product.Notes, product.NotesAr)!)
                            </div>
                        </div>
                    }

                    <!-- Aromatic Profile - if exists -->
                    @if (!string.IsNullOrEmpty(GetLocalizedText(product.AromaticProfile, product.AromaticProfileAr)))
                    {
                        <div class="mt-6 bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-6 lg:p-8 border border-purple-100">
                            <h4 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                                <svg class="w-6 h-6 mr-2 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/>
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
                                </svg>
                                Aromatic Profile
                            </h4>
                            <div class="product-aromatic text-gray-700">
                                @((MarkupString)GetLocalizedText(product.AromaticProfile, product.AromaticProfileAr)!)
                            </div>
                        </div>
                    }

                    <!-- Brewing Instructions - if exists -->
                    @if (!string.IsNullOrEmpty(GetLocalizedText(product.BrewingInstructions, product.BrewingInstructionsAr)))
                    {
                        <div class="mt-6 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-2xl p-6 lg:p-8 border border-blue-100">
                            <h4 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                                <svg class="w-6 h-6 mr-2 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                </svg>
                                Brewing Instructions
                            </h4>
                            <div class="product-brewing text-gray-700">
                                @((MarkupString)GetLocalizedText(product.BrewingInstructions, product.BrewingInstructionsAr)!)
                            </div>
                        </div>
                    }
                </div>
            }
            else if (activeTab == TabType.Reviews)
            {
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xl font-semibold">@Loc["CustomerReviews"]</h3>
                        <button type="button" 
                                @onclick="OpenReviewModal"
                                class="px-4 py-2 bg-amber-600 text-white rounded-md hover:bg-amber-700 transition-colors">
                            @Loc["WriteReview"]
                        </button>
                    </div>

                    @if (reviewsResponse != null)
                    {
                        <!-- Rating Summary -->
                        <div class="bg-gray-50 rounded-lg p-6 mb-8">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="text-3xl font-bold text-gray-900">@reviewsResponse.AverageRating.ToString("F1")</div>
                                    <div class="flex items-center mt-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <svg class="w-5 h-5 @(i <= reviewsResponse.AverageRating ? "text-yellow-400" : "text-gray-300")" 
                                                 fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        }
                                    </div>
                                    <div class="text-sm text-gray-600 mt-1">@reviewsResponse.TotalCount @Loc["ReviewsTotal"]</div>
                                </div>

                                <!-- Rating Breakdown -->
                                <div class="space-y-2">
                                    @for (int rating = 5; rating >= 1; rating--)
                                    {
                                        var count = reviewsResponse.RatingBreakdown.GetValueOrDefault(rating, 0);
                                        var percentage = reviewsResponse.TotalCount > 0 ? (count * 100.0 / reviewsResponse.TotalCount) : 0;
                                        
                                        <div class="flex items-center text-sm">
                                            <span class="w-3">@rating</span>
                                            <svg class="w-4 h-4 text-yellow-400 mx-1" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                            <div class="w-32 bg-gray-200 rounded-full h-2 mx-2">
                                                <div class="bg-yellow-400 h-2 rounded-full" style="width: @(percentage)%"></div>
                                            </div>
                                            <span class="w-10 text-right">@count</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Reviews List -->
                        @if (reviewsResponse.Reviews.Any())
                        {
                            <div class="space-y-6">
                                @foreach (var review in reviewsResponse.Reviews)
                                {
                                    <div class="border-b border-gray-200 pb-6 last:border-b-0">
                                        <div class="flex items-start justify-between mb-2">
                                            <div>
                                                <h4 class="font-medium text-gray-900">@review.CustomerName</h4>
                                                <div class="flex items-center mt-1">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <svg class="w-4 h-4 @(i <= review.Rating ? "text-yellow-400" : "text-gray-300")" 
                                                             fill="currentColor" viewBox="0 0 20 20">
                                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                                        </svg>
                                                    }
                                                </div>
                                            </div>
                                            <span class="text-sm text-gray-500">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(review.Title))
                                        {
                                            <h5 class="font-medium text-gray-900 mb-2">@review.Title</h5>
                                        }
                                        
                                        <p class="text-gray-700">@review.Content</p>
                                    </div>
                                }
                            </div>

                            @if (reviewsResponse.CurrentPage < reviewsResponse.TotalPages)
                            {
                                <div class="text-center mt-8">
                                    <button type="button" 
                                            @onclick="LoadMoreReviews"
                                            class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 transition-colors">
                                        @Loc["LoadMoreReviews"]
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                </svg>
                                <h3 class="mt-2 text-sm font-medium text-gray-900">@Loc["NoReviews"]</h3>
                                <p class="mt-1 text-sm text-gray-500">@Loc["BeFirstReview"]</p>
                                <div class="mt-6">
                                    <button type="button" 
                                            @onclick="OpenReviewModal"
                                            class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-amber-600 hover:bg-amber-700">
                                        @Loc["WriteFirstReview"]
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

<!-- Image Modal - Enhanced with High z-index -->
@if (showImageModal)
{
    <div class="fixed inset-0 z-[99999999] flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-black/80 backdrop-blur-sm" @onclick="CloseImageModal">
        <div class="relative w-full max-w-6xl" style="height: 80vh;" @onclick:stopPropagation>
            <img src="@currentImagePath" 
                 alt="@GetLocalizedText(product?.ImageAlt, product?.ImageAltAr)"
                 class="w-full h-full object-contain rounded-lg shadow-2xl" />
            <button type="button" 
                    @onclick="CloseImageModal"
                    class="absolute top-2 right-2 sm:top-4 sm:right-4 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white p-2 rounded-full transition-all duration-200 hover:scale-110">
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    </div>
}

<!-- Review Modal -->
@if (showReviewModal)
{
    <div @onclick="CloseReviewModal" class="fixed inset-0 z-[9999] flex items-center justify-center p-4 sm:p-6 bg-black/60">
        <div @onclick:stopPropagation class="relative bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto">
            <!-- Header -->
            <div class="sticky top-0 bg-white px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-semibold text-gray-900">@Loc["WriteReview"]</h3>
                    <button type="button" @onclick="CloseReviewModal" 
                            class="text-gray-400 hover:text-gray-600 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Content -->
            <div class="p-6">
                @if (!string.IsNullOrEmpty(reviewSubmissionError))
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-800">
                        @reviewSubmissionError
                    </div>
                }

                <EditForm Model="reviewSubmission" OnValidSubmit="SubmitReview">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-5">
                        <!-- Rating -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                @Loc["Rating"] *
                            </label>
                            <div class="flex gap-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    int rating = i;
                                    <button type="button" 
                                            @onclick="() => reviewSubmission.Rating = rating"
                                            class="text-3xl transition-transform hover:scale-110 focus:outline-none @(i <= reviewSubmission.Rating ? "text-amber-400" : "text-gray-300")">
                                        ★
                                    </button>
                                }
                            </div>
                            <ValidationMessage For="() => reviewSubmission.Rating" class="text-red-600 text-xs mt-1" />
                        </div>

                        <!-- Name & Email Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Name -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    @Loc["Name"] *
                                </label>
                                <InputText @bind-Value="reviewSubmission.CustomerName" 
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A]" 
                                           placeholder="@Loc["Name"]" />
                                <ValidationMessage For="() => reviewSubmission.CustomerName" class="text-red-600 text-xs mt-1" />
                            </div>

                            <!-- Email -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    @Loc["Email"] *
                                </label>
                                <InputText @bind-Value="reviewSubmission.CustomerEmail" 
                                           type="email"
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A]" 
                                           placeholder="email@example.com" />
                                <ValidationMessage For="() => reviewSubmission.CustomerEmail" class="text-red-600 text-xs mt-1" />
                            </div>
                        </div>

                        <!-- Title -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                @Loc["ReviewTitle"] *
                            </label>
                            <InputText @bind-Value="reviewSubmission.Title" 
                                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A]" 
                                       placeholder="@Loc["ReviewTitlePlaceholder"]" />
                            <ValidationMessage For="() => reviewSubmission.Title" class="text-red-600 text-xs mt-1" />
                        </div>

                        <!-- Content -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                @Loc["YourReview"] *
                            </label>
                            <InputTextArea @bind-Value="reviewSubmission.Content" 
                                           rows="4" 
                                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] resize-none" 
                                           placeholder="@Loc["ReviewContentPlaceholder"]" />
                            <ValidationMessage For="() => reviewSubmission.Content" class="text-red-600 text-xs mt-1" />
                        </div>

                        <!-- Buttons -->
                        <div class="flex flex-col-reverse sm:flex-row gap-2 pt-2">
                            <button type="button" 
                                    @onclick="CloseReviewModal" 
                                    class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                                @Loc["Cancel"]
                            </button>
                            <button type="submit" 
                                    disabled="@isSubmittingReview"
                                    class="flex-1 sm:flex-none px-6 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-md text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed transition-colors flex items-center justify-center gap-2">
                                @if (isSubmittingReview)
                                {
                                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <span>@Loc["Submitting"]...</span>
                                }
                                else
                                {
                                    <span>@Loc["SubmitReview"]</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}



@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    private Product? product;
    private ProductVariant? selectedVariant;
    private string currentImagePath = string.Empty;
    private bool isLoading = true;
    private bool showImageModal = false;
    private bool showReviewModal = false;
    private bool isSubmittingReview = false;
    private bool isAddingToCart = false;
    private string? reviewSubmissionError;
    private ReviewsResponse? reviewsResponse;
    private int currentReviewPage = 1;
    private bool isFavorite = false;
    
    private TabType activeTab = TabType.Details;
    private SubmitReviewRequest reviewSubmission = new();

    private enum TabType
    {
        Details,
        Reviews
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProduct();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isLoading) return;
        await LoadProduct();
    }

    private async Task LoadProduct()
    {
        try
        {
            isLoading = true;
            product = null;
            reviewsResponse = null;
            StateHasChanged();

            // Load product by ID or slug
            if (Id.HasValue)
            {
                product = await ProductService.GetProductByIdAsync(Id.Value);
            }
            else if (!string.IsNullOrEmpty(Slug))
            {
                product = await ProductService.GetProductBySlugAsync(Slug);
            }

            if (product != null)
            {
                // Set initial image and variant
                currentImagePath = product.MainImage?.ImagePath ?? product.GalleryImages?.FirstOrDefault()?.ImagePath ?? "/images/no-image.jpg";
                selectedVariant = product.Variants?.FirstOrDefault(v => v.IsDefault) ?? product.Variants?.FirstOrDefault();
                
                // Check if product is in favorites
                isFavorite = await FavoriteService.IsFavoriteAsync(product.Id);
                
                // Load reviews
                await LoadReviews();
            }
        }
        catch (Exception ex)
        {
            // Log error
            Console.WriteLine($"Error loading product: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReviews()
    {
        if (product == null) return;

        try
        {
            reviewsResponse = await ReviewService.GetProductReviewsAsync(product.Id, 1, 10);
            currentReviewPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reviews: {ex.Message}");
        }
    }

    private async Task LoadMoreReviews()
    {
        if (product == null || reviewsResponse == null) return;

        try
        {
            var nextPage = currentReviewPage + 1;
            var response = await ReviewService.GetProductReviewsAsync(product.Id, nextPage, 10);
            if (response != null && response.Reviews.Any())
            {
                reviewsResponse.Reviews.AddRange(response.Reviews);
                reviewsResponse.CurrentPage = response.CurrentPage;
                currentReviewPage = nextPage;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more reviews: {ex.Message}");
        }
    }

    private void SelectImage(string imagePath)
    {
        currentImagePath = imagePath;
        StateHasChanged();
    }

    private void SelectVariant(ProductVariant variant)
    {
        selectedVariant = variant;
        StateHasChanged();
    }

    private void OpenImageModal()
    {
        if (!string.IsNullOrEmpty(currentImagePath))
        {
            showImageModal = true;
            StateHasChanged();
        }
    }

    private void CloseImageModal()
    {
        showImageModal = false;
        StateHasChanged();
    }

    private void OpenReviewModal()
    {
        reviewSubmission = new SubmitReviewRequest();
        reviewSubmissionError = null;
        showReviewModal = true;
        StateHasChanged();
    }

    private void CloseReviewModal()
    {
        showReviewModal = false;
        reviewSubmissionError = null;
        StateHasChanged();
    }

    private async Task SubmitReview()
    {
        if (product == null) return;

        try
        {
            isSubmittingReview = true;
            reviewSubmissionError = null;
            StateHasChanged();

            var success = await ReviewService.SubmitReviewAsync(product.Id, reviewSubmission);
            
            if (success)
            {
                CloseReviewModal();
                ToastService.ShowSuccess(Loc["ReviewSubmittedSuccess"]);
                await LoadReviews(); // Reload reviews to show the new one (if approved)
            }
            else
            {
                reviewSubmissionError = Loc["ReviewSubmissionError"];
            }
        }
        catch (Exception ex)
        {
            reviewSubmissionError = Loc["ReviewSubmissionError"];
            Console.WriteLine($"Error submitting review: {ex.Message}");
        }
        finally
        {
            isSubmittingReview = false;
            StateHasChanged();
        }
    }

    private string GetLocalizedProductName()
    {
        if (product == null) return string.Empty;
        return GetLocalizedText(product.Name, product.NameAr) ?? string.Empty;
    }

    private string? GetLocalizedText(string? englishText, string? arabicText)
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        
        if (currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(arabicText))
        {
            return arabicText;
        }
        
        return englishText;
    }

    private async Task AddToCart()
    {
        if (product == null || selectedVariant == null) return;

        // Check if variant is out of stock
        if (selectedVariant.StockQuantity <= 0)
        {
            ToastService.ShowError(Loc["OutOfStockMessage"]);
            return;
        }

        try
        {
            isAddingToCart = true;
            StateHasChanged();

            // Include variant size information in product name
            var productNameWithSize = $"{GetLocalizedProductName()} ({FormatWeight(selectedVariant.Weight, selectedVariant.WeightUnit)})";
            var effectivePrice = selectedVariant.DiscountPrice ?? selectedVariant.Price;
            var variantInfo = FormatWeight(selectedVariant.Weight, selectedVariant.WeightUnit);

            await CartService.AddToCartAsync(
                product.Id,
                productNameWithSize,
                effectivePrice,
                currentImagePath,
                1,
                selectedVariant.Id,
                variantInfo,
                selectedVariant.Weight,
                selectedVariant.WeightUnit
            );
            
            // Show success message with variant info
            var successMessage = string.Format(Loc["AddedToCartWithSizeSuccess"], 
                FormatWeight(selectedVariant.Weight, selectedVariant.WeightUnit));
            ToastService.ShowSuccess(successMessage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding to cart: {ex.Message}");
            ToastService.ShowError(Loc["AddToCartError"]);
        }
        finally
        {
            isAddingToCart = false;
            StateHasChanged();
        }
    }
    
    private async Task ToggleFavorite()
    {
        if (product == null) return;
        
        try
        {
            isFavorite = await FavoriteService.ToggleFavoriteAsync(product.Id);
            
            if (isFavorite)
            {
                ToastService.ShowSuccess(Loc["AddedToFavorites"]);
            }
            else
            {
                ToastService.ShowSuccess(Loc["RemovedFromFavorites"]);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling favorite: {ex.Message}");
            ToastService.ShowError(Loc["ErrorUpdatingFavorites"]);
        }
    }

    private string GetCurrentCulture()
    {
        return System.Globalization.CultureInfo.CurrentUICulture.Name;
    }

    private string FormatWeight(decimal weight, string weightUnit)
    {
        // Convert 1000 grams to 1 kilogram for display
        if ((weightUnit.ToLower() == "g" || weightUnit.ToLower() == "gram" || weightUnit.ToLower() == "grams") && weight == 1000)
        {
            var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
            if (currentCulture.StartsWith("ar"))
            {
                return "1 كيلوغرام";
            }
            return "1 kg";
        }
        
        return $"{weight} {weightUnit}";
    }
}

