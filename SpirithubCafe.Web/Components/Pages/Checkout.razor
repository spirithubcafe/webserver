@page "/checkout"
@using Microsoft.AspNetCore.Authorization
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Application.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpirithubCafe.Domain.Entities
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text.Json
@attribute [Authorize]
@layout PublicLayout
@inject CartService CartService
@inject LocationService LocationService
@inject ShippingMethodService ShippingMethodService
@inject IAramexRateService AramexRateService
@inject ProductService ProductService
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ToastService ToastService
@inject TranslationLocalizer Localizer
@implements IDisposable

<PageTitle>@Localizer["CheckoutPageTitle"]</PageTitle>


<div>
    <title>Checkout - SpirithubCafe</title>
</div>

<!-- Loading State -->
@if (isLoading)
{
    <div class="min-h-screen bg-[#f5f5f5] flex items-center justify-center">
        <div class="text-center">
            <div class="w-16 h-16 mx-auto mb-4">
                <svg class="animate-spin text-[#715A5A]" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <p class="text-gray-600 font-medium">@Localizer["LoadingCheckout"]...</p>
        </div>
    </div>
}
else if (!CartService.Items.Any())
{
    <div class="min-h-screen bg-[#f5f5f5] flex items-center justify-center">
        <div class="text-center max-w-md mx-auto px-4">
            <div class="w-32 h-32 mx-auto mb-8 bg-[#D3DAD9] rounded-full flex items-center justify-center">
                <svg class="w-16 h-16 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.5 6M7 13l-1.5-6m0 0h14.5M17 21a2 2 0 100-4 2 2 0 000 4zM9 21a2 2 0 100-4 2 2 0 000 4z"/>
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">@Localizer["YourCartIsEmpty"]</h2>
            <p class="text-gray-600 mb-8">@Localizer["AddCoffeeBeforeCheckout"]</p>
            <a href="/products" class="inline-flex items-center px-8 py-3 bg-[#715A5A] text-white font-semibold rounded-xl hover:bg-[#5d4a4a] transition-all duration-300 transform hover:scale-105 shadow-lg">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                @Localizer["BrowseProducts"]
            </a>
        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-50">
        <!-- Header with Progress -->
        <div class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">@Localizer["SecureCheckout"]</h1>
                        <p class="text-gray-600 mt-1">@Localizer["CompleteOrderSecurely"]</p>
                    </div>
                    <div class="hidden md:flex items-center space-x-2 text-sm text-gray-500">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@Localizer["SSLSecured"]</span>
                    </div>
                </div>
 
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="lg:grid lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16">
                <!-- Left Column - Forms -->
                <div class="lg:col-span-7">
                    @if (currentStep == 1)
                    {
                        <!-- Step 1: Shipping Information (Address + Shipping Method) -->
                        
                        <!-- Basic Information -->
                        <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8">
                            <div class="px-6 py-4 bg-[#715A5A] text-white">
                                <h2 class="text-xl font-bold flex items-center">
                                    <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                    @Localizer["ShippingAddress"]
                                </h2>
                            </div>
                            
                            <div class="p-6">
                                <EditForm Model="shippingAddress" OnValidSubmit="HandleShippingSubmit">
                                    <DataAnnotationsValidator />
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div class="md:col-span-2">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["FullName"] *</label>
                                            <InputText @bind-Value="shippingAddress.FullName" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="@Localizer["EnterFullName"]" />
                                            <ValidationMessage For="() => shippingAddress.FullName" class="text-red-600 text-sm mt-1" />
                                        </div>
                                        
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["PhoneNumber"] *</label>
                                            <InputText @bind-Value="shippingAddress.Phone" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="@Localizer["PhonePlaceholder"]" />
                                            <ValidationMessage For="() => shippingAddress.Phone" class="text-red-600 text-sm mt-1" />
                                        </div>
                                        
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["Email"] *</label>
                                            <InputText @bind-Value="shippingAddress.Email" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="@Localizer["EmailPlaceholder"]" />
                                            <ValidationMessage For="() => shippingAddress.Email" class="text-red-600 text-sm mt-1" />
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["Country"] *</label>
                                            <select @onchange="OnCountryChanged" value="@shippingAddress.CountryId" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors">
                                                <option value="0">@Localizer["SelectCountry"]</option>
                                                @foreach (var country in countries)
                                                {
                                                    <option value="@country.Id">@country.Name</option>
                                                }
                                            </select>
                                            <ValidationMessage For="() => shippingAddress.CountryId" class="text-red-600 text-sm mt-1" />
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["City"] *</label>
                                            <select @onchange="OnCityChanged" value="@shippingAddress.CityId" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" disabled="@(shippingAddress.CountryId == 0)">
                                                <option value="0">@(shippingAddress.CountryId == 0 ? @Localizer["FirstSelectCountry"] : @Localizer["SelectCity"])</option>
                                                @foreach (var city in availableCities)
                                                {
                                                    <option value="@city.Id">@city.Name</option>
                                                }
                                            </select>
                                            <ValidationMessage For="() => shippingAddress.CityId" class="text-red-600 text-sm mt-1" />
                                        </div>
                                        
                                        <div class="md:col-span-2">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["AddressLine1"] *</label>
                                            <InputText @bind-Value="shippingAddress.Line1" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="Street address, building number" />
                                            <ValidationMessage For="() => shippingAddress.Line1" class="text-red-600 text-sm mt-1" />
                                        </div>
                                        
                                        <div class="md:col-span-2">
                                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["AddressLine2Optional"]</label>
                                            <InputText @bind-Value="shippingAddress.Line2" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="@Localizer["ApartmentSuite"]" />
                                        </div>
                                        
                                        
                                        

                                        
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-2">Postal Code</label>
                                            <InputText @bind-Value="shippingAddress.PostalCode" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="XXX" />
                                        </div>
                                    </div>
                                    
                                    <div class="mt-6 flex items-center">
                                        <input type="checkbox" @bind="saveAddress" class="h-4 w-4 text-orange-600 focus:ring-orange-500 border-gray-300 rounded">
                                        <label class="ml-2 block text-sm text-gray-900">Save this address for future orders</label>
                                    </div>
                                </EditForm>
                            </div>
                        </div>
                        
                        <!-- Gift Address Section -->
                        <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8 border-2 border-dashed border-orange-300">
                            <div class="p-6">
                                <div class="flex items-center mb-4">
                                    <input type="checkbox" @bind="isGift" @bind:after="OnGiftCheckboxChanged" class="h-5 w-5 text-orange-600 focus:ring-orange-500 border-gray-300 rounded">
                                    <label class="ml-3 block text-base font-semibold text-orange-600">
                                        @Localizer["GiftSurpriseTitle"]
                                    </label>
                                </div>
                                
                                @if (isGift)
                                {
                                    <div class="mt-6 border-t pt-6">
                                        <div class="mb-4">
                                            <p class="text-sm text-gray-600 bg-orange-50 border-l-4 border-orange-500 p-3 rounded">
                                                <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                Please enter the recipient's delivery information
                                            </p>
                                        </div>
                                        
                                        <EditForm Model="giftAddress">
                                            <DataAnnotationsValidator />
                                            
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                                <div class="md:col-span-2">
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Recipient Name *</label>
                                                    <InputText @bind-Value="giftAddress.FullName" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="Enter recipient's full name" />
                                                    <ValidationMessage For="() => giftAddress.FullName" class="text-red-600 text-sm mt-1" />
                                                </div>
                                                
                                                <div class="md:col-span-2">
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Recipient Phone *</label>
                                                    <InputText @bind-Value="giftAddress.Phone" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="+968 XX XXX XXX" />
                                                    <ValidationMessage For="() => giftAddress.Phone" class="text-red-600 text-sm mt-1" />
                                                </div>

                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Country *</label>
                                                    <select @onchange="OnGiftCountryChanged" value="@giftAddress.CountryId" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors">
                                                        <option value="0">Select Country</option>
                                                        @foreach (var country in countries)
                                                        {
                                                            <option value="@country.Id">@country.Name</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="() => giftAddress.CountryId" class="text-red-600 text-sm mt-1" />
                                                </div>

                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">City *</label>
                                                    <select @onchange="OnGiftCityChanged" value="@giftAddress.CityId" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" disabled="@(giftAddress.CountryId == 0)">
                                                        <option value="0">@(giftAddress.CountryId == 0 ? Localizer["FirstSelectCountry"] : Localizer["SelectCity"])</option>
                                                        @foreach (var city in availableGiftCities)
                                                        {
                                                            <option value="@city.Id">@city.Name</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="() => giftAddress.CityId" class="text-red-600 text-sm mt-1" />
                                                </div>
                                                
                                                <div class="md:col-span-2">
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Delivery Address *</label>
                                                    <InputText @bind-Value="giftAddress.Line1" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="Street address, building number" />
                                                    <ValidationMessage For="() => giftAddress.Line1" class="text-red-600 text-sm mt-1" />
                                                </div>
                                                
                                                <div class="md:col-span-2">
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Address Line 2 (Optional)</label>
                                                    <InputText @bind-Value="giftAddress.Line2" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="Apartment, suite, etc." />
                                                </div>
                                                
                                                <div>
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Postal Code</label>
                                                    <InputText @bind-Value="giftAddress.PostalCode" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="XXX" />
                                                </div>
                                                
                                                <div class="md:col-span-2">
                                                    <label class="block text-sm font-medium text-gray-700 mb-2">Gift Message (Optional)</label>
                                                    <textarea @bind="giftMessage" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-colors" placeholder="Add a personal message for the recipient..."></textarea>
                                                </div>
                                            </div>
                                        </EditForm>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Continue Button -->
                        @if (currentStep == 1)
                        {
                            <div class="bg-white rounded-2xl shadow-md border-2 border-[#715A5A]/20 overflow-hidden mb-8">
                                <div class="p-6">
                                    <button @onclick="NextStep" disabled="@(!IsValidShippingAddress() || string.IsNullOrEmpty(selectedShippingMethod))" class="w-full inline-flex items-center justify-center px-8 py-4 bg-[#715A5A] text-white font-bold text-lg rounded-xl hover:bg-[#5d4a4a] transition-all duration-300 transform hover:scale-[1.02] shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
                                        <span>@Localizer["ContinueToReviewPayment"]</span>
                                        <svg class="ltr:ml-3 rtl:mr-3 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else if (currentStep == 2)
                    {
                        <!-- Step 2: Review & Payment -->
                        <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8">
                            <div class="px-6 py-4 bg-[#715A5A] text-white">
                                <h2 class="text-xl font-bold flex items-center">
                                    <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                    </svg>
                                    Review Your Order
                                </h2>
                            </div>
                            
                            <div class="p-6 space-y-6">
                                <!-- Shipping Information Review -->
                                <div class="border border-gray-200 rounded-xl p-4">
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 class="font-semibold text-gray-900 flex items-center">
                                            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            </svg>
                                            Shipping Address
                                        </h3>
                                        <button @onclick="EditShipping" class="text-orange-600 hover:text-orange-700 text-sm font-medium">Edit</button>
                                    </div>
                                    <div class="text-sm text-gray-600 bg-gray-50 p-3 rounded-lg">
                                        <p class="font-medium text-gray-900 mb-1">@shippingAddress.FullName</p>
                                        <p class="mb-1">@shippingAddress.Line1</p>
                                        @if (!string.IsNullOrEmpty(shippingAddress.Line2))
                                        {
                                            <p class="mb-1">@shippingAddress.Line2</p>
                                        }
                                        @if (!string.IsNullOrEmpty(shippingAddress.CityName) && !string.IsNullOrEmpty(shippingAddress.CountryName))
                                        {
                                            <p class="mb-1">@shippingAddress.CityName, @shippingAddress.CountryName</p>
                                        }
                                        @if (!string.IsNullOrEmpty(shippingAddress.PostalCode))
                                        {
                                            <p class="mb-1">Postal Code: @shippingAddress.PostalCode</p>
                                        }
                                        <p class="mb-1">📞 @shippingAddress.Phone</p>
                                        <p>📧 @shippingAddress.Email</p>
                                    </div>
                                </div>

                                <!-- Gift Address Review (if applicable) -->
                                @if (isGift && IsValidGiftAddress())
                                {
                                    <div class="border border-orange-200 bg-orange-50 rounded-xl p-4">
                                        <div class="flex items-center justify-between mb-3">
                                            <h3 class="font-semibold text-gray-900 flex items-center">
                                                <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
                                                </svg>
                                                🎁 Gift Recipient Address
                                            </h3>
                                            <button @onclick="EditShipping" class="text-orange-600 hover:text-orange-700 text-sm font-medium">Edit</button>
                                        </div>
                                        <div class="text-sm text-gray-600 bg-white p-3 rounded-lg border border-orange-200">
                                            <p class="font-medium text-gray-900 mb-1">📦 Delivering to: @giftAddress.FullName</p>
                                            <p class="mb-1">@giftAddress.Line1</p>
                                            @if (!string.IsNullOrEmpty(giftAddress.Line2))
                                            {
                                                <p class="mb-1">@giftAddress.Line2</p>
                                            }
                                            @if (!string.IsNullOrEmpty(giftAddress.CityName) && !string.IsNullOrEmpty(giftAddress.CountryName))
                                            {
                                                <p class="mb-1">@giftAddress.CityName, @giftAddress.CountryName</p>
                                            }
                                            @if (!string.IsNullOrEmpty(giftAddress.PostalCode))
                                            {
                                                <p class="mb-1">Postal Code: @giftAddress.PostalCode</p>
                                            }
                                            <p class="mb-1">📞 @giftAddress.Phone</p>
                                            @if (!string.IsNullOrEmpty(giftMessage))
                                            {
                                                <div class="mt-3 pt-3 border-t border-orange-200">
                                                    <p class="font-medium text-gray-900 mb-1">💌 Gift Message:</p>
                                                    <p class="italic text-gray-700">@giftMessage</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Shipping Method Review -->
                                <div class="border border-gray-200 rounded-xl p-4">
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 class="font-semibold text-gray-900 flex items-center">
                                            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                                            </svg>
                                            Shipping Method
                                        </h3>
                                        <button @onclick="() => currentStep = 1" class="text-orange-600 hover:text-orange-700 text-sm font-medium">Change</button>
                                    </div>
                                    <div class="text-sm text-gray-600 bg-gray-50 p-3 rounded-lg">
                                        @if (!string.IsNullOrEmpty(selectedShippingMethod))
                                        {
                                            var method = shippingMethods.FirstOrDefault(sm => sm.Type.ToLower() == selectedShippingMethod.ToLower());
                                            if (method != null)
                                            {
                                                <p class="font-medium text-gray-900 mb-1">@method.Name</p>
                                                <p class="mb-1">@method.Description</p>
                                                <p class="font-semibold text-orange-600">Cost: @GetShippingCost().ToString("F3") OMR</p>
                                            }
                                            else
                                            {
                                                <p class="text-red-600">⚠️ Shipping method '@selectedShippingMethod' not found</p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-red-600">⚠️ No shipping method selected</p>
                                        }
                                    </div>
                                </div>

                                <!-- Order Items Review -->
                                <div class="border border-gray-200 rounded-xl p-4">
                                    <div class="flex items-center justify-between mb-3">
                                        <h3 class="font-semibold text-gray-900 flex items-center">
                                            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                            </svg>
                                            Order Items (@CartService.Items.Count items)
                                        </h3>
                                        <span class="text-sm text-gray-500">Total Weight: @GetTotalWeight().ToString("F2") kg</span>
                                    </div>
                                    <div class="space-y-3">
                                        @foreach (var item in CartService.Items)
                                        {
