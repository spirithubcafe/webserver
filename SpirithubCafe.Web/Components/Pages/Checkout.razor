}

@code {
    private int currentStep = 1;
    private ShippingAddress shippingAddress = new();
    private bool saveAddress = false;
    private bool isProcessing = false;
    private bool isLoading = true;
    
    // Gift address fields
    private bool isGift = false;
    private ShippingAddress giftAddress = new();
    private List<City> availableGiftCities = new();
    private string giftMessage = "";
    
    // Database data
    private List<Country> countries = new();
    private List<City> cities = new();
    private List<City> availableCities = new();
    private List<ShippingMethod> shippingMethods = new();
    private List<Product> allProducts = new();
    
    // Selected options
    private string selectedShippingMethod = "";
    private decimal calculatedShippingCost = 0;
 
    protected override Task OnInitializedAsync()
    {
        // Just set up, don't load cart yet
        // Cart will be loaded in OnAfterRenderAsync
        return Task.CompletedTask;
    }
    
    private async Task LoadDataAsync()
    {
        try
        {
            countries = await LocationService.GetAllCountriesAsync();
            cities = await LocationService.GetAllCitiesAsync();
            shippingMethods = await ShippingMethodService.GetActiveShippingMethodsAsync();
            allProducts = await ProductService.GetAllProductsAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading data: {ex.Message}");
        }
    }
    
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int countryId) && countryId > 0)
        {
            shippingAddress.CountryId = countryId;
            shippingAddress.CityId = 0; // Reset city selection
            calculatedShippingCost = 0; // Reset shipping cost
            selectedShippingMethod = ""; // Reset shipping method selection
            
            availableCities = await LocationService.GetCitiesByCountryIdAsync(countryId);
            
            // Update country name for display
            var selectedCountry = countries.FirstOrDefault(c => c.Id == countryId);
            shippingAddress.CountryName = selectedCountry?.Name ?? "";
        }
        else
        {
            shippingAddress.CountryId = 0;
            shippingAddress.CityId = 0;
            calculatedShippingCost = 0;
            selectedShippingMethod = "";
            availableCities.Clear();
            shippingAddress.CountryName = "";
        }
        
        StateHasChanged();
    }
    
    private async Task OnGiftCountryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int countryId) && countryId > 0)
        {
            giftAddress.CountryId = countryId;
            giftAddress.CityId = 0; // Reset city selection
            
            availableGiftCities = await LocationService.GetCitiesByCountryIdAsync(countryId);
            
            // Update country name for display
            var selectedCountry = countries.FirstOrDefault(c => c.Id == countryId);
            giftAddress.CountryName = selectedCountry?.Name ?? "";
            
            // Recalculate shipping cost if gift address is used
            await CalculateShippingCostAsync();
        }
        else
        {
            giftAddress.CountryId = 0;
            giftAddress.CityId = 0;
            availableGiftCities.Clear();
            giftAddress.CountryName = "";
        }
        
        StateHasChanged();
    }
    
    private async Task OnGiftCityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cityId) && cityId > 0)
        {
            giftAddress.CityId = cityId;
            
            // Update city name for display
            var selectedCity = availableGiftCities.FirstOrDefault(c => c.Id == cityId);
            giftAddress.CityName = selectedCity?.Name ?? "";
            
            // Recalculate shipping cost with gift address
            await CalculateShippingCostAsync();
        }
        else
        {
            giftAddress.CityId = 0;
            giftAddress.CityName = "";
        }
        
        StateHasChanged();
    }
    
    private async Task OnGiftCheckboxChanged()
    {
        if (!isGift)
        {
            // Reset gift address when unchecked
            giftAddress = new ShippingAddress();
            availableGiftCities.Clear();
            giftMessage = "";
        }
        
        // Recalculate shipping cost
        await CalculateShippingCostAsync();
        StateHasChanged();
    }
    
    private async Task OnCityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cityId) && cityId > 0)
        {
            shippingAddress.CityId = cityId;
            
            // Update city name for display
            var selectedCity = availableCities.FirstOrDefault(c => c.Id == cityId);
            shippingAddress.CityName = selectedCity?.Name ?? "";
            
            // Calculate shipping cost if shipping method is selected
            await CalculateShippingCostAsync();
        }
        else
        {
            shippingAddress.CityId = 0;
            shippingAddress.CityName = "";
            calculatedShippingCost = 0;
        }
        
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Load cart from localStorage after first render
                await CartService.InitializeAsync();
                
                // Check if cart is empty after loading
                if (!CartService.Items.Any())
                {
                    // Cart is empty, show empty cart message
                    isLoading = false;
                    StateHasChanged();
                    return;
                }
                
                // Load countries, cities, and shipping methods
                await LoadDataAsync();
                
                // Load saved address if exists
                await LoadAddressFromStorage();
                
                // Set loading to false after everything is loaded
                isLoading = false;
                StateHasChanged();
                
                // Scroll to top of page when component is first rendered
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch (InvalidOperationException)
            {
                // Ignore JS interop exceptions during prerendering
                isLoading = false;
            }
        }
    }

    // This method is no longer used since address and shipping are in the same step
    private async Task HandleShippingSubmit()
    {
        // Address validation is handled by the form itself
        // Shipping method selection is in the same step now
        await Task.CompletedTask;
    }

    private bool IsValidShippingAddress()
    {
        var mainAddressValid = !string.IsNullOrWhiteSpace(shippingAddress.FullName) &&
               !string.IsNullOrWhiteSpace(shippingAddress.Phone) &&
               !string.IsNullOrWhiteSpace(shippingAddress.Email) &&
               !string.IsNullOrWhiteSpace(shippingAddress.Line1) &&
               shippingAddress.CountryId > 0 &&
               shippingAddress.CityId > 0;
        
        // If gift is selected, validate gift address too
        if (isGift)
        {
            var giftAddressValid = !string.IsNullOrWhiteSpace(giftAddress.FullName) &&
                   !string.IsNullOrWhiteSpace(giftAddress.Phone) &&
                   !string.IsNullOrWhiteSpace(giftAddress.Line1) &&
                   giftAddress.CountryId > 0 &&
                   giftAddress.CityId > 0;
            
            return mainAddressValid && giftAddressValid;
        }
        
        return mainAddressValid;
    }

    private async Task NextStep()
    {
        if (currentStep < 2)
        {
            // Save address if checkbox is checked
            if (saveAddress)
            {
                await SaveAddressToStorage();
            }
            
            currentStep++;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EditShipping()
    {
        currentStep = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EditPayment()
    {
        currentStep = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlaceOrder()
    {
        if (isProcessing) return;
        
        // Validate that shipping address is complete
        if (string.IsNullOrEmpty(shippingAddress.FullName) || 
            string.IsNullOrEmpty(shippingAddress.Email) || 
            string.IsNullOrEmpty(shippingAddress.Phone) ||
            string.IsNullOrEmpty(shippingAddress.Line1) ||
            shippingAddress.CountryId <= 0 ||
            shippingAddress.CityId <= 0)
        {
            ToastService.ShowError("❌ Please complete all shipping address fields before placing your order.");
            return;
        }

        // Debug log
        await JSRuntime.InvokeVoidAsync("console.log", $"PlaceOrder called with selectedShippingMethod: '{selectedShippingMethod}'");
        
        // Validate that shipping method is selected
        if (string.IsNullOrEmpty(selectedShippingMethod))
        {
            ToastService.ShowError($"❌ Please select a shipping method before placing your order. Current value: '{selectedShippingMethod}'");
            return;
        }
        
        isProcessing = true;
        StateHasChanged();
        
        try
        {
            // Get current user ID
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            
            // Find selected shipping method (case insensitive comparison)
            var selectedMethod = shippingMethods.FirstOrDefault(sm => sm.Type.ToLower() == selectedShippingMethod.ToLower());
            if (selectedMethod == null)
            {
                throw new InvalidOperationException($"Selected shipping method '{selectedShippingMethod}' not found. Available methods: {string.Join(", ", shippingMethods.Select(m => m.Type))}");
            }

            // Split full name into first and last name
            var nameParts = shippingAddress.FullName.Split(' ', 2);
            var firstName = nameParts[0];
            var lastName = nameParts.Length > 1 ? nameParts[1] : "";
            
            // Determine which address to use for shipping
            var useGiftAddress = isGift && IsValidGiftAddress();
            var finalShippingAddress = useGiftAddress ? giftAddress : shippingAddress;

            // Create order request
            var orderRequest = new CreateOrderRequest
            {
                UserId = userId,
                FirstName = firstName,
                LastName = lastName,
                Email = shippingAddress.Email,
                Phone = shippingAddress.Phone,
                AddressLine1 = finalShippingAddress.Line1,
                AddressLine2 = finalShippingAddress.Line2,
                CountryId = finalShippingAddress.CountryId,
                CityId = finalShippingAddress.CityId,
                PostalCode = finalShippingAddress.PostalCode,
                ShippingMethodId = selectedMethod.Id,
                ShippingCost = calculatedShippingCost,
                Notes = isGift ? $"🎁 GIFT ORDER\nRecipient: {giftAddress.FullName}\nPhone: {giftAddress.Phone}\n{(!string.IsNullOrEmpty(giftMessage) ? $"Message: {giftMessage}" : "")}" : null,
                // Gift Order Properties
                IsGift = isGift,
                GiftRecipientName = isGift ? giftAddress.FullName : null,
                GiftRecipientPhone = isGift ? giftAddress.Phone : null,
                GiftRecipientAddressLine1 = isGift ? giftAddress.Line1 : null,
                GiftRecipientAddressLine2 = isGift ? giftAddress.Line2 : null,
                GiftRecipientCountryId = isGift ? giftAddress.CountryId : null,
                GiftRecipientCityId = isGift ? giftAddress.CityId : null,
                GiftRecipientPostalCode = isGift ? giftAddress.PostalCode : null,
                GiftMessage = isGift && !string.IsNullOrEmpty(giftMessage) ? giftMessage : null
            };

            // Create the order with payment
            var (order, paymentUrl) = await OrderService.CreateOrderWithPaymentAsync(orderRequest);
            
            // Clear cart after successful order creation
            await CartService.ClearCartAsync();
            
            // Show message and redirect to payment redirect page
            ToastService.ShowSuccess($"🛒 Order #{order.OrderNumber} created successfully! Redirecting to payment...");
            
            // Redirect to payment redirect page
            Navigation.NavigateTo($"/payment-redirect/{order.Id}", forceLoad: true);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"❌ Error placing order: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task OnShippingMethodChanged(string shippingType)
    {
        await JSRuntime.InvokeVoidAsync("console.log", $"OnShippingMethodChanged called with: '{shippingType}'");
        
        if (!string.IsNullOrEmpty(shippingType))
        {
            selectedShippingMethod = shippingType;
            await CalculateShippingCostAsync();
            StateHasChanged();
            
            // Debug log to console
            await JSRuntime.InvokeVoidAsync("console.log", $"Shipping method set to: '{selectedShippingMethod}'");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("console.log", "Shipping method is null or empty!");
        }
    }

    private async Task CalculateShippingCostAsync()
    {
        // Determine which address to use for shipping calculation
        var useGiftAddress = isGift && IsValidGiftAddress();
        var targetAddress = useGiftAddress ? giftAddress : shippingAddress;
        var targetCityId = targetAddress.CityId;
        var targetCountryId = targetAddress.CountryId;
        
        if (!string.IsNullOrEmpty(selectedShippingMethod) && targetCityId > 0)
        {
            // If Aramex is selected, use AramexRateService
            if (selectedShippingMethod.ToLower() == "aramex")
            {
                var totalWeight = CalculateTotalWeight();
                var country = countries.FirstOrDefault(c => c.Id == targetCountryId);
                var city = cities.FirstOrDefault(c => c.Id == targetCityId);
                
                if (country != null && city != null && totalWeight > 0)
                {
                    var request = new AramexRateRequest
                    {
                        DestinationCountryCode = country.Code,
                        DestinationCity = city.Name,
                        DestinationAddress = targetAddress.Line1,
                        DestinationPostalCode = targetAddress.PostalCode,
                        Weight = totalWeight
                    };
                    
                    var result = await AramexRateService.CalculateRateAsync(request);
                    
                    if (result.Success)
                    {
                        calculatedShippingCost = result.TotalAmount;
                    }
                    else
                    {
                        // Fallback to standard calculation if Aramex fails
                        calculatedShippingCost = await ShippingMethodService.CalculateShippingCostAsync(
                            selectedShippingMethod, 
                            targetCountryId, 
                            targetCityId);
                    }
                }
                else
                {
                    calculatedShippingCost = 0;
                }
            }
            else
            {
                calculatedShippingCost = await ShippingMethodService.CalculateShippingCostAsync(
                    selectedShippingMethod, 
                    targetCountryId, 
                    targetCityId);
            }
        }
        else
        {
            calculatedShippingCost = 0;
        }
    }
    
    private bool IsValidGiftAddress()
    {
        return !string.IsNullOrWhiteSpace(giftAddress.FullName) &&
               !string.IsNullOrWhiteSpace(giftAddress.Phone) &&
               !string.IsNullOrWhiteSpace(giftAddress.Line1) &&
               giftAddress.CountryId > 0 &&
               giftAddress.CityId > 0;
    }

    private decimal GetShippingCost()
    {
        return calculatedShippingCost;
    }

    private string GetShippingMethodDisplayName()
    {
        if (string.IsNullOrEmpty(selectedShippingMethod))
        {
            return "Shipping";
        }

        var method = shippingMethods.FirstOrDefault(s => s.Type.ToLower() == selectedShippingMethod.ToLower());
        return method?.Name ?? "Shipping";
    }

    private List<ShippingMethod> GetAvailableShippingMethods()
    {
        var availableMethods = new List<ShippingMethod>();
        
        foreach (var method in shippingMethods)
        {
            // Always show pickup
            if (method.Type.ToLower() == "pickup")
            {
                availableMethods.Add(method);
                continue;
            }
            
            // Show Nool only for Oman (country ID = 4)
            if (method.Type.ToLower().Contains("nool"))
            {
                if (shippingAddress.CountryId == 4) // Oman country ID
                {
                    availableMethods.Add(method);
                }
                continue;
            }
            
            // Show other methods (like Aramex) for all countries
            availableMethods.Add(method);
        }
        
        return availableMethods;
    }

    private decimal GetTax()
    {
        decimal totalTax = 0;
        
        foreach (var item in CartService.Items)
        {
            // Get product to access its category
            var product = allProducts.FirstOrDefault(p => p.Id == item.ProductId);
            if (product?.Category != null)
            {
                var itemSubtotal = item.Price * item.Quantity;
                var categoryTaxRate = product.Category.TaxPercentage / 100m;
                totalTax += itemSubtotal * categoryTaxRate;
            }
        }
        
        return totalTax;
    }

 
    private decimal GetFinalTotal()
    {
        return CartService.TotalPrice + GetShippingCost() + GetTax();
    }

    private decimal CalculateTotalWeight()
    {
        decimal totalWeightInKg = 0;
        
        foreach (var item in CartService.Items)
        {
            if (item.Weight > 0)
            {
                decimal itemWeightInKg = item.Weight;
                
                // Convert weight to kg based on unit
                switch (item.WeightUnit?.ToLower())
                {
                    case "g":
                    case "gram":
                    case "grams":
                        itemWeightInKg = item.Weight / 1000m; // Convert grams to kg
                        break;
                    case "kg":
                    case "kilogram":
                    case "kilograms":
                        itemWeightInKg = item.Weight; // Already in kg
                        break;
                    case "lb":
                    case "pound":
                    case "pounds":
                        itemWeightInKg = item.Weight * 0.453592m; // Convert pounds to kg
                        break;
                    default:
                        // Default assume grams if unit is not specified or unknown
                        itemWeightInKg = item.Weight / 1000m;
                        break;
                }
                
                totalWeightInKg += itemWeightInKg * item.Quantity;
            }
        }
        
        return totalWeightInKg;
    }

    private decimal GetTotalWeight()
    {
        return CalculateTotalWeight();
    }

    private decimal GetTaxRate()
    {
        // Default tax rate - you can make this configurable
        return 5.0m; // 5%
    }

