    private async Task SaveAddressToStorage()
    {
        try
        {
            var addressJson = JsonSerializer.Serialize(shippingAddress);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "spirithub_saved_address", addressJson);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error saving address:", ex.Message);
        }
    }
    
    private async Task LoadAddressFromStorage()
    {
        try
        {
            var addressJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "spirithub_saved_address");
            
            if (!string.IsNullOrEmpty(addressJson))
            {
                var savedAddress = JsonSerializer.Deserialize<ShippingAddress>(addressJson);
                
                if (savedAddress != null)
                {
                    shippingAddress = savedAddress;
                    
                    // Load cities for the saved country
                    if (shippingAddress.CountryId > 0)
                    {
                        availableCities = cities.Where(c => c.CountryId == shippingAddress.CountryId).ToList();
                    }
                    
                    // Mark the checkbox as checked since we loaded a saved address
                    saveAddress = true;
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", "Error loading address:", ex.Message);
        }
    }

