@page "/payment/cancel"
@using Microsoft.AspNetCore.Authorization
@using SpirithubCafe.Application.Services
@attribute [Authorize]
@layout PublicLayout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<PaymentCancel> Logger
@inject TranslationLocalizer Localizer

<div class="min-h-screen bg-gradient-to-br from-red-50 via-white to-red-50 flex items-center justify-center">
    <div class="max-w-2xl mx-auto text-center px-4">
        <div class="mb-8">
            <div class="w-24 h-24 mx-auto mb-6 bg-red-100 rounded-full flex items-center justify-center">
                <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
            <h1 class="text-3xl md:text-4xl font-bold text-red-600 mb-4">@Localizer["PaymentCancelled"]</h1>
            <p class="text-lg text-gray-600 mb-8">@Localizer["PaymentCancelledDescription"]</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg border border-red-100 p-8 mb-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-4">@Localizer["WhatHappened"]?</h2>
            <div class="text-left space-y-3">
                <div class="flex items-start space-x-3">
                    <div class="w-2 h-2 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <p class="text-gray-600">@Localizer["PaymentCancelledByUser"]</p>
                </div>
                <div class="flex items-start space-x-3">
                    <div class="w-2 h-2 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <p class="text-gray-600">@Localizer["PaymentGatewayDeclined"]</p>
                </div>
                <div class="flex items-start space-x-3">
                    <div class="w-2 h-2 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <p class="text-gray-600">@Localizer["SessionTimeoutOrConnectionIssue"]</p>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <p class="text-gray-600">
                @Localizer["DontWorryCartSaved"]
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <NavLink href="/checkout" class="inline-flex items-center px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    @Localizer["TryAgain"]
                </NavLink>
                <NavLink href="/cart" class="inline-flex items-center px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.5 6M7 13l-1.5-6m0 0h14.5M17 21a2 2 0 100-4 2 2 0 000 4zM9 21a2 2 0 100-4 2 2 0 000 4z"/>
                    </svg>
                    View Cart
                </NavLink>
            </div>
            
            <div class="mt-8 pt-8 border-t border-gray-200">
                <p class="text-sm text-gray-500 mb-4">Need help? Contact our support team:</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center text-sm">
                    <a href="mailto:support@spirithubcafe.com" class="inline-flex items-center text-blue-600 hover:text-blue-800">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        support@spirithubcafe.com
                    </a>
                    <a href="tel:+96824123456" class="inline-flex items-center text-blue-600 hover:text-blue-800">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        +968 2412 3456
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override Task OnInitializedAsync()
    {
        try
        {
            // Log the payment cancellation
            var uri = new Uri(Navigation.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            
            Logger.LogInformation("Payment cancelled. Query parameters: {Query}", string.Join(", ", query.Select(kv => $"{kv.Key}={kv.Value}")));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing payment cancellation");
        }
        
        return Task.CompletedTask;
    }
}