@page "/smartpay-official-test"
@using SpirithubCafe.Application.Services
@inject IPaymentGatewayService PaymentGatewayService
@inject ILogger<SmartPayOfficialTest> Logger
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="container mx-auto p-6">
    <h2 class="text-3xl font-bold mb-8 text-center">SmartPay Gateway Test Center</h2>

    <!-- Gateway Environment Selection -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Gateway Environment</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="flex items-center space-x-2">
                    <input type="radio" name="environment" @onchange="() => SetEnvironment(true)" checked="@isSandbox" class="form-radio" />
                    <span class="font-medium">Sandbox (UAT)</span>
                </label>
                <p class="text-sm text-gray-600 break-all overflow-x-auto max-w-full">https://spayuattrns.bmtest.om/transaction.do?command=initiateTransaction</p>
            </div>
            <div class="space-y-2">
                <label class="flex items-center space-x-2">
                    <input type="radio" name="environment" @onchange="() => SetEnvironment(false)" checked="@(!isSandbox)" class="form-radio" />
                    <span class="font-medium">Production</span>
                </label>
                <p class="text-sm text-gray-600 break-all overflow-x-auto max-w-full">https://smartpaytrns.bankmuscat.com/transaction.do?command=initiateTransaction</p>
            </div>
        </div>
    </div>

    <!-- Gateway Credentials -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Gateway Credentials</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant ID</label>
                <input type="text" @bind="testData.MerchantId" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Access Code</label>
                <input type="text" @bind="testData.AccessCode" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Working Key</label>
                <input type="text" @bind="testData.WorkingKey" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>
    </div>

    <!-- Transaction Details -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Transaction Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Order ID *</label>
                <input type="text" @bind="testData.OrderId" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="e.g., ORD12345" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Amount *</label>
                <input type="number" step="0.001" @bind="testData.Amount" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="1.000" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Currency *</label>
                <select @bind="testData.Currency" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="OMR">OMR - Omani Rial</option>
                    <option value="USD">USD - US Dollar</option>
                    <option value="EUR">EUR - Euro</option>
                    <option value="AED">AED - UAE Dirham</option>
                </select>
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Customer Identifier</label>
                <input type="number" @bind="testData.CustomerIdentifier" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="12345" />
            </div>
        </div>
    </div>

    <!-- URLs -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Response URLs</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Redirect URL</label>
                <input type="text" @bind="testData.RedirectUrl" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Cancel URL</label>
                <input type="text" @bind="testData.CancelUrl" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>
    </div>

    <!-- Customer Billing Information -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Customer Billing Information</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Address</label>
                <input type="text" @bind="testData.BillingAddress" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="123 Main Street" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing City</label>
                <input type="text" @bind="testData.BillingCity" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Muscat" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing State</label>
                <input type="text" @bind="testData.BillingState" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Muscat" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Zip</label>
                <input type="text" @bind="testData.BillingZip" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="12345" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Country</label>
                <input type="text" @bind="testData.BillingCountry" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Oman" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Email</label>
                <input type="email" @bind="testData.BillingEmail" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="customer@email.com" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Name</label>
                <input type="text" @bind="testData.BillingName" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="John Doe" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Billing Tel</label>
                <input type="text" @bind="testData.BillingTel" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="+968 12345678" />
            </div>
        </div>
    </div>

    <!-- Merchant Parameters -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Merchant Parameters (Optional)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant Param 1</label>
                <input type="text" @bind="testData.MerchantParam1" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant Param 2</label>
                <input type="text" @bind="testData.MerchantParam2" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant Param 3</label>
                <input type="text" @bind="testData.MerchantParam3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant Param 4</label>
                <input type="text" @bind="testData.MerchantParam4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Merchant Param 5</label>
                <input type="text" @bind="testData.MerchantParam5" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>
    </div>

    <!-- Card Details (for Merchant Hosted Integration) -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Card Details (Merchant Hosted Integration Only)</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Card Number</label>
                <input type="text" @bind="testData.CardNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="1234567812345678" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Expiry Month (MM)</label>
                <input type="text" @bind="testData.ExpiryMonth" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="12" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">Expiry Year (YY)</label>
                <input type="text" @bind="testData.ExpiryYear" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="25" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">CVV</label>
                <input type="text" @bind="testData.CvvNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="123" />
            </div>
        </div>
    </div>

    <!-- MOTO Parameters -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">MOTO Parameters (if enabled)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">SI Type</label>
                <input type="text" @bind="testData.SiType" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="ONDEMAND" />
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-medium text-gray-700">SI Merchant Reference No</label>
                <input type="text" @bind="testData.SiMerRefNo" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
        </div>
    </div>

    <!-- Send Method Selection -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Send Method</h3>
        <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="flex items-center space-x-2">
                    <input type="radio" name="sendMethod" @onchange="() => SetSendMethod(true)" checked="@usePostMethod" class="form-radio" />
                    <span class="font-medium">POST Method</span>
                </label>
                <p class="text-sm text-gray-600">Send encrypted data via form POST</p>
            </div>
            <div class="space-y-2">
                <label class="flex items-center space-x-2">
                    <input type="radio" name="sendMethod" @onchange="() => SetSendMethod(false)" checked="@(!usePostMethod)" class="form-radio" />
                    <span class="font-medium">GET Method (Query String)</span>
                </label>
                <p class="text-sm text-gray-600">Send encrypted data via URL parameters</p>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">Test Actions</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button @onclick="TestEncryption" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                Test Encryption
            </button>
            <button @onclick="GenerateRequestString" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                Generate Request String
            </button>
            <button @onclick="SendToGateway" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                Send to Gateway (@(usePostMethod ? "POST" : "GET"))
            </button>
        </div>
    </div>

    <!-- Test Results -->
    @if (!string.IsNullOrEmpty(testResult))
    {
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
            <h3 class="text-xl font-semibold mb-4">Test Results</h3>
            <div class="bg-gray-100 p-4 rounded-lg">
                <pre class="whitespace-pre-wrap text-sm font-mono break-all overflow-x-auto max-w-full">@testResult</pre>
            </div>
        </div>
    }

    <!-- Send to Gateway Form -->
    @if (showGatewayForm)
    {
        <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
            <h3 class="text-xl font-semibold mb-4">Gateway Redirect (@(usePostMethod ? "POST Method" : "GET Method"))</h3>
            <p class="mb-4">Click the button below to redirect to the SmartPay gateway:</p>
            
            @if (usePostMethod)
            {
                <!-- POST Method Form -->
                <form method="post" action="@gatewayUrl" target="_blank">
                    <input type="hidden" name="access_code" value="@testData.AccessCode" />
                    <input type="hidden" name="encRequest" value="@encryptedData" />
                    
                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                        🚀 Open SmartPay Gateway (POST)
                    </button>
                </form>
            }
            else
            {
                <!-- GET Method Link -->
                <a href="@GetMethodUrl" target="_blank" class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300 text-decoration-none">
                    🚀 Open SmartPay Gateway (GET)
                </a>
                
                <div class="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                    <p class="text-sm text-blue-700"><strong>GET URL:</strong></p>
                    <div class="bg-white p-2 rounded border mt-2 break-all text-xs font-mono overflow-x-auto max-w-full">
                        @GetMethodUrl
                    </div>
                </div>
            }
            
            <div class="mt-4 text-sm text-gray-600">
                <p><strong>Gateway URL:</strong> @gatewayUrl</p>
                <p><strong>Method:</strong> @(usePostMethod ? "POST" : "GET")</p>
                <p><strong>Access Code:</strong> @testData.AccessCode</p>
                <p><strong>Encrypted Request Length:</strong> @(encryptedData?.Length ?? 0) characters</p>
            </div>
        </div>
    }

    <!-- Encode/Decode Section -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
        <h3 class="text-xl font-semibold mb-4">🔐 Encryption/Decryption Tool</h3>
        
        <!-- Working Key for Encode/Decode -->
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Working Key for Encryption/Decryption</label>
            <input type="text" @bind="encodeDecodeKey" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 break-all" placeholder="Enter working key..." />
        </div>

        <!-- Encode Section -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="space-y-3">
                <h4 class="text-lg font-semibold text-green-600">🔒 Encode (Encrypt)</h4>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Plain Text to Encrypt:</label>
                    <textarea @bind="plainTextToEncode" 
                              rows="6" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 resize-vertical break-all"
                              placeholder="Enter plain text data to encrypt..."></textarea>
                </div>
                <button @onclick="EncodeData" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
                    🔒 Encrypt Data
                </button>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Encrypted Result:</label>
                    <textarea @bind="encodedResult" 
                              readonly 
                              rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 resize-vertical break-all overflow-x-auto"
                              placeholder="Encrypted data will appear here..."></textarea>
                </div>
            </div>

            <!-- Decode Section -->
            <div class="space-y-3">
                <h4 class="text-lg font-semibold text-red-600">🔓 Decode (Decrypt)</h4>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Encrypted Text to Decrypt:</label>
                    <textarea @bind="encryptedTextToDecode" 
                              rows="6" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 resize-vertical break-all"
                              placeholder="Enter encrypted hex data to decrypt..."></textarea>
                </div>
                <button @onclick="DecodeData" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
                    🔓 Decrypt Data
                </button>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Decrypted Result:</label>
                    <textarea @bind="decodedResult" 
                              readonly 
                              rows="4" 
                              class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-50 resize-vertical break-all overflow-x-auto"
                              placeholder="Decrypted data will appear here..."></textarea>
                </div>
            </div>
        </div>

        <!-- Encode/Decode Results -->
        @if (!string.IsNullOrEmpty(encodeDecodeResult))
        {
            <div class="bg-gray-100 p-4 rounded-lg">
                <h4 class="text-lg font-semibold mb-2">Operation Result:</h4>
                <pre class="whitespace-pre-wrap text-sm font-mono break-all overflow-x-auto max-w-full">@encodeDecodeResult</pre>
            </div>
        }
    </div>
</div>

@code {
    private TestData testData = new TestData();
    private string testResult = "";
    private bool isSandbox = true;
    private bool usePostMethod = true;
    private bool showGatewayForm = false;
    private string encryptedData = "";
    private string gatewayUrl = "";
    
    // Encode/Decode variables
    private string encodeDecodeKey = "";
    private string plainTextToEncode = "";
    private string encodedResult = "";
    private string encryptedTextToDecode = "";
    private string decodedResult = "";
    private string encodeDecodeResult = "";
    
    private string GetMethodUrl 
    { 
        get
        {
            if (string.IsNullOrEmpty(encryptedData)) return "";
            
            var encodedAccessCode = Uri.EscapeDataString(testData.AccessCode);
            var encodedRequest = Uri.EscapeDataString(encryptedData);
            
            // gatewayUrl already contains ?command=initiateTransaction, so we use & for additional parameters
            return $"{gatewayUrl}&access_code={encodedAccessCode}&encRequest={encodedRequest}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDefaultValues();
    }

    private async Task LoadDefaultValues()
    {
        // Load default values
        testData.MerchantId = "224";
        testData.AccessCode = "AVDP00LA16BE47PDEB";
        testData.WorkingKey = "88B52B2B043B326F9CD78246223A8205";
        testData.OrderId = $"TEST{DateTime.Now:yyyyMMddHHmmss}";
        testData.Amount = 1.000m;
        testData.Currency = "OMR";
        testData.RedirectUrl = "http://localhost:5212/payment-success";
        testData.CancelUrl = "http://localhost:5212/payment-cancel";
        testData.BillingEmail = "test@example.com";
        testData.BillingCountry = "Oman";
        testData.BillingCity = "Muscat";
        testData.BillingState = "Muscat";
        testData.BillingAddress = "Test Address";
        testData.BillingZip = "12345";
        testData.BillingName = "Test Customer";
        testData.BillingTel = "+968 12345678";
        
        // Initialize encode/decode key with the same working key
        encodeDecodeKey = testData.WorkingKey;
    }

    private void SetEnvironment(bool sandbox)
    {
        isSandbox = sandbox;
        showGatewayForm = false; // Reset form when environment changes
    }

    private void SetSendMethod(bool postMethod)
    {
        usePostMethod = postMethod;
    }

    private async Task TestEncryption()
    {
        try
        {
            var requestString = GenerateRequestStringInternal();
            testResult = $"Original Request String:\n{requestString}\n\n";
            testResult += $"Working Key: {testData.WorkingKey}\n\n";
            
            var encryptedData = PaymentGatewayService.EncryptPaymentData(requestString, testData.WorkingKey);
            testResult += $"Encrypted Data:\n{encryptedData}\n\n";
            
            testResult += $"Encryption: SUCCESS ✅\n\n";
            
            var baseUrl = isSandbox ? "https://spayuattrns.bmtest.om/transaction.do" : "https://smartpaytrns.bankmuscat.com/transaction.do";
            testResult += $"Gateway URL: {baseUrl}?command=initiateTransaction\n";
            testResult += $"Access Code: {testData.AccessCode}\n";
            testResult += $"Encrypted Request Length: {encryptedData.Length} characters\n";
            
            Logger.LogInformation("Encryption test successful for Order ID: {OrderId}", testData.OrderId);
            
        }
        catch (Exception ex)
        {
            testResult = $"❌ Error: {ex.Message}\n\nStack Trace:\n{ex.StackTrace}";
            Logger.LogError(ex, "Encryption test failed");
        }
    }

    private async Task GenerateRequestString()
    {
        try
        {
            var requestString = GenerateRequestStringInternal();
            testResult = $"Generated Request String:\n{requestString}\n\n";
            testResult += "✅ Request string generated successfully!\n\n";
            testResult += "Parameters included:\n";
            
            var parameters = requestString.Split('&');
            foreach (var param in parameters)
            {
                testResult += $"  • {param}\n";
            }
        }
        catch (Exception ex)
        {
            testResult = $"❌ Error generating request string: {ex.Message}";
        }
    }

    private string GenerateRequestStringInternal()
    {
        var parameters = new List<string>();
        
        // Mandatory parameters
        parameters.Add($"merchant_id={Uri.EscapeDataString(testData.MerchantId)}");
        parameters.Add($"order_id={Uri.EscapeDataString(testData.OrderId)}");
