    private async Task SendToGateway()
    {
        try
        {
            var requestString = GenerateRequestStringInternal();
            encryptedData = PaymentGatewayService.EncryptPaymentData(requestString, testData.WorkingKey);
            
            // Complete gateway URL with command parameter
            var baseUrl = isSandbox ? 
                "https://spayuattrns.bmtest.om/transaction.do" : 
                "https://smartpaytrns.bankmuscat.com/transaction.do";
            
            gatewayUrl = $"{baseUrl}?command=initiateTransaction";
            
            testResult = $"🚀 Ready to send to gateway...\n\n";
            testResult += $"Method: {(usePostMethod ? "POST" : "GET")}\n";
            testResult += $"Gateway URL: {gatewayUrl}\n";
            testResult += $"Access Code: {testData.AccessCode}\n";
            testResult += $"Request String: {requestString}\n";
            testResult += $"Encrypted Data: {encryptedData}\n\n";
            
            if (usePostMethod)
            {
                testResult += "POST Method: Form will submit access_code and encRequest as form data.\n\n";
            }
            else
            {
                testResult += "GET Method: Parameters will be sent in URL query string.\n";
                testResult += $"Complete GET URL: {GetMethodUrl}\n\n";
            }
            
            testResult += "Form is ready below. Click 'Open SmartPay Gateway' to proceed.";
            
            showGatewayForm = true;
            
            Logger.LogInformation("Payment form prepared for Order ID: {OrderId} using {Method} method", 
                testData.OrderId, usePostMethod ? "POST" : "GET");
            
        }
        catch (Exception ex)
        {
            testResult = $"❌ Error sending to gateway: {ex.Message}";
            Logger.LogError(ex, "Failed to prepare gateway form");
        }
    }

    private async Task EncodeData()
    {
        try
        {
            if (string.IsNullOrEmpty(plainTextToEncode))
            {
                encodeDecodeResult = "❌ Error: Please enter plain text to encrypt.";
                return;
            }

            if (string.IsNullOrEmpty(encodeDecodeKey))
            {
                encodeDecodeResult = "❌ Error: Please enter working key for encryption.";
                return;
            }

            encodedResult = PaymentGatewayService.EncryptPaymentData(plainTextToEncode, encodeDecodeKey);
            
            encodeDecodeResult = $"✅ Encryption Successful!\n\n";
            encodeDecodeResult += $"Plain Text Length: {plainTextToEncode.Length} characters\n";
            encodeDecodeResult += $"Encrypted Length: {encodedResult.Length} characters\n";
            encodeDecodeResult += $"Working Key: {encodeDecodeKey}\n";
            encodeDecodeResult += $"Algorithm: AES-256-GCM with BouncyCastle\n\n";
            encodeDecodeResult += $"Plain Text:\n{plainTextToEncode}\n\n";
            encodeDecodeResult += $"Encrypted (HEX):\n{encodedResult}";
            
            Logger.LogInformation("Data encryption successful. Plain text length: {PlainLength}, Encrypted length: {EncLength}", 
                plainTextToEncode.Length, encodedResult.Length);
        }
        catch (Exception ex)
        {
            encodedResult = "";
            encodeDecodeResult = $"❌ Encryption Failed: {ex.Message}\n\n";
            encodeDecodeResult += $"Stack Trace:\n{ex.StackTrace}";
            Logger.LogError(ex, "Data encryption failed");
        }
    }

    private async Task DecodeData()
    {
        try
        {
            if (string.IsNullOrEmpty(encryptedTextToDecode))
            {
                encodeDecodeResult = "❌ Error: Please enter encrypted text to decrypt.";
                return;
            }

            if (string.IsNullOrEmpty(encodeDecodeKey))
            {
                encodeDecodeResult = "❌ Error: Please enter working key for decryption.";
                return;
            }

            decodedResult = PaymentGatewayService.DecryptPaymentData(encryptedTextToDecode, encodeDecodeKey);
            
            encodeDecodeResult = $"✅ Decryption Successful!\n\n";
            encodeDecodeResult += $"Encrypted Length: {encryptedTextToDecode.Length} characters\n";
            encodeDecodeResult += $"Decrypted Length: {decodedResult.Length} characters\n";
            encodeDecodeResult += $"Working Key: {encodeDecodeKey}\n";
            encodeDecodeResult += $"Algorithm: AES-256-GCM with BouncyCastle\n\n";
            encodeDecodeResult += $"Encrypted (HEX):\n{encryptedTextToDecode}\n\n";
            encodeDecodeResult += $"Decrypted Text:\n{decodedResult}";
            
            Logger.LogInformation("Data decryption successful. Encrypted length: {EncLength}, Decrypted length: {PlainLength}", 
                encryptedTextToDecode.Length, decodedResult.Length);
        }
        catch (Exception ex)
        {
            decodedResult = "";
            encodeDecodeResult = $"❌ Decryption Failed: {ex.Message}\n\n";
            encodeDecodeResult += $"Possible reasons:\n";
            encodeDecodeResult += $"- Incorrect working key\n";
            encodeDecodeResult += $"- Invalid encrypted data format\n";
            encodeDecodeResult += $"- Corrupted encrypted string\n\n";
            encodeDecodeResult += $"Stack Trace:\n{ex.StackTrace}";
            Logger.LogError(ex, "Data decryption failed");
        }
    }

