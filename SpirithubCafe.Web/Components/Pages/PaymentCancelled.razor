@page "/checkout/payment-cancelled"
@using SpirithubCafe.Application.Services
@using Microsoft.AspNetCore.Components
@inject IPaymentService PaymentService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
            <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
            </div>
            
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Payment Cancelled</h1>
            <p class="text-lg text-gray-600 mb-6">Your payment was cancelled. Don't worry, no charges have been made to your account.</p>
            
            @if (!string.IsNullOrEmpty(PaymentRef))
            {
                <div class="bg-gray-50 rounded-lg p-6 mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Payment Reference</h2>
                    <p class="text-sm text-gray-700">@PaymentRef</p>
                </div>
            }
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button @onclick="@(() => Navigation.NavigateTo("/checkout"))" 
                        class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
                    Try Payment Again
                </button>
                <button @onclick="@(() => Navigation.NavigateTo("/cart"))" 
                        class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors">
                    Back to Cart
                </button>
                <button @onclick="@(() => Navigation.NavigateTo("/"))" 
                        class="bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition-colors">
                    Continue Shopping
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? PaymentRef { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        // Update payment status to cancelled if reference is provided
        if (!string.IsNullOrEmpty(PaymentRef))
        {
            try
            {
                var callbackDto = new Application.DTOs.PaymentCallbackDto
                {
                    PaymentReference = PaymentRef,
                    Status = "Cancelled",
                    ErrorMessage = "Payment was cancelled by user"
                };
                
                await PaymentService.UpdatePaymentStatusAsync(PaymentRef, callbackDto);
            }
            catch (Exception)
            {
                // Log error but don't fail the page load
            }
        }
    }
}