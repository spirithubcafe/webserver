@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer

<PageTitle>@Localizer["Error"] - @Localizer["SiteTitle"]</PageTitle>

<h1 class="text-danger">@Localizer["Error"]</h1>
<h2 class="text-danger">@Localizer["UnhandledErrorOccurred"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>
    @Localizer["DevelopmentModeMessage"]
</p>
<p>
    <strong>@Localizer["DevelopmentModeWarning"]</strong>
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
