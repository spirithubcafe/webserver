@page "/Error"
@using System.Diagnostics
@inject TranslationLocalizer Localizer
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Localizer["Error"] - @Localizer["SiteTitle"]</PageTitle>

<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div class="text-center">
            <!-- Error Icon -->
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-6">
                <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
            </div>
            
            <!-- Error Title -->
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
                @Localizer["Error"]
            </h1>
            
            <!-- Error Message -->
            <h2 class="text-lg text-red-600 font-medium mb-6">
                @Localizer["UnhandledErrorOccurred"]
            </h2>
            
            @if (ShowRequestId)
            {
                <!-- Request ID Card -->
                <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
                    <div class="text-sm text-gray-600 mb-1">
                        <strong>@Localizer["RequestId"]:</strong>
                    </div>
                    <code class="text-xs bg-gray-100 px-2 py-1 rounded font-mono text-gray-800 break-all">
                        @RequestId
                    </code>
                </div>
            }
            
            <!-- Development Mode Warning -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-left">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-yellow-400 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-yellow-800 mb-2">
                            @Localizer["DevelopmentMode"]
                        </h3>
                        <div class="text-sm text-yellow-700 space-y-2">
                            <p>@Localizer["DevelopmentModeMessage"]</p>
                            <p class="font-semibold">@Localizer["DevelopmentModeWarning"]</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="mt-8 space-y-3">
                <button onclick="window.history.back()" 
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                    <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Go Back
                </button>
                
                <a href="/" 
                   class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-3 px-4 rounded-lg transition duration-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 inline-block text-center">
                    <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Return to Home
                </a>
            </div>
        </div>
    </div>
</div>

@code{
    private HttpContext? HttpContext => HttpContextAccessor.HttpContext;

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
