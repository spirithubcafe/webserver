    private bool IsEmptySubtitle(string subtitle)
    {
        // Check if subtitle is empty or contains only default localized text
        if (string.IsNullOrWhiteSpace(subtitle)) return true;
        
        // Check against common default values
        var defaultValues = new[] { 
            Localizer["DiscoverCoffeeCategories"], 
            Localizer["PerfectCoffeeExperience"], 
            Localizer["DiscoverPopularSelections"], 
            Localizer["StayUpdated"] 
        };
        
        return defaultValues.Any(defaultVal => string.Equals(subtitle, defaultVal, StringComparison.OrdinalIgnoreCase));
    }

