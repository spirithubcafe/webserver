@page "/decrypt-test"
@using SpirithubCafe.Application.Services
@inject IPaymentGatewayService PaymentGatewayService
@rendermode InteractiveServer

<div class="container mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold mb-4">Bank Muscat Decrypt Test</h2>
    
    <div class="mb-4">
        <label class="block text-sm font-semibold text-gray-700 mb-2">Encrypted Data:</label>
        <textarea @bind="encryptedData" rows="5" class="w-full px-3 py-2 border border-gray-300 rounded-md"></textarea>
    </div>
    
    <div class="mb-4">
        <label class="block text-sm font-semibold text-gray-700 mb-2">Working Key:</label>
        <input type="text" @bind="workingKey" class="w-full px-3 py-2 border border-gray-300 rounded-md" />
    </div>
    
    <button @onclick="DecryptData" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
        Decrypt
    </button>
    
    @if (!string.IsNullOrEmpty(decryptResult))
    {
        <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-lg">
            <h3 class="font-semibold mb-2">Decrypted Result:</h3>
            <pre class="text-sm overflow-auto whitespace-pre-wrap">@decryptResult</pre>
        </div>
    }
</div>

@code {
    private string encryptedData = "";
    private string workingKey = "841FEAE32609C3E892C4D0B1393A7ACC";
    private string decryptResult = "";

    private async Task DecryptData()
    {
        try
        {
            var decrypted = PaymentGatewayService.DecryptPaymentData(encryptedData, workingKey);
            decryptResult = decrypted;
        }
        catch (Exception ex)
        {
            decryptResult = $"Decryption failed: {ex.Message}";
        }
    }
}