@page "/admin/email-test"
@layout SpirithubCafe.Web.Components.Layout.AdminLayout
@using SpirithubCafe.Application.Services
@inject IEmailService EmailService

<PageTitle>Email Test - SpirithubCafe Admin</PageTitle>

<div class="max-w-4xl mx-auto py-8">
    <div class="bg-white rounded-lg shadow-lg p-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Email Service Test</h1>
        
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="mb-4 p-4 rounded-lg @(isSuccess ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                @statusMessage
            </div>
        }

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Test Email Address</label>
                <input @bind="testEmail" type="email" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                       placeholder="Enter email to test" />
            </div>

            <div class="flex flex-wrap gap-2">
                <button @onclick="SendWelcomeEmail" disabled="@isSending"
                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50">
                    @(isSending ? "Sending..." : "Send Welcome Email")
                </button>

                <button @onclick="SendContactEmail" disabled="@isSending"
                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50">
                    @(isSending ? "Sending..." : "Send Contact Notification")
                </button>

                <button @onclick="SendOrderEmail" disabled="@isSending"
                        class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50">
                    @(isSending ? "Sending..." : "Send Order Confirmation")
                </button>

                <button @onclick="SendNewsletterEmail" disabled="@isSending"
                        class="px-4 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 disabled:opacity-50">
                    @(isSending ? "Sending..." : "Send Newsletter Welcome")
                </button>
            </div>
        </div>

        <div class="mt-8">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Email Configuration</h2>
            <div class="bg-gray-50 p-4 rounded-lg">
                <p><strong>SMTP Server:</strong> @(Configuration["EmailSettings:SmtpServer"] ?? "Not configured")</p>
                <p><strong>SMTP Port:</strong> @(Configuration["EmailSettings:SmtpPort"] ?? "Not configured")</p>
                <p><strong>From Email:</strong> @(Configuration["EmailSettings:FromEmail"] ?? "Not configured")</p>
                <p><strong>SSL Enabled:</strong> @(Configuration["EmailSettings:EnableSsl"] ?? "Not configured")</p>
            </div>
        </div>
    </div>
</div>

@code {
    private string testEmail = "";
    private bool isSending = false;
    private string statusMessage = "";
    private bool isSuccess = false;

    [Inject] private IConfiguration Configuration { get; set; } = null!;

    private async Task SendWelcomeEmail()
    {
        await SendTestEmail("welcome");
    }

    private async Task SendContactEmail()
    {
        await SendTestEmail("contact");
    }

    private async Task SendOrderEmail()
    {
        await SendTestEmail("order");
    }

    private async Task SendNewsletterEmail()
    {
        await SendTestEmail("newsletter");
    }

    private async Task SendTestEmail(string emailType)
    {
        if (string.IsNullOrWhiteSpace(testEmail))
        {
            statusMessage = "Please enter a test email address.";
            isSuccess = false;
            return;
        }

        try
        {
            isSending = true;
            statusMessage = "";

            switch (emailType)
            {
                case "welcome":
                    await EmailService.SendConfirmationEmailAsync(testEmail, "http://localhost:5212/confirm-test");
                    statusMessage = "Welcome email sent successfully!";
                    break;

                case "contact":
                    await EmailService.SendContactFormEmailAsync(testEmail, "Test User", "General Inquiry", "This is a test contact message from the email system.");
                    statusMessage = "Contact notification sent successfully!";
                    break;

                case "order":
                    await EmailService.SendOrderConfirmationEmailAsync(testEmail, "TEST-001", 99.99m);
                    statusMessage = "Order confirmation sent successfully!";
                    break;

                case "newsletter":
                    await EmailService.SendWelcomeEmailAsync(testEmail, "Test User");
                    statusMessage = "Newsletter welcome email sent successfully!";
                    break;

                default:
                    statusMessage = "Unknown email type.";
                    isSuccess = false;
                    return;
            }

            isSuccess = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"Error sending email: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }
}