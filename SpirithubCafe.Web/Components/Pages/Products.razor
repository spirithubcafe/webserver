@page "/products"
@page "/products/{category?}"
@layout SpirithubCafe.Web.Components.Layout.MainLayout
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Components.Web
@inject CartService CartService
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@implements IDisposable

<PageTitle>@Localizer["Products"] - @Localizer["SiteTitle"]</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer["Products.MetaDescription"]" />
    <meta property="og:title" content="@Localizer["Products"] - @Localizer["SiteTitle"]" />
    <meta property="og:description" content="@Localizer["Products.MetaDescription"]" />
    <meta property="og:type" content="website" />
</HeadContent>

<!-- Toast Component -->
<Toast />

<!-- Quick View Modal -->
<ProductQuickViewModal Product="selectedProduct" IsVisible="isQuickViewVisible" OnClose="CloseQuickView" />

<!-- Hero Section -->
<section class="relative py-8" style="@GetHeroBackgroundStyle()">
    @* Remove overlay when custom background is set *@
    @if (shopBgType != "color" && shopBgType != "image")
    {
        <div class="absolute inset-0 bg-opacity-5"></div>
    }
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
                <h1 class="text-2xl md:text-3xl font-bold mb-4" style="color: @shopTitleTextColor">
                    @GetShopTitle()
                </h1>
                <p class="mx-auto" style="color: @shopSubtitleTextColor">
                    @GetShopSubtitle()
                </p>
            </div>
            
            <!-- Filter Toggle Button -->
            <button @onclick="ToggleFilters" 
                    class="flex-shrink-0 flex items-center gap-2 px-4 py-3 rounded-xl
                           bg-white/90 hover:bg-white border-2 border-gray-200 hover:border-amber-400
                           text-gray-700 hover:text-amber-600 font-medium
                           shadow-md hover:shadow-lg transition-all duration-300
                           focus:outline-none focus:ring-3 focus:ring-amber-100">
                @if (showFilters)
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <span class="hidden sm:inline">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "إخفاء الفلاتر" : "Hide Filters")</span>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                    </svg>
                    <span class="hidden sm:inline">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "إظهار الفلاتر" : "Show Filters")</span>
                }
            </button>
        </div>
     </div>
</section>

<!-- Simple & Minimal Filter Section -->
@if (showFilters)
{
    <section class="py-4 bg-white sticky top-20 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Loading Skeleton -->
            <div class="animate-pulse flex gap-2">
                <div class="h-10 bg-gray-200 rounded flex-1"></div>
                <div class="h-10 w-10 bg-gray-200 rounded md:w-48"></div>
                <div class="h-10 w-10 bg-gray-200 rounded md:w-40"></div>
            </div>
        }
        else
        {
            <!-- Mobile Filter Bar (single row) -->
            <div class="flex gap-2 md:hidden">
                <!-- Search -->
                <div class="relative flex-1">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <input
                        type="text"
                        @bind="searchQuery"
                        @oninput="OnSearchInputChange"
                        placeholder="@Localizer["Search"]"
                        class="w-full h-11 pl-9 pr-9 text-sm border border-gray-300 rounded-lg focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
                    />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button @onclick="ClearSearch" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Category Icon Button -->
                <button type="button" @onclick="OpenCategoryModal" @onclick:preventDefault="true"
                        class="relative h-11 w-11 flex-shrink-0 flex items-center justify-center border border-gray-300 rounded-lg bg-white hover:bg-gray-50 active:bg-gray-100 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    @if (!string.IsNullOrEmpty(selectedCategory))
                    {
                        <span class="absolute -top-1 -right-1 w-3 h-3 bg-amber-500 rounded-full border-2 border-white"></span>
                    }
                </button>

                <!-- Sort Icon Button -->
                <button type="button" @onclick="OpenSortModal" @onclick:preventDefault="true"
                        class="h-11 w-11 flex-shrink-0 flex items-center justify-center border border-gray-300 rounded-lg bg-white hover:bg-gray-50 active:bg-gray-100 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-colors">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
                    </svg>
                </button>
            </div>

            <!-- Desktop Filter Bar -->
            <div class="hidden md:flex gap-3">
                <!-- Search -->
                <div class="relative flex-1">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <input
                        type="text"
                        @bind="searchQuery"
                        @oninput="OnSearchInputChange"
                        placeholder="@Localizer["Search"]"
                        class="w-full h-10 pl-10 pr-10 border border-gray-300 rounded-lg focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
                    />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button @onclick="ClearSearch" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Category -->
                <div class="relative">
                    <select @bind="selectedCategory" @bind:event="onchange"
                            class="h-10 pl-3 pr-10 border border-gray-300 rounded-lg appearance-none bg-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 min-w-[200px]">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Name">@GetCategoryName(cat)</option>
                        }
                    </select>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>

                <!-- Sort -->
                <div class="relative">
                    <select @bind="sortOption" @bind:event="onchange"
                            class="h-10 pl-3 pr-10 border border-gray-300 rounded-lg appearance-none bg-white focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 min-w-[160px]">
                        <option value="name">@Localizer["NameAZ"]</option>
                        <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                        <option value="price-high">@Localizer["PriceHighToLow"]</option>
                        <option value="popular">@Localizer["MostPopular"]</option>
                        <option value="newest">@Localizer["Newest"]</option>
                    </select>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </div>
            </div>
        }
    </div>
</section>
}

<!-- Category Modal (Mobile) -->
@if (showCategoryModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" @onclick="CloseCategoryModal">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <!-- Modal panel -->
            <div class="inline-block align-bottom bg-white rounded-t-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:rounded-2xl"
                 @onclick:stopPropagation="true">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-gray-900">
                            @Localizer["Categories"]
                        </h3>
                        <button type="button" @onclick="CloseCategoryModal" @onclick:stopPropagation="true" class="text-gray-400 hover:text-gray-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    
                    <div class="space-y-2 max-h-96 overflow-y-auto">
                        <button type="button" @onclick="() => SelectCategory(string.Empty)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(string.IsNullOrEmpty(selectedCategory) ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["AllCategories"]
                        </button>
                        @foreach (var cat in categories)
                        {
                            var categoryName = cat.Name;
                            <button type="button" @onclick="() => SelectCategory(categoryName)" @onclick:stopPropagation="true"
                                    class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(selectedCategory == categoryName ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                                @GetCategoryName(cat)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Sort Modal (Mobile) -->
@if (showSortModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" @onclick="CloseSortModal">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <!-- Modal panel -->
            <div class="inline-block align-bottom bg-white rounded-t-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:rounded-2xl"
                 @onclick:stopPropagation="true">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-semibold text-gray-900">
                            @Localizer["SortBy"]
                        </h3>
                        <button type="button" @onclick="CloseSortModal" @onclick:stopPropagation="true" class="text-gray-400 hover:text-gray-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    
                    <div class="space-y-2">
                        <button type="button" @onclick="() => SelectSort(sortName)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(sortOption == "name" ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["NameAZ"]
                        </button>
                        <button type="button" @onclick="() => SelectSort(sortPriceLow)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(sortOption == "price-low" ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["PriceLowToHigh"]
                        </button>
                        <button type="button" @onclick="() => SelectSort(sortPriceHigh)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(sortOption == "price-high" ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["PriceHighToLow"]
                        </button>
                        <button type="button" @onclick="() => SelectSort(sortPopular)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(sortOption == "popular" ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["MostPopular"]
                        </button>
                        <button type="button" @onclick="() => SelectSort(sortNewest)" @onclick:stopPropagation="true"
                                class="w-full text-left px-4 py-3 rounded-lg hover:bg-gray-50 transition-colors @(sortOption == "newest" ? "bg-amber-50 text-amber-700 font-semibold" : "text-gray-700")">
                            @Localizer["Newest"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Products Grid -->
<section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Simple Loading Skeleton -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                        <!-- Image Skeleton -->
                        <div class="aspect-square bg-gray-200"></div>
                        
                        <!-- Content Skeleton -->
                        <div class="p-4 space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                            <div class="h-6 bg-gray-200 rounded w-1/3"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (filteredProducts is not null && filteredProducts.Any())
        {
            <!-- Results Count -->
            <div class="mb-8">
                <p class="text-gray-600">
                    @Localizer["Showing"] @(filteredProducts.Count()) @Localizer["Of"] @(allProducts?.Count() ?? 0) @Localizer["Products"]
                </p>
            </div>
            
            <!-- Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @foreach (var product in filteredProducts)
                {
                    <div class="bg-white rounded-lg sm:rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col relative">
                        <!-- Product Image -->
                        <div class="block relative aspect-square bg-gradient-to-br from-stone-50 to-stone-100">
                            <a href="/product/@product.Slug" class="absolute inset-0 z-0">
                                @if (product.MainImage?.ImagePath != null)
                                {
                                    <img 
                                        src="@product.MainImage.ImagePath" 
                                        alt="@product.Name"
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg class="w-20 h-20 text-stone-400" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                                        </svg>
                                    </div>
                                }
                            </a>
                            
                            @{
                                var badgeVariant = product.Variants?
                                    .Where(v => v.DiscountPrice.HasValue && v.DiscountPrice.Value > 0 && v.DiscountPrice.Value < v.Price)
                                    .FirstOrDefault() 
                                ?? product.Variants?.FirstOrDefault(v => v.IsDefault) 
                                ?? product.Variants?.FirstOrDefault();
                                var badgePrice = badgeVariant?.Price ?? 0;
                                var badgeDiscountPrice = badgeVariant?.DiscountPrice ?? 0;
                                var badgeHasDiscount = badgeDiscountPrice > 0 && badgeDiscountPrice < badgePrice;
                                var badgeDiscountPercent = badgeHasDiscount ? Math.Round((badgePrice - badgeDiscountPrice) / badgePrice * 100) : 0;
                            }
                            
                            <!-- Discount Badge (Top Right) -->
                            @if (badgeHasDiscount)
                            {
                                <div class="absolute top-3 right-3 z-20">
                                    <div class="bg-red-600 text-white px-2.5 py-1 rounded-lg shadow-lg text-xs sm:text-sm font-bold">
                                        @badgeDiscountPercent% OFF
                                    </div>
                                </div>
                            }
                            
                            <!-- Quick Action Buttons -->
                            <div class="absolute top-4 left-0 right-0 flex justify-between w-full px-4 z-30">
                                <!-- Quick View Button (Left) -->
                                <button 
                                    @onclick="() => ShowQuickView(product.Id)"
                                    class="bg-white bg-opacity-90 hover:bg-opacity-100 rounded-full p-2 shadow-lg transition-all duration-200 hover:scale-110"
                                    title="@Localizer["QuickView"]"
                                >
                                    <svg class="w-5 h-5 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </button>
                                
 
                            </div>
                        </div>
                        
                        <!-- Product Info -->
                        <div class="p-3 sm:p-4 flex flex-col h-full">
                            <div class="flex-grow">
                                <div class="flex items-start justify-between mb-2">
                                    <a href="/product/@product.Slug" class="hover:text-stone-700 transition-colors cursor-pointer block">
                                        <h3 class="text-sm sm:text-base font-semibold text-gray-900 line-clamp-2 leading-tight">@GetProductName(product)</h3>
                                    </a>
                                </div>
                                
                                <!-- Tasting Notes -->
                                @{
                                    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                    var tastingNotes = currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(product.TastingNotesAr) 
                                        ? product.TastingNotesAr 
                                        : product.TastingNotes;
                                }
                                @if (!string.IsNullOrEmpty(tastingNotes))
                                {
                                    <p class="text-xs text-stone-600 mb-2 line-clamp-2 leading-tight">@tastingNotes</p>
                                }
                                
                                <!-- Price -->
                                <div class="mb-3">
                                    @{
                                        var variant = product.Variants?
                                            .Where(v => v.DiscountPrice.HasValue && v.DiscountPrice.Value > 0 && v.DiscountPrice.Value < v.Price)
                                            .FirstOrDefault() 
                                        ?? product.Variants?.FirstOrDefault(v => v.IsDefault) 
                                        ?? product.Variants?.FirstOrDefault();
                                        
                                        var price = variant?.Price ?? 0;
                                        var discountPrice = variant?.DiscountPrice ?? 0;
                                        var hasDiscount = discountPrice > 0 && discountPrice < price;
                                    }
                                    
                                    @if (hasDiscount)
                                    {
                                        <div class="space-y-1">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-base sm:text-lg font-bold text-red-600">
                                                    @discountPrice.ToString("0.000") <span class="text-xs">OMR</span>
                                                </span>
                                                <span class="text-xs sm:text-sm text-gray-400 line-through">
                                                    @price.ToString("0.000")
                                                </span>
                                            </div>
                                            @{
                                                var discountPercentage = ((price - discountPrice) / price * 100);
                                            }
                                            <span class="inline-block bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-semibold">
                                                @discountPercentage.ToString("0")% OFF
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-base sm:text-lg font-bold text-gray-900">
                                            @price.ToString("0.000") <span class="text-xs">OMR</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <!-- Buttons at bottom -->
                            <div class="mt-auto space-y-2">
                                <!-- Quantity Selector and Add to Cart -->
                                <div class="flex items-stretch space-x-2">
                                    <div class="flex items-center border border-gray-300 rounded-lg h-9">
                                        <button 
                                            @onclick="@(() => DecreaseQuantity(product.Id))"
                                            class="px-2.5 h-full hover:bg-gray-100 transition-colors flex items-center justify-center"
                                            disabled="@(GetQuantity(product.Id) <= 1)"
                                        >
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                            </svg>
                                        </button>
                                        <span class="px-3 h-full font-medium text-sm min-w-[2rem] text-center flex items-center justify-center">@GetQuantity(product.Id)</span>
                                        <button 
                                            @onclick="@(() => IncreaseQuantity(product.Id))"
                                            class="px-2.5 h-full hover:bg-gray-100 transition-colors flex items-center justify-center"
                                        >
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
