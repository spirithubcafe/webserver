@page "/products"
@page "/products/{category?}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout SpirithubCafe.Web.Components.Layout.PublicLayout
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Components.Web
@inject CartService CartService
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Products - SpirithubCafe</PageTitle>

<!-- Toast Component -->
<Toast />

<!-- Quick View Modal -->
<ProductQuickViewModal Product="selectedProduct" IsVisible="isQuickViewVisible" OnClose="CloseQuickView" />

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-stone-50 to-stone-100 py-16">
    <div class="absolute inset-0 bg-black bg-opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                Premium <span class="text-stone-600">Coffee</span> Collection
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Discover our carefully curated selection of single-origin beans and signature blends from around the world.
            </p>
        </div>
    </div>
</section>

<!-- Filters and Search -->
<section class="py-4 bg-white border-b border-gray-200 sticky top-20 z-40 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Loading Skeleton for Filters -->
            <div class="space-y-4">
                <!-- Mobile Search Skeleton -->
                <div class="lg:hidden">
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                </div>
                
                <!-- Desktop Layout Skeleton -->
                <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-6 mb-0">
                    <div class="flex-1 max-w-md">
                        <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="h-4 bg-gray-300 rounded w-16 animate-pulse"></div>
                        <div class="h-12 bg-gray-300 rounded-xl w-48 animate-pulse"></div>
                        <div class="h-4 bg-gray-300 rounded w-12 animate-pulse"></div>
                        <div class="h-12 bg-gray-300 rounded-xl w-32 animate-pulse"></div>
                    </div>
                </div>
                
                <!-- Mobile Filters Skeleton -->
                <div class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                </div>
            </div>
        }
        else
        {
            <!-- Mobile-First Responsive Layout -->
            <div class="space-y-4">
                <!-- Mobile Search Bar (Always Visible) -->
                <div class="lg:hidden">
                    <div class="relative">
                        <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input
                            type="text"
                            @bind="searchQuery"
                            @bind:event="oninput"
                            placeholder="@Localizer["SearchCoffee"]"
                            class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 text-sm placeholder-gray-500"
                        />
                    </div>
                </div>

                <!-- Desktop Layout -->
                <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-6 mb-0">
                    <!-- Desktop Search Bar -->
                    <div class="flex-1 max-w-md">
                        <div class="relative">
                            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            <input
                                type="text"
                                @bind="searchQuery"
                                @bind:event="oninput"
                                placeholder="@Localizer["SearchCoffee"]"
                                class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 placeholder-gray-500"
                            />
                        </div>
                    </div>
                    
                    <!-- Desktop Filters -->
                    <div class="flex items-center gap-6">
                        <!-- Category Filter -->
                        <div class="flex items-center gap-3">
                            <label class="text-sm font-semibold text-gray-700 whitespace-nowrap">@Localizer["Category"]</label>
                            <div class="relative">
                                <select @bind="selectedCategory" class="appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 min-w-[12rem] text-sm font-medium">
                                    <option value="">@Localizer["AllCategories"]</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Name">@GetCategoryName(cat)</option>
                                    }
                                </select>
                                <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                        
                        <!-- Sort Options -->
                        <div class="flex items-center gap-3">
                            <label class="text-sm font-semibold text-gray-700 whitespace-nowrap">@Localizer["SortBy"]</label>
                            <div class="relative">
                                <select @bind="sortOption" class="appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 text-sm font-medium">
                                    <option value="name">@Localizer["NameAZ"]</option>
                                    <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                    <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                    <option value="popular">@Localizer["MostPopular"]</option>
                                </select>
                                <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Filters -->
                <div class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- Mobile Category Filter -->
                    <div class="relative">
                        <label class="block text-xs font-semibold text-gray-600 mb-2">@Localizer["Category"]</label>
                        <div class="relative">
                            <select @bind="selectedCategory" class="appearance-none w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 text-sm font-medium">
                                <option value="">@Localizer["AllCategories"]</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Name">@GetCategoryName(cat)</option>
                                }
                            </select>
                            <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    
                    <!-- Mobile Sort Options -->
                    <div class="relative">
                        <label class="block text-xs font-semibold text-gray-600 mb-2">@Localizer["SortBy"]</label>
                        <div class="relative">
                            <select @bind="sortOption" class="appearance-none w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:bg-white transition-all duration-200 text-sm font-medium">
                                <option value="name">@Localizer["NameAZ"]</option>
                                <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                <option value="popular">@Localizer["MostPopular"]</option>
                            </select>
                            <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Active Filters -->
        @if (!isLoading && (!string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(searchQuery)))
        {
            <div class="mt-4 bg-amber-50 rounded-xl p-4 border border-amber-100">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm font-semibold text-amber-800 flex items-center">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                            </svg>
                            @Localizer["ActiveFilters"]
                        </span>
                        
                        @if (!string.IsNullOrEmpty(selectedCategory))
                        {
                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs sm:text-sm bg-white border border-amber-200 text-amber-900 font-medium shadow-sm">
                                <svg class="w-3 h-3 mr-1.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                @GetCategoryDisplayName(selectedCategory)
                                <button @onclick="ClearCategoryFilter" class="ml-2 p-0.5 hover:bg-amber-100 rounded-full transition-colors duration-150">
                                    <svg class="w-3 h-3 text-amber-700 hover:text-amber-900" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }
                        
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs sm:text-sm bg-white border border-amber-200 text-amber-900 font-medium shadow-sm">
                                <svg class="w-3 h-3 mr-1.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <span class="max-w-[100px] sm:max-w-[200px] truncate">"@searchQuery"</span>
                                <button @onclick="ClearSearch" class="ml-2 p-0.5 hover:bg-amber-100 rounded-full transition-colors duration-150">
                                    <svg class="w-3 h-3 text-amber-700 hover:text-amber-900" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }
                    </div>
                    
                    <button @onclick="ClearAllFilters" class="inline-flex items-center px-4 py-2 text-xs sm:text-sm font-semibold text-amber-700 bg-white border border-amber-300 rounded-lg hover:bg-amber-50 hover:text-amber-800 transition-all duration-200 shadow-sm">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        @Localizer["ClearAll"]
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<!-- Products Grid -->
<section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Loading Skeleton -->
            <div class="mb-8">
                <div class="h-6 bg-gray-300 rounded-md w-48 animate-pulse"></div>
            </div>
            
            <!-- Products Grid Skeleton -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @for (int i = 0; i < 12; i++)
                {
                    <div class="bg-white rounded-lg sm:rounded-xl shadow-md overflow-hidden animate-pulse">
                        <!-- Image Skeleton -->
                        <div class="aspect-square bg-gray-300"></div>
                        
                        <!-- Content Skeleton -->
                        <div class="p-3 sm:p-4 md:p-6 space-y-2 sm:space-y-3 md:space-y-4">
                            <!-- Title -->
                            <div class="space-y-2">
                                <div class="h-5 bg-gray-300 rounded w-3/4"></div>
                                <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                            </div>
                            
                            <!-- Price -->
                            <div class="h-6 bg-gray-300 rounded w-1/3"></div>
                            
                            <!-- Buttons -->
                            <div class="space-y-3 pt-4">
                                <div class="flex items-center space-x-3">
                                    <div class="h-10 bg-gray-300 rounded-lg w-32"></div>
                                    <div class="h-10 bg-gray-300 rounded-lg flex-1"></div>
                                </div>
                                <div class="h-10 bg-gray-300 rounded-lg w-full"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (filteredProducts is not null && filteredProducts.Any())
        {
            <!-- Results Count -->
            <div class="mb-8">
                <p class="text-gray-600">
                    @Localizer["Showing"] @(filteredProducts.Count()) @Localizer["Of"] @(allProducts?.Count() ?? 0) @Localizer["Products"]
                </p>
            </div>
            
            <!-- Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @foreach (var product in filteredProducts)
                {
                    <div class="bg-white rounded-lg sm:rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col relative">
                        <!-- Product Image -->
                        <div @onclick="() => NavigateToProduct(product.Id)" class="block relative aspect-square bg-gradient-to-br from-stone-50 to-stone-100 cursor-pointer">
                            @if (product.GalleryImages?.Any() == true)
                            {
                                <img 
                                    src="@product.GalleryImages.First().ImagePath" 
                                    alt="@product.Name"
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg class="w-20 h-20 text-stone-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                                    </svg>
                                </div>
                            }
                            
                            <!-- Quick Action Buttons -->
                            <div class="absolute top-4 left-0 right-0 flex justify-between w-full px-4 z-10">
                                <!-- Quick View Button (Left) -->
                                <button 
                                    @onclick="() => ShowQuickView(product.Id)"
                                    @onclick:stopPropagation="true"
                                    class="bg-white bg-opacity-90 hover:bg-opacity-100 rounded-full p-2 shadow-lg transition-all duration-200 hover:scale-110"
                                    title="Quick view"
                                >
                                    <svg class="w-5 h-5 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </button>
                                
                                <!-- Quick Add Button (Right) -->
                                <button 
                                    @onclick="() => QuickAddToCart(product.Id)"
                                    @onclick:stopPropagation="true"
                                    class="bg-white bg-opacity-90 hover:bg-opacity-100 rounded-full p-2 shadow-lg transition-all duration-200 hover:scale-110"
                                    title="Quick add to cart"
                                >

                                                <svg class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none">
                <path
                    d="M7.5 18C8.32843 18 9 18.6716 9 19.5C9 20.3284 8.32843 21 7.5 21C6.67157 21 6 20.3284 6 19.5C6 18.6716 6.67157 18 7.5 18Z"
                    stroke="currentColor" stroke-width="1.5" />
                <path
                    d="M16.5 18.0001C17.3284 18.0001 18 18.6716 18 19.5001C18 20.3285 17.3284 21.0001 16.5 21.0001C15.6716 21.0001 15 20.3285 15 19.5001C15 18.6716 15.6716 18.0001 16.5 18.0001Z"
                    stroke="currentColor" stroke-width="1.5" />
                <path
                    d="M2.26121 3.09184L2.50997 2.38429H2.50997L2.26121 3.09184ZM2.24876 2.29246C1.85799 2.15507 1.42984 2.36048 1.29246 2.75124C1.15507 3.14201 1.36048 3.57016 1.75124 3.70754L2.24876 2.29246ZM4.58584 4.32298L5.20507 3.89983V3.89983L4.58584 4.32298ZM5.88772 14.5862L5.34345 15.1022H5.34345L5.88772 14.5862ZM20.6578 9.88275L21.3923 10.0342L21.3933 10.0296L20.6578 9.88275ZM20.158 12.3075L20.8926 12.4589L20.158 12.3075ZM20.7345 6.69708L20.1401 7.15439L20.7345 6.69708ZM19.1336 15.0504L18.6598 14.469L19.1336 15.0504ZM5.70808 9.76V7.03836H4.20808V9.76H5.70808ZM2.50997 2.38429L2.24876 2.29246L1.75124 3.70754L2.01245 3.79938L2.50997 2.38429ZM10.9375 16.25H16.2404V14.75H10.9375V16.25ZM5.70808 7.03836C5.70808 6.3312 5.7091 5.7411 5.65719 5.26157C5.60346 4.76519 5.48705 4.31247 5.20507 3.89983L3.96661 4.74613C4.05687 4.87822 4.12657 5.05964 4.1659 5.42299C4.20706 5.8032 4.20808 6.29841 4.20808 7.03836H5.70808ZM2.01245 3.79938C2.68006 4.0341 3.11881 4.18965 3.44166 4.34806C3.74488 4.49684 3.87855 4.61727 3.96661 4.74613L5.20507 3.89983C4.92089 3.48397 4.54304 3.21763 4.10241 3.00143C3.68139 2.79485 3.14395 2.60719 2.50997 2.38429L2.01245 3.79938ZM4.20808 9.76C4.20808 11.2125 4.22171 12.2599 4.35876 13.0601C4.50508 13.9144 4.79722 14.5261 5.34345 15.1022L6.43198 14.0702C6.11182 13.7325 5.93913 13.4018 5.83723 12.8069C5.72607 12.1578 5.70808 11.249 5.70808 9.76H4.20808ZM10.9375 14.75C9.52069 14.75 8.53763 14.7482 7.79696 14.6432C7.08215 14.5418 6.70452 14.3576 6.43198 14.0702L5.34345 15.1022C5.93731 15.7286 6.69012 16.0013 7.58636 16.1283C8.45674 16.2518 9.56535 16.25 10.9375 16.25V14.75ZM4.95808 6.87H17.0888V5.37H4.95808V6.87ZM19.9232 9.73135L19.4235 12.1561L20.8926 12.4589L21.3923 10.0342L19.9232 9.73135ZM17.0888 6.87C17.9452 6.87 18.6989 6.871 19.2937 6.93749C19.5893 6.97053 19.8105 7.01643 19.9659 7.07105C20.1273 7.12776 20.153 7.17127 20.1401 7.15439L21.329 6.23978C21.094 5.93436 20.7636 5.76145 20.4632 5.65587C20.1567 5.54818 19.8101 5.48587 19.4604 5.44678C18.7646 5.369 17.9174 5.37 17.0888 5.37V6.87ZM21.3933 10.0296C21.5625 9.18167 21.7062 8.47024 21.7414 7.90038C21.7775 7.31418 21.7108 6.73617 21.329 6.23978L20.1401 7.15439C20.2021 7.23508 20.2706 7.38037 20.2442 7.80797C20.2168 8.25191 20.1002 8.84478 19.9223 9.73595L21.3933 10.0296ZM16.2404 16.25C17.0021 16.25 17.6413 16.2513 18.1566 16.1882C18.6923 16.1227 19.1809 15.9794 19.6074 15.6318L18.6598 14.469C18.5346 14.571 18.3571 14.6525 17.9744 14.6994C17.5712 14.7487 17.0397 14.75 16.2404 14.75V16.25ZM19.4235 12.1561C19.2621 12.9389 19.1535 13.4593 19.0238 13.8442C18.9007 14.2095 18.785 14.367 18.6598 14.469L19.6074 15.6318C20.0339 15.2842 20.2729 14.8346 20.4453 14.3232C20.6111 13.8312 20.7388 13.2049 20.8926 12.4589L19.4235 12.1561Z"
                    fill="currentColor" />
            </svg>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Product Info -->
                        <div class="p-3 sm:p-4 md:p-6 flex flex-col h-full">
                            <div class="flex-grow">
                                <div class="flex items-start justify-between mb-2">
                                    <div @onclick="() => NavigateToProduct(product.Id)" class="hover:text-stone-700 transition-colors cursor-pointer">
