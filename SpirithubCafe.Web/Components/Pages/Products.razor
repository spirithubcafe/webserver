@page "/products"
@page "/products/{category?}"
@layout SpirithubCafe.Web.Components.Layout.PublicLayout
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Components.Web
@inject CartService CartService
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@implements IDisposable

<PageTitle>@Localizer["Products"] - @Localizer["SiteTitle"]</PageTitle>

<!-- Toast Component -->
<Toast />

<!-- Quick View Modal -->
<ProductQuickViewModal Product="selectedProduct" IsVisible="isQuickViewVisible" OnClose="CloseQuickView" />

<!-- Hero Section -->
<section class="relative py-8" style="@GetHeroBackgroundStyle()">
    @* Remove overlay when custom background is set *@
    @if (shopBgType != "color" && shopBgType != "image")
    {
        <div class="absolute inset-0 bg-opacity-5"></div>
    }
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
             <h1 class="text-2xl md:text-3xl font-bold mb-4" style="color: @shopTitleTextColor">
                @GetShopTitle()
            </h1>
            <p class="mx-auto" style="color: @shopSubtitleTextColor">
                @GetShopSubtitle()
            </p>
     </div>
</section>

<!-- Filters and Search -->
<section class="py-4 bg-white border-b border-gray-200 lg:sticky lg:top-20 lg:z-40 lg:backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Loading Skeleton for Filters -->
            <div class="space-y-4">
                <!-- Mobile Search Skeleton -->
                <div class="lg:hidden">
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                </div>
                
                <!-- Desktop Layout Skeleton -->
                <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-6 mb-0">
                    <div class="flex-1 max-w-md">
                        <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="h-4 bg-gray-300 rounded w-16 animate-pulse"></div>
                        <div class="h-12 bg-gray-300 rounded-xl w-48 animate-pulse"></div>
                        <div class="h-4 bg-gray-300 rounded w-12 animate-pulse"></div>
                        <div class="h-12 bg-gray-300 rounded-xl w-32 animate-pulse"></div>
                    </div>
                </div>
                
                <!-- Mobile Filters Skeleton -->
                <div class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                    <div class="h-12 bg-gray-300 rounded-xl animate-pulse"></div>
                </div>
            </div>
        }
        else
        {
            <!-- Mobile-First Responsive Layout -->
            <div class="space-y-4">
                <!-- Mobile Search Bar (Always Visible) -->
                <div class="lg:hidden">
                    <div class="relative">
                        <svg class="absolute ltr:left-4 rtl:right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input
                            type="text"
                            @bind="searchQuery"
                            @bind:event="oninput"
                            placeholder="@Localizer["SearchCoffee"]"
                            class="w-full ltr:pl-12 ltr:pr-4 rtl:pr-12 rtl:pl-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 text-sm placeholder-gray-500"
                        />
                    </div>
                </div>

                <!-- Desktop Layout -->
                <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-6 mb-0">
                    <!-- Desktop Search Bar -->
                    <div class="flex-1 max-w-md">
                        <div class="relative">
                            <svg class="absolute ltr:left-4 rtl:right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            <input
                                type="text"
                                @bind="searchQuery"
                                @bind:event="oninput"
                                placeholder="@Localizer["SearchCoffee"]"
                                class="w-full ltr:pl-12 ltr:pr-4 rtl:pr-12 rtl:pl-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 placeholder-gray-500"
                            />
                        </div>
                    </div>
                    
                    <!-- Desktop Filters -->
                    <div class="flex items-center gap-6">
                        <!-- Category Filter -->
                        <div class="flex items-center gap-3">
                            <label class="text-sm font-semibold text-gray-700 whitespace-nowrap">@Localizer["Category"]</label>
                            <div class="relative">
                                <select @bind="selectedCategory" class="appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 ltr:pr-10 rtl:pl-10 focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 min-w-[12rem] text-sm font-medium">
                                    <option value="">@Localizer["AllCategories"]</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Name">@GetCategoryName(cat)</option>
                                    }
                                </select>
                                <svg class="absolute ltr:right-3 rtl:left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                        
                        <!-- Sort Options -->
                        <div class="flex items-center gap-3">
                            <label class="text-sm font-semibold text-gray-700 whitespace-nowrap">@Localizer["SortBy"]</label>
                            <div class="relative">
                                <select @bind="sortOption" class="appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 ltr:pr-10 rtl:pl-10 focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 text-sm font-medium">
                                    <option value="name">@Localizer["NameAZ"]</option>
                                    <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                    <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                    <option value="popular">@Localizer["MostPopular"]</option>
                                </select>
                                <svg class="absolute ltr:right-3 rtl:left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Filters -->
                <div class="lg:hidden grid grid-cols-2 gap-3">
                    <!-- Mobile Category Filter -->
                    <div class="relative">
                        <label class="block text-xs font-semibold text-gray-600 mb-2">@Localizer["Category"]</label>
                        <div class="relative">
                            <select @bind="selectedCategory" class="appearance-none w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 ltr:pr-10 rtl:pl-10 focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 text-sm font-medium">
                                <option value="">@Localizer["AllCategories"]</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Name">@GetCategoryName(cat)</option>
                                }
                            </select>
                            <svg class="absolute ltr:right-3 rtl:left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    
                    <!-- Mobile Sort Options -->
                    <div class="relative">
                        <label class="block text-xs font-semibold text-gray-600 mb-2">@Localizer["SortBy"]</label>
                        <div class="relative">
                            <select @bind="sortOption" class="appearance-none w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 ltr:pr-10 rtl:pl-10 focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A] focus:bg-white transition-all duration-200 text-sm font-medium">
                                <option value="name">@Localizer["NameAZ"]</option>
                                <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                <option value="popular">@Localizer["MostPopular"]</option>
                            </select>
                            <svg class="absolute ltr:right-3 rtl:left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        <!-- Active Filters -->
        @if (!isLoading && (!string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(searchQuery)))
        {
            <div class="mt-4 bg-amber-50 rounded-xl p-4 border border-[#D3DAD9]">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm font-semibold text-[#44444E] flex items-center">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                            </svg>
                            @Localizer["ActiveFilters"]
                        </span>
                        
                        @if (!string.IsNullOrEmpty(selectedCategory))
                        {
                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs sm:text-sm bg-white border border-[#D3DAD9] text-amber-900 font-medium shadow-sm">
                                <svg class="w-3 h-3 mr-1.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                @GetCategoryDisplayName(selectedCategory)
                                <button @onclick="ClearCategoryFilter" class="ml-2 p-0.5 hover:bg-amber-100 rounded-full transition-colors duration-150">
                                    <svg class="w-3 h-3 text-amber-700 hover:text-[#37353E]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }
                        
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs sm:text-sm bg-white border border-[#D3DAD9] text-amber-900 font-medium shadow-sm">
                                <svg class="w-3 h-3 mr-1.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <span class="max-w-[100px] sm:max-w-[200px] truncate">"@searchQuery"</span>
                                <button @onclick="ClearSearch" class="ml-2 p-0.5 hover:bg-amber-100 rounded-full transition-colors duration-150">
                                    <svg class="w-3 h-3 text-amber-700 hover:text-[#37353E]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }
                    </div>
                    
                    <button @onclick="ClearAllFilters" class="inline-flex items-center px-4 py-2 text-xs sm:text-sm font-semibold text-amber-700 bg-white border border-[#715A5A] rounded-lg hover:bg-amber-50 hover:text-[#44444E] transition-all duration-200 shadow-sm">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        @Localizer["ClearAll"]
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<!-- Products Grid -->
<section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Simple Loading Skeleton -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                        <!-- Image Skeleton -->
                        <div class="aspect-square bg-gray-200"></div>
                        
                        <!-- Content Skeleton -->
                        <div class="p-4 space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                            <div class="h-6 bg-gray-200 rounded w-1/3"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (filteredProducts is not null && filteredProducts.Any())
        {
            <!-- Results Count -->
            <div class="mb-8">
                <p class="text-gray-600">
                    @Localizer["Showing"] @(filteredProducts.Count()) @Localizer["Of"] @(allProducts?.Count() ?? 0) @Localizer["Products"]
                </p>
            </div>
            
            <!-- Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @foreach (var product in filteredProducts)
                {
                    <div class="bg-white rounded-lg sm:rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col relative">
                        <!-- Product Image -->
                        <a href="/product/@product.Slug" class="block relative aspect-square bg-gradient-to-br from-stone-50 to-stone-100 cursor-pointer">
                            @if (product.GalleryImages?.Any() == true)
                            {
                                <img 
                                    src="@product.GalleryImages.First().ImagePath" 
                                    alt="@product.Name"
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg class="w-20 h-20 text-stone-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                                    </svg>
                                </div>
                            }
                            
                            @{
                                var badgeVariant = product.Variants?.FirstOrDefault();
                                var badgePrice = badgeVariant?.Price ?? 0;
                                var badgeDiscountPrice = badgeVariant?.DiscountPrice ?? 0;
                                var badgeHasDiscount = badgeDiscountPrice > 0 && badgeDiscountPrice < badgePrice;
                                var badgeDiscountPercent = badgeHasDiscount ? Math.Round((badgePrice - badgeDiscountPrice) / badgePrice * 100) : 0;
                            }
                            
                            <!-- Discount Badge (Top Right) -->
                            @if (badgeHasDiscount)
                            {
                                <div class="absolute top-3 right-3 z-20">
                                    <div class="bg-red-600 text-white px-2.5 py-1 rounded-lg shadow-lg text-xs sm:text-sm font-bold">
                                        @badgeDiscountPercent% OFF
                                    </div>
                                </div>
                            }
                            
                            <!-- Quick Action Buttons -->
                            <div class="absolute top-4 left-0 right-0 flex justify-between w-full px-4 z-10">
                                <!-- Quick View Button (Left) -->
                                <button 
                                    @onclick="() => ShowQuickView(product.Id)"
                                    @onclick:stopPropagation="true"
                                    class="bg-white bg-opacity-90 hover:bg-opacity-100 rounded-full p-2 shadow-lg transition-all duration-200 hover:scale-110"
                                    title="Quick view"
                                >
                                    <svg class="w-5 h-5 text-stone-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </button>
                                
 
                            </div>
                        </a>
                        
                        <!-- Product Info -->
                        <div class="p-3 sm:p-4 flex flex-col h-full">
                            <div class="flex-grow">
                                <div class="flex items-start justify-between mb-2">
                                    <a href="/product/@product.Slug" class="hover:text-stone-700 transition-colors cursor-pointer block">
                                        <h3 class="text-sm sm:text-base font-semibold text-gray-900 line-clamp-2 leading-tight">@GetProductName(product)</h3>
                                    </a>
                                </div>
                                
                                <!-- Tasting Notes -->
                                @{
                                    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                    var tastingNotes = currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(product.TastingNotesAr) 
                                        ? product.TastingNotesAr 
                                        : product.TastingNotes;
                                }
                                @if (!string.IsNullOrEmpty(tastingNotes))
                                {
                                    <p class="text-xs text-stone-600 mb-2 line-clamp-2 leading-tight">@tastingNotes</p>
                                }
                                
                                <!-- Price -->
                                <div class="mb-3">
                                    @{
                                        var variant = product.Variants?.FirstOrDefault();
                                        var price = variant?.Price ?? 0;
                                        var discountPrice = variant?.DiscountPrice ?? 0;
                                        var hasDiscount = discountPrice > 0 && discountPrice < price;
                                    }
                                    
                                    @if (hasDiscount)
                                    {
                                        <div class="space-y-1">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-base sm:text-lg font-bold text-red-600">
                                                    @discountPrice.ToString("0.000") <span class="text-xs">OMR</span>
                                                </span>
                                                <span class="text-xs sm:text-sm text-gray-400 line-through">
                                                    @price.ToString("0.000")
                                                </span>
                                            </div>
                                            @{
                                                var discountPercentage = ((price - discountPrice) / price * 100);
                                            }
                                            <span class="inline-block bg-red-100 text-red-700 px-2 py-0.5 rounded text-xs font-semibold">
                                                @discountPercentage.ToString("0")% OFF
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-base sm:text-lg font-bold text-gray-900">
                                            @price.ToString("0.000") <span class="text-xs">OMR</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <!-- Buttons at bottom -->
                            <div class="mt-auto space-y-2">
                                <!-- Quantity Selector and Add to Cart -->
                                <div class="flex items-stretch space-x-2">
                                    <div class="flex items-center border border-gray-300 rounded-lg h-9">
                                        <button 
                                            @onclick="@(() => DecreaseQuantity(product.Id))"
                                            class="px-2.5 h-full hover:bg-gray-100 transition-colors flex items-center justify-center"
                                            disabled="@(GetQuantity(product.Id) <= 1)"
                                        >
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                            </svg>
                                        </button>
                                        <span class="px-3 h-full font-medium text-sm min-w-[2rem] text-center flex items-center justify-center">@GetQuantity(product.Id)</span>
                                        <button 
                                            @onclick="@(() => IncreaseQuantity(product.Id))"
                                            class="px-2.5 h-full hover:bg-gray-100 transition-colors flex items-center justify-center"
                                        >
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    
                                    <button 
                                        @onclick="() => AddToCart(product.Id)"
                                        class="flex-1 bg-stone-600 hover:bg-stone-700 text-white px-3 rounded-lg font-medium text-sm transition-colors duration-200 flex items-center justify-center space-x-1 h-9"
                                    >


                                                <svg class="w-5 h-5 text-stone-600" viewBox="0 0 24 24" fill="none">
                <path
                    d="M7.5 18C8.32843 18 9 18.6716 9 19.5C9 20.3284 8.32843 21 7.5 21C6.67157 21 6 20.3284 6 19.5C6 18.6716 6.67157 18 7.5 18Z"
                    stroke="#FFFFFF" stroke-width="1.5" />
                <path
                    d="M16.5 18.0001C17.3284 18.0001 18 18.6716 18 19.5001C18 20.3285 17.3284 21.0001 16.5 21.0001C15.6716 21.0001 15 20.3285 15 19.5001C15 18.6716 15.6716 18.0001 16.5 18.0001Z"
                    stroke="#FFFFFF" stroke-width="1.5" />
                <path
