                                        @onclick="() => AddToCart(product.Id)"
                                        class="flex-1 bg-stone-600 hover:bg-stone-700 text-white px-4 py-2 rounded-lg font-medium transition-colors duration-200 flex items-center justify-center space-x-2"
                                    >


