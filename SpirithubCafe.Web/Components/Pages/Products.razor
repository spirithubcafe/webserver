<!-- Featured Categories -->
<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-center">
            <div class="text-center mb-12">
                @if (isLoading)
                {
                    <div class="h-8 bg-gray-300 rounded-md w-64 mx-auto mb-4 animate-pulse"></div>
                    <div class="h-6 bg-gray-200 rounded-md w-96 mx-auto animate-pulse"></div>
                }
                else
                {
                    <h2 class="text-3xl font-bold text-gray-900 mb-4">@Localizer["FeaturedCategories"]</h2>
                    <p class="text-xl text-gray-600">@Localizer["ExplorePremiumCollections"]</p>
                }
            </div>
        </div>
        
        <div class="flex justify-center">
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 max-w-7xl">
                @if (isLoading)
                {
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="group bg-white rounded-xl shadow-md overflow-hidden animate-pulse">
                            <div class="aspect-square bg-gray-300"></div>
                            <div class="p-3 md:p-4 text-center space-y-2">
                                <div class="h-4 bg-gray-300 rounded w-3/4 mx-auto"></div>
                                <div class="h-3 bg-gray-200 rounded w-1/2 mx-auto"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var category in categories.Take(6))
                    {
                        <button 
                            @onclick="() => SetCategoryFilter(category.Name)"
                            class="group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden flex flex-col"
                        >
                            <!-- Fixed Square Image Container -->
                            <div class="w-full aspect-square bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center overflow-hidden">
                                @if (!string.IsNullOrEmpty(category.ImagePath))
                                {
                                    <img 
                                        src="@category.ImagePath" 
                                        alt="@GetCategoryName(category)"
                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                    />
                                }
                                else
                                {
                                    <svg class="w-10 h-10 md:w-12 md:h-12 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                                    </svg>
                                }
                            </div>
                            <!-- Text Always Below Image -->
                            <div class="p-3 md:p-4 text-center flex-shrink-0">
                                <h3 class="font-semibold text-gray-900 group-hover:text-amber-600 transition-colors text-xs md:text-sm line-clamp-2">@GetCategoryName(category)</h3>
                                <p class="text-xs text-gray-600 mt-1">@category.Products?.Count() @Localizer["Products"]</p>
                            </div>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Category { get; set; }
    
    // Filter State Management
    private string searchQuery = string.Empty;
    private string selectedCategory = string.Empty;
    private string sortOption = "name";
    private System.Timers.Timer? searchTimer;
    private readonly Dictionary<int, int> productQuantities = new();
    private bool shouldScrollToTop = false;
    private bool _disposed = false;
    
    // Filter Toggle State
    private bool showFilters = true;
    
    // Mobile Modal States
    private bool showCategoryModal = false;
    private bool showSortModal = false;

    // Sort option constants
    private const string sortName = "name";
    private const string sortPriceLow = "price-low";
    private const string sortPriceHigh = "price-high";
    private const string sortPopular = "popular";
    private const string sortNewest = "newest";
    
    // Professional UI State Management
    private bool isSearching = false;
    
    private List<Category> categories = new();
    private List<Product> allProducts = new();
    private bool isLoading = true;
    
    // Quick View Modal properties
    private Product? selectedProduct = null;
    private bool isQuickViewVisible = false;
    
    // Shop settings
    private string shopTitleEn = "Premium Coffee Collection";
    private string shopTitleAr = "مجموعة القهوة المتميزة";
    private string shopSubtitleEn = "Discover our carefully curated selection of single-origin beans and signature blends from around the world.";
    private string shopSubtitleAr = "اكتشف مجموعتنا المختارة بعناية من حبوب القهوة المنفردة المنشأ والمخاليط المميزة من جميع أنحاء العالم.";
    private string shopBgType = "color";
    private string shopBgValue = "#f3f4f6";
    private string shopTitleTextColor = "#1f2937";
    private string shopSubtitleTextColor = "#6b7280";
    
    private IEnumerable<Product> filteredProducts => GetFilteredProducts();
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load shop settings
            await LoadShopSettings();
           
            // Load categories
            categories = await CategoryService.GetAllCategoriesAsync();
            
            // Load products
            allProducts = await ProductService.GetAllProductsAsync();
            
            // Check for category in route parameter
            if (!string.IsNullOrEmpty(Category))
            {
                var categoryFromRoute = categories.FirstOrDefault(c => 
                    c.Slug.Equals(Category, StringComparison.OrdinalIgnoreCase));
                if (categoryFromRoute != null)
                {
                    selectedCategory = categoryFromRoute.Name;
                }
            }
            
            // Initialize quantities for all products
            foreach (var product in allProducts)
            {
                productQuantities[product.Id] = 1;
            }
            
            // Initialize search timer
            searchTimer = new System.Timers.Timer(500); // 500ms delay
            searchTimer.Elapsed += async (sender, e) => await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
            searchTimer.AutoReset = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize CartService after render when JS is available
            await CartService.InitializeAsync();
        }
        
        if (firstRender || shouldScrollToTop)
        {
            try
            {
                // Scroll to top of page when component is first rendered or when parameters changed
                shouldScrollToTop = false;
            }
            catch (InvalidOperationException)
            {
                // Ignore JS interop exceptions during prerendering
                shouldScrollToTop = false;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        
        // Process category parameter when it changes
        if (!string.IsNullOrEmpty(Category))
        {
            var categoryFromRoute = categories.FirstOrDefault(c => 
                c.Slug.Equals(Category, StringComparison.OrdinalIgnoreCase));
            if (categoryFromRoute != null)
            {
                selectedCategory = categoryFromRoute.Name;
            }
            shouldScrollToTop = true;
            StateHasChanged();
        }
        else
        {
            // Clear category filter when no category in URL
            selectedCategory = string.Empty;
            StateHasChanged();
        }
    }
    
    private int GetQuantity(int productId)
    {
        return productQuantities.GetValueOrDefault(productId, 1);
    }
    
    private void IncreaseQuantity(int productId)
    {
        if (productQuantities.ContainsKey(productId))
        {
            if (productQuantities[productId] < 99) // Set max limit
            {
                productQuantities[productId]++;
            }
        }
        else
        {
            productQuantities[productId] = 2;
        }
        StateHasChanged();
    }
    
    private void DecreaseQuantity(int productId)
    {
        if (productQuantities.ContainsKey(productId))
        {
            if (productQuantities[productId] > 1)
            {
                productQuantities[productId]--;
            }
        }
        StateHasChanged();
    }
    
    private async Task AddToCart(int productId)
    {
        var product = allProducts.FirstOrDefault(p => p.Id == productId);
        if (product == null) return;
        
        var quantity = GetQuantity(productId);
        var variant = product.Variants?.FirstOrDefault();
        var price = variant?.DiscountPrice ?? variant?.Price ?? 0;
        
        // Add to cart using CartService
        await CartService.AddToCartAsync(
            productId: product.Id,
            name: product.Name,
            price: price,
            imageUrl: product.MainImage?.ImagePath ?? "",
            quantity: quantity,
            variantId: variant?.Id,
            variantInfo: variant?.VariantSku ?? "",
            weight: variant?.Weight ?? 0,
            weightUnit: variant?.WeightUnit ?? "g"
        );
        
        // Show success message using Toast component
        ToastService.ShowSuccess($"Added {quantity} x {product.Name} to cart!");
        
        // Reset quantity to 1 after adding to cart
        productQuantities[productId] = 1;
        StateHasChanged();
    }

    private async Task QuickAddToCart(int productId)
    {
        var product = allProducts.FirstOrDefault(p => p.Id == productId);
        if (product == null) return;
        
        var variant = product.Variants?.FirstOrDefault();
        var price = variant?.DiscountPrice ?? variant?.Price ?? 0;
        
        // Quick add with quantity 1
        await CartService.AddToCartAsync(
            productId: product.Id,
            name: product.Name,
            price: price,
            imageUrl: product.MainImage?.ImagePath ?? "",
            quantity: 1,
            variantId: variant?.Id,
            variantInfo: variant?.VariantSku ?? "",
            weight: variant?.Weight ?? 0,
            weightUnit: variant?.WeightUnit ?? "g"
        );
        
        // Show quick success message
        ToastService.ShowSuccess($"Added {product.Name} to cart!");
        StateHasChanged();
    }
    
    private IEnumerable<Product> GetFilteredProducts()
    {
        var products = allProducts.AsEnumerable();
        
        // Filter by selected category
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            products = products.Where(p => p.Category?.Name == selectedCategory);
        }
        
        // Filter by search query
        if (!string.IsNullOrEmpty(searchQuery))
        {
            products = products.Where(p => 
                p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (p.Description != null && p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                p.Category?.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true);
        }
        
        // Sort products
        return sortOption switch
        {
            "name" => products.OrderBy(p => p.Name),
            "price-low" => products.OrderBy(p => p.Variants?.FirstOrDefault()?.Price ?? 0),
            "price-high" => products.OrderByDescending(p => p.Variants?.FirstOrDefault()?.Price ?? 0),
            "popular" => products.OrderByDescending(p => p.Id), // Mock popularity by ID
            _ => products.OrderBy(p => p.Name)
        };
    }
    
    private void SetCategoryFilter(string categoryName)
    {
        selectedCategory = categoryName;
        shouldScrollToTop = true;
        StateHasChanged();
    }
    
    private void ClearCategoryFilter()
    {
        selectedCategory = string.Empty;
        StateHasChanged();
    }
    
    // Professional Filter Event Handlers
    private void OnSearchInputChange(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        isSearching = !string.IsNullOrEmpty(searchQuery);
        
        // Debounced search with professional feedback
        searchTimer?.Stop();
        searchTimer?.Start();
        StateHasChanged();
    }
    
    private void OnCategoryChange(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? string.Empty;
        ApplyFiltersWithAnimation();
    }
    
    private void OnSortChange(ChangeEventArgs e)
    {
        sortOption = e.Value?.ToString() ?? "name";
        ApplyFiltersWithAnimation();
    }

    // Mobile modal selection methods
    private void OpenCategoryModal()
    {
        showCategoryModal = true;
        StateHasChanged();
    }

    private void CloseCategoryModal()
    {
        showCategoryModal = false;
        StateHasChanged();
    }

    private void OpenSortModal()
    {
        showSortModal = true;
        StateHasChanged();
    }

    private void CloseSortModal()
    {
        showSortModal = false;
        StateHasChanged();
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        showCategoryModal = false;
        ApplyFiltersWithAnimation();
    }

    private void SelectSort(string sort)
    {
        sortOption = sort;
        showSortModal = false;
        ApplyFiltersWithAnimation();
    }
    
    private void ApplyFiltersWithAnimation()
    {
        shouldScrollToTop = true;
        StateHasChanged();
    }
    
    // Professional Helper Methods
    private string GetSearchPlaceholder()
    {
        var placeholders = new[]
        {
            Localizer["SearchCoffee"],
            Localizer["SearchByName"],
            Localizer["FindYourFavorite"],
            Localizer["DiscoverFlavors"]
        };
        return placeholders[0]; // Default to first placeholder
    }
    
    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(searchQuery);
    }
    
    private int GetActiveFiltersCount()
    {
        int count = 0;
        if (!string.IsNullOrEmpty(selectedCategory)) count++;
        if (!string.IsNullOrEmpty(searchQuery)) count++;
        return count;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        
        // Reset and start timer for debounced search
        searchTimer?.Stop();
        searchTimer?.Start();
    }
    
    private void ClearSearch()
    {
        searchQuery = string.Empty;
        StateHasChanged();
    }
    
    private void ClearAllFilters()
    {
        selectedCategory = string.Empty;
        searchQuery = string.Empty;
        StateHasChanged();
    }
    
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        StateHasChanged();
    }
    
    private string GetCategoryName(Category category)
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        return currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(category.NameAr) 
            ? category.NameAr 
            : category.Name;
    }
    
    private string GetCategoryDisplayName(string categoryName)
    {
        var category = categories.FirstOrDefault(c => c.Name == categoryName);
        return category != null ? GetCategoryName(category) : categoryName;
    }
    
    private string GetProductName(Product product)
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        return currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(product.NameAr) 
            ? product.NameAr 
            : product.Name;
    }
    
    private string GetProductDescription(Product product)
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        return currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(product.DescriptionAr) 
            ? product.DescriptionAr 
            : product.Description ?? "";
    }
    
    private async Task ShowQuickView(int productId)
    {
        try
        {
            selectedProduct = await ProductService.GetProductByIdAsync(productId);
            if (selectedProduct != null)
            {
                isQuickViewVisible = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading product: {ex.Message}");
        }
    }
    
    private void CloseQuickView()
    {
        isQuickViewVisible = false;
        selectedProduct = null;
        StateHasChanged();
    }
    
    private async Task LoadShopSettings()
    {
        try
        {
            shopTitleEn = await SettingService.GetValueAsync("ShopTitleEn", "Premium Coffee Collection");
            shopTitleAr = await SettingService.GetValueAsync("ShopTitleAr", "مجموعة القهوة المتميزة");
            shopSubtitleEn = await SettingService.GetValueAsync("ShopSubtitleEn", "Discover our carefully curated selection of single-origin beans and signature blends from around the world.");
            shopSubtitleAr = await SettingService.GetValueAsync("ShopSubtitleAr", "اكتشف مجموعتنا المختارة بعناية من حبوب القهوة المنفردة المنشأ والمخاليط المميزة من جميع أنحاء العالم.");
            
            shopBgType = await SettingService.GetValueAsync("ShopBgType", "color");
            shopBgValue = await SettingService.GetValueAsync("ShopBgValue", "#f3f4f6");
            
            shopTitleTextColor = await SettingService.GetValueAsync("ShopTitleTextColor", "#1f2937");
            shopSubtitleTextColor = await SettingService.GetValueAsync("ShopSubtitleTextColor", "#6b7280");
        }
        catch (Exception)
        {
            // Use default values if loading fails
        }
    }
    
    private string GetShopTitle()
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var isArabic = currentCulture.StartsWith("ar");
        
        // If category is selected, show category name
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            var category = categories.FirstOrDefault(c => c.Name == selectedCategory);
            if (category != null)
            {
                return isArabic && !string.IsNullOrEmpty(category.NameAr) 
                    ? category.NameAr 
                    : category.Name;
            }
        }
        
        // Otherwise show shop title
        return isArabic && !string.IsNullOrEmpty(shopTitleAr) 
            ? shopTitleAr 
            : shopTitleEn;
    }
    
    private string GetShopSubtitle()
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var isArabic = currentCulture.StartsWith("ar");
        
        // If category is selected, show category description
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            var category = categories.FirstOrDefault(c => c.Name == selectedCategory);
            if (category != null)
            {
                return isArabic && !string.IsNullOrEmpty(category.DescriptionAr) 
                    ? category.DescriptionAr 
                    : category.Description ?? "";
            }
        }
        
        // Otherwise show shop subtitle
        return isArabic && !string.IsNullOrEmpty(shopSubtitleAr) 
            ? shopSubtitleAr 
            : shopSubtitleEn;
    }
    
    private string GetHeroBackgroundStyle()
    {
        return shopBgType switch
        {
            "color" => $"background-color: {shopBgValue} !important;",
            "image" when !string.IsNullOrEmpty(shopBgValue) => $"background-image: url('{shopBgValue}') !important; background-size: cover !important; background-position: center !important; background-repeat: no-repeat !important;",
            "video" when !string.IsNullOrEmpty(shopBgValue) => $"background-color: #f3f4f6 !important;", // Fallback for video - would need video implementation
            _ => "background: linear-gradient(to bottom right, #fafaf9, #f5f5f4) !important;"
        };
    }
    
    public void Dispose()
    {
        _disposed = true;
        searchTimer?.Dispose();
    }
