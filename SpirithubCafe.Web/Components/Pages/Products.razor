                                        ? product.TastingNotesAr 
                                        : product.TastingNotes;
                                }
                                @if (!string.IsNullOrEmpty(tastingNotes))
                                {
                                    <p class="text-xs sm:text-sm text-stone-600 mb-2 sm:mb-4 line-clamp-2 md:line-clamp-3">@tastingNotes</p>
