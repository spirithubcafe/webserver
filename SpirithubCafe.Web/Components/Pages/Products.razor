@page "/products"
@page "/products/{category?}"
@layout SpirithubCafe.Web.Components.Layout.PublicLayout
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Components.Web
@inject CartService CartService
@inject ProductService ProductService
@inject CategoryService CategoryService
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@implements IDisposable

<PageTitle>@Localizer["Products"] - @Localizer["SiteTitle"]</PageTitle>

<!-- Toast Component -->
<Toast />

<!-- Quick View Modal -->
<ProductQuickViewModal Product="selectedProduct" IsVisible="isQuickViewVisible" OnClose="CloseQuickView" />

<!-- Hero Section -->
<section class="relative py-8" style="@GetHeroBackgroundStyle()">
    @* Remove overlay when custom background is set *@
    @if (shopBgType != "color" && shopBgType != "image")
    {
        <div class="absolute inset-0 bg-opacity-5"></div>
    }
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
                <h1 class="text-2xl md:text-3xl font-bold mb-4" style="color: @shopTitleTextColor">
                    @GetShopTitle()
                </h1>
                <p class="mx-auto" style="color: @shopSubtitleTextColor">
                    @GetShopSubtitle()
                </p>
            </div>
            
            <!-- Filter Toggle Button -->
            <button @onclick="ToggleFilters" 
                    class="flex-shrink-0 flex items-center gap-2 px-4 py-3 rounded-xl
                           bg-white/90 hover:bg-white border-2 border-gray-200 hover:border-amber-400
                           text-gray-700 hover:text-amber-600 font-medium
                           shadow-md hover:shadow-lg transition-all duration-300
                           focus:outline-none focus:ring-3 focus:ring-amber-100">
                @if (showFilters)
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    <span class="hidden sm:inline">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "إخفاء الفلاتر" : "Hide Filters")</span>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                    </svg>
                    <span class="hidden sm:inline">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "إظهار الفلاتر" : "Show Filters")</span>
                }
            </button>
        </div>
     </div>
</section>

<!-- Advanced Professional Filtering System -->
@if (showFilters)
{
    <section class="py-4 md:py-6 bg-gradient-to-r from-white via-gray-50/50 to-white border-b border-gray-200/70 sticky top-20 z-40 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Enhanced Loading State -->
            <div class="animate-pulse">
                <!-- Mobile Layout Skeleton -->
                <div class="lg:hidden space-y-4">
                    <div class="h-14 bg-gradient-to-r from-gray-200 to-gray-300 rounded-2xl shadow-inner"></div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <div class="h-4 bg-gray-200 rounded w-20"></div>
                            <div class="h-12 bg-gradient-to-r from-gray-200 to-gray-300 rounded-xl shadow-inner"></div>
                        </div>
                        <div class="space-y-2">
                            <div class="h-4 bg-gray-200 rounded w-16"></div>
                            <div class="h-12 bg-gradient-to-r from-gray-200 to-gray-300 rounded-xl shadow-inner"></div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Layout Skeleton -->
                <div class="hidden lg:flex lg:items-center lg:justify-between lg:gap-8">
                    <div class="flex items-center gap-6">
                        <div class="h-4 bg-gray-200 rounded w-24"></div>
                        <div class="h-14 bg-gradient-to-r from-gray-200 to-gray-300 rounded-2xl w-80 shadow-inner"></div>
                    </div>
                    <div class="flex items-center gap-8">
                        <div class="flex items-center gap-3">
                            <div class="h-4 bg-gray-200 rounded w-16"></div>
                            <div class="h-12 bg-gradient-to-r from-gray-200 to-gray-300 rounded-xl w-48 shadow-inner"></div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="h-4 bg-gray-200 rounded w-14"></div>
                            <div class="h-12 bg-gradient-to-r from-gray-200 to-gray-300 rounded-xl w-40 shadow-inner"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Professional Filter Interface -->
            <div class="space-y-6">
                
                <!-- Mobile-First Responsive Design -->
                <div class="lg:hidden">
                    <!-- Mobile Search with Enhanced Design -->
                    <div class="relative group">
                        <div class="absolute inset-y-0 ltr:left-0 rtl:right-0 ltr:pl-4 rtl:pr-4 flex items-center pointer-events-none z-10">
                            <svg class="h-6 w-6 text-gray-400 group-focus-within:text-amber-500 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        <input
                            type="text"
                            @bind="searchQuery"
                            @oninput="OnSearchInputChange"
                            @onfocus="OnSearchFocus"
                            @onblur="OnSearchBlur"
                            placeholder="@GetSearchPlaceholder()"
                            class="w-full h-14 ltr:pl-14 rtl:pr-14 ltr:pr-6 rtl:pl-6 bg-white/80 backdrop-blur-sm border-2 border-gray-200/50 rounded-2xl 
                                   text-gray-900 placeholder-gray-500 text-base font-medium
                                   focus:border-amber-400 focus:ring-4 focus:ring-amber-100 focus:bg-white focus:outline-none
                                   hover:border-gray-300 hover:shadow-md
                                   transition-all duration-300 ease-in-out shadow-lg
                                   @(isFocusedSearch ? "ring-4 ring-amber-100 border-amber-400 bg-white" : "")"
                        />
                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <button @onclick="ClearSearch" 
                                    class="absolute inset-y-0 ltr:right-0 rtl:left-0 ltr:pr-4 rtl:pl-4 flex items-center text-gray-400 hover:text-gray-600 transition-colors duration-200">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                            </button>
                        }
                    </div>

                    <!-- Mobile Filters with Professional Layout -->
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <!-- Category Filter -->
                        <div class="space-y-2">
                            <label class="flex items-center text-sm font-bold text-gray-700 tracking-wide">
                                <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                @Localizer["Category"]
                            </label>
                            <div class="relative">
                                <select @bind="selectedCategory" @bind:event="onchange"
                                        class="w-full h-12 px-4 ltr:pr-12 rtl:pl-12 bg-white/90 backdrop-blur-sm border-2 border-gray-200/70 rounded-xl
                                               text-gray-800 text-sm font-medium appearance-none cursor-pointer relative z-10
                                               focus:border-amber-400 focus:ring-3 focus:ring-amber-100 focus:bg-white focus:outline-none
                                               hover:border-gray-300 hover:shadow-md hover:bg-white
                                               transition-all duration-300 shadow-md
                                               @(string.IsNullOrEmpty(selectedCategory) ? "" : "border-amber-300 bg-amber-50/50")">
                                    <option value="">@Localizer["AllCategories"]</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Name">@GetCategoryName(cat)</option>
                                    }
                                </select>
                                <div class="absolute inset-y-0 ltr:right-0 rtl:left-0 flex items-center ltr:pr-4 rtl:pl-4 pointer-events-none z-0">
                                    <svg class="w-5 h-5 text-gray-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Sort Filter -->
                        <div class="space-y-2">
                            <label class="flex items-center text-sm font-bold text-gray-700 tracking-wide">
                                <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
                                </svg>
                                @Localizer["SortBy"]
                            </label>
                            <div class="relative">
                                <select @bind="sortOption" @bind:event="onchange"
                                        class="w-full h-12 px-4 ltr:pr-12 rtl:pl-12 bg-white/90 backdrop-blur-sm border-2 border-gray-200/70 rounded-xl
                                               text-gray-800 text-sm font-medium appearance-none cursor-pointer relative z-10
                                               focus:border-amber-400 focus:ring-3 focus:ring-amber-100 focus:bg-white focus:outline-none
                                               hover:border-gray-300 hover:shadow-md hover:bg-white
                                               transition-all duration-300 shadow-md">
                                    <option value="name">@Localizer["NameAZ"]</option>
                                    <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                    <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                    <option value="popular">@Localizer["MostPopular"]</option>
                                    <option value="newest">@Localizer["Newest"]</option>
                                </select>
                                <div class="absolute inset-y-0 ltr:right-0 rtl:left-0 flex items-center ltr:pr-4 rtl:pl-4 pointer-events-none z-0">
                                    <svg class="w-5 h-5 text-gray-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop Professional Layout with Tablet Support -->
                <div class="hidden lg:flex lg:flex-wrap lg:items-center lg:justify-between lg:gap-4 xl:gap-8">
                    <!-- Search Section -->
                    <div class="flex items-center gap-4 xl:gap-6 flex-shrink-0">
                        <div class="flex items-center text-sm font-bold text-gray-700 tracking-wide whitespace-nowrap">
                            <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            @Localizer["Search"]
                        </div>
                        
                        <div class="relative group flex-shrink-0">
                            <div class="absolute inset-y-0 ltr:left-0 rtl:right-0 ltr:pl-5 rtl:pr-5 flex items-center pointer-events-none z-10">
                                <svg class="h-6 w-6 text-gray-400 group-focus-within:text-amber-500 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <input
                                type="text"
                                @bind="searchQuery"
                                @oninput="OnSearchInputChange"
                                @onfocus="OnSearchFocus"
                                @onblur="OnSearchBlur"
                                placeholder="@GetSearchPlaceholder()"
                                class="w-64 xl:w-80 h-12 xl:h-14 ltr:pl-14 rtl:pr-14 ltr:pr-6 rtl:pl-6 bg-white/80 backdrop-blur-sm border-2 border-gray-200/50 rounded-2xl
                                       text-gray-900 placeholder-gray-500 text-base font-medium
                                       focus:border-amber-400 focus:ring-4 focus:ring-amber-100 focus:bg-white focus:outline-none
                                       hover:border-gray-300 hover:shadow-lg hover:bg-white
                                       transition-all duration-300 ease-in-out shadow-md
                                       @(isFocusedSearch ? "ring-4 ring-amber-100 border-amber-400 bg-white" : "")"
                            />
                            @if (!string.IsNullOrEmpty(searchQuery))
                            {
                                <button @onclick="ClearSearch" 
                                        class="absolute inset-y-0 ltr:right-0 rtl:left-0 ltr:pr-5 rtl:pl-5 flex items-center text-gray-400 hover:text-gray-600 transition-colors duration-200">
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Filter Controls -->
                    <div class="flex items-center gap-4 xl:gap-8 flex-wrap">
                        <!-- Category Filter -->
                        <div class="flex items-center gap-3 xl:gap-4 flex-shrink-0">
                            <label class="text-sm font-bold text-gray-700 tracking-wide whitespace-nowrap flex items-center">
                                <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                @Localizer["Category"]
                            </label>
                            <div class="relative flex-shrink-0">
                                <select @bind="selectedCategory" @bind:event="onchange"
                                        class="h-11 xl:h-12 px-4 xl:px-5 ltr:pr-12 rtl:pl-12 xl:ltr:pr-14 xl:rtl:pl-14 bg-white/90 backdrop-blur-sm border-2 border-gray-200/70 rounded-xl
                                               text-gray-800 text-sm font-semibold appearance-none cursor-pointer min-w-[10rem] xl:min-w-[12rem] relative z-10
                                               focus:border-amber-400 focus:ring-3 focus:ring-amber-100 focus:bg-white focus:outline-none
                                               hover:border-gray-300 hover:shadow-lg hover:bg-white
                                               transition-all duration-300 shadow-md
                                               @(string.IsNullOrEmpty(selectedCategory) ? "" : "border-amber-300 bg-amber-50/50")">
                                    <option value="">@Localizer["AllCategories"]</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Name">@GetCategoryName(cat)</option>
                                    }
                                </select>
                                <div class="absolute inset-y-0 ltr:right-0 rtl:left-0 flex items-center ltr:pr-4 rtl:pl-4 pointer-events-none z-0">
                                    <svg class="w-5 h-5 text-gray-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Sort Filter -->
                        <div class="flex items-center gap-3 xl:gap-4 flex-shrink-0">
                            <label class="text-sm font-bold text-gray-700 tracking-wide whitespace-nowrap flex items-center">
                                <svg class="w-5 h-5 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h9m5-4v12m0 0l-4-4m4 4l4-4"></path>
                                </svg>
                                @Localizer["SortBy"]
                            </label>
                            <div class="relative flex-shrink-0">
                                <select @bind="sortOption" @bind:event="onchange"
                                        class="h-11 xl:h-12 px-4 xl:px-5 ltr:pr-12 rtl:pl-12 xl:ltr:pr-14 xl:rtl:pl-14 bg-white/90 backdrop-blur-sm border-2 border-gray-200/70 rounded-xl
                                               text-gray-800 text-sm font-semibold appearance-none cursor-pointer min-w-[9rem] xl:min-w-[10rem] relative z-10
                                               focus:border-amber-400 focus:ring-3 focus:ring-amber-100 focus:bg-white focus:outline-none
                                               hover:border-gray-300 hover:shadow-lg hover:bg-white
                                               transition-all duration-300 shadow-md">
                                    <option value="name">@Localizer["NameAZ"]</option>
                                    <option value="price-low">@Localizer["PriceLowToHigh"]</option>
                                    <option value="price-high">@Localizer["PriceHighToLow"]</option>
                                    <option value="popular">@Localizer["MostPopular"]</option>
                                    <option value="newest">@Localizer["Newest"]</option>
                                </select>
                                <div class="absolute inset-y-0 ltr:right-0 rtl:left-0 flex items-center ltr:pr-4 rtl:pl-4 pointer-events-none z-0">
                                    <svg class="w-5 h-5 text-gray-400 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Professional Active Filters Display -->
        @if (!isLoading && (HasActiveFilters()))
        {
            <div class="mt-6 p-5 bg-gradient-to-r from-amber-50/80 via-yellow-50/60 to-amber-50/80 backdrop-blur-sm 
                        border border-amber-200/50 rounded-2xl shadow-lg">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <!-- Active Filters Header -->
                    <div class="flex items-center gap-3">
                        <div class="flex items-center text-sm font-bold text-amber-800 tracking-wide">
                            <div class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center mr-3">
                                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                                </svg>
                            </div>
                            @Localizer["ActiveFilters"] (@GetActiveFiltersCount())
                        </div>
                    </div>

                    <!-- Filter Chips -->
                    <div class="flex flex-wrap items-center gap-3">
                        @if (!string.IsNullOrEmpty(selectedCategory))
                        {
                            <span class="inline-flex items-center px-4 py-2.5 rounded-xl text-sm font-medium
                                         bg-white/90 backdrop-blur-sm border border-amber-300/50 text-amber-900 
                                         shadow-md hover:shadow-lg transition-all duration-200 group">
                                <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                                </svg>
                                <span class="font-semibold">@GetCategoryDisplayName(selectedCategory)</span>
                                <button @onclick="ClearCategoryFilter" 
                                        class="ml-3 w-5 h-5 flex items-center justify-center rounded-full bg-amber-100 hover:bg-red-100 
                                               text-amber-700 hover:text-red-600 transition-all duration-200 group-hover:scale-110">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span class="inline-flex items-center px-4 py-2.5 rounded-xl text-sm font-medium
                                         bg-white/90 backdrop-blur-sm border border-amber-300/50 text-amber-900 
                                         shadow-md hover:shadow-lg transition-all duration-200 group">
                                <svg class="w-4 h-4 mr-2 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                <span class="font-semibold max-w-[100px] sm:max-w-[150px] truncate">"@searchQuery"</span>
                                <button @onclick="ClearSearch" 
                                        class="ml-3 w-5 h-5 flex items-center justify-center rounded-full bg-amber-100 hover:bg-red-100 
                                               text-amber-700 hover:text-red-600 transition-all duration-200 group-hover:scale-110">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            </span>
                        }

                        <!-- Clear All Button -->
                        <button @onclick="ClearAllFilters" 
                                class="inline-flex items-center px-5 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-red-500 to-red-600 
                                       border border-red-600 rounded-xl hover:from-red-600 hover:to-red-700 hover:shadow-lg 
                                       focus:outline-none focus:ring-3 focus:ring-red-200 
                                       transition-all duration-200 transform hover:scale-105 shadow-md">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            @Localizer["ClearAll"]
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
}

<!-- Products Grid -->
<section class="py-8 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (isLoading)
        {
            <!-- Simple Loading Skeleton -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                        <!-- Image Skeleton -->
                        <div class="aspect-square bg-gray-200"></div>
                        
                        <!-- Content Skeleton -->
                        <div class="p-4 space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                            <div class="h-6 bg-gray-200 rounded w-1/3"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (filteredProducts is not null && filteredProducts.Any())
        {
            <!-- Results Count -->
            <div class="mb-8">
                <p class="text-gray-600">
                    @Localizer["Showing"] @(filteredProducts.Count()) @Localizer["Of"] @(allProducts?.Count() ?? 0) @Localizer["Products"]
                </p>
            </div>
            
            <!-- Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-3 sm:gap-4 md:gap-6">
                @foreach (var product in filteredProducts)
                {
                    <div class="bg-white rounded-lg sm:rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col relative">
                        <!-- Product Image -->
                        <a href="/product/@product.Slug" class="block relative aspect-square bg-gradient-to-br from-stone-50 to-stone-100 cursor-pointer">
                            @if (product.GalleryImages?.Any() == true)
                            {
                                <img 
                                    src="@product.GalleryImages.First().ImagePath" 
                                    alt="@product.Name"
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg class="w-20 h-20 text-stone-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
                                    </svg>
                                </div>
                            }
                            
                            @{
                                var badgeVariant = product.Variants?.FirstOrDefault();
                                var badgePrice = badgeVariant?.Price ?? 0;
                                var badgeDiscountPrice = badgeVariant?.DiscountPrice ?? 0;
                                var badgeHasDiscount = badgeDiscountPrice > 0 && badgeDiscountPrice < badgePrice;
                                var badgeDiscountPercent = badgeHasDiscount ? Math.Round((badgePrice - badgeDiscountPrice) / badgePrice * 100) : 0;
                            }
                            
                            <!-- Discount Badge (Top Right) -->
                            @if (badgeHasDiscount)
                            {
                                <div class="absolute top-3 right-3 z-20">
                                    <div class="bg-red-600 text-white px-2.5 py-1 rounded-lg shadow-lg text-xs sm:text-sm font-bold">
                                        @badgeDiscountPercent% OFF
                                    </div>
                                </div>
                            }
                            
                            <!-- Quick Action Buttons -->
                            <div class="absolute top-4 left-0 right-0 flex justify-between w-full px-4 z-10">
                                <!-- Quick View Button (Left) -->
                                <button 
                                    @onclick="() => ShowQuickView(product.Id)"
