    private string GetShopTitle()
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var isArabic = currentCulture.StartsWith("ar");
        
        // If category is selected, show category name
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            var category = categories.FirstOrDefault(c => c.Name == selectedCategory);
            if (category != null)
            {
                return isArabic && !string.IsNullOrEmpty(category.NameAr) 
                    ? category.NameAr 
                    : category.Name;
            }
        }
        
        // Otherwise show shop title
        return isArabic && !string.IsNullOrEmpty(shopTitleAr) 
            ? shopTitleAr 
            : shopTitleEn;
    }
    
    private string GetShopSubtitle()
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var isArabic = currentCulture.StartsWith("ar");
        
        // If category is selected, show category description
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            var category = categories.FirstOrDefault(c => c.Name == selectedCategory);
            if (category != null)
            {
                return isArabic && !string.IsNullOrEmpty(category.DescriptionAr) 
                    ? category.DescriptionAr 
                    : category.Description ?? "";
            }
        }
        
        // Otherwise show shop subtitle
        return isArabic && !string.IsNullOrEmpty(shopSubtitleAr) 
            ? shopSubtitleAr 
            : shopSubtitleEn;
    }
    
    private string GetHeroBackgroundStyle()
    {
        return shopBgType switch
        {
            "color" => $"background-color: {shopBgValue} !important;",
            "image" when !string.IsNullOrEmpty(shopBgValue) => $"background-image: url('{shopBgValue}') !important; background-size: cover !important; background-position: center !important; background-repeat: no-repeat !important;",
            "video" when !string.IsNullOrEmpty(shopBgValue) => $"background-color: #f3f4f6 !important;", // Fallback for video - would need video implementation
            _ => "background: linear-gradient(to bottom right, #fafaf9, #f5f5f4) !important;"
        };
    }
    
