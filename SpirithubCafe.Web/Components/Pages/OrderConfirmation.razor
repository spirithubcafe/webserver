@page "/order-confirmation/{orderNumber}"
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Application.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@layout PublicLayout
@inject OrderService OrderService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ToastService ToastService


<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        @if (order != null)
        {
            <!-- Success Header -->
            <div class="text-center mb-8">
                <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Order Placed Successfully!</h1>
                <p class="text-gray-600">Thank you for your order. We'll send you a confirmation email shortly.</p>
            </div>

            <!-- Order Summary Card -->
            <div class="bg-white rounded-lg shadow-md mb-6">
                <div class="p-6 border-b border-gray-200">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-semibold text-gray-900">Order Details</h2>
                        <span class="px-3 py-1 @GetStatusBadgeClass(order.Status) rounded-full text-sm font-medium">
                            @order.Status
                        </span>
                    </div>

                    <!-- Tracking Information (when available) -->
                    @if (!string.IsNullOrEmpty(order.TrackingNumber) && (order.Status.ToLower() == "shipped" || order.Status.ToLower() == "delivered"))
                    {
                        <div class="mb-6 p-4 bg-gradient-to-r from-green-50 to-blue-50 border border-green-200 rounded-lg">
                            <div class="flex items-center space-x-3">
                                <div class="flex-shrink-0">
                                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-1">Package Tracking</h3>
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4 space-y-2 sm:space-y-0">
                                        <div class="flex items-center space-x-2">
                                            <span class="text-sm font-medium text-gray-700">Tracking Number:</span>
                                            <code class="px-3 py-1 bg-white text-blue-700 font-mono text-sm border border-blue-200 rounded-md shadow-sm">
                                                @order.TrackingNumber
                                            </code>
                                        </div>
                                        <button @onclick="() => CopyTrackingNumber(order.TrackingNumber)"
                                                class="inline-flex items-center px-3 py-1 text-xs font-medium text-blue-700 bg-blue-100 hover:bg-blue-200 rounded-md transition-colors">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                            </svg>
                                            Copy
                                        </button>
                                    </div>
                                    @if (order.Status.ToLower() == "shipped")
                                    {
                                        <p class="text-sm text-gray-600 mt-2">
                                            📦 Your package has been shipped! Use the tracking number above to monitor its progress.
                                        </p>
                                    }
                                    else if (order.Status.ToLower() == "delivered")
                                    {
                                        <p class="text-sm text-green-700 mt-2 font-medium">
                                            ✅ Your package has been delivered! We hope you enjoy your purchase.
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="font-medium text-gray-900 mb-2">Order Information</h3>
                            <div class="space-y-1 text-sm text-gray-600">
                                <p><span class="font-medium">Order Number:</span> @order.OrderNumber</p>
                                <p><span class="font-medium">Order Date:</span> @order.CreatedAt.ToString("MMM dd, yyyy")</p>
                                <p><span class="font-medium">Total Amount:</span> @order.TotalAmount.ToString("F3") OMR</p>
                                <p><span class="font-medium">Payment Status:</span> 
                                    <span class="px-2 py-1 @GetPaymentStatusBadgeClass(order.PaymentStatus) rounded-full text-xs font-medium">
                                        @GetPaymentStatusText(order.PaymentStatus)
                                    </span>
                                </p>
                                @if (!string.IsNullOrEmpty(order.TrackingNumber) && order.Status.ToLower() != "shipped" && order.Status.ToLower() != "delivered")
                                {
                                    <p><span class="font-medium">Tracking Number:</span> 
                                        <code class="px-2 py-1 bg-gray-100 text-gray-800 font-mono text-xs rounded">@order.TrackingNumber</code>
                                    </p>
                                }
                            </div>
                        </div>
                        
                        <div>
                            <h3 class="font-medium text-gray-900 mb-2">Shipping Information</h3>
                            <div class="space-y-1 text-sm text-gray-600">
                                <p><span class="font-medium">Name:</span> @order.FirstName @order.LastName</p>
                                <p><span class="font-medium">Email:</span> @order.Email</p>
                                <p><span class="font-medium">Phone:</span> @order.Phone</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="p-6 border-b border-gray-200">
                    <h3 class="font-medium text-gray-900 mb-2">Shipping Address</h3>
                    <div class="text-sm text-gray-600">
                        <p>@order.AddressLine1</p>
                        @if (!string.IsNullOrEmpty(order.AddressLine2))
                        {
                            <p>@order.AddressLine2</p>
                        }
                        <p>@(order.City?.Name), @(order.Country?.Name)</p>
                        @if (!string.IsNullOrEmpty(order.PostalCode))
                        {
                            <p>@order.PostalCode</p>
                        }
                    </div>
                </div>

                <!-- Order Items -->
                <div class="p-6">
                    <h3 class="font-medium text-gray-900 mb-4">Order Items</h3>
                    <div class="space-y-4">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                                @if (item.Product?.MainImage != null)
                                {
                                    <img src="@item.Product.MainImage.ImagePath" alt="@item.ProductName" class="w-16 h-16 object-cover rounded-lg">
                                }
                                else
                                {
                                    <div class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center">
                                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                }
                                
                                <div class="flex-1">
                                    <h4 class="font-medium text-gray-900">@item.ProductName</h4>
                                    @if (!string.IsNullOrEmpty(item.VariantInfo))
                                    {
                                        <p class="text-sm text-gray-600">Variant: @item.VariantInfo</p>
                                    }
                                    <p class="text-sm text-gray-600">Quantity: @item.Quantity</p>
                                </div>
                                
                                <div class="text-right">
                                    <p class="font-medium text-gray-900">@item.TotalAmount.ToString("F3") OMR</p>
                                    <p class="text-sm text-gray-600">@item.UnitPrice.ToString("F3") OMR each</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Totals -->
                <div class="p-6 bg-gray-50 border-t border-gray-200">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Subtotal:</span>
                            <span class="text-gray-900">@order.SubTotal.ToString("F3") OMR</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Tax:</span>
                            <span class="text-gray-900">@order.TaxAmount.ToString("F3") OMR</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Shipping:</span>
                            <span class="text-gray-900">@order.ShippingCost.ToString("F3") OMR</span>
                        </div>
                        <div class="border-t border-gray-200 pt-2">
                            <div class="flex justify-between font-semibold text-lg">
                                <span class="text-gray-900">Total:</span>
                                <span class="text-gray-900">@order.TotalAmount.ToString("F3") OMR</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                @if (order.PaymentStatus == "Unpaid" || order.PaymentStatus == "Failed")
                {
                    <button @onclick="PayForOrder"
                            class="px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors flex items-center justify-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                        </svg>
                        <span>Pay Now</span>
                    </button>
                }
                @if (!string.IsNullOrEmpty(order.TrackingNumber) && (order.Status.ToLower() == "shipped" || order.Status.ToLower() == "delivered"))
                {
                    <button @onclick="() => OpenTrackingLink(order.TrackingNumber)" 
                            class="px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center justify-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Track Package</span>
                    </button>
                }
                <a href="/my-orders" 
                   class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
                    View My Orders
                </a>
                <a href="/products" 
                   class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors text-center">
                    Continue Shopping
                </a>
            </div>
        }
        else if (isLoading)
        {
            <!-- Loading State -->
            <div class="text-center py-16">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                <p class="mt-4 text-gray-600">Loading order details...</p>
            </div>
        }
        else
        {
            <!-- Order Not Found -->
            <div class="text-center py-16">
                <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Order Not Found</h1>
                <p class="text-gray-600 mb-6">We couldn't find an order with this number.</p>
                <a href="/products" 
                   class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
                    Continue Shopping
                </a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string OrderNumber { get; set; } = string.Empty;
    
    private Order? order;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        try
        {
            isLoading = true;
            order = await OrderService.GetOrderByNumberAsync(OrderNumber);
        }
        catch (Exception)
        {
            // Log error if needed
            order = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }



    private async Task CopyTrackingNumber(string trackingNumber)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", trackingNumber);
            ToastService.ShowSuccess("Tracking number copied to clipboard!");
        }
        catch (Exception)
        {
            // Fallback if clipboard API is not available
            ToastService.ShowInfo($"Tracking Number: {trackingNumber}");
        }
    }

    private Task OpenTrackingLink(string trackingNumber)
    {
        // This is a generic example - you can customize this based on your shipping provider
        // For example, if you use specific carriers, you can detect the carrier and use their tracking URL
        var message = $"Please use your tracking number '{trackingNumber}' on your shipping provider's website to track your package.\n\nCommon tracking websites:\n• Aramex: www.aramex.com/track\n• DHL: www.dhl.com/track\n• FedEx: www.fedex.com/track";
        ToastService.ShowInfo(message);
        return Task.CompletedTask;
    }

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-yellow-100 text-yellow-800",
            "processing" => "bg-blue-100 text-blue-800",
            "shipped" => "bg-purple-100 text-purple-800",
            "delivered" => "bg-green-100 text-green-800",
            "cancelled" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetPaymentStatusBadgeClass(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "paid" => "bg-green-100 text-green-800",
            "unpaid" => "bg-red-100 text-red-800",
            "failed" => "bg-red-100 text-red-800",
            "refunded" => "bg-gray-100 text-gray-800",
            "pending" => "bg-yellow-100 text-yellow-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetPaymentStatusText(string paymentStatus)
    {
        return paymentStatus?.ToLower() switch
        {
            "paid" => "Paid",
            "unpaid" => "Unpaid",
            "failed" => "Failed",
            "refunded" => "Refunded",
            "pending" => "Processing",
            _ => "Unknown"
        };
    }

    private async Task PayForOrder()
    {
        if (order == null) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            // Call payment initiation API
            var httpClient = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
            var response = await httpClient.GetAsync($"/api/payment/initiate/{order.Id}");
            
            if (response.IsSuccessStatusCode)
            {
                var paymentData = await response.Content.ReadFromJsonAsync<PaymentInitiationResponse>();
                if (paymentData != null && !string.IsNullOrEmpty(paymentData.PaymentUrl))
                {
                    // Redirect to payment gateway
                    Navigation.NavigateTo(paymentData.PaymentUrl, forceLoad: true);
                }
                else
                {
                    ToastService.ShowError("Failed to initiate payment. Please try again.");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Payment initiation failed: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error initiating payment: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class PaymentInitiationResponse
    {
        public string PaymentUrl { get; set; } = string.Empty;
        public string PaymentReference { get; set; } = string.Empty;
    }
}