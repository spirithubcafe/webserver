@page "/admin/chat-management"
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Domain.Entities
@using System.Timers
@inject IChatService ChatService
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@rendermode InteractiveServer

<!-- Full Height Responsive Chat Management -->
<div class="h-[calc(100vh-85px)] bg-[#F8F9FA] flex flex-col">
    <!-- Header -->
    @* <div class="bg-[#37353E] text-[#D3DAD9] p-4 sm:p-6 flex-shrink-0">
        <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold">@Localizer["ChatManagement"]</h1>
        <p class="text-sm text-[#D3DAD9]/70 mt-1">Manage all active chat sessions</p>
    </div> *@

    <!-- Main Chat Container -->
    <div class="flex flex-col lg:flex-row flex-1 bg-white shadow-lg overflow-hidden">
        <!-- Chat Sessions Sidebar -->
        <div class="lg:w-1/3 xl:w-1/4 bg-[#F8F9FA] border-r border-[#D3DAD9]/20 flex flex-col h-full admin-sessions-mobile @(selectedSession != null && !showSessions ? "hidden lg:flex" : "flex")">
            <div class="p-4 border-b border-[#D3DAD9]/20 bg-white flex-shrink-0">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-lg font-semibold text-[#37353E]">@Localizer["ActiveChats"]</h2>
                        <p class="text-sm text-[#715A5A] mt-1">@chatSessions.Count active sessions</p>
                    </div>
                    @if (selectedSession != null)
                    {
                        <button @onclick="() => showSessions = false" class="lg:hidden bg-[#37353E] text-[#D3DAD9] p-2 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    }
                </div>
            </div>
            
                @if (chatSessions.Any())
                {
                    <div class="flex-1 overflow-y-auto p-3 space-y-3">
                        @foreach (var session in chatSessions.OrderByDescending(s => s.LastMessageAt ?? s.CreatedAt))
                        {
                            <div class="admin-session-card p-4 cursor-pointer transition-all duration-300 @(selectedSession?.Id == session.Id ? "admin-session-selected" : "")"
                                 @onclick="() => SelectSession(session)">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 bg-[#715A5A] text-white rounded-full flex items-center justify-center text-sm font-bold shadow-md flex-shrink-0">
                                        @session.VisitorName?.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4 class="font-semibold text-[#37353E] truncate text-sm">@session.VisitorName</h4>
                                        @if (!string.IsNullOrEmpty(session.VisitorEmail))
                                        {
                                            <div class="flex items-center gap-1 mt-1">
                                                <svg class="w-3 h-3 text-[#715A5A] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                                                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                                                </svg>
                                                <p class="text-xs text-[#715A5A] truncate">@session.VisitorEmail</p>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(session.PhoneNumber))
                                        {
                                            <div class="flex items-center gap-1">
                                                <svg class="w-3 h-3 text-[#715A5A] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                                </svg>
                                                <p class="text-xs text-[#715A5A] truncate">@session.PhoneNumber</p>
                                            </div>
                                        }
                                         <div class="flex items-center gap-1">
                                        <svg class="w-3 h-3 text-[#715A5A] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"></path></svg>
                                        <p class="text-xs text-[#715A5A] mt-1 font-medium">
                                            @((session.LastMessageAt ?? session.CreatedAt).ToString("MM/dd HH:mm"))
                                        </p>
                                         </div>
                                    </div>
                                    @if (session.HasUnreadVisitorMessages)
                                    {
                                        <div class="bg-[#715A5A] text-white text-xs px-2 py-1 rounded-full font-bold shadow animate-pulse flex-shrink-0">
                                            New
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex-1 flex items-center justify-center p-8">
                        <div class="text-center text-[#715A5A]">
                            <svg class="w-16 h-16 mx-auto mb-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                            </svg>
                            <p class="font-medium">@Localizer["NoActiveChats"]</p>
                            <p class="text-xs opacity-75 mt-1">Waiting for new conversations...</p>
                        </div>
                    </div>
                }
        </div>

        <!-- Chat Messages Area -->
        <div class="flex-1 flex flex-col admin-chat-mobile @(selectedSession == null || showSessions ? "hidden lg:flex" : "flex")">
            @if (selectedSession != null)
            {
                <!-- Chat Header -->
                <div class="bg-[#37353E] text-[#D3DAD9] p-4 border-b border-[#715A5A]/20">
                    <div class="flex items-center gap-4">
                        <!-- Back to Sessions Button for Mobile -->
                        <button @onclick="() => showSessions = true" class="lg:hidden bg-[#44444E] p-2 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                        <div class="w-10 h-10 bg-[#715A5A] text-white rounded-full flex items-center justify-center text-sm font-bold shadow-lg">
                            @selectedSession.VisitorName?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-lg text-[#D3DAD9] truncate">@selectedSession.VisitorName</h3>
                            <p class="text-xs text-[#D3DAD9]/70 font-medium">@Localizer["ChatWith"] - Active Session</p>
                        </div>
                        <!-- Session Info Button for Mobile -->
                        <button @onclick="ToggleSessionInfo" class="lg:hidden bg-[#44444E] p-2 rounded-lg">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                        </button>
                    </div>
                    
                    <!-- Session Details -->
                    <div class="mt-4 flex flex-wrap lg:flex-nowrap gap-2 @(showSessionInfo ? "flex" : "hidden lg:flex")">
                        @if (!string.IsNullOrEmpty(selectedSession.VisitorEmail))
                        {
                            <div class="bg-[#44444E] rounded-lg px-3 py-2 flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#D3DAD9] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                                </svg>
                                <span class="text-xs text-[#D3DAD9] font-medium truncate">@selectedSession.VisitorEmail</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selectedSession.PhoneNumber))
                        {
                            <div class="bg-[#44444E] rounded-lg px-3 py-2 flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#D3DAD9] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                                </svg>
                                <span class="text-xs text-[#D3DAD9] font-medium truncate">@selectedSession.PhoneNumber</span>
                            </div>
                        }
                        <div class="bg-[#44444E] rounded-lg px-3 py-2 flex items-center gap-2">
                            <svg class="w-4 h-4 text-[#D3DAD9] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="text-xs text-[#D3DAD9] font-medium truncate">@selectedSession.IpAddress</span>
                        </div>
                    </div>
                </div>

                <!-- Messages Container -->
                <div class="flex-1 overflow-hidden flex flex-col admin-messages-container">
                    <div class="flex-1 p-4 overflow-y-auto admin-chat-messages" @ref="messagesContainer">
                        @if (currentMessages.Any())
                        {
                            @foreach (var message in currentMessages)
                            {
                                <div class="mb-4 admin-message-animate @(message.SenderType == ChatSenderType.Admin ? "text-right" : "text-left")">
                                    <div class="inline-block max-w-sm sm:max-w-md lg:max-w-lg xl:max-w-xl px-4 py-3 rounded-2xl shadow-sm @(message.SenderType == ChatSenderType.Admin ? "admin-bubble-admin" : "admin-bubble-visitor")">
                                        <div class="text-sm font-medium leading-relaxed break-words">@message.Content</div>
                                        <div class="text-xs opacity-75 mt-2 font-medium">
                                            @message.SenderName • @message.CreatedAt.ToString("HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full">
                                <div class="text-center text-[#715A5A]">
                                    <div class="opacity-60 text-4xl mb-3">💬</div>
                                    <div class="font-medium">No messages yet...</div>
                                    <div class="text-xs opacity-40 mt-1">Start the conversation</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Message Input -->
                <div class="p-4 border-t border-[#D3DAD9]/20 bg-white admin-message-input-container">
                    <div class="flex gap-3 items-center relative">
                        <input @bind="replyMessage" 
                               @onkeypress="@(async (e) => { if (e.Key == "Enter") await SendAdminMessage(); })"
                               placeholder="@Localizer["TypeYourReply"]..."
                               class="flex-1 admin-message-input"
                               @ref="messageInput"
                               disabled="@isLoading" />
                        
                        <!-- Emoji Button -->
                        <button @onclick="ToggleEmojiPicker" 
                                class="admin-emoji-button"
                                type="button"
                                title="Add Emoji">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zM8.5 9a1.5 1.5 0 1 1-.001 3.001A1.5 1.5 0 0 1 8.5 9zm7 0a1.5 1.5 0 1 1-.001 3.001A1.5 1.5 0 0 1 15.5 9zM12 17.5c-2.33 0-4.31-1.46-5.11-3.5h10.22c-.8 2.04-2.78 3.5-5.11 3.5z"/>
                            </svg>
                        </button>
                        
                        <!-- Emoji Picker -->
                        <div class="admin-emoji-picker @(showEmojiPicker ? "show" : "")">
                            <div class="admin-emoji-header">
                                <h4>Select Emoji</h4>
                                <button @onclick="() => showEmojiPicker = false" class="admin-emoji-close">✕</button>
                            </div>
                            <div class="admin-emoji-grid">
                                @foreach (var emoji in popularEmojis)
                                {
                                    <button @onclick="() => InsertEmoji(emoji)" 
                                            class="admin-emoji-item" 
                                            type="button"
                                            title="@emoji">
                                        @emoji
                                    </button>
                                }
                            </div>
                        </div>
                        
                        <button @onclick="SendAdminMessage" 
                                disabled="@(isLoading || string.IsNullOrWhiteSpace(replyMessage))"
                                class="admin-send-button"
                                type="button">
                            @if (isLoading)
                            {
                                <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                            else
                            {
                                <span>@Localizer["Send"]</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="flex-1 flex items-center justify-center text-[#715A5A] bg-[#F8F9FA]">
                    <div class="text-center p-8">
                        <svg class="w-20 h-20 mx-auto mb-6 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                        </svg>
                        <h3 class="text-lg font-semibold mb-2">@Localizer["SelectChatToView"]</h3>
                        <p class="text-sm opacity-75">Choose a chat session from the sidebar to start managing conversations</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<ChatSession> chatSessions = new();
    private ChatSession? selectedSession;
    private List<ChatMessage> currentMessages = new();
    private ElementReference messagesContainer;
    private string replyMessage = string.Empty;
    private bool isLoading = false;
    private Timer? refreshTimer;
    private DateTime lastUpdate = DateTime.UtcNow;
    private bool showSessions = true; // Mobile navigation state
    private bool showSessionInfo = false; // Mobile session info toggle

    protected override async Task OnInitializedAsync()
    {
        await LoadChatSessions();
        
        // Setup refresh timer
        refreshTimer = new Timer(2000); // Check every 2 seconds
        refreshTimer.Elapsed += async (sender, e) => await RefreshData();
        refreshTimer.AutoReset = true;
        refreshTimer.Enabled = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Setup JavaScript event listener for closing emoji picker
                await JSRuntime.InvokeVoidAsync("eval", @"
                    if (typeof emojiPicker !== 'undefined') {
                        emojiPicker.init();
                    }
                    
                    // Listen for close emoji picker event
                    document.addEventListener('closeEmojiPicker', () => {
                        // Close emoji picker through direct DOM manipulation
                        const emojiPicker = document.querySelector('.admin-emoji-picker.show');
                        if (emojiPicker) {
                            emojiPicker.classList.remove('show');
                        }
                    });
                ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing emoji picker: {ex.Message}");
            }
        }
    }

    private async Task RefreshData()
    {
        try
        {
            // Refresh sessions
            var updatedSessions = await ChatService.GetActiveSessionsAsync();
            var updatedSessionsList = updatedSessions.ToList();
            var hasNewSessions = updatedSessionsList.Count != chatSessions.Count ||
                                updatedSessionsList.Any(s => !chatSessions.Any(cs => cs.Id == s.Id));
            
            if (hasNewSessions)
            {
                chatSessions = updatedSessionsList;
                await InvokeAsync(StateHasChanged);
            }

            // Refresh current messages if a session is selected
            if (selectedSession != null)
            {
                var messages = await ChatService.GetMessagesAsync(selectedSession.Id);
                var messagesList = messages.ToList();
                if (messagesList.Count != currentMessages.Count)
                {
                    currentMessages = messagesList;
                    
                    // Mark visitor messages as read
                    await ChatService.MarkMessagesAsReadAsync(selectedSession.Id, ChatSenderType.Visitor);
                    
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing data: {ex.Message}");
        }
    }

    private async Task LoadChatSessions()
    {
        try
        {
            chatSessions = (await ChatService.GetActiveSessionsAsync()).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading chat sessions: {ex.Message}");
        }
    }

    private async Task SelectSession(ChatSession session)
    {
        selectedSession = session;
        showSessions = false; // Hide sessions on mobile when chat is selected
        showSessionInfo = false; // Hide session info initially
        await LoadMessages();
        
        // Mark visitor messages as read
        try
        {
            await ChatService.MarkMessagesAsReadAsync(session.Id, ChatSenderType.Visitor);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking messages as read: {ex.Message}");
        }
    }

    private async Task LoadMessages()
    {
        if (selectedSession == null) return;
        
        try
        {
            currentMessages = (await ChatService.GetMessagesAsync(selectedSession.Id)).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading messages: {ex.Message}");
        }
    }

    private async Task SendAdminMessage()
    {
        if (selectedSession == null || isLoading || string.IsNullOrWhiteSpace(replyMessage))
            return;

        isLoading = true;
        var content = replyMessage.Trim();
        replyMessage = string.Empty;
        StateHasChanged();

        try
        {
            var message = await ChatService.SendMessageAsync(
                selectedSession.Id,
                ChatSenderType.Admin,
                Localizer["Admin"],
                content);

            if (message != null)
            {
                currentMessages.Add(message);
                ToastService.ShowSuccess(Localizer["MessageSentSuccessfully"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Localizer["ErrorSendingMessage"]);
            Console.WriteLine($"Error sending admin message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleSessionInfo()
    {
        showSessionInfo = !showSessionInfo;
    }

    // Emoji Picker Variables
    private bool showEmojiPicker = false;
    private ElementReference messageInput;
    
    // Popular Emojis Collection (50 most used emojis)
    private readonly string[] popularEmojis = {
        "😀", "😃", "😄", "😁", "😆", "😅", "🤣", "😂", "🙂", "🙃",
        "😉", "😊", "😇", "🥰", "😍", "🤩", "😘", "😗", "😚", "😙",
        "😋", "😛", "😜", "🤪", "😝", "🤑", "🤗", "🤭", "🤫", "🤔",
        "🤐", "🤨", "😐", "😑", "😶", "😏", "😒", "🙄", "😬", "🤥",
        "😔", "😪", "🤤", "😴", "😷", "🤒", "🤕", "🤢", "🤮", "🤧",
        "🥵", "🥶", "🥴", "😵", "🤯", "🤠", "🥳", "😎", "🤓", "🧐",
        "😕", "😟", "🙁", "☹️", "😮", "😯", "😲", "😳", "🥺", "😦",
        "😧", "😨", "😰", "😥", "😢", "😭", "😱", "😖", "😣", "😞",
        "😓", "😩", "😫", "🥱", "😤", "😡", "😠", "🤬", "😈", "👿",
        "💀", "☠️", "💩", "🤡", "👹", "👺", "👻", "👽", "👾", "🤖"
    };

    private void ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
    }

    private async Task InsertEmoji(string emoji)
    {
        replyMessage += emoji;
        showEmojiPicker = false;
        
        // Focus back to input
        try
        {
            await messageInput.FocusAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error focusing input: {ex.Message}");
        }
        
        StateHasChanged();
    }

    [JSInvokable]
