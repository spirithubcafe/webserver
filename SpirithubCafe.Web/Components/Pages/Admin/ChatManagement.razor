@page "/admin/chat-management"
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Domain.Entities
@using System.Timers
@inject IChatService ChatService
@inject IStringLocalizer<Resources> Localizer
@inject ToastService ToastService
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@rendermode InteractiveServer
<div class="container mx-auto p-6">
    <div class="bg-white rounded-lg shadow-lg">
        <!-- Header -->
        <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white p-6 rounded-t-lg">
            <h1 class="text-2xl font-bold">@Localizer["ChatManagement"]</h1>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 h-96">
                <!-- Chat Sessions List -->
                <div class="lg:col-span-1 border-r border-gray-200 pr-4">
                    <h2 class="text-lg font-semibold mb-4 text-gray-800">@Localizer["ActiveChats"]</h2>
                    
                    @if (chatSessions.Any())
                    {
                        <div class="space-y-2 overflow-y-auto max-h-80">
                            @foreach (var session in chatSessions.OrderByDescending(s => s.LastMessageAt ?? s.CreatedAt))
                            {
                                <div class="p-3 border rounded-lg cursor-pointer transition-colors @(selectedSession?.Id == session.Id ? "bg-amber-50 border-amber-300" : "hover:bg-gray-50 border-gray-200")"
                                     @onclick="() => SelectSession(session)">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1">
                                            <h3 class="font-medium text-gray-900">@session.VisitorName</h3>
                                            @if (!string.IsNullOrEmpty(session.VisitorEmail))
                                            {
                                                <p class="text-sm text-gray-600">📧 @session.VisitorEmail</p>
                                            }
                                            @if (!string.IsNullOrEmpty(session.PhoneNumber))
                                            {
                                                <p class="text-sm text-gray-600">📱 @session.PhoneNumber</p>
                                            }
                                            <p class="text-xs text-gray-500 mt-1">
                                                @(session.LastMessageAt?.ToString("dd/MM HH:mm") ?? session.CreatedAt.ToString("dd/MM HH:mm"))
                                            </p>
                                        </div>
                                        @if (session.HasUnreadVisitorMessages)
                                        {
                                            <div class="bg-red-500 text-white text-xs rounded-full px-2 py-1">
                                                New
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-gray-500 py-8">
                            <svg class="w-12 h-12 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                            </svg>
                            <p>@Localizer["NoActiveChats"]</p>
                        </div>
                    }
                </div>

                <!-- Chat Messages -->
                <div class="lg:col-span-2 flex flex-col">
                    @if (selectedSession != null)
                    {
                        <!-- Chat Header -->
                        <div class="bg-gray-50 p-4 rounded-t-lg border-b border-gray-200">
                            <h3 class="font-semibold text-gray-800">@Localizer["ChatWith"] @selectedSession.VisitorName</h3>
                            <div class="mt-2 space-y-1">
                                @if (!string.IsNullOrEmpty(selectedSession.VisitorEmail))
                                {
                                    <p class="text-sm text-gray-600">📧 @selectedSession.VisitorEmail</p>
                                }
                                @if (!string.IsNullOrEmpty(selectedSession.PhoneNumber))
                                {
                                    <p class="text-sm text-gray-600">📱 @selectedSession.PhoneNumber</p>
                                }
                                <p class="text-xs text-gray-500">🌐 IP: @selectedSession.IpAddress</p>
                            </div>
                        </div>

                        <!-- Messages Container -->
                        <div class="flex-1 p-4 overflow-y-auto bg-gray-50 max-h-64" @ref="messagesContainer">
                            @if (currentMessages.Any())
                            {
                                @foreach (var message in currentMessages)
                                {
                                    <div class="mb-4 @(message.SenderType == ChatSenderType.Admin ? "text-right" : "text-left")">
                                        <div class="inline-block max-w-xs lg:max-w-md px-4 py-2 rounded-lg @(message.SenderType == ChatSenderType.Admin ? "bg-blue-500 text-white" : "bg-white text-gray-800 border border-gray-200")">
                                            <div class="text-sm">@message.Content</div>
                                            <div class="text-xs opacity-70 mt-1">
                                                @message.SenderName - @message.CreatedAt.ToString("HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-gray-500 text-sm">
                                    No messages yet...
                                </div>
                            }
                        </div>

                        <!-- Message Input -->
                        <div class="p-4 border-t bg-white rounded-b-lg">
                            <div class="flex gap-2">
                                <input @bind="replyMessage" 
                                       @onkeypress="@(async (e) => { if (e.Key == "Enter") await SendAdminMessage(); })"
                                       placeholder="@Localizer["TypeYourReply"]..."
                                       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       disabled="@isLoading" />
                                <button @onclick="SendAdminMessage" 
                                        disabled="@(isLoading || string.IsNullOrWhiteSpace(replyMessage))"
                                        class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors disabled:opacity-50">
                                    @Localizer["Send"]
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex-1 flex items-center justify-center text-gray-500">
                            <div class="text-center">
                                <svg class="w-16 h-16 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.02-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                                </svg>
                                <p>@Localizer["SelectChatToView"]</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ChatSession> chatSessions = new();
    private ChatSession? selectedSession;
    private List<ChatMessage> currentMessages = new();
    private ElementReference messagesContainer;
    private string replyMessage = string.Empty;
    private bool isLoading = false;
    private Timer? refreshTimer;
    private DateTime lastUpdate = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        await LoadChatSessions();
        
        // Setup refresh timer
        refreshTimer = new Timer(2000); // Check every 2 seconds
        refreshTimer.Elapsed += async (sender, e) => await RefreshData();
        refreshTimer.AutoReset = true;
        refreshTimer.Enabled = true;
    }

    private async Task RefreshData()
    {
        try
        {
            // Refresh sessions
            var updatedSessions = await ChatService.GetActiveSessionsAsync();
            var updatedSessionsList = updatedSessions.ToList();
            var hasNewSessions = updatedSessionsList.Count != chatSessions.Count ||
                                updatedSessionsList.Any(s => !chatSessions.Any(cs => cs.Id == s.Id));
            
            if (hasNewSessions)
            {
                chatSessions = updatedSessionsList;
                await InvokeAsync(StateHasChanged);
            }

            // Refresh current messages if a session is selected
            if (selectedSession != null)
            {
                var messages = await ChatService.GetMessagesAsync(selectedSession.Id);
                var messagesList = messages.ToList();
                if (messagesList.Count != currentMessages.Count)
                {
                    currentMessages = messagesList;
                    
                    // Mark visitor messages as read
                    await ChatService.MarkMessagesAsReadAsync(selectedSession.Id, ChatSenderType.Visitor);
                    
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing data: {ex.Message}");
        }
    }

    private async Task LoadChatSessions()
    {
        try
        {
            chatSessions = (await ChatService.GetActiveSessionsAsync()).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading chat sessions: {ex.Message}");
        }
    }

    private async Task SelectSession(ChatSession session)
    {
        selectedSession = session;
        await LoadMessages();
        
        // Mark visitor messages as read
        try
        {
            await ChatService.MarkMessagesAsReadAsync(session.Id, ChatSenderType.Visitor);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking messages as read: {ex.Message}");
        }
    }

    private async Task LoadMessages()
    {
        if (selectedSession == null) return;
        
        try
        {
            currentMessages = (await ChatService.GetMessagesAsync(selectedSession.Id)).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading messages: {ex.Message}");
        }
    }

    private async Task SendAdminMessage()
    {
        if (selectedSession == null || isLoading || string.IsNullOrWhiteSpace(replyMessage))
            return;

        isLoading = true;
        var content = replyMessage.Trim();
        replyMessage = string.Empty;
        StateHasChanged();

        try
        {
            var message = await ChatService.SendMessageAsync(
                selectedSession.Id,
                ChatSenderType.Admin,
                Localizer["Admin"],
                content);

            if (message != null)
            {
                currentMessages.Add(message);
                ToastService.ShowSuccess(Localizer["MessageSentSuccessfully"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Localizer["ErrorSendingMessage"]);
            Console.WriteLine($"Error sending admin message: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}