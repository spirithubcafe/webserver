@page "/admin/pages/delivery"
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Web.Components.Shared
@inject IDeliveryPolicyService DeliveryPolicyService
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Delivery Policy Page Management - SpirithubCafe</PageTitle>

<div class="min-h-screen bg-[#F8F9FA] p-4">
    <!-- Header Section -->
    <div class="mb-8">
        <div class="bg-white rounded-lg shadow-sm border border-[#D3DAD9]/20 overflow-hidden">
            <div class="bg-[#37353E] text-[#D3DAD9] px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h1 class="text-xl font-bold">@Localizer["DeliveryPolicyManagement"]</h1>
                    </div>
                </div>
            </div>
            
            <!-- Page Settings -->
            <div class="p-6">
                <EditForm Model="aboutUsPage" OnValidSubmit="SavePageSettings" FormName="DeliveryPolicyPageForm">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- English Fields -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">English Content</h3>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Page Title</label>
                                <InputText @bind-Value="aboutUsPage.Title" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="Delivery Policy" />
                                <ValidationMessage For="@(() => aboutUsPage.Title)" class="text-red-500 text-sm" />
                            </div>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Page Subtitle</label>
                                <InputText @bind-Value="aboutUsPage.Subtitle" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="Learn more about our story" />
                            </div>
                        </div>
                        
                        <!-- Arabic Fields -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Arabic Content</h3>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Page Title (Arabic)</label>
                                <InputText @bind-Value="aboutUsPage.TitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent text-right" placeholder="من نحن" dir="rtl" />
                                <ValidationMessage For="@(() => aboutUsPage.TitleAr)" class="text-red-500 text-sm" />
                            </div>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Page Subtitle (Arabic)</label>
                                <InputText @bind-Value="aboutUsPage.SubtitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent text-right" placeholder="تعرف على قصتنا" dir="rtl" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Background Settings -->
                    <div class="mt-6 space-y-4">
                        <h3 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Background Settings</h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Background Type</label>
                                <select @onchange="OnPageBgTypeChanged" value="@aboutUsPage.BgType" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent">
                                    <option value="color">Color</option>
                                    <option value="image">Image</option>
                                    <option value="video">Video</option>
                                </select>
                            </div>
                            
                            @if (aboutUsPage.BgType == "color")
                            {
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Background Color</label>
                                    <div class="flex gap-2">
                                        <input type="color" @bind="aboutUsPage.BgValue" class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                        <InputText @bind-Value="aboutUsPage.BgValue" class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="#ffffff" />
                                    </div>
                                </div>
                            }
                            
                            @if (aboutUsPage.BgType == "image" || aboutUsPage.BgType == "video")
                            {
                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">@(aboutUsPage.BgType == "image" ? "Background Image" : "Background Video")</label>
                                    <FileUpload FileType="@aboutUsPage.BgType" Folder="backgrounds" Prefix="@($"page-{aboutUsPage.BgType}")" @bind-CurrentFileUrl="aboutUsPage.BgValue" />
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="mt-6 flex justify-end">
                        <button type="submit" disabled="@isLoading" class="bg-[#37353E] text-[#D3DAD9] px-6 py-3 rounded-lg hover:bg-[#44444E] transition-all duration-200 font-medium flex items-center">
                            @if (isLoading)
                            {
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            }
                            Save Page Settings
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    
    <!-- Sections Management -->
    <div class="bg-white rounded-lg shadow-sm border border-[#D3DAD9]/20 overflow-hidden">
        <div class="bg-[#37353E] text-[#D3DAD9] px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-5H9m10 9H3"></path>
                    </svg>
                    <h2 class="text-lg font-semibold">Dynamic Sections</h2>
                </div>
                <button @onclick="OpenSectionModal" class="bg-[#715A5A] text-white px-4 py-2 rounded-lg hover:bg-[#715A5A]/80 transition-all duration-200 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Add Section
                </button>
            </div>
        </div>
        
        <div class="p-6">
            @if (sections.Any())
            {
                <div class="space-y-4">
                    @foreach (var currentSection in sections.OrderBy(s => s.DisplayOrder))
                    {
                        <div class="border border-[#D3DAD9]/20 rounded-lg p-4 bg-gray-50">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center space-x-3">
                                    <div class="flex flex-col space-y-1">
                                        <button @onclick="() => MoveSectionUp(currentSection.Id)" disabled="@(currentSection.DisplayOrder == 1)" class="text-[#37353E] hover:text-[#715A5A] disabled:text-gray-300">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                            </svg>
                                        </button>
                                        <button @onclick="() => MoveSectionDown(currentSection.Id)" disabled="@(currentSection.DisplayOrder == sections.Count)" class="text-[#37353E] hover:text-[#715A5A] disabled:text-gray-300">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <div>
                                        <h4 class="font-semibold text-[#37353E]">@currentSection.Title</h4>
                                        <p class="text-sm text-gray-600">Layout: @GetLayoutDisplayName(currentSection.LayoutType)</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <button @onclick="() => EditSection(currentSection)" class="text-[#715A5A] hover:text-[#37353E] p-2 rounded">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </button>
                                    <button @onclick="() => DeleteSection(currentSection.Id)" class="text-red-500 hover:text-red-700 p-2 rounded">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Section Preview -->
                            <div class="text-sm text-gray-600">
                                @if (!string.IsNullOrEmpty(currentSection.Content))
                                {
                                    <p>@((currentSection.Content.Length > 100) ? currentSection.Content.Substring(0, 100) + "..." : currentSection.Content)</p>
                                }
                                @if (!string.IsNullOrEmpty(currentSection.ImagePath))
                                {
                                    <div class="mt-2">
                                        <img src="@currentSection.ImagePath" alt="@currentSection.ImageAlt" class="w-20 h-20 object-cover rounded border" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14-5H9m10 9H3"></path>
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-gray-900">No sections yet</h3>
                    <p class="mt-2 text-gray-600">Get started by creating your first about us currentSection.</p>
                    <button @onclick="OpenSectionModal" class="mt-4 bg-[#37353E] text-[#D3DAD9] px-6 py-2 rounded-lg hover:bg-[#44444E] transition-all duration-200">
                        Add First Section
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Section Modal -->
@if (showSectionModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            <div class="bg-[#37353E] text-[#D3DAD9] px-6 py-4 flex items-center justify-between">
                <h3 class="text-lg font-semibold">@(isEditingSection ? "Edit Section" : "Add New Section")</h3>
                <button @onclick="CloseSectionModal" class="text-[#D3DAD9] hover:text-white">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            
            <EditForm Model="currentSection" OnValidSubmit="SaveSection" FormName="SectionForm">
                <DataAnnotationsValidator />
                <div class="p-6 space-y-6">
                    
                    <!-- Layout Type Selection -->
                    <div class="space-y-4">
                        <h4 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Layout Type</h4>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            @foreach (var layoutType in GetLayoutTypes())
                            {
                                <div class="relative">
                                    <button type="button" @onclick="() => OnLayoutTypeChanged(layoutType.Key)" class="w-full">
                                        <div class="border-2 @(currentSection.LayoutType == layoutType.Key ? "border-[#37353E] bg-[#37353E]/5" : "border-gray-200") rounded-lg p-4 text-center hover:border-[#715A5A] transition-all">
                                            <div class="@layoutType.Value.IconClass mb-2">
                                                @if (layoutType.Key == "image-right-text-left")
                                                {
                                                    <span class="text-xs">📝🖼️</span>
                                                }
                                                else if (layoutType.Key == "image-left-text-right")
                                                {
                                                    <span class="text-xs">🖼️📝</span>
                                                }
                                                else if (layoutType.Key == "text-only")
                                                {
                                                    <span class="text-xs">📝</span>
                                                }
                                                else if (layoutType.Key == "image-only")
                                                {
                                                    <span class="text-xs">🖼️</span>
                                                }
                                            </div>
                                            <div class="text-sm font-medium text-gray-700">@layoutType.Value.Name</div>
                                            @if (currentSection.LayoutType == layoutType.Key)
                                            {
                                                <div class="mt-2">
                                                    <svg class="w-4 h-4 mx-auto text-[#37353E]" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                    </svg>
                                                </div>
                                            }
                                        </div>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Content Fields -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- English Fields -->
                        <div class="space-y-4">
                            <h4 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">English Content</h4>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title</label>
                                <InputText @bind-Value="currentSection.Title" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="Section title" />
                                <ValidationMessage For="@(() => currentSection.Title)" class="text-red-500 text-sm" />
                            </div>
                            
                            @if (currentSection.LayoutType != "image-only")
                            {
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Content</label>
                                    <InputTextArea @bind-Value="currentSection.Content" rows="6" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="Section content..." />
                                </div>
                            }
                        </div>
                        
                        <!-- Arabic Fields -->
                        <div class="space-y-4">
                            <h4 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Arabic Content</h4>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (Arabic)</label>
                                <InputText @bind-Value="currentSection.TitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent text-right" placeholder="عنوان القسم" dir="rtl" />
                                <ValidationMessage For="@(() => currentSection.TitleAr)" class="text-red-500 text-sm" />
                            </div>
                            
                            @if (currentSection.LayoutType != "image-only")
                            {
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Content (Arabic)</label>
                                    <InputTextArea @bind-Value="currentSection.ContentAr" rows="6" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent text-right" placeholder="محتوى القسم..." dir="rtl" />
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Image Upload -->
                    @if (currentSection.LayoutType != "text-only")
                    {
                        <div class="space-y-4">
                            <h4 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Image Settings</h4>
                            
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Section Image</label>
                                    <FileUpload FileType="image" Folder="delivery-policy" Prefix="section" @bind-CurrentFileUrl="currentSection.ImagePath" />
                                </div>
                                
                                <div class="space-y-4">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Image Alt Text (English)</label>
                                        <InputText @bind-Value="currentSection.ImageAlt" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="Image description" />
                                    </div>
                                    
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Image Alt Text (Arabic)</label>
                                        <InputText @bind-Value="currentSection.ImageAltAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent text-right" placeholder="وصف الصورة" dir="rtl" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Background Settings -->
                    <div class="space-y-4">
                        <h4 class="text-lg font-semibold text-[#37353E] border-b border-[#D3DAD9]/20 pb-2">Background Settings</h4>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Background Type</label>
                                <select @onchange="OnSectionBgTypeChanged" value="@currentSection.BgType" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent">
                                    <option value="color">Color</option>
                                    <option value="image">Image</option>
                                    <option value="video">Video</option>
                                </select>
                            </div>
                            
                            @if (currentSection.BgType == "color")
                            {
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">Background Color</label>
                                    <div class="flex gap-2">
                                        <input type="color" @bind="currentSection.BgValue" class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                        <InputText @bind-Value="currentSection.BgValue" class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#37353E] focus:border-transparent" placeholder="#ffffff" />
                                    </div>
                                </div>
                            }
                            
                            @if (currentSection.BgType == "image" || currentSection.BgType == "video")
                            {
                                <div class="md:col-span-2 space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">@(currentSection.BgType == "image" ? "Background Image" : "Background Video")</label>
                                    <FileUpload FileType="@currentSection.BgType" Folder="backgrounds" Prefix="@($"section-{currentSection.BgType}")" @bind-CurrentFileUrl="currentSection.BgValue" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3">
                    <button type="button" @onclick="CloseSectionModal" class="px-6 py-2 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-all duration-200">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isLoading" class="bg-[#37353E] text-[#D3DAD9] px-6 py-2 rounded-lg hover:bg-[#44444E] transition-all duration-200 font-medium flex items-center">
                        @if (isLoading)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        }
                        @(isEditingSection ? "Update Section" : "Add Section")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private DeliveryPolicyPage aboutUsPage = new();
    private List<DeliveryPolicySection> sections = new();
    private DeliveryPolicySection currentSection = new() 
    { 
        LayoutType = "image-right-text-left",
        BgType = "color",
        BgValue = "#ffffff"
    };
    private bool showSectionModal = false;
    private bool isEditingSection = false;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var page = await DeliveryPolicyService.GetDeliveryPolicyPageAsync();
            if (page != null)
            {
                aboutUsPage = page;
                sections = page.Sections.OrderBy(s => s.DisplayOrder).ToList();
            }
            else
            {
                sections = await DeliveryPolicyService.GetDeliveryPolicySectionsAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
    }

    private async Task SavePageSettings()
    {
        if (isLoading) return;

        try
        {
            isLoading = true;
            await DeliveryPolicyService.CreateOrUpdateDeliveryPolicyPageAsync(aboutUsPage);
            ToastService.ShowSuccess("Page settings saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving page settings: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenSectionModal()
    {
        currentSection = new DeliveryPolicySection
        {
            DeliveryPolicyPageId = aboutUsPage?.Id ?? 0,
            LayoutType = "image-right-text-left",
            BgType = "color",
            BgValue = "#ffffff",
            Title = "",
            TitleAr = "",
            Content = "",
            ContentAr = "",
            ImagePath = "",
            ImageAlt = "",
            ImageAltAr = "",
            IsActive = true
        };
        isEditingSection = false;
        showSectionModal = true;
    }

    private void EditSection(DeliveryPolicySection sectionToEdit)
    {
        currentSection = new DeliveryPolicySection
        {
            Id = sectionToEdit.Id,
            DeliveryPolicyPageId = sectionToEdit.DeliveryPolicyPageId,
            Title = sectionToEdit.Title,
            TitleAr = sectionToEdit.TitleAr,
            Content = sectionToEdit.Content,
            ContentAr = sectionToEdit.ContentAr,
            ImagePath = sectionToEdit.ImagePath,
            ImageAlt = sectionToEdit.ImageAlt,
            ImageAltAr = sectionToEdit.ImageAltAr,
            LayoutType = sectionToEdit.LayoutType,
            BgType = sectionToEdit.BgType,
            BgValue = sectionToEdit.BgValue,
            DisplayOrder = sectionToEdit.DisplayOrder,
            IsActive = sectionToEdit.IsActive,
            CreatedAt = sectionToEdit.CreatedAt,
            UpdatedAt = sectionToEdit.UpdatedAt
        };
        isEditingSection = true;
        showSectionModal = true;
    }

    private void CloseSectionModal()
    {
        showSectionModal = false;
        currentSection = new();
        isEditingSection = false;
    }

    private async Task SaveSection()
    {
        if (isLoading) return;

        try
        {
            isLoading = true;

            if (isEditingSection)
            {
                await DeliveryPolicyService.UpdateDeliveryPolicySectionAsync(currentSection);
                ToastService.ShowSuccess("Section updated successfully!");
            }
            else
            {
                await DeliveryPolicyService.CreateDeliveryPolicySectionAsync(currentSection);
                ToastService.ShowSuccess("Section added successfully!");
            }

            await LoadData();
            CloseSectionModal();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving section: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteSection(int sectionId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this section?"))
        {
            try
            {
                await DeliveryPolicyService.DeleteDeliveryPolicySectionAsync(sectionId);
                ToastService.ShowSuccess("Section deleted successfully!");
                await LoadData();
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting section: {ex.Message}");
            }
        }
    }

    private async Task MoveSectionUp(int sectionId)
    {
        try
        {
            var section = sections.FirstOrDefault(s => s.Id == sectionId);
            if (section == null || section.DisplayOrder == 1) return;

            var previousSection = sections.FirstOrDefault(s => s.DisplayOrder == section.DisplayOrder - 1);
            if (previousSection != null)
            {
                // Swap display orders
                var tempOrder = section.DisplayOrder;
                section.DisplayOrder = previousSection.DisplayOrder;
                previousSection.DisplayOrder = tempOrder;

                // Update both sections
                await DeliveryPolicyService.UpdateDeliveryPolicySectionAsync(section);
                await DeliveryPolicyService.UpdateDeliveryPolicySectionAsync(previousSection);
                
                await LoadData();
                ToastService.ShowSuccess("Section moved up successfully!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error moving section: {ex.Message}");
        }
    }

    private async Task MoveSectionDown(int sectionId)
    {
        try
        {
            var section = sections.FirstOrDefault(s => s.Id == sectionId);
            if (section == null || section.DisplayOrder == sections.Count) return;

            var nextSection = sections.FirstOrDefault(s => s.DisplayOrder == section.DisplayOrder + 1);
            if (nextSection != null)
            {
                // Swap display orders
                var tempOrder = section.DisplayOrder;
                section.DisplayOrder = nextSection.DisplayOrder;
                nextSection.DisplayOrder = tempOrder;

                // Update both sections
                await DeliveryPolicyService.UpdateDeliveryPolicySectionAsync(section);
                await DeliveryPolicyService.UpdateDeliveryPolicySectionAsync(nextSection);
                
                await LoadData();
                ToastService.ShowSuccess("Section moved down successfully!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error moving section: {ex.Message}");
        }
    }

    private void OnPageBgTypeChanged(ChangeEventArgs e)
    {
        aboutUsPage.BgType = e.Value?.ToString() ?? "color";
        if (aboutUsPage.BgType == "color" && string.IsNullOrEmpty(aboutUsPage.BgValue))
        {
            aboutUsPage.BgValue = "#ffffff";
        }
        StateHasChanged();
    }

    private void OnSectionBgTypeChanged(ChangeEventArgs e)
    {
        currentSection.BgType = e.Value?.ToString() ?? "color";
        if (currentSection.BgType == "color" && string.IsNullOrEmpty(currentSection.BgValue))
        {
            currentSection.BgValue = "#ffffff";
        }
        StateHasChanged();
    }

    private void OnLayoutTypeChanged(string layoutType)
    {
        if (currentSection != null)
        {
            currentSection.LayoutType = layoutType;
            
            // Clear image-related fields if switching to text-only
            if (layoutType == "text-only")
            {
                currentSection.ImagePath = null;
                currentSection.ImageAlt = null;
                currentSection.ImageAltAr = null;
            }
            
            StateHasChanged();
        }
    }

    private string GetLayoutDisplayName(string layoutType)
    {
        return layoutType switch
        {
            "image-right-text-left" => "Image Right, Text Left",
            "image-left-text-right" => "Image Left, Text Right",
            "text-only" => "Text Only",
            "image-only" => "Image Only",
            _ => layoutType
        };
    }

    private Dictionary<string, (string Name, string IconClass)> GetLayoutTypes()
    {
        return new Dictionary<string, (string Name, string IconClass)>
        {
            { "image-right-text-left", ("Image Right", "w-8 h-8 mx-auto bg-gradient-to-r from-blue-100 to-blue-200 rounded flex items-center justify-center text-xs font-mono") },
            { "image-left-text-right", ("Image Left", "w-8 h-8 mx-auto bg-gradient-to-l from-green-100 to-green-200 rounded flex items-center justify-center text-xs font-mono") },
            { "text-only", ("Text Only", "w-8 h-8 mx-auto bg-gradient-to-r from-gray-100 to-gray-200 rounded flex items-center justify-center text-xs font-mono") },
            { "image-only", ("Image Only", "w-8 h-8 mx-auto bg-gradient-to-r from-purple-100 to-purple-200 rounded flex items-center justify-center text-xs font-mono") }
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch { }
        }
    }
