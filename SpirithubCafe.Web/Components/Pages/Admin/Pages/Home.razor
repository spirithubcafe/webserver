@code {
    private HomePageSettings? settings;
    private bool saving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            settings = await HomePageSettingsService.GetSettingsAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading settings: {ex.Message}");
        }
        
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;
        
        saving = true;
        try
        {
            await HomePageSettingsService.UpdateSettingsAsync(settings);
            ToastService.ShowSuccess("Settings saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving settings: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
        
        StateHasChanged();
    }

    private void OnNewsletterBgTypeChanged(ChangeEventArgs e)
    {
        if (settings != null && e.Value != null)
        {
            settings.NewsletterBgType = e.Value.ToString();
            // Reset the background value when type changes
            settings.NewsletterBgValue = settings.NewsletterBgType switch
            {
                "color" => "#f8f9fa",
                "image" => "",
                "video" => "",
                _ => "#f8f9fa"
            };
        }
    }

    private void OnAboutUsBgTypeChanged(ChangeEventArgs e)
    {
        if (settings != null && e.Value != null)
        {
            settings.AboutUsBgType = e.Value.ToString();
            // Reset the background value when type changes
            settings.AboutUsBgValue = settings.AboutUsBgType switch
            {
                "color" => "#ffffff",
                "image" => "",
                "video" => "",
                _ => "#ffffff"
            };
        }
    }

    // Section Order Management
    public class SectionInfo
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public int Order { get; set; }
        public bool IsEnabled { get; set; }
    }



    private List<SectionInfo> GetSortedSections()
    {
        if (settings == null) return new List<SectionInfo>();

        var sections = new List<SectionInfo>
        {
            new() { Name = "slideshow", DisplayName = "Slideshow", Description = "Hero image slider", Order = settings.SlideshowOrder, IsEnabled = settings.ShowSlideshow },
            new() { Name = "categories", DisplayName = "Categories", Description = "Product categories grid", Order = settings.CategoriesOrder, IsEnabled = settings.ShowCategories },
            new() { Name = "mission", DisplayName = "Mission", Description = "Company mission statement", Order = settings.MissionOrder, IsEnabled = settings.ShowMission },
            new() { Name = "latestproducts", DisplayName = "Latest Products", Description = "Recently added products", Order = settings.LatestProductsOrder, IsEnabled = settings.ShowLatestProducts },
            new() { Name = "aboutus", DisplayName = "About Us", Description = "Company information", Order = settings.AboutUsOrder, IsEnabled = settings.ShowAboutUs },
            new() { Name = "newsletter", DisplayName = "Newsletter", Description = "Email subscription", Order = settings.NewsletterOrder, IsEnabled = settings.ShowNewsletter }
        };

        return sections.OrderBy(s => s.Order).ToList();
    }

    private void MoveSection(string sectionName, int direction)
    {
        if (settings == null) return;
        
        var sections = GetSortedSections();
        var currentIndex = sections.FindIndex(s => s.Name.Equals(sectionName, StringComparison.OrdinalIgnoreCase));
        
        if (currentIndex == -1) return;
        
        var newIndex = currentIndex + direction;
        if (newIndex < 0 || newIndex >= sections.Count) return;

        // Swap order values
        var currentSection = sections[currentIndex];
        var targetSection = sections[newIndex];
        
        var tempOrder = currentSection.Order;
        
        // Update the order in the settings object
        UpdateSectionOrder(currentSection.Name, targetSection.Order);
        UpdateSectionOrder(targetSection.Name, tempOrder);
        
        StateHasChanged();
    }

    private void UpdateSectionOrder(string sectionName, int newOrder)
    {
        if (settings == null) return;

        switch (sectionName.ToLower())
        {
            case "slideshow":
                settings.SlideshowOrder = newOrder;
                break;
            case "categories":
                settings.CategoriesOrder = newOrder;
                break;
            case "mission":
                settings.MissionOrder = newOrder;
                break;
            case "latestproducts":
                settings.LatestProductsOrder = newOrder;
                break;
            case "aboutus":
                settings.AboutUsOrder = newOrder;
                break;
            case "newsletter":
                settings.NewsletterOrder = newOrder;
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
            catch { }
        }
    }
}