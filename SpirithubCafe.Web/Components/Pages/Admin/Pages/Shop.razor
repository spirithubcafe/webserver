@page "/admin/pages/shop"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpirithubCafe.Web.Components.Shared
@using SpirithubCafe.Application.DTOs
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@inject ToastService ToastService
@rendermode InteractiveServer

<PageTitle>Shop Page Settings - SpirithubCafe</PageTitle>

<Toast />

<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Page Header -->
        <div class="bg-white shadow-sm rounded-lg mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Shop Page Settings</h1>
                        <p class="mt-1 text-sm text-gray-600">Configure title, subtitle, background and appearance of your shop page</p>
                    </div>
                    <div class="mt-4 sm:mt-0">
                        <button type="button" @onclick="SaveSettings" disabled="@saving" 
                                class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 disabled:opacity-50 disabled:cursor-not-allowed transition duration-200">
                            @if (saving)
                            {
                                <svg class="animate-spin -ml-1 mr-3 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <text>Saving...</text>
                            }
                            else
                            {
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                <text>Save Changes</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            
            <!-- Page Title Section -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Page Title</h3>
                            <p class="text-sm text-gray-600">Configure the main title and subtitle displayed on the shop page</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 space-y-6">
                    <!-- Title English -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Title (English)</label>
                        <input type="text" @bind="titleEn" @bind:event="oninput"
                               class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                               placeholder="Premium Coffee Collection" />
                    </div>
                    
                    <!-- Title Arabic -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Title (Arabic)</label>
                        <input type="text" @bind="titleAr" @bind:event="oninput" dir="rtl"
                               class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                               placeholder="مجموعة القهوة المتميزة" />
                    </div>
                    
                    <!-- Subtitle English -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Subtitle (English)</label>
                        <textarea @bind="subtitleEn" @bind:event="oninput" rows="3"
                                  class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"
                                  placeholder="Discover our carefully curated selection of single-origin beans and signature blends from around the world."></textarea>
                    </div>
                    
                    <!-- Subtitle Arabic -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Subtitle (Arabic)</label>
                        <textarea @bind="subtitleAr" @bind:event="oninput" rows="3" dir="rtl"
                                  class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"
                                  placeholder="اكتشف مجموعتنا المختارة بعناية من حبوب القهوة المنفردة المنشأ والمخاليط المميزة من جميع أنحاء العالم."></textarea>
                    </div>
                </div>
            </div>

            <!-- Background Section -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Background Settings</h3>
                            <p class="text-sm text-gray-600">Configure the background appearance of the shop page</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 space-y-6">
                    
                    <!-- Background Type Selection -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Background Type</label>
                        <select @onchange="OnBgTypeChanged" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                            <option value="color" selected="@(bgType == "color")">Color</option>
                            <option value="image" selected="@(bgType == "image")">Image</option>
                            <option value="video" selected="@(bgType == "video")">Video</option>
                        </select>
                    </div>

                    <!-- Color Picker (when color is selected) -->
                    @if (bgType == "color")
                    {
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">Background Color</label>
                            <div class="flex gap-2">
                                <input type="color" @bind="bgValue" @bind:event="oninput"
                                       class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                <input type="text" @bind="bgValue" @bind:event="oninput"
                                       class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                                       placeholder="#f3f4f6" />
                            </div>
                        </div>
                    }

                    <!-- File Upload (when image or video is selected) -->
                    @if (bgType == "image" || bgType == "video")
                    {
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @(bgType == "image" ? "Background Image" : "Background Video")
                            </label>
                            <FileUpload FileType="@(bgType == "image" ? "image" : "video")"
                                        Folder="backgrounds"
                                        Prefix="@($"shop-{bgType}")"
                                        @bind-CurrentFileUrl="bgValue" />
                        </div>
                    }
                </div>
            </div>

            <!-- Text Style Section -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17v4a2 2 0 002 2h4M13 13h4a2 2 0 012 2v4a2 2 0 01-2 2H9a2 2 0 01-2-2v-4a2 2 0 012-2z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Text Style</h3>
                            <p class="text-sm text-gray-600">Configure text colors for optimal readability</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6 space-y-6">
                    
                    <!-- Title Text Color -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Title Text Color</label>
                        <div class="flex gap-2">
                            <input type="color" @bind="titleTextColor" @bind:event="oninput"
                                   class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                            <input type="text" @bind="titleTextColor" @bind:event="oninput"
                                   class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
                                   placeholder="#1f2937" />
                        </div>
                    </div>
                    
                    <!-- Subtitle Text Color -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Subtitle Text Color</label>
                        <div class="flex gap-2">
                            <input type="color" @bind="subtitleTextColor" @bind:event="oninput"
                                   class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                            <input type="text" @bind="subtitleTextColor" @bind:event="oninput"
                                   class="flex-1 px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
                                   placeholder="#6b7280" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preview Section -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Preview</h3>
                            <p class="text-sm text-gray-600">See how your shop page will look</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-6">
                    <div class="relative rounded-lg overflow-hidden border border-gray-200"
                         style="@GetPreviewBackgroundStyle()">
                        <div class="relative px-8 py-16 text-center">
                            <h1 class="text-4xl md:text-5xl font-bold mb-4"
                                style="color: @titleTextColor">
                                @(!string.IsNullOrEmpty(titleEn) ? titleEn : "Premium Coffee Collection")
                            </h1>
                            <p class="text-xl max-w-2xl mx-auto"
                               style="color: @subtitleTextColor">
                                @(!string.IsNullOrEmpty(subtitleEn) ? subtitleEn : "Discover our carefully curated selection of single-origin beans and signature blends from around the world.")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private bool saving = false;
    
    // Title settings
    private string titleEn = "";
    private string titleAr = "";
    private string subtitleEn = "";
    private string subtitleAr = "";
    
    // Background settings
    private string bgType = "color";
    private string bgValue = "#f3f4f6";
    
    // Text color settings
    private string titleTextColor = "#1f2937";
    private string subtitleTextColor = "#6b7280";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }
    
    private async Task LoadSettings()
    {
        try
        {
            titleEn = await SettingService.GetValueAsync("ShopTitleEn", "Premium Coffee Collection");
            titleAr = await SettingService.GetValueAsync("ShopTitleAr", "مجموعة القهوة المتميزة");
            subtitleEn = await SettingService.GetValueAsync("ShopSubtitleEn", "Discover our carefully curated selection of single-origin beans and signature blends from around the world.");
            subtitleAr = await SettingService.GetValueAsync("ShopSubtitleAr", "اكتشف مجموعتنا المختارة بعناية من حبوب القهوة المنفردة المنشأ والمخاليط المميزة من جميع أنحاء العالم.");
            
            bgType = await SettingService.GetValueAsync("ShopBgType", "color");
            bgValue = await SettingService.GetValueAsync("ShopBgValue", "#f3f4f6");
            
            titleTextColor = await SettingService.GetValueAsync("ShopTitleTextColor", "#1f2937");
            subtitleTextColor = await SettingService.GetValueAsync("ShopSubtitleTextColor", "#6b7280");
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading settings: {ex.Message}");
        }
    }
    
    private async Task SaveSettings()
    {
        try
        {
            saving = true;
            StateHasChanged();
            
            // Save title settings
            await UpdateSettingAsync("ShopTitleEn", titleEn);
            await UpdateSettingAsync("ShopTitleAr", titleAr);
            await UpdateSettingAsync("ShopSubtitleEn", subtitleEn);
            await UpdateSettingAsync("ShopSubtitleAr", subtitleAr);
            
            // Save background settings
            await UpdateSettingAsync("ShopBgType", bgType);
            await UpdateSettingAsync("ShopBgValue", bgValue);
            
            // Save text color settings
            await UpdateSettingAsync("ShopTitleTextColor", titleTextColor);
            await UpdateSettingAsync("ShopSubtitleTextColor", subtitleTextColor);
            
            ToastService.ShowSuccess("Shop settings saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving settings: {ex.Message}");
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }
    
    private async Task UpdateSettingAsync(string key, string value)
    {
        try
        {
            var exists = await SettingService.ExistsAsync(key);
            
            if (exists)
            {
                await SettingService.UpdateAsync(key, new SpirithubCafe.Application.DTOs.UpdateSettingDto { Value = value });
            }
            else
            {
                await SettingService.CreateAsync(new SpirithubCafe.Application.DTOs.CreateSettingDto 
                { 
                    Key = key, 
                    Value = value,
                    Category = "Shop",
                    DataType = key.EndsWith("Color") ? "Color" : "Text"
                });
            }
        }
        catch (Exception ex)
        {
            throw new Exception($"Error saving setting {key}: {ex.Message}");
        }
    }
    
    private void OnBgTypeChanged(ChangeEventArgs e)
    {
        bgType = e.Value?.ToString() ?? "color";
        
        // Reset background value when type changes
        if (bgType == "color")
        {
            bgValue = "#f3f4f6";
        }
        else
        {
            bgValue = "";
        }
        
        StateHasChanged();
    }
    
    private string GetPreviewBackgroundStyle()
    {
        return bgType switch
        {
            "color" => $"background-color: {bgValue};",
            "image" when !string.IsNullOrEmpty(bgValue) => $"background-image: url('{bgValue}'); background-size: cover; background-position: center; background-repeat: no-repeat;",
            "video" when !string.IsNullOrEmpty(bgValue) => $"background-color: #f3f4f6;", // Fallback for video preview
            _ => "background-color: #f3f4f6;"
        };
    }
}