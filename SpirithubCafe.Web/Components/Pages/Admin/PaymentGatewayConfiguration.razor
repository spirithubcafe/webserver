                                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                                        </svg>
                                                    }
                                                    <div>
                                                        <p class="text-sm font-medium text-gray-900">@result.UrlType</p>
                                                        <p class="text-xs text-gray-500">@result.Url</p>
                                                    </div>
                                                </div>
                                                <div class="text-right">
                                                    <p class="text-sm @(result.IsSuccess ? "text-green-600" : "text-red-600")">
                                                        @result.StatusCode
                                                    </p>
                                                    <p class="text-xs text-gray-500">@result.ResponseTime ms</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                    <!-- Enhanced Actions Section -->
                    <div class="px-4 sm:px-6 py-6 bg-gradient-to-r from-gray-50 to-gray-100 border-t border-gray-200">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-4 sm:space-y-0">
                            <div class="flex flex-col sm:flex-row sm:items-center space-y-2 sm:space-y-0 sm:space-x-6">
                                <div class="flex items-center space-x-2 text-sm text-gray-600">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span>@Localizer["LastUpdated"]: @(settings.UpdatedAt.ToString("MMM dd, yyyy HH:mm"))</span>
                                </div>
                                <div class="flex items-center space-x-2 text-sm text-gray-600">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <span>Configuration Status: @(settings.IsEnabled ? "Active" : "Inactive")</span>
                                </div>
                            </div>
                            <div class="flex flex-col sm:flex-row items-stretch sm:items-center space-y-2 sm:space-y-0 sm:space-x-3">
                                <button type="button" @onclick="TestConnection" 
                                        class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-sm">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                    </svg>
                                    @Localizer["TestConnection"]
                                </button>
                                <button type="submit" disabled="@isSaving"
                                        class="inline-flex items-center justify-center px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg">
                                    @if (isSaving)
                                    {
                                        <span class="flex items-center">
                                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                            @Localizer["Saving"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="flex items-center">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            @Localizer["SaveSettings"]
                                        </span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        }

    </div>
</div>

<!-- Toast Component -->
<Toast />

@code {
    private PaymentGatewaySettings? settings;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showWorkingKey = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            isLoading = true;
            settings = await PaymentGatewayService.GetBankMuscatSettingsAsync();
            if (settings == null)
            {
                // Create default settings if none exist
                settings = new PaymentGatewaySettings
                {
                    GatewayName = "Bank Muscat",
                    Title = "Bank Muscat",
                    Description = "Pay securely by Credit or Debit card or internet banking through Bank Muscat Secure Servers.",
                    IsEnabled = false,
                    MerchantId = "224",
                    AccessCode = "AVDP00LA16BE47PDEB",
                    WorkingKey = "841FEAE32609C3E892C4D0B1393A7ACC",
                    IsSandboxMode = true,
                    LiveGatewayUrl = "https://secure.checkout.visa.com/payment/",
                    SandboxGatewayUrl = "https://secure.checkout.visa.com/payment/",
                    Currency = "OMR",
                    ReturnUrl = "/api/payment/callback/success",
                    CancelUrl = "/api/payment/callback/cancel",
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
            }
        }
        catch (Exception ex)
        {
            ShowToast($"{Localizer["ErrorLoadingSettings"]}: {ex.Message}", "error");
            // Create default settings on error
            settings = new PaymentGatewaySettings
            {
                GatewayName = "Bank Muscat",
                Title = "Bank Muscat",
                Description = "Pay securely by Credit or Debit card or internet banking through Bank Muscat Secure Servers.",
                IsEnabled = false,
                MerchantId = "224",
                AccessCode = "AVDP00LA16BE47PDEB",
                WorkingKey = "841FEAE32609C3E892C4D0B1393A7ACC",
                IsSandboxMode = true,
                LiveGatewayUrl = "https://secure.checkout.visa.com/payment/",
                SandboxGatewayUrl = "https://secure.checkout.visa.com/payment/",
                Currency = "OMR",
                ReturnUrl = "/api/payment/callback/success",
                CancelUrl = "/api/payment/callback/cancel",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;

        try
        {
            isSaving = true;
            settings.UpdatedAt = DateTime.UtcNow;
            await PaymentGatewayService.UpdateBankMuscatSettingsAsync(settings);
            ShowToast(Localizer["SettingsSavedSuccessfully"], "success");
        }
        catch (Exception ex)
        {
            ShowToast($"{Localizer["ErrorSavingSettings"]}: {ex.Message}", "error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ToggleWorkingKeyVisibility()
    {
        showWorkingKey = !showWorkingKey;
    }

    private async Task TestConnection()
    {
        if (settings == null) return;

        try
        {
            ShowToast(Localizer["TestingConnection"], "info");
            
            // Test connection using the service
            var result = await PaymentGatewayService.TestConnectionAsync();
            
            if (result)
            {
                ShowToast(Localizer["ConnectionTestSuccessful"], "success");
            }
            else
            {
                ShowToast(Localizer["ConnectionTestFailed"], "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"{Localizer["ErrorTestingConnection"]}: {ex.Message}", "error");
        }
    }

    private void ShowToast(string message, string type)
    {
        switch (type.ToLower())
        {
            case "success":
                ToastService.ShowSuccess(message);
                break;
            case "error":
                ToastService.ShowError(message);
                break;
            case "warning":
                ToastService.ShowWarning(message);
                break;
            case "info":
            default:
                ToastService.ShowInfo(message);
                break;
        }
    }

    // Additional properties for enhanced functionality
    private int webhookTimeout = 30;
    private bool isTestingUrls = false;
    private List<UrlTestResult> urlTestResults = new();

    public class UrlTestResult
    {
        public string UrlType { get; set; } = "";
        public string Url { get; set; } = "";
        public bool IsSuccess { get; set; } = false;
        public int StatusCode { get; set; } = 0;
        public long ResponseTime { get; set; } = 0;
    }

    private string GetFullUrl(string? relativePath)
    {
        if (string.IsNullOrEmpty(relativePath))
            return "";
            
        // Get the current request's base URL
        var currentUrl = NavigationManager.Uri;
        var uri = new Uri(currentUrl);
        var baseUrl = $"{uri.Scheme}://{uri.Host}{(uri.Port == 80 || uri.Port == 443 ? "" : $":{uri.Port}")}";
        
        if (relativePath.StartsWith("http"))
            return relativePath;
            
        return baseUrl + (relativePath.StartsWith("/") ? relativePath : "/" + relativePath);
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ShowToast("URL copied to clipboard!", "success");
        }
        catch
        {
            ShowToast("Failed to copy URL to clipboard", "error");
        }
    }

    private async Task TestCallbackUrls()
    {
        if (settings == null) return;

        try
        {
            isTestingUrls = true;
            urlTestResults.Clear();
            StateHasChanged();

            var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(webhookTimeout);

            // Test Success URL
            await TestUrl(httpClient, "Success Callback", GetFullUrl(settings.ReturnUrl));
            
            // Test Cancel URL
            await TestUrl(httpClient, "Cancel Callback", GetFullUrl(settings.CancelUrl));

            ShowToast("URL testing completed", "info");
        }
        catch (Exception ex)
        {
            ShowToast($"Error testing URLs: {ex.Message}", "error");
        }
        finally
        {
            isTestingUrls = false;
            StateHasChanged();
        }
    }

    private async Task TestUrl(HttpClient httpClient, string urlType, string url)
    {
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        var result = new UrlTestResult
        {
            UrlType = urlType,
            Url = url
        };

        try
        {
            var response = await httpClient.GetAsync(url);
            stopwatch.Stop();
            
            result.IsSuccess = response.IsSuccessStatusCode;
            result.StatusCode = (int)response.StatusCode;
            result.ResponseTime = stopwatch.ElapsedMilliseconds;
        }
        catch (HttpRequestException)
        {
            stopwatch.Stop();
            result.IsSuccess = false;
            result.StatusCode = 0;
            result.ResponseTime = stopwatch.ElapsedMilliseconds;
        }
        catch (TaskCanceledException)
        {
            stopwatch.Stop();
            result.IsSuccess = false;
            result.StatusCode = 408; // Request Timeout
            result.ResponseTime = stopwatch.ElapsedMilliseconds;
        }

        urlTestResults.Add(result);
        StateHasChanged();
    }
}