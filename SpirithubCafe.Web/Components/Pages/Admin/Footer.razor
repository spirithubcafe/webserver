@code {
    private FooterSettings settings = new();
    private List<FooterMenu> quickLinkMenus = new();
    private List<FooterMenu> legalPageMenus = new();
    private int activeTab = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            settings = await FooterService.GetFooterSettingsAsync();
            quickLinkMenus = await FooterService.GetFooterMenusByTypeAsync(FooterMenuType.QuickLinks);
            legalPageMenus = await FooterService.GetFooterMenusByTypeAsync(FooterMenuType.LegalPages);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            await FooterService.UpdateFooterSettingsAsync(settings);
            ToastService.ShowSuccess(Localizer["SaveChanges"] + " - Success!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private void OnBgTypeChanged(ChangeEventArgs e)
    {
        settings.BgType = e.Value?.ToString() ?? "color";
        if (settings.BgType == "color")
        {
            settings.BgValue = "#111827";
        }
        else
        {
            settings.BgValue = "";
        }
        StateHasChanged();
    }

    private void OnMenuItemsChanged()
    {
        StateHasChanged();
    }

    // Quick Links Management
    private void AddQuickLink()
    {
        quickLinkMenus.Add(new FooterMenu
        {
            MenuType = FooterMenuType.QuickLinks,
            SortOrder = quickLinkMenus.Count + 1,
            IsActive = true
        });
        StateHasChanged();
    }

    private async Task RemoveQuickLink(FooterMenu menu)
    {
        if (menu.Id > 0)
        {
            await FooterService.DeleteFooterMenuAsync(menu.Id);
        }
        quickLinkMenus.Remove(menu);
        // Reorder remaining items
        for (int i = 0; i < quickLinkMenus.Count; i++)
        {
            quickLinkMenus[i].SortOrder = i + 1;
        }
        StateHasChanged();
    }

    // Legal Pages Management
    private void AddLegalPage()
    {
        legalPageMenus.Add(new FooterMenu
        {
            MenuType = FooterMenuType.LegalPages,
            SortOrder = legalPageMenus.Count + 1,
            IsActive = true
        });
        StateHasChanged();
    }

    private async Task RemoveLegalPage(FooterMenu menu)
    {
        if (menu.Id > 0)
        {
            await FooterService.DeleteFooterMenuAsync(menu.Id);
        }
        legalPageMenus.Remove(menu);
        // Reorder remaining items
        for (int i = 0; i < legalPageMenus.Count; i++)
        {
            legalPageMenus[i].SortOrder = i + 1;
        }
        StateHasChanged();
    }

    // Save all settings and menu items
    private async Task SaveAllSettings()
    {
        try
        {
            // Save footer settings
            await FooterService.UpdateFooterSettingsAsync(settings);

            // Save quick links
            foreach (var menu in quickLinkMenus)
            {
                if (menu.Id > 0)
                {
                    await FooterService.UpdateFooterMenuAsync(menu);
                }
                else
                {
                    await FooterService.CreateFooterMenuAsync(menu);
                }
            }

            // Save legal pages
            foreach (var menu in legalPageMenus)
            {
                if (menu.Id > 0)
                {
                    await FooterService.UpdateFooterMenuAsync(menu);
                }
                else
                {
                    await FooterService.CreateFooterMenuAsync(menu);
                }
            }

            ToastService.ShowSuccess(Localizer["SaveChanges"] + " - Success!");
            await LoadData(); // Reload to get updated IDs
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }
}