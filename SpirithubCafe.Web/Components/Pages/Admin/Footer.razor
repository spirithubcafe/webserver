@page "/admin/footer"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using SpirithubCafe.Domain.Entities
@using SpirithubCafe.Application.Interfaces
@using SpirithubCafe.Web.Components.Shared
@inject TranslationLocalizer Localizer
@inject IFooterService FooterService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<div class="container mx-auto px-4 py-6">
    <div class="bg-white rounded-lg shadow-md">
        <!-- Header -->
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">@Localizer["FooterManagement"]</h1>
                    <p class="text-sm text-gray-600 mt-1">@Localizer["FooterSettings"]</p>
                </div>
                <button @onclick="SaveAllSettings" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors">
                    <i class="fas fa-save mr-2"></i>
                    @Localizer["SaveChanges"]
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="border-b border-gray-200">
            <nav class="flex space-x-8 px-6" aria-label="Tabs">
                <button @onclick="() => activeTab = 1" 
                        class="@(activeTab == 1 ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    @Localizer["GeneralSettings"]
                </button>
                <button @onclick="() => activeTab = 2" 
                        class="@(activeTab == 2 ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    @Localizer["QuickLinks"]
                </button>
                <button @onclick="() => activeTab = 3" 
                        class="@(activeTab == 3 ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    @Localizer["LegalPages"]
                </button>
                <button @onclick="() => activeTab = 4" 
                        class="@(activeTab == 4 ? "border-blue-500 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
                    @Localizer["SocialMedia"]
                </button>
            </nav>
        </div>

        <!-- Tab Content -->
        <div class="p-6">
            @if (activeTab == 1)
            {
                <!-- General Settings Tab -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Company Information -->
                    <div class="space-y-6">
                        <h3 class="text-lg font-semibold text-gray-900 border-b pb-2">@Localizer["CompanyInformation"]</h3>
                        
                        <!-- Logo -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">@Localizer["Logo"]</label>
                            <FileUpload FileType="image"
                                        Folder="footer"
                                        Prefix="logo"
                                        @bind-CurrentFileUrl="settings.LogoUrl" />
                        </div>

                        <!-- Company Name -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["CompanyName"] (English)</label>
                                <input type="text" @bind="settings.CompanyName" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["CompanyName"] (العربية)</label>
                                <input type="text" @bind="settings.CompanyNameAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Description"] (English)</label>
                                <textarea @bind="settings.Description" rows="4" class="w-full px-4 py-3 border border-gray-200 rounded-lg"></textarea>
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Description"] (العربية)</label>
                                <textarea @bind="settings.DescriptionAr" rows="4" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl"></textarea>
                            </div>
                        </div>

                        <!-- Copyright Text -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["CopyrightText"] (English)</label>
                                <input type="text" @bind="settings.CopyrightText" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["CopyrightText"] (العربية)</label>
                                <input type="text" @bind="settings.CopyrightTextAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>
                    </div>

                    <!-- Background & Appearance -->
                    <div class="space-y-6">
                        <h3 class="text-lg font-semibold text-gray-900 border-b pb-2">@Localizer["BackgroundAndAppearance"]</h3>
                        
                        <!-- Background Type -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">@Localizer["BackgroundType"]</label>
                            <select @onchange="OnBgTypeChanged" class="w-full px-4 py-3 border border-gray-200 rounded-lg">
                                <option value="color" selected="@(settings.BgType == "color")">@Localizer["Color"]</option>
                                <option value="image" selected="@(settings.BgType == "image")">@Localizer["Image"]</option>
                                <option value="video" selected="@(settings.BgType == "video")">@Localizer["Video"]</option>
                            </select>
                        </div>

                        <!-- Background Value -->
                        @if (settings.BgType == "color")
                        {
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["BackgroundColor"]</label>
                                <div class="flex gap-2">
                                    <input type="color" @bind="settings.BgValue" 
                                           class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                    <input type="text" @bind="settings.BgValue" 
                                               class="flex-1 px-4 py-3 border border-gray-200 rounded-lg" 
                                               placeholder="#111827" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    @(settings.BgType == "image" ? Localizer["BackgroundImage"] : Localizer["BackgroundVideo"])
                                </label>
                                <FileUpload FileType="@(settings.BgType == "image" ? "image" : "video")"
                                            Folder="footer"
                                            Prefix="@($"bg-{settings.BgType}")"
                                            @bind-CurrentFileUrl="settings.BgValue" />
                            </div>
                        }

                        <!-- Overlay Settings -->
                        @if (settings.BgType != "color")
                        {
                            <div class="space-y-4">
                                <div class="flex items-center">
                                    <input type="checkbox" @bind="settings.EnableOverlay" class="rounded border-gray-300 text-blue-600 shadow-sm" />
                                    <label class="ml-2 block text-sm font-semibold text-gray-700">@Localizer["EnableOverlay"]</label>
                                </div>

                                @if (settings.EnableOverlay)
                                {
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">@Localizer["OverlayType"]</label>
                                            <select @bind="settings.OverlayType" class="w-full px-4 py-3 border border-gray-200 rounded-lg">
                                                <option value="blur">@Localizer["Blur"]</option>
                                                <option value="mask">@Localizer["Mask"]</option>
                                                <option value="gradient">@Localizer["Gradient"]</option>
                                            </select>
                                        </div>
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">@Localizer["OverlayValue"]</label>
                                            <input type="text" @bind="settings.OverlayValue" 
                                                       class="w-full px-4 py-3 border border-gray-200 rounded-lg"
                                                       placeholder="@(settings.OverlayType == "blur" ? "5px" : "0.5")" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Text Colors -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["TextColor"]</label>
                                <div class="flex gap-2">
                                    <input type="color" @bind="settings.TextColor" 
                                           class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                    <input type="text" @bind="settings.TextColor" 
                                               class="flex-1 px-4 py-3 border border-gray-200 rounded-lg" 
                                               placeholder="#ffffff" />
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["AccentColor"]</label>
                                <div class="flex gap-2">
                                    <input type="color" @bind="settings.AccentColor" 
                                           class="w-12 h-10 border border-gray-200 rounded cursor-pointer" />
                                    <input type="text" @bind="settings.AccentColor" 
                                               class="flex-1 px-4 py-3 border border-gray-200 rounded-lg" 
                                               placeholder="#f59e0b" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Information Section -->
                <div class="mt-8 space-y-6">
                    <h3 class="text-lg font-semibold text-gray-900 border-b pb-2">@Localizer["ContactInformation"]</h3>
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Address -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Address"] (English)</label>
                                <input type="text" @bind="settings.Address" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Address"] (العربية)</label>
                                <input type="text" @bind="settings.AddressAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>

                        <!-- Phone Numbers -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Phone"] 1</label>
                                <input type="text" @bind="settings.Phone1" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["Phone"] 2</label>
                                <input type="text" @bind="settings.Phone2" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                        </div>

                        <!-- Email and Working Hours -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">@Localizer["Email"]</label>
                            <input type="email" @bind="settings.Email" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["WorkingHours"] (English)</label>
                                <input type="text" @bind="settings.WorkingHours" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">@Localizer["WorkingHours"] (العربية)</label>
                                <input type="text" @bind="settings.WorkingHoursAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == 2)
            {
                <!-- Quick Links Tab -->
                <div class="space-y-6">
                    <!-- Quick Links Settings -->
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">@Localizer["QuickLinks"] Management</h3>
                                <p class="text-sm text-gray-600">Manage quick navigation links in footer</p>
                            </div>
                            <button @onclick="AddQuickLink" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
                                <i class="fas fa-plus mr-2"></i>Add Link
                            </button>
                        </div>

                        <!-- Enable/Disable Quick Links -->
                        <div class="flex items-center">
                            <input type="checkbox" @bind="settings.ShowQuickLinks" class="rounded border-gray-300 text-blue-600 shadow-sm" />
                            <label class="ml-2 block text-sm font-semibold text-gray-700">Show Quick Links Section</label>
                        </div>

                        <!-- Section Titles -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (English)</label>
                                <input type="text" @bind="settings.QuickLinksTitle" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (العربية)</label>
                                <input type="text" @bind="settings.QuickLinksTitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>
                    </div>

                    <!-- Quick Links List -->
                    <div class="space-y-4">
                        @if (quickLinkMenus.Any())
                        {
                            @foreach (var link in quickLinkMenus)
                            {
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">
                                        <!-- Title -->
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Title (EN)</label>
                                            <input type="text" @bind="link.Title" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Title (AR)</label>
                                            <input type="text" @bind="link.TitleAr" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" dir="rtl" />
                                        </div>
                                        <!-- URL -->
                                        <div class="lg:col-span-3 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">URL</label>
                                            <input type="url" @bind="link.Url" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <!-- Icon -->
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Icon Class</label>
                                            <input type="text" @bind="link.IconClass" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" placeholder="fas fa-home" />
                                        </div>
                                        <!-- Order -->
                                        <div class="lg:col-span-1 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Order</label>
                                            <input type="number" @bind="link.SortOrder" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <!-- Actions -->
                                        <div class="lg:col-span-2 flex gap-2">
                                            <label class="flex items-center">
                                                <input type="checkbox" @bind="link.IsActive" class="rounded border-gray-300 text-blue-600 shadow-sm mr-1" />
                                                <span class="text-xs">Active</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="checkbox" @bind="link.OpenInNewTab" class="rounded border-gray-300 text-blue-600 shadow-sm mr-1" />
                                                <span class="text-xs">New Tab</span>
                                            </label>
                                            <button @onclick="() => RemoveQuickLink(link)" class="text-red-600 hover:text-red-800 p-1">
                                                <i class="fas fa-trash text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-8 text-gray-500">
                                <i class="fas fa-link text-2xl mb-2"></i>
                                <p>No quick links added yet. Click "Add Link" to get started.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == 3)
            {
                <!-- Legal Pages Tab -->
                <div class="space-y-6">
                    <!-- Legal Pages Settings -->
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">@Localizer["LegalPages"] Management</h3>
                                <p class="text-sm text-gray-600">Manage legal and policy links in footer</p>
                            </div>
                            <button @onclick="AddLegalPage" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
                                <i class="fas fa-plus mr-2"></i>Add Legal Page
                            </button>
                        </div>

                        <!-- Enable/Disable Legal Pages -->
                        <div class="flex items-center">
                            <input type="checkbox" @bind="settings.ShowLegalPages" class="rounded border-gray-300 text-blue-600 shadow-sm" />
                            <label class="ml-2 block text-sm font-semibold text-gray-700">Show Legal Pages Section</label>
                        </div>

                        <!-- Section Titles -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (English)</label>
                                <input type="text" @bind="settings.LegalPagesTitle" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (العربية)</label>
                                <input type="text" @bind="settings.LegalPagesTitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>
                    </div>

                    <!-- Legal Pages List -->
                    <div class="space-y-4">
                        @if (legalPageMenus.Any())
                        {
                            @foreach (var page in legalPageMenus)
                            {
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">
                                        <!-- Title -->
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Page Title (EN)</label>
                                            <input type="text" @bind="page.Title" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Page Title (AR)</label>
                                            <input type="text" @bind="page.TitleAr" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" dir="rtl" />
                                        </div>
                                        <!-- URL -->
                                        <div class="lg:col-span-3 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">URL</label>
                                            <input type="url" @bind="page.Url" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <!-- Icon -->
                                        <div class="lg:col-span-2 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Icon Class</label>
                                            <input type="text" @bind="page.IconClass" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" placeholder="fas fa-gavel" />
                                        </div>
                                        <!-- Order -->
                                        <div class="lg:col-span-1 space-y-2">
                                            <label class="block text-sm font-medium text-gray-700">Order</label>
                                            <input type="number" @bind="page.SortOrder" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm" />
                                        </div>
                                        <!-- Actions -->
                                        <div class="lg:col-span-2 flex gap-2">
                                            <label class="flex items-center">
                                                <input type="checkbox" @bind="page.IsActive" class="rounded border-gray-300 text-blue-600 shadow-sm mr-1" />
                                                <span class="text-xs">Active</span>
                                            </label>
                                            <label class="flex items-center">
                                                <input type="checkbox" @bind="page.OpenInNewTab" class="rounded border-gray-300 text-blue-600 shadow-sm mr-1" />
                                                <span class="text-xs">New Tab</span>
                                            </label>
                                            <button @onclick="() => RemoveLegalPage(page)" class="text-red-600 hover:text-red-800 p-1">
                                                <i class="fas fa-trash text-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-8 text-gray-500">
                                <i class="fas fa-gavel text-2xl mb-2"></i>
                                <p>No legal pages added yet. Click "Add Legal Page" to get started.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == 4)
            {
                <!-- Social Media Tab -->
                <div class="space-y-6">
                    <!-- Social Media Settings -->
                    <div class="space-y-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">@Localizer["SocialMedia"] Management</h3>
                            <p class="text-sm text-gray-600">Manage social media links and settings</p>
                        </div>

                        <!-- Enable/Disable Social Media -->
                        <div class="flex items-center">
                            <input type="checkbox" @bind="settings.ShowSocialMedia" class="rounded border-gray-300 text-blue-600 shadow-sm" />
                            <label class="ml-2 block text-sm font-semibold text-gray-700">Show Social Media Section</label>
                        </div>

                        <!-- Section Titles -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (English)</label>
                                <input type="text" @bind="settings.SocialMediaTitle" class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">Section Title (العربية)</label>
                                <input type="text" @bind="settings.SocialMediaTitleAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg" dir="rtl" />
                            </div>
                        </div>
                    </div>

                    <!-- Social Media Links -->
                    <div class="space-y-6">
                        <h4 class="text-md font-semibold text-gray-900 border-b pb-2">Social Media Links</h4>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Facebook -->
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700 flex items-center">
                                    <svg class="w-5 h-5 text-blue-600 mr-2" fill="currentColor" viewBox="0 0 24 24">
