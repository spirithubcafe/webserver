@page "/admin/import-resources"
@layout AdminLayout
@using SpirithubCafe.Web.Services
@using SpirithubCafe.Web.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Admin")]
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Import Resources</PageTitle>

<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-6">Import Resources to Database</h1>
            
            @if (isImporting)
            {
                <div class="flex items-center justify-center py-12">
                    <div class="text-center">
                        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-blue-600 mx-auto mb-4"></div>
                        <p class="text-lg text-gray-700">Importing translations...</p>
                    </div>
                </div>
            }
            else if (importComplete)
            {
                <div class="bg-green-50 border border-green-200 rounded-lg p-6 mb-6">
                    <div class="flex items-center mb-4">
                        <svg class="w-8 h-8 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h2 class="text-xl font-semibold text-green-800">Import Completed Successfully!</h2>
                    </div>
                    
                    <div class="space-y-2 text-green-700">
                        <p><strong>Total Imported:</strong> @totalImported translations</p>
                        <p><strong>English:</strong> @englishCount translations</p>
                        <p><strong>Arabic:</strong> @arabicCount translations</p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded">
                            <p class="text-yellow-800">@errorMessage</p>
                        </div>
                    }
                </div>
                
                <div class="flex gap-4">
                    <a href="/admin/translations" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
                        View Translations
                    </a>
                    <button @onclick="ResetImport" class="flex-1 px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                        Import Again
                    </button>
                </div>
            }
            else
            {
                <div class="space-y-6">
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                        <h3 class="font-semibold text-blue-900 mb-2">What will happen?</h3>
                        <ul class="list-disc list-inside space-y-2 text-blue-800">
                            <li>All resources from Resources.resx (English) will be imported</li>
                            <li>All resources from Resources.ar.resx (Arabic) will be imported</li>
                            <li>Existing translations will be updated</li>
                            <li>New translations will be added</li>
                            <li>Categories will be automatically assigned</li>
                        </ul>
                    </div>
                    
                    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
                        <h3 class="font-semibold text-yellow-900 mb-2">⚠️ Warning</h3>
                        <p class="text-yellow-800">This will update existing translations in the database. Make sure you want to proceed.</p>
                    </div>
                    
                    <button @onclick="StartImport" 
                            class="w-full px-6 py-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-semibold text-lg">
                        <i class="fas fa-download mr-2"></i>
                        Start Import
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isImporting = false;
    private bool importComplete = false;
    private int totalImported = 0;
    private int englishCount = 0;
    private int arabicCount = 0;
    private string errorMessage = "";

    private async Task StartImport()
    {
        isImporting = true;
        errorMessage = "";
        
        try
        {
            var importer = new ResourceImporter(DbContext);
            
            // Get count before import
            var beforeCount = await DbContext.Translations.CountAsync();
            
            await importer.ImportResourcesAsync();
            
            // Get counts after import
            var afterCount = await DbContext.Translations.CountAsync();
            totalImported = afterCount;
            // Count translations with non-key values
            englishCount = await DbContext.Translations.CountAsync(t => t.ValueEn != t.Key);
            arabicCount = await DbContext.Translations.CountAsync(t => t.ValueAr != t.Key);
            
            importComplete = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error during import: {ex.Message}";
            importComplete = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    private void ResetImport()
    {
        importComplete = false;
        totalImported = 0;
        englishCount = 0;
        arabicCount = 0;
        errorMessage = "";
    }
}
