@page "/admin/translation-test"
@layout AdminLayout
@using SpirithubCafe.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject TranslationLocalizer Localizer
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Translation Test</PageTitle>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">@Localizer["TranslationTest"]</h1>
    
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-xl font-semibold mb-4">استفاده دقیقاً مثل Localizer</h2>
        
        <div class="space-y-4">
            <div class="p-4 bg-gray-50 rounded">
                <p class="font-mono text-sm text-gray-600 mb-2">@@Localizer["Welcome"]</p>
                <p class="text-lg">@Localizer["Welcome"]</p>
            </div>
            
            <div class="p-4 bg-gray-50 rounded">
                <p class="font-mono text-sm text-gray-600 mb-2">@@Localizer["Users"]</p>
                <p class="text-lg">@Localizer["Users"]</p>
            </div>
            
            <div class="p-4 bg-gray-50 rounded">
                <p class="font-mono text-sm text-gray-600 mb-2">@@Localizer["Products"]</p>
                <p class="text-lg">@Localizer["Products"]</p>
            </div>
            
            <div class="p-4 bg-gray-50 rounded">
                <p class="font-mono text-sm text-gray-600 mb-2">@@Localizer["Dashboard"]</p>
                <p class="text-lg">@Localizer["Dashboard"]</p>
            </div>
            
            <div class="p-4 bg-blue-50 rounded">
                <p class="font-mono text-sm text-blue-600 mb-2">Format with parameters:</p>
                <p class="text-lg">@Localizer["Hello, {0}!", "Admin"]</p>
            </div>
        </div>
    </div>
    
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <h3 class="font-semibold text-yellow-800 mb-2">توجه:</h3>
        <ul class="list-disc list-inside text-yellow-700 space-y-1">
            <li>اگر ترجمه‌ای در دیتابیس وجود نداشته باشد، خود کلید به عنوان مقدار نمایش داده می‌شود</li>
            <li>و به صورت خودکار در دیتابیس با وضعیت "Untranslated" ثبت می‌شود</li>
            <li>ادمین می‌تواند بعداً از بخش Translations آن را ترجمه کند</li>
        </ul>
    </div>
</div>

