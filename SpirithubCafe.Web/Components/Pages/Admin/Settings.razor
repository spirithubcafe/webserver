@page "/admin/settings"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject SpirithubCafe.Application.Services.ISettingService SettingService
@inject IStringLocalizer<SpirithubCafe.Langs.Resources> Localizer
@inject IJSRuntime JSRuntime
@inject SpirithubCafe.Web.Services.ToastService ToastService
@using SpirithubCafe.Application.DTOs
@using SpirithubCafe.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer

<PageTitle>@Localizer["Settings"] - Admin</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">@Localizer["Settings"]</h1>
        <p class="mt-2 text-gray-600">@Localizer["ManageApplicationSettings"]</p>
    </div>

    <!-- Settings Tabs -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden">
        <!-- Tab Navigation -->
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex space-x-8 px-6">
                <button @onclick="@(() => SetActiveTab("general"))" 
                        class="@GetTabClasses("general")">
                    <svg class="w-5 h-5 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
                    </svg>
                    @Localizer["General"]
                </button>
                
                <button @onclick="@(() => SetActiveTab("branding"))" 
                        class="@GetTabClasses("branding")">
                    <svg class="w-5 h-5 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                    </svg>
                    @Localizer["Branding"]
                </button>
                
                <button @onclick="@(() => SetActiveTab("chat"))" 
                        class="@GetTabClasses("chat")">
                    <svg class="w-5 h-5 mr-2 inline" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                    </svg>
                    Chat
                </button>
            </nav>
        </div>

        <!-- Tab Content -->
        <div class="p-6">
            @if (activeTab == "general")
            {
                <!-- General Settings -->
                <div class="space-y-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["GeneralSettings"]</h3>
                    
                    <!-- Site Name -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["SiteName"]</label>
                            <input @bind="siteNameValue" @bind:event="oninput" type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="SpirithubCafe" />
                            <button @onclick="@(() => UpdateSetting("site_name", siteNameValue))" class="mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm">
                                @Localizer["Save"]
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "branding")
            {
                <!-- Branding Settings -->
                <div class="space-y-8">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["BrandingSettings"]</h3>
                    
                    <!-- Main Logo Configuration -->
                    <div class="bg-gray-50 rounded-xl p-6 mb-8">
                        <h4 class="text-md font-semibold text-gray-800 mb-4">@Localizer["MainLogoConfiguration"]</h4>
                        
                        <!-- Logo Type Selection -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-3">@Localizer["LogoType"]</label>
                            <div class="flex space-x-4">
                                <label class="flex items-center">
                                    <input type="radio" @onchange="@(() => SetLogoType("text"))" checked="@(logoTypeValue == "text")" 
                                           class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" />
                                    <span class="ml-2 text-sm text-gray-700">@Localizer["TextLogo"]</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" @onchange="@(() => SetLogoType("image"))" checked="@(logoTypeValue == "image")" 
                                           class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" />
                                    <span class="ml-2 text-sm text-gray-700">@Localizer["ImageLogo"]</span>
                                </label>
                            </div>
                        </div>

                        @if (logoTypeValue == "text")
                        {
                            <!-- Text Logo Configuration -->
                            <div class="space-y-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["LogoText"]</label>
                                        <input @bind="logoTextValue" @bind:event="oninput" type="text" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                                               placeholder="SpirithubCafe" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["LogoTextArabic"] (@Localizer["Optional"])</label>
                                        <input @bind="logoTextArValue" @bind:event="oninput" type="text" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                                               placeholder="روح هاب كافيه" dir="rtl" />
                                    </div>
                                </div>
                                
                                <!-- Preview -->
                                <div class="bg-white p-4 rounded-lg shadow-sm">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["Preview"]</label>
                                    <div class="text-xl font-bold text-amber-600">
                                        @(string.IsNullOrEmpty(logoTextValue) ? "SpirithubCafe" : logoTextValue)
                                    </div>
                                </div>
                                
                                <button @onclick="SaveLogoSettings" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                    @Localizer["SaveLogoSettings"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- Image Logo Configuration -->
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["LogoImage"]</label>
                                    
                                    <!-- File Upload Component -->
                                    <FileUpload Folder="logos" 
                                               FileType="image" 
                                               Prefix="logo"
                                               @bind-CurrentFileUrl="logoImageValue"
                                               AltText="Logo Image"
                                               OnFileUploaded="@OnLogoUploaded"
                                               OnFileRemoved="@OnLogoRemoved" />
                                    
                                    <p class="text-xs text-gray-500 mt-1">Upload or drop logo image file here</p>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(logoImageValue))
                                {
                                    <!-- Current Logo Preview -->
                                    <div class="bg-white p-4 rounded-lg shadow-sm">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["CurrentLogo"]</label>
                                        <img src="@logoImageValue" alt="Logo" class="h-16 w-auto" />
                                    </div>
                                }
                                
                                <button @onclick="SaveLogoSettings" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                    @Localizer["SaveLogoSettings"]
                                </button>
                            </div>
                        }
                    </div>
                    
                    <!-- Home Page Logo Configuration -->
                    <div class="bg-amber-50 rounded-xl p-6">
                        <h4 class="text-md font-semibold text-gray-800 mb-4">@Localizer["HomePageLogoConfiguration"]</h4>
                        <p class="text-sm text-gray-600 mb-4">@Localizer["HomePageLogoDescription"]</p>
                        
                        <!-- Home Logo Type Selection -->
                        <div class="mb-6">
                            <label class="block text-sm font-medium text-gray-700 mb-3">@Localizer["HomeLogoType"]</label>
                            <div class="flex space-x-4">
                                <label class="flex items-center">
                                    <input type="radio" @onchange="@(() => SetHomeLogoType("inherit"))" checked="@(homeLogoTypeValue == "inherit")" 
                                           class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300" />
                                    <span class="ml-2 text-sm text-gray-700">@Localizer["UseMainLogo"]</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" @onchange="@(() => SetHomeLogoType("text"))" checked="@(homeLogoTypeValue == "text")" 
                                           class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300" />
                                    <span class="ml-2 text-sm text-gray-700">@Localizer["CustomTextLogo"]</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" @onchange="@(() => SetHomeLogoType("image"))" checked="@(homeLogoTypeValue == "image")" 
                                           class="h-4 w-4 text-amber-600 focus:ring-amber-500 border-gray-300" />
                                    <span class="ml-2 text-sm text-gray-700">@Localizer["CustomImageLogo"]</span>
                                </label>
                            </div>
                        </div>

                        @if (homeLogoTypeValue == "text")
                        {
                            <!-- Custom Text Logo for Home -->
                            <div class="space-y-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["HomeLogoText"]</label>
                                        <input @bind="homeLogoTextValue" @bind:event="oninput" type="text" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A]" 
                                               placeholder="SpirithubCafe Home" />
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["HomeLogoTextArabic"] (@Localizer["Optional"])</label>
                                        <input @bind="homeLogoTextArValue" @bind:event="oninput" type="text" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-[#715A5A]" 
                                               placeholder="مقهى سبيريت هب" dir="rtl" />
                                    </div>
                                </div>
                                
                                <!-- Home Logo Preview -->
                                <div class="bg-white p-4 rounded-lg shadow-sm border-2 border-[#D3DAD9]">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["HomePagePreview"]</label>
                                    <div class="text-xl font-bold text-amber-600">
                                        @(string.IsNullOrEmpty(homeLogoTextValue) ? "SpirithubCafe Home" : homeLogoTextValue)
                                    </div>
                                </div>
                            </div>
                        }
                        else if (homeLogoTypeValue == "image")
                        {
                            <!-- Custom Image Logo for Home -->
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["HomeLogoImage"]</label>
                                    
                                    <!-- File Upload Component for Home Logo -->
                                    <FileUpload Folder="logos" 
                                               FileType="image" 
                                               Prefix="home-logo"
                                               @bind-CurrentFileUrl="homeLogoImageValue"
                                               AltText="Home Page Logo Image"
                                               OnFileUploaded="@OnHomeLogoUploaded"
                                               OnFileRemoved="@OnHomeLogoRemoved" />
                                    
                                    <p class="text-xs text-gray-500 mt-1">@Localizer["HomeLogoUploadDescription"]</p>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(homeLogoImageValue))
                                {
                                    <!-- Current Home Logo Preview -->
                                    <div class="bg-white p-4 rounded-lg shadow-sm border-2 border-[#D3DAD9]">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["CurrentHomeLogo"]</label>
                                        <img src="@homeLogoImageValue" alt="Home Logo" class="h-16 w-auto" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Using Main Logo -->
                            <div class="bg-white p-4 rounded-lg shadow-sm border-2 border-[#D3DAD9]">
                                <p class="text-sm text-gray-600">@Localizer["UsingMainLogoDescription"]</p>
                            </div>
                        }
                        
                        <button @onclick="SaveHomeLogoSettings" class="mt-4 px-6 py-2 bg-amber-600 text-white rounded-lg hover:bg-amber-700 transition-colors">
                            @Localizer["SaveHomeLogoSettings"]
                        </button>
                    </div>
                </div>
            }
            else if (activeTab == "chat")
            {
                <!-- Chat Settings -->
                <div class="space-y-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Chat Settings</h3>
                    
                    <!-- Chat Widget Enable/Disable -->
                    <div class="bg-gray-50 rounded-xl p-6">
                        <h4 class="text-md font-semibold text-gray-800 mb-4">Chat Widget</h4>
                        
                        <div class="flex items-center justify-between">
                            <div>
                                <label class="text-sm font-medium text-gray-700">Enable Chat Widget</label>
                                <p class="text-sm text-gray-500 mt-1">Show or hide the chat widget on your website</p>
                            </div>
                            <div class="flex items-center">
                                <input type="checkbox" @bind="chatWidgetEnabled" 
                                       class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                            </div>
                        </div>
                        
                        <button @onclick="SaveChatSettings" class="mt-4 px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Save Chat Settings
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Toast Component -->
<Toast />

@code {
    private string activeTab = "branding";
    private string logoTypeValue = "text";
    private string logoTextValue = "SpirithubCafe";
    private string logoTextArValue = "";
    private string logoImageValue = "";
    private string siteNameValue = "SpirithubCafe";
    
    // Home Page Logo Settings
    private string homeLogoTypeValue = "inherit";
    private string homeLogoTextValue = "";
    private string homeLogoTextArValue = "";
    private string homeLogoImageValue = "";
    
    // Chat Settings
    private bool chatWidgetEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private string GetTabClasses(string tab)
    {
        if (activeTab == tab)
            return "border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors";
        else
            return "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors";
    }

    private async Task LoadSettings()
    {
        try
        {
            // Load logo type
            logoTypeValue = await SettingService.GetValueAsync("logo_type", "text");
            
            // Load logo text
            logoTextValue = await SettingService.GetValueAsync("logo_text", "SpirithubCafe");
            logoTextArValue = await SettingService.GetValueAsync("logo_text_ar", "");
            
            // Load logo image
            logoImageValue = await SettingService.GetValueAsync("logo_image", "");
            
            // Load home page logo settings
            homeLogoTypeValue = await SettingService.GetValueAsync("home_logo_type", "inherit");
            homeLogoTextValue = await SettingService.GetValueAsync("home_logo_text", "");
            homeLogoTextArValue = await SettingService.GetValueAsync("home_logo_text_ar", "");
            homeLogoImageValue = await SettingService.GetValueAsync("home_logo_image", "");
            
            // Load site name
            siteNameValue = await SettingService.GetValueAsync("site_name", "SpirithubCafe");
            
            // Load chat settings
            var chatWidgetValue = await SettingService.GetValueAsync("ChatWidgetEnabled", "true");
            chatWidgetEnabled = chatWidgetValue.Equals("true", StringComparison.OrdinalIgnoreCase);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Handle error silently for now
            Console.WriteLine($"Error loading settings: {ex.Message}");
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private void SetLogoType(string type)
    {
        logoTypeValue = type;
    }

    private void SetHomeLogoType(string type)
    {
        homeLogoTypeValue = type;
    }

    private async Task OnLogoUploaded(SpirithubCafe.Web.Components.Shared.FileUpload.UploadResult result)
    {
        if (result.Success)
        {
            logoImageValue = result.FileUrl;
            ToastService.ShowSuccess(Localizer["LogoUploadedSuccessfully"]);
            StateHasChanged();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("showErrorToast", $"Upload failed: {result.Message}");
        }
    }

    private async Task OnLogoRemoved()
    {
        logoImageValue = "";
        ToastService.ShowSuccess(Localizer["LogoRemovedSuccessfully"]);
        StateHasChanged();
    }

    private async Task OnHomeLogoUploaded(SpirithubCafe.Web.Components.Shared.FileUpload.UploadResult result)
    {
        if (result.Success)
        {
            homeLogoImageValue = result.FileUrl;
            ToastService.ShowSuccess(Localizer["HomeLogoUploadedSuccessfully"]);
            StateHasChanged();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("showErrorToast", $"Home logo upload failed: {result.Message}");
        }
    }

    private async Task OnHomeLogoRemoved()
    {
        homeLogoImageValue = "";
        ToastService.ShowSuccess(Localizer["HomeLogoRemovedSuccessfully"]);
        StateHasChanged();
    }

    private async Task SaveLogoSettings()
    {
        try
        {
            // Save logo type
            await UpdateSettingInternal("logo_type", logoTypeValue);
            
            if (logoTypeValue == "text")
            {
                // Save text logo settings
                await UpdateSettingInternal("logo_text", logoTextValue);
                await UpdateSettingInternal("logo_text_ar", logoTextArValue);
            }
            else
            {
                // Save image logo setting
                await UpdateSettingInternal("logo_image", logoImageValue);
            }
            
            // Show success message only once
            ToastService.ShowSuccess(Localizer["LogoSettingsSavedSuccessfully"]);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showErrorToast", $"Error saving logo settings: {ex.Message}");
        }
    }

    private async Task SaveHomeLogoSettings()
    {
        try
        {
            // Save home logo type
            await UpdateSettingInternal("home_logo_type", homeLogoTypeValue);
            
            if (homeLogoTypeValue == "text")
            {
                // Save text logo settings for home
                await UpdateSettingInternal("home_logo_text", homeLogoTextValue);
                await UpdateSettingInternal("home_logo_text_ar", homeLogoTextArValue);
            }
            else if (homeLogoTypeValue == "image")
            {
                // Save image logo setting for home
                await UpdateSettingInternal("home_logo_image", homeLogoImageValue);
            }
            
            // Show success message
            ToastService.ShowSuccess(Localizer["HomeLogoSettingsSavedSuccessfully"]);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showErrorToast", $"Error saving home logo settings: {ex.Message}");
        }
    }

    private async Task UpdateSetting(string key, string value)
    {
        try
        {
            await UpdateSettingInternal(key, value);
            ToastService.ShowSuccess(Localizer["SettingsSavedSuccessfully"]);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("showErrorToast", $"Error saving settings: {ex.Message}");
        }
    }

    private async Task UpdateSettingInternal(string key, string value)
    {
        try
        {
            var exists = await SettingService.ExistsAsync(key);
            
            if (exists)
            {
                await SettingService.UpdateAsync(key, new UpdateSettingDto { Value = value });
            }
            else
            {
                await SettingService.CreateAsync(new CreateSettingDto 
                { 
                    Key = key, 
                    Value = value,
                    Category = key.StartsWith("logo") || key.StartsWith("home_logo") ? "Branding" : "General",
                    DataType = key.EndsWith("_image") ? "Image" : "Text"
                });
            }
        }
        catch (Exception ex)
        {
            throw new Exception($"Error saving setting {key}: {ex.Message}");
        }
    }

    private async Task SaveChatSettings()
    {
        try
        {
            await UpdateSettingInternal("ChatWidgetEnabled", chatWidgetEnabled ? "true" : "false");
            ToastService.ShowSuccess("Chat settings saved successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving chat settings: {ex.Message}");
        }
    }
}