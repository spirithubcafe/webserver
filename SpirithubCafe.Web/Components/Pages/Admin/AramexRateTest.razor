@page "/admin/aramex-rate-test"
@using SpirithubCafe.Application.Services
@inject IAramexRateService AramexRateService
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow rounded-lg">
            <div class="px-6 py-4 border-b border-gray-200">
                <h1 class="text-2xl font-bold text-gray-900">Aramex Rate Calculator Test</h1>
                <p class="text-gray-600 mt-1">Test shipping rate calculations using Aramex API</p>
            </div>

            <div class="p-6">
                @if (aramexSettings == null)
                {
                    <div class="bg-red-50 border border-red-200 rounded-md p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-red-800">Aramex Settings Not Configured</h3>
                                <p class="text-sm text-red-700 mt-2">
                                    Please configure Aramex settings first in the admin panel.
                                </p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Configuration Info -->
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <h3 class="text-lg font-semibold text-blue-900 mb-3">Current Configuration</h3>
                            <div class="space-y-2 text-sm">
                                <div><span class="font-medium">Mode:</span> @(aramexSettings.TestMode ? "Test (Sandbox)" : "Production")</div>
                                <div><span class="font-medium">Username:</span> @aramexSettings.Username</div>
                                <div><span class="font-medium">Account:</span> @aramexSettings.AccountNumber</div>
                                <div><span class="font-medium">Entity:</span> @aramexSettings.AccountEntity</div>
                                <div><span class="font-medium">Country:</span> @aramexSettings.AccountCountryCode</div>
                                <div><span class="font-medium">Origin:</span> @aramexSettings.City, @aramexSettings.CountryCode</div>
                            </div>
                        </div>

                        <!-- Rate Calculator Form -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Rate Calculator</h3>
                            
                            <form @onsubmit="CalculateRate" @onsubmit:preventDefault="true">
                                <div class="space-y-4">
                                    <!-- Destination -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Destination Country</label>
                                            <input type="text" @bind="rateRequest.DestinationCountryCode" 
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                                   placeholder="e.g., AE, SA, US" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Destination City</label>
                                            <input type="text" @bind="rateRequest.DestinationCity" 
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                                   placeholder="e.g., Dubai, Riyadh" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Destination Address</label>
                                        <input type="text" @bind="rateRequest.DestinationAddress" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                               placeholder="Street address" />
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">State/Province</label>
                                            <input type="text" @bind="rateRequest.DestinationState" 
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                                   placeholder="Optional" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Postal Code</label>
                                            <input type="text" @bind="rateRequest.DestinationPostalCode" 
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                                   placeholder="Optional" />
                                        </div>
                                    </div>

                                    <!-- Package Details -->
                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Weight (KG)</label>
                                            <input type="number" @bind="rateRequest.Weight" step="0.1"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Length (CM)</label>
                                            <input type="number" @bind="rateRequest.Length"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Width (CM)</label>
                                            <input type="number" @bind="rateRequest.Width"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Height (CM)</label>
                                            <input type="number" @bind="rateRequest.Height"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Number of Pieces</label>
                                            <input type="number" @bind="rateRequest.NumberOfPieces"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Product Type</label>
                                            <select @bind="rateRequest.ProductType" 
                                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                                <option value="EPX">Express (EPX)</option>
                                                <option value="PPX">Priority (PPX)</option>
                                                <option value="GRD">Ground (GRD)</option>
                                                <option value="OND">Domestic (OND)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Package Description</label>
                                        <input type="text" @bind="rateRequest.Description" 
                                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                               placeholder="Description of goods" />
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">COD Amount (OMR)</label>
                                            <input type="number" @bind="rateRequest.CodAmount" step="0.01"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-700 mb-1">Insurance Amount (OMR)</label>
                                            <input type="number" @bind="rateRequest.InsuranceAmount" step="0.01"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                        </div>
                                    </div>

                                    <!-- Submit Button -->
                                    <div class="pt-4">
                                        <button type="submit" 
                                                disabled="@isCalculating"
                                                class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                            @if (isCalculating)
                                            {
                                                <span class="inline-flex items-center">
                                                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                    </svg>
                                                    Calculating...
                                                </span>
                                            }
                                            else
                                            {
                                                <span>Calculate Rate</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Results -->
                    @if (rateResult != null)
                    {
                        <div class="mt-8 border-t pt-8">
                            <h3 class="text-lg font-semibold text-gray-900 mb-4">Rate Calculation Result</h3>
                            
                            @if (rateResult.Success)
                            {
                                <div class="bg-green-50 border border-green-200 rounded-lg p-6">
                                    <div class="flex items-center mb-4">
                                        <svg class="h-6 w-6 text-green-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <h4 class="text-lg font-semibold text-green-800">Rate Calculated Successfully</h4>
                                    </div>
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <div class="bg-white rounded-lg p-4 border">
                                                <div class="text-center">
                                                    <div class="text-3xl font-bold text-green-600">@rateResult.TotalAmount.ToString("F3")</div>
                                                    <div class="text-lg text-gray-600">@rateResult.Currency (Omani Rial)</div>
                                                    <div class="text-sm text-gray-500 mt-1">Total Shipping Cost</div>
                                                    <div class="text-xs text-blue-600 mt-2 font-medium">🔵 Mock Rate - Real API Integration Pending</div>
                                                </div>
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(rateResult.TransactionId))
                                            {
                                                <div class="mt-4 text-sm text-gray-600">
                                                    <span class="font-medium">Transaction ID:</span> @rateResult.TransactionId
                                                </div>
                                            }
                                        </div>
                                        
                                        @if (rateResult.RateBreakdown?.Any() == true)
                                        {
                                            <div>
                                                <h5 class="font-semibold text-gray-800 mb-3">Rate Breakdown</h5>
                                                <div class="space-y-2">
                                                    @foreach (var item in rateResult.RateBreakdown)
                                                    {
                                                        <div class="flex justify-between items-center py-2 border-b border-gray-200 last:border-b-0">
                                                            <span class="text-sm text-gray-600">@item.Description</span>
                                                            <span class="text-sm font-medium">@item.Amount.ToString("F3") @item.Currency</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="bg-red-50 border border-red-200 rounded-lg p-6">
                                    <div class="flex items-center mb-4">
                                        <svg class="h-6 w-6 text-red-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <h4 class="text-lg font-semibold text-red-800">Rate Calculation Failed</h4>
                                    </div>
                                    <p class="text-red-700">@rateResult.ErrorMessage</p>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- Quick Test Presets -->
                <div class="mt-8 border-t pt-8">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Test Presets</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <button @onclick="LoadUAEPreset" 
                                class="p-4 border border-gray-300 rounded-lg hover:bg-gray-50 text-left">
                            <div class="font-semibold text-gray-900">UAE (Dubai)</div>
                            <div class="text-sm text-gray-600">Standard Express Package</div>
                        </button>
                        <button @onclick="LoadSaudiPreset" 
                                class="p-4 border border-gray-300 rounded-lg hover:bg-gray-50 text-left">
                            <div class="font-semibold text-gray-900">Saudi Arabia (Riyadh)</div>
                            <div class="text-sm text-gray-600">Priority Package</div>
                        </button>
                        <button @onclick="LoadUSAPreset" 
                                class="p-4 border border-gray-300 rounded-lg hover:bg-gray-50 text-left">
                            <div class="font-semibold text-gray-900">USA (New York)</div>
                            <div class="text-sm text-gray-600">International Ground</div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SpirithubCafe.Domain.Entities.AramexSettings? aramexSettings;
    private AramexRateRequest rateRequest = new();
    private AramexRateResult? rateResult;
    private bool isCalculating = false;

    protected override async Task OnInitializedAsync()
    {
        aramexSettings = await AramexRateService.GetAramexSettingsAsync();
        
        // Initialize with default values
        rateRequest = new AramexRateRequest
        {
            DestinationCountryCode = "AE",
            DestinationCity = "Dubai",
            DestinationAddress = "Business Bay",
            Weight = 1.0m,
            Length = 20,
            Width = 15,
            Height = 10,
            NumberOfPieces = 1,
            ProductType = "EPX",
            Description = "Test Package",
            Currency = "OMR"
        };
    }

    private async Task CalculateRate()
    {
        if (aramexSettings == null) return;

        isCalculating = true;
        rateResult = null;
        StateHasChanged();

        try
        {
            rateResult = await AramexRateService.CalculateRateAsync(rateRequest);
        }
        catch (Exception ex)
        {
            rateResult = new AramexRateResult
            {
                Success = false,
                ErrorMessage = $"Unexpected error: {ex.Message}"
            };
        }
        finally
        {
            isCalculating = false;
            StateHasChanged();
        }
    }

    private void LoadUAEPreset()
    {
        rateRequest.DestinationCountryCode = "AE";
        rateRequest.DestinationCity = "Dubai";
        rateRequest.DestinationAddress = "Business Bay";
        rateRequest.ProductType = "EPX";
        rateRequest.Weight = 1.5m;
        rateResult = null;
        StateHasChanged();
    }

    private void LoadSaudiPreset()
    {
        rateRequest.DestinationCountryCode = "SA";
        rateRequest.DestinationCity = "Riyadh";
        rateRequest.DestinationAddress = "King Fahd Road";
        rateRequest.ProductType = "PPX";
        rateRequest.Weight = 2.0m;
        rateResult = null;
        StateHasChanged();
    }

    private void LoadUSAPreset()
    {
        rateRequest.DestinationCountryCode = "US";
        rateRequest.DestinationCity = "New York";
        rateRequest.DestinationAddress = "Manhattan";
        rateRequest.DestinationState = "NY";
        rateRequest.DestinationPostalCode = "10001";
        rateRequest.ProductType = "GRD";
        rateRequest.Weight = 0.5m;
        rateResult = null;
        StateHasChanged();
    }
}