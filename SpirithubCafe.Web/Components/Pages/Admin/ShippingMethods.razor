@page "/admin/shipping-methods"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using SpirithubCafe.Web.Components.Shared
@using System.Text.Json
@inject ShippingMethodService ShippingMethodService
@inject ShippingService ShippingService
@inject ToastService ToastService
@rendermode @(new InteractiveServerRenderMode(prerender: false))


<PageTitle>Shipping Methods Management - SpirithubCafe</PageTitle>

<Toast />

<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Page Header -->
        <div class="bg-white shadow-sm rounded-lg mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Shipping Methods</h1>
                        <p class="mt-1 text-sm text-gray-600">Manage shipping methods: Pickup, Nool Oman, and Aramex</p>
                    </div>
                    <div class="mt-4 sm:mt-0">
                        <a href="/admin/shipping" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Back to Countries & Cities
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- Stats Cards -->
            <div class="px-6 py-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-blue-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-blue-600">Total Methods</dt>
                            <dd class="text-2xl font-bold text-blue-900">@shippingMethods.Count</dd>
                        </div>
                    </div>
                </div>
                
                <div class="bg-green-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-green-600">Active Methods</dt>
                            <dd class="text-2xl font-bold text-green-900">@shippingMethods.Count(s => s.IsActive)</dd>
                        </div>
                    </div>
                </div>
                
                <div class="bg-purple-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-purple-600">Nool Rates</dt>
                            <dd class="text-2xl font-bold text-purple-900">@totalNoolRates</dd>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shipping Methods List -->
        <div class="bg-white shadow-sm rounded-lg">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Shipping Methods Configuration</h2>
            </div>
            
            <div class="divide-y divide-gray-200">
                @if (shippingMethods?.Any() == true)
                {
                    @foreach (var method in shippingMethods.OrderBy(s => s.DisplayOrder))
                    {
                        <div class="p-6">
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center space-x-3">
                                    @if (method.Type == "Pickup")
                                    {
                                        <div class="flex-shrink-0 w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </div>
                                    }
                                    else if (method.Type == "NoolOman")
                                    {
                                        <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            </svg>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex-shrink-0 w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                        </div>
                                    }
                                    <div>
                                        <h3 class="text-lg font-medium text-gray-900">@method.Name</h3>
                                        <p class="text-sm text-gray-500">@method.NameAr</p>
                                        <p class="text-sm text-gray-600 mt-1">@method.Description</p>
                                    </div>
                                </div>
                                
                                <div class="flex items-center space-x-2">
                                    <!-- Status Toggle -->
                                    <button type="button" @onclick="() => ToggleMethodStatus(method.Id)"
                                            class="@(method.IsActive ? "bg-green-600 hover:bg-green-700" : "bg-gray-400 hover:bg-gray-500") relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                        <span class="sr-only">Toggle method status</span>
                                        <span class="@(method.IsActive ? "translate-x-5" : "translate-x-0") pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                                    </button>
                                    
                                    <!-- Edit Button -->
                                    <button type="button" @onclick="() => EditMethod(method)"
                                            class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        Edit
                                    </button>
                                    
                                    @if (method.Type == "NoolOman")
                                    {
                                        <a href="/admin/nool-rates"
                                           class="inline-flex items-center px-3 py-2 border border-green-300 shadow-sm text-sm leading-4 font-medium rounded-md text-green-700 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                                            </svg>
                                            Manage Rates (@method.NoolRates.Count(r => r.IsActive))
                                        </a>
                                    }
                                </div>
                            </div>
                            

                            
                            @if (method.Type == "Aramex" && !string.IsNullOrEmpty(method.ApiConfiguration))
                            {
                                <div class="mt-4 bg-gray-50 rounded-lg p-4">
                                    <h4 class="text-md font-medium text-gray-900 mb-3">API Configuration</h4>
                                    <div class="text-sm text-gray-600">
                                        <p>✓ API settings configured</p>
                                        <p class="text-xs mt-1">Click Edit to modify API credentials</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2m13-8V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v1M8 5V4a1 1 0 00-1-1H3a1 1 0 00-1 1v1"/>
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No shipping methods</h3>
                        <p class="mt-1 text-sm text-gray-500">Shipping methods will be created automatically when the application starts.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Method Modal -->
@if (showEditModal && currentMethod != null)
{
    <div class="fixed inset-0 backdrop-blur-sm bg-black/20 h-full w-full z-50 flex items-center justify-center p-4" @onclick="CloseEditModal">
        <div class="relative bg-white rounded-xl shadow-2xl max-w-3xl w-full border border-gray-100 transform transition-all max-h-[90vh] flex flex-col" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-t-xl">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                            @if (currentMethod.Type == "Pickup")
                            {
                                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                </svg>
                            }
                            else if (currentMethod.Type == "NoolOman")
                            {
                                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2v0"/>
                                </svg>
                            }
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Edit @currentMethod.Name</h3>
                            <p class="text-sm text-gray-600">Configure shipping method settings</p>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseEditModal" class="p-2 hover:bg-white/50 rounded-lg transition-colors">
                        <svg class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Form Content -->
            <div class="px-6 py-6 flex-1 overflow-y-auto">
                <EditForm Model="currentMethod" OnValidSubmit="SaveMethod" id="method-form">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-6">
                        <!-- Basic Information Section -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                        </svg>
                                        Name (English)
                                    </span>
                                </label>
                                <InputText @bind-Value="currentMethod.Name" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200" placeholder="Enter method name" />
                                <ValidationMessage For="() => currentMethod.Name" class="text-red-600 text-sm mt-1" />
                            </div>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                        </svg>
                                        Name (Arabic)
                                    </span>
                                </label>
                                <InputText @bind-Value="currentMethod.NameAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200" dir="rtl" placeholder="أدخل اسم الطريقة" />
                            </div>
                        </div>
                        
                        <!-- Description Section -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
                                        </svg>
                                        Description (English)
                                    </span>
                                </label>
                                <InputTextArea @bind-Value="currentMethod.Description" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 resize-none" rows="3" placeholder="Enter method description" />
                            </div>
                            
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
                                        </svg>
                                        Description (Arabic)
                                    </span>
                                </label>
                                <InputTextArea @bind-Value="currentMethod.DescriptionAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 resize-none" rows="3" dir="rtl" placeholder="أدخل وصف الطريقة" />
                            </div>
                        </div>
                        
                        <!-- Display Order -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                                    </svg>
                                    Display Order
                                </span>
                            </label>
                            <InputNumber @bind-Value="currentMethod.DisplayOrder" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 max-w-xs" placeholder="1" />
                        </div>
                        
                        <!-- Aramex API Configuration -->
                        @if (currentMethod.Type == "Aramex")
                        {
                            <div class="border-t border-gray-200 pt-6">
                                <div class="flex items-center mb-4">
                                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                                        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        </svg>
                                    </div>
                                    <h4 class="text-lg font-semibold text-gray-900">Aramex API Configuration</h4>
                                </div>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 p-4 bg-purple-50 rounded-lg">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Username</label>
                                        <input type="text" @bind="aramexConfig.Username" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition duration-200" placeholder="API Username" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Password</label>
                                        <input type="password" @bind="aramexConfig.Password" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition duration-200" placeholder="API Password" />
                                    </div>
                                    <div class="space-y-2 lg:col-span-2">
                                        <label class="block text-sm font-semibold text-gray-700">Account Number</label>
                                        <input type="text" @bind="aramexConfig.AccountNumber" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition duration-200" placeholder="Aramex Account Number" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
            
            <!-- Footer -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 rounded-b-xl flex justify-end space-x-3 flex-shrink-0">
                <button type="button" @onclick="CloseEditModal" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Cancel
                </button>
                <button type="submit" form="method-form" class="inline-flex items-center px-6 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ShippingMethod> shippingMethods = new();
    private ShippingMethod? currentMethod;
    private bool showEditModal = false;
    private int totalNoolRates = 0;
    
    // Aramex configuration
    private AramexConfig aramexConfig = new();
    
    public class AramexConfig
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string AccountNumber { get; set; } = string.Empty;
        public string Version { get; set; } = "v1.0";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadShippingMethods();
    }

    private async Task LoadShippingMethods()
    {
        shippingMethods = await ShippingMethodService.GetAllShippingMethodsAsync();
        totalNoolRates = shippingMethods
            .Where(s => s.Type == "NoolOman")
            .SelectMany(s => s.NoolRates)
            .Count(r => r.IsActive);
    }

    private async Task ToggleMethodStatus(int methodId)
    {
        try
        {
            await ShippingMethodService.ToggleShippingMethodStatusAsync(methodId);
            await LoadShippingMethods();
            ToastService.ShowSuccess("Shipping method status updated successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating status: {ex.Message}");
        }
    }

    private void EditMethod(ShippingMethod method)
    {
        currentMethod = new ShippingMethod
        {
            Id = method.Id,
            Type = method.Type,
            Name = method.Name ?? string.Empty,
            NameAr = method.NameAr,
            Description = method.Description,
            DescriptionAr = method.DescriptionAr,
            DisplayOrder = method.DisplayOrder,
            IsActive = method.IsActive,
            ApiConfiguration = method.ApiConfiguration
        };

        // Load Aramex config if applicable
        if (method.Type == "Aramex" && !string.IsNullOrEmpty(method.ApiConfiguration))
        {
            try
            {
                var config = JsonSerializer.Deserialize<Dictionary<string, object>>(method.ApiConfiguration);
                if (config != null)
                {
                    aramexConfig.Username = config.GetValueOrDefault("username")?.ToString() ?? string.Empty;
                    aramexConfig.Password = config.GetValueOrDefault("password")?.ToString() ?? string.Empty;
                    aramexConfig.AccountNumber = config.GetValueOrDefault("accountNumber")?.ToString() ?? string.Empty;
                    aramexConfig.Version = config.GetValueOrDefault("version")?.ToString() ?? "v1.0";
                }
            }
            catch
            {
                aramexConfig = new AramexConfig();
            }
        }

        showEditModal = true;
    }

    private async Task SaveMethod()
    {
        if (currentMethod == null) return;

        try
        {
            // Update Aramex config if applicable
            if (currentMethod.Type == "Aramex")
            {
                var config = new Dictionary<string, object>
                {
                    ["username"] = aramexConfig.Username,
                    ["password"] = aramexConfig.Password,
                    ["accountNumber"] = aramexConfig.AccountNumber,
                    ["version"] = aramexConfig.Version
                };
                currentMethod.ApiConfiguration = JsonSerializer.Serialize(config);
            }

            await ShippingMethodService.UpdateShippingMethodAsync(currentMethod);
            await LoadShippingMethods();
            showEditModal = false;
            currentMethod = null;
            ToastService.ShowSuccess("Shipping method updated successfully!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving method: {ex.Message}");
        }
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        currentMethod = null;
        aramexConfig = new AramexConfig();
    }


}