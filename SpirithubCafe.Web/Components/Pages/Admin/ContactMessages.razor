@page "/admin/contact-messages"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject TranslationLocalizer Localizer
@inject SpirithubCafe.Web.Data.ApplicationDbContext DbContext
@inject ToastService ToastService
@inject SpirithubCafe.Application.Services.IEmailService EmailService




@using Microsoft.AspNetCore.Authorization
@using SpirithubCafe.Web.Data
@using SpirithubCafe.Domain.Entities
@using Microsoft.EntityFrameworkCore

<div class="p-6 bg-gray-50 min-h-screen">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">@Localizer["ContactMessages"]</h1>
        <p class="text-gray-600">@Localizer["ManageContactMessages"]</p>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">@Localizer["TotalMessages"]</p>
                    <h3 class="text-2xl font-bold text-gray-900">@messages.Count</h3>
                </div>
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">@Localizer["UnreadMessages"]</p>
                    <h3 class="text-2xl font-bold text-orange-600">@messages.Count(m => !m.IsRead)</h3>
                </div>
                <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600 mb-1">@Localizer["ReadMessages"]</p>
                    <h3 class="text-2xl font-bold text-green-600">@messages.Count(m => m.IsRead)</h3>
                </div>
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Localizer["MessageFrom"]
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Localizer["MessageSubject"]
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Localizer["MessageDate"]
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Localizer["MessageStatus"]
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            @Localizer["Actions"]
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (messages.Any())
                    {
                        @foreach (var message in messages)
                        {
                            <tr class="@(message.IsRead ? "bg-white" : "bg-blue-50") hover:bg-gray-100 cursor-pointer"
                                @onclick="@(() => ViewMessage(message))">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">@message.Name</div>
                                            <div class="text-sm text-gray-500">@message.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900 font-medium">@message.Subject</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-500">@message.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (message.IsRead)
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold text-green-800 bg-green-100 rounded-full">
                                            @Localizer["Read"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold text-orange-800 bg-orange-100 rounded-full">
                                            @Localizer["Unread"]
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex gap-2">
                                        <button @onclick="@(() => ViewMessage(message))" 
                                                @onclick:stopPropagation="true"
                                                class="text-blue-600 hover:text-blue-900 text-sm font-medium">
                                            @Localizer["ViewMessage"]
                                        </button>
                                        <button @onclick="@(() => ShowReplyModal(message))" 
                                                @onclick:stopPropagation="true"
                                                class="text-green-600 hover:text-green-900 text-sm font-medium">
                                            @Localizer["Reply"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                @Localizer["NoDataAvailable"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- View Message Modal -->
@if (showMessageModal && selectedMessage != null)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">@Localizer["MessageDetails"]</h2>
                    <button @onclick="CloseMessageModal" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>

                <div class="space-y-4">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm text-gray-600 mb-1">@Localizer["MessageFrom"]</p>
                                <p class="text-sm font-medium text-gray-900">@selectedMessage.Name</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600 mb-1">@Localizer["Email"]</p>
                                <p class="text-sm font-medium text-gray-900">@selectedMessage.Email</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600 mb-1">@Localizer["MessageSubject"]</p>
                                <p class="text-sm font-medium text-gray-900">@selectedMessage.Subject</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600 mb-1">@Localizer["MessageDate"]</p>
                                <p class="text-sm font-medium text-gray-900">@selectedMessage.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <p class="text-sm text-gray-600 mb-2">@Localizer["OriginalMessage"]</p>
                        <div class="bg-white border border-gray-200 rounded-lg p-4">
                            <p class="text-gray-900 whitespace-pre-wrap">@selectedMessage.Message</p>
                        </div>
                    </div>

                    <div class="flex gap-3 justify-end">
                        @if (!selectedMessage.IsRead)
                        {
                            <button @onclick="MarkAsRead" 
                                    class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                                @Localizer["MarkAsRead"]
                            </button>
                        }
                        <button @onclick="@(() => ShowReplyModal(selectedMessage))" 
                                class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors">
                            @Localizer["Reply"]
                        </button>
                        <button @onclick="CloseMessageModal" 
                                class="px-6 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors">
                            @Localizer["Close"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Reply Modal -->
@if (showReplyModal && selectedMessage != null)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
            <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">@Localizer["ReplyMessage"]</h2>
                    <button @onclick="CloseReplyModal" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>

                <div class="space-y-4">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <p class="text-sm text-gray-600 mb-2">@Localizer["OriginalMessage"]</p>
                        <p class="text-sm text-gray-900 border-l-4 border-gray-300 pl-3">@selectedMessage.Message</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            @Localizer["YourReply"]
                        </label>
                        <textarea @bind="replyMessage" 
                                  rows="8"
                                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent"
                                  placeholder="@Localizer["YourReply"]"></textarea>
                    </div>

                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                        <p class="text-sm text-blue-800">
                            <strong>@Localizer["Recipients"]:</strong> @selectedMessage.Email
                        </p>
                    </div>

                    <div class="flex gap-3 justify-end">
                        <button @onclick="CloseReplyModal" 
                                class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                            @Localizer["Cancel"]
                        </button>
                        <button @onclick="SendReplyAsync" 
                                disabled="@isSending"
                                class="px-6 py-2 bg-green-600 hover:bg-green-700 disabled:bg-gray-400 text-white rounded-lg transition-colors">
                            @if (isSending)
                            {
                                <span>@Localizer["Sending"]...</span>
                            }
                            else
                            {
                                <span>@Localizer["SendReply"]</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactMessage> messages = new();
    private ContactMessage? selectedMessage;
    private bool showMessageModal = false;
    private bool showReplyModal = false;
    private bool isSending = false;
    private string replyMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        messages = await DbContext.ContactMessages
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();
    }

    private void ViewMessage(ContactMessage message)
    {
        selectedMessage = message;
        showMessageModal = true;
        
        if (!message.IsRead)
        {
            _ = MarkAsReadAsync(message);
        }
    }

    private void CloseMessageModal()
    {
        showMessageModal = false;
        selectedMessage = null;
    }

    private void ShowReplyModal(ContactMessage message)
    {
        selectedMessage = message;
        showMessageModal = false;
        showReplyModal = true;
    }

    private void CloseReplyModal()
    {
        showReplyModal = false;
        replyMessage = "";
    }

    private async Task MarkAsRead()
    {
        if (selectedMessage != null)
        {
            await MarkAsReadAsync(selectedMessage);
            CloseMessageModal();
        }
    }

    private async Task MarkAsReadAsync(ContactMessage message)
    {
        message.IsRead = true;
        await DbContext.SaveChangesAsync();
        await LoadMessages();
        StateHasChanged();
    }

    private async Task SendReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(replyMessage) || selectedMessage == null)
        {
            ToastService.ShowWarning(Localizer["PleaseFillAllFields"]);
            return;
        }

        isSending = true;
        StateHasChanged();

        try
        {
            var subject = $"Re: {selectedMessage.Subject}";
            await EmailService.SendEmailAsync(selectedMessage.Email, subject, replyMessage);

            ToastService.ShowSuccess(Localizer["ReplySentSuccessfully"]);
            
            // Mark as read after sending reply
            if (!selectedMessage.IsRead)
            {
                await MarkAsReadAsync(selectedMessage);
            }

            CloseReplyModal();
            replyMessage = "";
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }
}
