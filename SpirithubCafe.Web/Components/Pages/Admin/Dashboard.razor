@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject TranslationLocalizer Localizer

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using SpirithubCafe.Web.Data
@using Microsoft.EntityFrameworkCore

<!-- Simple Odoo-Style Dashboard -->
<div class="p-8 bg-gray-50 min-h-screen">
    <!-- Welcome Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">@Localizer["WelcomeToDashboard"]</h1>
        <p class="text-gray-600">@Localizer["ManageSpirithubCafe"]</p>
    </div>

    <!-- Main Navigation Grid - Simple Odoo Style -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6 max-w-6xl">
        
        <!-- Products -->
        <a href="/admin/products" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-orange-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-[#715A5A] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Products"]</h3>
            </div>
        </a>

        <!-- Categories -->
        <a href="/admin/categories" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-blue-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-blue-400 to-blue-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Categories"]</h3>
            </div>
        </a>

        <!-- Orders -->
        <a href="/admin/orders" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-green-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-green-400 to-green-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Orders"]</h3>
            </div>
        </a>

        <!-- Users -->
        <a href="/admin/users" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-purple-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-purple-400 to-purple-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Users"]</h3>
            </div>
        </a>

        <!-- Slides -->
        <a href="/admin/slides" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-pink-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-pink-400 to-pink-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Slides"]</h3>
            </div>
        </a>

        <!-- Settings -->
        <a href="/admin/settings" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-gray-300 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-gray-400 to-gray-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Settings"]</h3>
            </div>
        </a>

        <!-- Reviews -->
        <a href="/admin/reviews" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-[#D3DAD9] min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-[#715A5A] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["ManageReviews"]</h3>
            </div>
        </a>

        <!-- Shipping Methods -->
        <a href="/admin/shipping-methods" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-indigo-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-indigo-400 to-indigo-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Shipping"]</h3>
            </div>
        </a>

        <!-- Chat Management -->
        <a href="/admin/chat-management" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-teal-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-teal-400 to-teal-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["ChatManagement"]</h3>
            </div>
        </a>

        <!-- Reports -->
        <a href="/admin/reports" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-cyan-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-cyan-400 to-cyan-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Reports"]</h3>
            </div>
        </a>

        <!-- Home Page Settings -->
        <a href="/admin/pages/home" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-red-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-red-400 to-red-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["HomePage"]</h3>
            </div>
        </a>

        <!-- Payment Gateway -->
        <a href="/admin/payment-gateway-settings" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-emerald-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-emerald-400 to-emerald-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["PaymentGatewaySettings"]</h3>
            </div>
        </a>

        <!-- Footer Settings -->
        <a href="/admin/footer" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-slate-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-slate-400 to-slate-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["FooterManagement"]</h3>
            </div>
        </a>

        <!-- About Us -->
        <a href="/admin/pages/about" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-sky-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-sky-400 to-sky-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["AboutUs"]</h3>
            </div>
        </a>

        <!-- Contact Us -->
        <a href="/admin/pages/contact" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-lime-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-lime-400 to-lime-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["ContactUs"]</h3>
            </div>
        </a>

        <!-- Aramex Settings -->
        <a href="/admin/aramex-settings" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-violet-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-violet-400 to-violet-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Aramex"]</h3>
            </div>
        </a>

        <!-- Shipping Locations -->
        <a href="/admin/shipping" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-rose-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-rose-400 to-rose-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Locations"]</h3>
            </div>
        </a>

        <!-- Translations Management -->
        <a href="/admin/translations" class="group">
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 p-6 flex flex-col items-center justify-center border border-gray-100 hover:border-fuchsia-200 min-h-[140px]">
                <div class="w-16 h-16 mb-3 bg-gradient-to-br from-fuchsia-400 to-fuchsia-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900 text-center whitespace-nowrap">@Localizer["Translations"]</h3>
            </div>
        </a>

    </div>

    <!-- Quick Statistics Section -->
    <div class="mt-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">@Localizer["QuickStats"]</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- Total Products -->
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl shadow-sm p-6 border border-blue-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-blue-600 mb-1">@Localizer["TotalProducts"]</p>
                        <h3 class="text-3xl font-bold text-blue-900">@totalProducts</h3>
                        <p class="text-xs text-blue-600 mt-2">@activeProducts @Localizer["ActiveProducts"]</p>
                    </div>
                    <div class="w-14 h-14 bg-blue-500 rounded-xl flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total Categories -->
            <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl shadow-sm p-6 border border-purple-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-purple-600 mb-1">@Localizer["TotalCategories"]</p>
                        <h3 class="text-3xl font-bold text-purple-900">@totalCategories</h3>
                        <p class="text-xs text-purple-600 mt-2">@Localizer["ViewDetails"]</p>
                    </div>
                    <div class="w-14 h-14 bg-purple-500 rounded-xl flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total Orders -->
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-2xl shadow-sm p-6 border border-green-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-green-600 mb-1">@Localizer["TotalOrders"]</p>
                        <h3 class="text-3xl font-bold text-green-900">@totalOrders</h3>
                        <p class="text-xs text-green-600 mt-2">@pendingOrders @Localizer["PendingOrders"]</p>
                    </div>
                    <div class="w-14 h-14 bg-green-500 rounded-xl flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total Users -->
            <div class="bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl shadow-sm p-6 border border-orange-200">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-orange-600 mb-1">@Localizer["TotalUsers"]</p>
                        <h3 class="text-3xl font-bold text-orange-900">@totalUsers</h3>
                        <p class="text-xs text-orange-600 mt-2">@Localizer["ThisMonth"]</p>
                    </div>
                    <div class="w-14 h-14 bg-orange-500 rounded-xl flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [Inject] private ApplicationDbContext DbContext { get; set; } = default!;

    private int totalProducts = 0;
    private int activeProducts = 0;
    private int totalCategories = 0;
    private int totalOrders = 0;
    private int pendingOrders = 0;
    private int totalUsers = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        try
        {
            // Load products statistics
            totalProducts = await DbContext.Products.CountAsync();
            activeProducts = await DbContext.Products.CountAsync(p => p.IsActive);

            // Load categories count
            totalCategories = await DbContext.Categories.CountAsync();

            // Load orders statistics
            totalOrders = await DbContext.Orders.CountAsync();
            pendingOrders = await DbContext.Orders.CountAsync(o => o.Status == "Pending");

            // Load users count
            totalUsers = await DbContext.Users.CountAsync();
        }
        catch (Exception ex)
        {
            // Log error if needed
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
    }
}