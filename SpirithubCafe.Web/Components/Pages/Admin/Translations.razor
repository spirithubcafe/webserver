@page "/admin/translations"
@layout AdminLayout
@using SpirithubCafe.Application.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject ITranslationService TranslationService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime



<PageTitle>Translation Management</PageTitle>

<div class="container-fluid px-4 py-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center mb-6 space-y-4 lg:space-y-0">
        <div>
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-900">Translation Management</h1>
            <p class="text-gray-600 mt-2 text-sm lg:text-base">Manage translations for English and Arabic languages</p>
        </div>
        <button @onclick="AddNewTranslation" class="w-full lg:w-auto px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline">Add Translation</span>
            <span class="sm:hidden">Add</span>
        </button>
    </div>

    <!-- Filter Tabs -->
    <div class="bg-white rounded-lg shadow-sm mb-6">
        <div class="flex flex-col sm:flex-row border-b">
            <button @onclick='() => SetFilter("all")' 
                    class="@(currentFilter == "all" ? "border-b-2 sm:border-b-2 border-blue-500 text-blue-600 bg-blue-50" : "text-gray-600 hover:bg-gray-50") px-4 sm:px-6 py-3 font-medium transition-all text-sm sm:text-base flex-1 sm:flex-none">
                <span class="hidden sm:inline">All Translations (@allCount)</span>
                <span class="sm:hidden">All (@allCount)</span>
            </button>
            <button @onclick='() => SetFilter("incomplete-en")' 
                    class="@(currentFilter == "incomplete-en" ? "border-b-2 sm:border-b-2 border-blue-500 text-blue-600 bg-blue-50" : "text-gray-600 hover:bg-gray-50") px-4 sm:px-6 py-3 font-medium transition-all text-sm sm:text-base flex-1 sm:flex-none">
                <span class="hidden sm:inline">Incomplete (EN) (@incompleteEnCount)</span>
                <span class="sm:hidden">EN (@incompleteEnCount)</span>
            </button>
            <button @onclick='() => SetFilter("incomplete-ar")' 
                    class="@(currentFilter == "incomplete-ar" ? "border-b-2 sm:border-b-2 border-blue-500 text-blue-600 bg-blue-50" : "text-gray-600 hover:bg-gray-50") px-4 sm:px-6 py-3 font-medium transition-all text-sm sm:text-base flex-1 sm:flex-none">
                <span class="hidden sm:inline">Incomplete (AR) (@incompleteArCount)</span>
                <span class="sm:hidden">AR (@incompleteArCount)</span>
            </button>
        </div>
    </div>

    <!-- Search -->
    <div class="bg-white rounded-lg shadow-sm p-3 sm:p-4 mb-6">
        <div class="flex gap-4">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterTranslations"
                       placeholder="Search by key, value, or category..."
                       class="w-full pl-10 pr-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base">
            </div>
        </div>
    </div>

    <!-- Results Info and Page Size Selector -->
    @if (!isLoading && totalItems > 0)
    {
        <div class="bg-white rounded-lg shadow-sm p-3 sm:p-4 mb-4">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center space-y-3 sm:space-y-0">
                <!-- Results Info -->
                <div class="text-sm text-gray-600">
                    Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalItems) of @totalItems translations
                </div>
                
                <!-- Page Size Selector -->
                <div class="flex items-center space-x-2">
                    <span class="text-sm text-gray-600">Show:</span>
                    <select @onchange="@((e) => ChangePageSize(int.Parse(e.Value?.ToString() ?? "10")))" 
                            class="border border-gray-300 rounded-md px-3 py-1 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="25" selected="@(pageSize == 25)">25</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                        <option value="100" selected="@(pageSize == 100)">100</option>
                    </select>
                    <span class="text-sm text-gray-600">per page</span>
                </div>
            </div>
        </div>
    }

    <!-- Translations Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden">
        @if (isLoading)
        {
            <div class="flex flex-col justify-center items-center py-8 sm:py-12 px-4">
                <div class="animate-spin rounded-full h-10 sm:h-12 w-10 sm:w-12 border-b-2 border-blue-600 mb-4"></div>
                <p class="text-sm sm:text-base text-gray-600">Loading translations...</p>
            </div>
        }
        else if (totalItems == 0)
        {
            <div class="text-center py-8 sm:py-12 px-4">
                <svg class="w-16 sm:w-24 h-16 sm:h-24 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No translations found</h3>
                <p class="text-gray-600 mb-4">
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <span>Try adjusting your search criteria or </span>
                    }
                    else
                    {
                        <span>Get started by adding your first translation.</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button @onclick='() => { searchTerm = ""; FilterTranslations(); }' 
                            class="inline-flex items-center px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-md hover:bg-blue-100 transition-colors mr-3">
                        Clear Search
                    </button>
                }
                <button @onclick="AddNewTranslation" 
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Translation
                </button>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden lg:block overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                             <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">English</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Arabic</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var translation in pagedTranslations)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
 
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900 max-w-md truncate" title="@translation.ValueEn">
                                        @translation.ValueEn
                                        @if (translation.ValueEn == translation.Key)
                                        {
                                            <span class="ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                <svg class="w-3 h-3 inline-block" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900 max-w-md truncate" title="@translation.ValueAr" dir="rtl">
                                        @translation.ValueAr
                                        @if (translation.ValueAr == translation.Key)
                                        {
                                            <span class="ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                <svg class="w-3 h-3 inline-block" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                                </svg>
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-sm text-gray-600">@(translation.Category ?? "N/A")</span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <button @onclick="() => EditTranslation(translation.Id)" 
                                                class="inline-flex items-center px-3 py-2 text-sm font-medium text-blue-600 hover:text-white hover:bg-blue-600 rounded-md transition-all duration-200">
                                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                            Edit
                                        </button>
                                        <button @onclick="() => DeleteTranslation(translation.Id)" 
                                                class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-600 hover:text-white hover:bg-red-600 rounded-md transition-all duration-200">
                                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Mobile Card View -->
            <div class="lg:hidden space-y-4">
                @foreach (var translation in pagedTranslations)
                {
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <!-- Key and Category -->
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-sm font-bold text-gray-900 truncate" title="@translation.Key">@translation.Key</h3>
                                @if (!string.IsNullOrEmpty(translation.Category))
                                {
                                    <span class="inline-block mt-1 px-2 py-1 text-xs bg-gray-100 text-gray-700 rounded-full">@translation.Category</span>
                                }
                            </div>
                            <div class="flex gap-1 ml-2">
                                <button @onclick="() => EditTranslation(translation.Id)" 
                                        class="p-2 text-blue-600 hover:bg-blue-50 rounded-md transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <button @onclick="() => DeleteTranslation(translation.Id)" 
                                        class="p-2 text-red-600 hover:bg-red-50 rounded-md transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        
                        <!-- English Translation -->
                        <div class="mb-3">
                            <div class="flex items-center mb-1">
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">English</span>
                                @if (translation.ValueEn == translation.Key)
                                {
                                    <span class="ml-2 px-2 py-0.5 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        <svg class="w-3 h-3 inline-block" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                        </svg>
                                    </span>
                                }
                            </div>
                            <p class="text-sm text-gray-900 break-words">@translation.ValueEn</p>
                        </div>
                        
                        <!-- Arabic Translation -->
                        <div>
                            <div class="flex items-center mb-1">
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Arabic</span>
                                @if (translation.ValueAr == translation.Key)
                                {
                                    <span class="ml-2 px-2 py-0.5 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        <svg class="w-3 h-3 inline-block" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                        </svg>
                                    </span>
                                }
                            </div>
                            <p class="text-sm text-gray-900 break-words" dir="rtl">@translation.ValueAr</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (!isLoading && totalItems > 0 && totalPages > 1)
    {
        <div class="bg-white rounded-lg shadow-sm p-4 mt-4">
            <div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
                <!-- Page Info -->
                <div class="text-sm text-gray-600">
                    Page @currentPage of @totalPages
                </div>

                <!-- Pagination Controls -->
                <div class="flex items-center space-x-1">
                    <!-- First Page -->
                    <button @onclick="() => GoToPage(1)" 
                            disabled="@(currentPage == 1)"
                            class="px-2 py-1 sm:px-3 sm:py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-l-md hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
                        </svg>
                    </button>

                    <!-- Previous Page -->
                    <button @onclick="() => GoToPage(currentPage - 1)" 
                            disabled="@(currentPage == 1)"
                            class="px-2 py-1 sm:px-3 sm:py-2 text-sm font-medium text-gray-500 bg-white border-t border-b border-gray-300 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        int pageNumber = i;
                        <button @onclick="() => GoToPage(pageNumber)" 
                                class="@(pageNumber == currentPage ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-500 border-gray-300 hover:bg-gray-50") px-2 py-1 sm:px-3 sm:py-2 text-sm font-medium border-t border-b transition-colors">
                            @pageNumber
                        </button>
                    }

                    <!-- Next Page -->
                    <button @onclick="() => GoToPage(currentPage + 1)" 
                            disabled="@(currentPage == totalPages)"
                            class="px-2 py-1 sm:px-3 sm:py-2 text-sm font-medium text-gray-500 bg-white border-t border-b border-gray-300 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>

                    <!-- Last Page -->
                    <button @onclick="() => GoToPage(totalPages)" 
                            disabled="@(currentPage == totalPages)"
                            class="px-2 py-1 sm:px-3 sm:py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-r-md hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>

                <!-- Go to Page Input (Desktop Only) -->
                <div class="hidden sm:flex items-center space-x-2">
                    <span class="text-sm text-gray-600">Go to:</span>
                    <input type="number" min="1" max="@totalPages" @bind="@jumpToPage" @onkeypress="HandlePageJump"
                           class="w-16 px-2 py-1 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
            </div>
        </div>
    }
</div>

<!-- Edit Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @onclick="CloseModal">
        <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div class="px-4 sm:px-6 py-4 border-b flex justify-between items-center sticky top-0 bg-white">
                <h2 class="text-lg sm:text-xl font-bold text-gray-900">
                    @(editingId == 0 ? "Add Translation" : "Edit Translation")
                </h2>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 transition-colors p-1">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            
            <!-- Modal Body -->
            <div class="px-4 sm:px-6 py-4 space-y-4 sm:space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Key *</label>
                    <input type="text" @bind="editKey" 
                           disabled="@(editingId != 0)"
                           class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base @(editingId != 0 ? "bg-gray-100" : "")"
                           placeholder="e.g., HomePage.Title">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">English Value *</label>
                    <textarea @bind="editValueEn" rows="3"
                              class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base resize-none"
                              placeholder="English translation"></textarea>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Arabic Value *</label>
                    <textarea @bind="editValueAr" rows="3" dir="rtl"
                              class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base resize-none"
                              placeholder="الترجمة العربية"></textarea>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                    <input type="text" @bind="editCategory" 
                           class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base"
                           placeholder="e.g., UI, Product, HomePage">
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="px-4 sm:px-6 py-4 border-t flex flex-col sm:flex-row justify-end space-y-3 sm:space-y-0 sm:space-x-3 sticky bottom-0 bg-white">
                <button @onclick="CloseModal" 
                        class="w-full sm:w-auto px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors font-medium">
                    Cancel
                </button>
                <button @onclick="SaveTranslation" 
                        class="w-full sm:w-auto px-4 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Translation
                </button>
            </div>
        </div>
    </div>
}
@code {
    private List<TranslationItem> allTranslations = new();
    private List<TranslationItem> filteredTranslations = new();
    private List<TranslationItem> pagedTranslations = new();
    private string currentFilter = "all";
    private string searchTerm = "";
    private bool isLoading = true;
    
    private int allCount = 0;
    private int incompleteEnCount = 0;
    private int incompleteArCount = 0;
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalItems = 0;
    private int jumpToPage = 1;
    
    // Edit Modal
    private bool showEditModal = false;
    private int editingId = 0;
    private string editKey = "";
    private string editValueEn = "";
    private string editValueAr = "";
    private string editCategory = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTranslations();
    }

    private async Task LoadTranslations()
    {
        isLoading = true;
        var translations = await TranslationService.GetAllTranslationsAsync();
        allTranslations = translations.Select(t => new TranslationItem
        {
            Id = t.Id,
            Key = t.Key,
            ValueEn = t.ValueEn,
            ValueAr = t.ValueAr,
            Category = t.Category
        }).ToList();
        
        allCount = allTranslations.Count;
        incompleteEnCount = allTranslations.Count(t => t.ValueEn == t.Key);
        incompleteArCount = allTranslations.Count(t => t.ValueAr == t.Key);
        
        FilterTranslations();
        isLoading = false;
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
        FilterTranslations();
    }

    private void FilterTranslations()
    {
        var query = allTranslations.AsEnumerable();
        
        // Apply status filter
        if (currentFilter == "incomplete-en")
        {
            query = query.Where(t => t.ValueEn == t.Key);
        }
        else if (currentFilter == "incomplete-ar")
        {
            query = query.Where(t => t.ValueAr == t.Key);
        }
        
        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var search = searchTerm.ToLower();
            query = query.Where(t => 
                t.Key.ToLower().Contains(search) || 
                t.ValueEn.ToLower().Contains(search) || 
                t.ValueAr.ToLower().Contains(search) ||
                (t.Category?.ToLower().Contains(search) ?? false));
        }
        
        filteredTranslations = query.ToList();
        
        // Reset to first page when filtering
        currentPage = 1;
        ApplyPagination();
    }

    private void ApplyPagination()
    {
        totalItems = filteredTranslations.Count;
        totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
        
        if (currentPage > totalPages && totalPages > 0)
            currentPage = totalPages;
        
        var skip = (currentPage - 1) * pageSize;
        pagedTranslations = filteredTranslations.Skip(skip).Take(pageSize).ToList();
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyPagination();
        }
    }

    private void ChangePageSize(int newPageSize)
    {
        pageSize = newPageSize;
        currentPage = 1;
        ApplyPagination();
    }

    private void HandlePageJump(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            if (jumpToPage >= 1 && jumpToPage <= totalPages)
            {
                GoToPage(jumpToPage);
            }
            else
            {
                jumpToPage = currentPage; // Reset to current page if invalid
            }
        }
    }

    private void AddNewTranslation()
    {
        editingId = 0;
        editKey = "";
        editValueEn = "";
        editValueAr = "";
        editCategory = "";
        showEditModal = true;
    }

    private void EditTranslation(int id)
    {
        var translation = allTranslations.FirstOrDefault(t => t.Id == id);
        if (translation != null)
        {
            editingId = id;
            editKey = translation.Key;
            editValueEn = translation.ValueEn;
            editValueAr = translation.ValueAr;
            editCategory = translation.Category ?? "";
            showEditModal = true;
        }
    }

    private async Task SaveTranslation()
    {
        if (string.IsNullOrWhiteSpace(editKey) || string.IsNullOrWhiteSpace(editValueEn) || string.IsNullOrWhiteSpace(editValueAr))
        {
            return;
        }
        
        if (editingId == 0)
        {
            // For new translations, we need to use SetTranslationAsync for both languages
            await TranslationService.SetTranslationAsync(editKey, "en", editValueEn, editCategory);
            var translations = await TranslationService.GetAllTranslationsAsync();
            var newTranslation = translations.FirstOrDefault(t => t.Key == editKey);
            if (newTranslation.Id != 0)
            {
                await TranslationService.UpdateTranslationAsync(newTranslation.Id, editValueEn, editValueAr);
            }
        }
        else
        {
            await TranslationService.UpdateTranslationAsync(editingId, editValueEn, editValueAr);
        }
        
        CloseModal();
        await LoadTranslations();
    }

    private async Task DeleteTranslation(int id)
    {
        var translation = allTranslations.FirstOrDefault(t => t.Id == id);
        if (translation != null)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to delete the translation for '{translation.Key}'?");
            
            if (confirmed && await TranslationService.DeleteTranslationAsync(id))
            {
                await LoadTranslations();
            }
        }
    }

    private void CloseModal()
    {
        showEditModal = false;
    }

    private class TranslationItem
    {
        public int Id { get; set; }
        public string Key { get; set; } = "";
        public string ValueEn { get; set; } = "";
        public string ValueAr { get; set; } = "";
        public string? Category { get; set; }
    }
}
