@page "/admin/shipping"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using SpirithubCafe.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using SpirithubCafe.Web.Components.Shared
@inject ShippingService ShippingService
@inject ShippingMethodService ShippingMethodService
@inject TranslationLocalizer Localizer
@inject ToastService ToastService
@rendermode InteractiveServer

<PageTitle>Shipping Management - SpirithubCafe</PageTitle>

<Toast />

<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Page Header -->
        <div class="bg-white shadow-sm rounded-lg mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Shipping Management</h1>
                        <p class="mt-1 text-sm text-gray-600">Manage GCC countries and cities for Aramex shipping</p>
                    </div>
                    <div class="mt-4 sm:mt-0 flex space-x-3">
                        <a href="/admin/shipping-methods" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2m13-8V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v1M8 5V4a1 1 0 00-1-1H3a1 1 0 00-1 1v1"/>
                            </svg>
                            Shipping Methods
                        </a>
                        <button type="button" @onclick="ShowCreateCountryForm" 
                                class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Add Country
                        </button>
                        @if (selectedCountry != null)
                        {
                            <button type="button" @onclick="ShowCreateCityForm" 
                                    class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                Add City to @selectedCountry.Name
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Stats Section -->
            <div class="px-6 py-4">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945"></path>
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-blue-900">Total Countries</p>
                                <p class="text-2xl font-bold text-blue-600">@totalCountries</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-green-50 rounded-lg p-4 border border-green-200">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-green-900">Active Countries</p>
                                <p class="text-2xl font-bold text-green-600">@activeCountries</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-8 w-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-purple-900">Total Cities</p>
                                <p class="text-2xl font-bold text-purple-600">@totalCities</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-amber-50 rounded-lg p-4 border border-[#D3DAD9]">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <svg class="h-8 w-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-amber-900">Active Cities</p>
                                <p class="text-2xl font-bold text-amber-600">@activeCities</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        @if (showCountryForm || showCityForm)
        {
            <!-- Form Modal -->
            <div class="fixed inset-0 backdrop-blur-sm bg-black/20 h-full w-full z-50 flex items-center justify-center p-4" @onclick="CancelForm">
                <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full border border-gray-100 transform transition-all max-h-[90vh] flex flex-col" @onclick:stopPropagation="true">
                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-t-xl">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                                    @if (showCountryForm)
                                    {
                                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <h3 class="text-lg font-semibold text-gray-900">
                                        @if (showCountryForm)
                                        {
                                            @(editingCountry != null ? "Edit Country" : "Add New Country")
                                        }
                                        else
                                        {
                                            @(editingCity != null ? "Edit City" : "Add New City")
                                        }
                                    </h3>
                                    <p class="text-sm text-gray-600">
                                        @if (showCountryForm)
                                        {
                                            @(editingCountry != null ? "Update country information" : "Add a new GCC country")
                                        }
                                        else
                                        {
                                            @(editingCity != null ? "Update city information" : $"Add a new city to {selectedCountry?.Name}")
                                        }
                                    </p>
                                </div>
                            </div>
                            <button type="button" @onclick="CancelForm" class="p-2 hover:bg-white/50 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Form Content -->
                    <div class="px-6 py-6 flex-1 overflow-y-auto">
                        @if (showCountryForm)
                        {
                            <!-- Country Form -->
                            <EditForm Model="currentCountry" OnValidSubmit="SaveCountry">
                                <DataAnnotationsValidator />
                                <div class="space-y-6">
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">Country Code *</label>
                                            <InputText @bind-Value="currentCountry.Code" 
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" 
                                                placeholder="e.g., AE, SA, KW" />
                                            <ValidationMessage For="() => currentCountry.Code" class="text-red-500 text-sm font-medium" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">Country Name (English) *</label>
                                            <InputText @bind-Value="currentCountry.Name" 
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" />
                                            <ValidationMessage For="() => currentCountry.Name" class="text-red-500 text-sm font-medium" />
                                        </div>
                                    </div>
                                    
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Country Name (Arabic)</label>
                                        <InputText @bind-Value="currentCountry.NameAr" 
                                            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" 
                                            dir="rtl" />
                                    </div>
                                    
                                    <div class="flex items-center space-x-3 p-4 bg-blue-50 rounded-lg">
                                        <InputCheckbox @bind-Value="currentCountry.IsActive" 
                                            class="w-5 h-5 text-blue-600 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 transition-all" />
                                        <label class="text-sm font-semibold text-blue-800 cursor-pointer">Active Country</label>
                                        <span class="text-xs text-blue-600">Enable this country for shipping</span>
                                    </div>
                                </div>
                                
                                <!-- Footer -->
                                <div class="flex justify-end space-x-3 mt-8 pt-6 border-t border-gray-100 flex-shrink-0">
                                    <button type="button" @onclick="CancelForm" 
                                        class="px-6 py-3 border border-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 focus:ring-2 focus:ring-gray-200 transition-all duration-200">
                                        Cancel
                                    </button>
                                    <button type="submit" disabled="@saving"
                                        class="px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:from-blue-600 hover:to-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transform hover:scale-105 transition-all duration-200 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                                        <div class="flex items-center space-x-2">
                                            @if (saving) 
                                            {
                                                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                                <span>Saving...</span>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                <span>@(editingCountry != null ? "Update" : "Save") Country</span>
                                            }
                                        </div>
                                    </button>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <!-- City Form -->
                            <EditForm Model="currentCity" OnValidSubmit="SaveCity">
                                <DataAnnotationsValidator />
                                <div class="space-y-6">
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">Select Country</label>
                                        <select @bind="currentCity.CountryId" 
                                            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white">
                                            <option value="">Choose a country...</option>
                                            @foreach (var country in allCountries)
                                            {
                                                <option value="@country.Id">@country.Name (@country.Code)</option>
                                            }
                                        </select>
                                    </div>
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">City Code</label>
                                            <InputText @bind-Value="currentCity.Code" 
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" 
                                                placeholder="e.g., DXB, RUH, DOH" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="block text-sm font-semibold text-gray-700">City Name (English) *</label>
                                            <InputText @bind-Value="currentCity.Name" 
                                                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" />
                                            <ValidationMessage For="() => currentCity.Name" class="text-red-500 text-sm font-medium" />
                                        </div>
                                    </div>
                                    
                                    <div class="space-y-2">
                                        <label class="block text-sm font-semibold text-gray-700">City Name (Arabic)</label>
                                        <InputText @bind-Value="currentCity.NameAr" 
                                            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white" 
                                            dir="rtl" />
                                    </div>
                                    
                                    <div class="flex items-center space-x-3 p-4 bg-green-50 rounded-lg">
                                        <InputCheckbox @bind-Value="currentCity.IsActive" 
                                            class="w-5 h-5 text-green-600 bg-white border-2 border-gray-300 rounded-md focus:ring-2 focus:ring-green-500 transition-all" />
                                        <label class="text-sm font-semibold text-green-800 cursor-pointer">Active City</label>
                                        <span class="text-xs text-green-600">Enable this city for shipping</span>
                                    </div>
                                </div>
                                
                                <!-- Footer -->
                                <div class="flex justify-end space-x-3 mt-8 pt-6 border-t border-gray-100 flex-shrink-0">
                                    <button type="button" @onclick="CancelForm" 
                                        class="px-6 py-3 border border-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 focus:ring-2 focus:ring-gray-200 transition-all duration-200">
                                        Cancel
                                    </button>
                                    <button type="submit" disabled="@saving"
                                        class="px-6 py-3 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold rounded-lg hover:from-green-600 hover:to-emerald-700 focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transform hover:scale-105 transition-all duration-200 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                                        <div class="flex items-center space-x-2">
                                            @if (saving) 
                                            {
                                                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                                <span>Saving...</span>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                <span>@(editingCity != null ? "Update" : "Save") City</span>
                                            }
                                        </div>
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Countries Grid and Cities List -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Countries Panel -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-medium text-gray-900">Countries</h2>
                    <p class="text-sm text-gray-600">Click a country to view its cities</p>
                </div>
                <div class="p-6">
                    @if (allCountries.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var country in allCountries)
                            {
                                <div class="border rounded-lg p-4 cursor-pointer transition-colors @(selectedCountry?.Id == country.Id ? "border-blue-500 bg-blue-50" : "border-gray-200 hover:border-gray-300")" 
                                     @onclick="() => SelectCountry(country)">
                                    <div class="flex items-center justify-between">
                                        <div class="flex-1">
                                            <div class="flex items-center space-x-2">
                                                <h3 class="text-sm font-semibold text-gray-900">@country.Name</h3>
                                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800">@country.Code</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(country.NameAr))
                                            {
                                                <p class="text-xs text-gray-600 mt-1" dir="rtl">@country.NameAr</p>
                                            }
                                            <p class="text-xs text-gray-500 mt-1">@country.Cities.Count cities</p>
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            @if (country.IsActive)
                                            {
                                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactive</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-3 flex space-x-2">
                                        <button @onclick="() => EditCountry(country)" @onclick:stopPropagation="true"
                                                class="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 px-2 py-1 rounded border border-blue-200">
                                            Edit
                                        </button>
                                        <button @onclick="() => ToggleCountryStatus(country.Id)" @onclick:stopPropagation="true"
                                                class="text-xs @(country.IsActive ? "bg-yellow-50 text-yellow-700 hover:bg-yellow-100 border-yellow-200" : "bg-green-50 text-green-700 hover:bg-green-100 border-green-200") px-2 py-1 rounded border">
                                            @(country.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                        <button @onclick="() => DeleteCountry(country)" @onclick:stopPropagation="true"
                                                class="text-xs bg-red-50 text-red-700 hover:bg-red-100 px-2 py-1 rounded border border-red-200">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No countries</h3>
                            <p class="mt-1 text-sm text-gray-500">Get started by adding your first country.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Cities Panel -->
            <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h2 class="text-lg font-medium text-gray-900">
                        Cities
                        @if (selectedCountry != null)
                        {
                            <span class="text-sm font-normal text-gray-600">in @selectedCountry.Name</span>
                        }
                    </h2>
                </div>
                <div class="p-6">
                    @if (selectedCountry != null)
                    {
                        @if (currentCities.Any())
                        {
                            <div class="space-y-3">
                                @foreach (var city in currentCities)
                                {
                                    <div class="border rounded-lg p-3 border-gray-200">
                                        <div class="flex items-center justify-between">
                                            <div class="flex-1">
                                                <div class="flex items-center space-x-2">
                                                    <h4 class="text-sm font-medium text-gray-900">@city.Name</h4>
                                                    @if (!string.IsNullOrEmpty(city.Code))
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800">@city.Code</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(city.NameAr))
                                                {
                                                    <p class="text-xs text-gray-600 mt-1" dir="rtl">@city.NameAr</p>
                                                }
                                            </div>
                                            <div class="flex items-center space-x-2">
                                                @if (city.IsActive)
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactive</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="mt-2 flex space-x-2">
                                            <button @onclick="() => EditCity(city)"
                                                    class="text-xs bg-green-50 text-green-700 hover:bg-green-100 px-2 py-1 rounded border border-green-200">
                                                Edit
                                            </button>
                                            <button @onclick="() => ToggleCityStatus(city.Id)"
                                                    class="text-xs @(city.IsActive ? "bg-yellow-50 text-yellow-700 hover:bg-yellow-100 border-yellow-200" : "bg-green-50 text-green-700 hover:bg-green-100 border-green-200") px-2 py-1 rounded border">
                                                @(city.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                            <button @onclick="() => DeleteCity(city)"
                                                    class="text-xs bg-red-50 text-red-700 hover:bg-red-100 px-2 py-1 rounded border border-red-200">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                </svg>
                                <h3 class="mt-2 text-sm font-medium text-gray-900">No cities</h3>
                                <p class="mt-1 text-sm text-gray-500">Add cities to @selectedCountry.Name for shipping coverage.</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">Select a country</h3>
                            <p class="mt-1 text-sm text-gray-500">Choose a country from the left panel to view its cities.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Country> allCountries = new();
    private List<City> currentCities = new();
    private Country? selectedCountry = null;
    
    private Country currentCountry = new() { IsActive = true };
    private City currentCity = new() { IsActive = true };
    
    private Country? editingCountry = null;
    private City? editingCity = null;
    
    private bool showCountryForm = false;
    private bool showCityForm = false;
    private bool saving = false;

    // Stats
    private int totalCountries = 0;
    private int activeCountries = 0;
    private int totalCities = 0;
    private int activeCities = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            allCountries = await ShippingService.GetAllCountriesAsync();
            CalculateStats();
            
            // Auto-select first country if available
            if (allCountries.Any() && selectedCountry == null)
            {
                await SelectCountry(allCountries.First());
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading data: {ex.Message}");
        }
        
        StateHasChanged();
    }

    private async Task SelectCountry(Country country)
    {
        selectedCountry = country;
        try
        {
            currentCities = await ShippingService.GetCitiesByCountryAsync(country.Id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading cities: {ex.Message}");
        }
        StateHasChanged();
    }

    private void CalculateStats()
    {
        totalCountries = allCountries.Count;
        activeCountries = allCountries.Count(c => c.IsActive);
        totalCities = allCountries.Sum(c => c.Cities.Count);
        activeCities = allCountries.SelectMany(c => c.Cities).Count(c => c.IsActive);
    }

    // Country methods
    private void ShowCreateCountryForm()
    {
        currentCountry = new() { IsActive = true };
        editingCountry = null;
        showCountryForm = true;
    }

    private void EditCountry(Country country)
    {
        editingCountry = country;
        currentCountry = new Country
        {
            Id = country.Id,
            Code = country.Code,
            Name = country.Name,
            NameAr = country.NameAr,
            IsActive = country.IsActive
        };
        showCountryForm = true;
    }

    private async Task SaveCountry()
    {
        saving = true;
        try
        {
            if (editingCountry != null)
            {
                await ShippingService.UpdateCountryAsync(currentCountry);
                ToastService.ShowSuccess("Country updated successfully");
            }
            else
            {
                await ShippingService.CreateCountryAsync(currentCountry);
                ToastService.ShowSuccess("Country created successfully");
            }
            
            CancelForm();
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving country: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleCountryStatus(int countryId)
    {
        try
        {
            await ShippingService.ToggleCountryStatusAsync(countryId);
            await LoadData();
            ToastService.ShowSuccess("Country status updated");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating country status: {ex.Message}");
        }
    }

    private async Task DeleteCountry(Country country)
    {
        try
        {
            await ShippingService.DeleteCountryAsync(country.Id);
            await LoadData();
            ToastService.ShowSuccess("Country deleted successfully");
            
            // Clear selection if deleted country was selected
            if (selectedCountry?.Id == country.Id)
            {
                selectedCountry = null;
                currentCities.Clear();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting country: {ex.Message}");
        }
    }

    // City methods
    private void ShowCreateCityForm()
    {
        if (selectedCountry == null) return;
        
        currentCity = new() { IsActive = true, CountryId = selectedCountry.Id };
        editingCity = null;
        showCityForm = true;
    }

    private void EditCity(City city)
    {
        editingCity = city;
        currentCity = new City
        {
            Id = city.Id,
            Code = city.Code,
            Name = city.Name,
            NameAr = city.NameAr,
            IsActive = city.IsActive,
            CountryId = city.CountryId
        };
        showCityForm = true;
    }

    private async Task SaveCity()
    {
        saving = true;
        try
        {
            if (editingCity != null)
            {
                await ShippingService.UpdateCityAsync(currentCity);
                ToastService.ShowSuccess("City updated successfully");
            }
            else
            {
                await ShippingService.CreateCityAsync(currentCity);
                ToastService.ShowSuccess("City created successfully");
            }
            
            CancelForm();
            await LoadData();
            
            // Refresh cities for selected country
            if (selectedCountry != null)
            {
                await SelectCountry(selectedCountry);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving city: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleCityStatus(int cityId)
    {
        try
        {
            await ShippingService.ToggleCityStatusAsync(cityId);
            
            // Refresh cities for selected country
            if (selectedCountry != null)
            {
                await SelectCountry(selectedCountry);
            }
            await LoadData();
            ToastService.ShowSuccess("City status updated");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error updating city status: {ex.Message}");
        }
    }

    private async Task DeleteCity(City city)
    {
        try
        {
            await ShippingService.DeleteCityAsync(city.Id);
            
            // Refresh cities for selected country
            if (selectedCountry != null)
            {
                await SelectCountry(selectedCountry);
            }
            await LoadData();
            ToastService.ShowSuccess("City deleted successfully");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting city: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showCountryForm = false;
        showCityForm = false;
        editingCountry = null;
        editingCity = null;
        currentCountry = new() { IsActive = true };
        currentCity = new() { IsActive = true };
    }
}