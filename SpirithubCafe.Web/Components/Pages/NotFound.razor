@page "/not-found"
@inject NavigationManager Navigation
@inject TranslationLocalizer Localizer
@layout SpirithubCafe.Web.Components.Layout.MainLayout

<PageTitle>@Localizer["PageNotFound"] - @Localizer["SiteTitle"]</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full text-center">
        <!-- 404 Illustration -->
        <div class="mb-8 relative">
            <div class="text-[180px] font-bold text-gray-200 leading-none select-none">404</div>
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-32 h-32 bg-[#715A5A] rounded-full flex items-center justify-center shadow-2xl animate-bounce">
                    <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Error Message -->
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            @Localizer["PageNotFound"]
        </h1>
        <p class="text-lg text-gray-600 mb-8 max-w-md mx-auto">
            @Localizer["PageNotFoundMessage"]
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <button @onclick="GoBack" 
                    class="inline-flex items-center px-6 py-3 bg-white border-2 border-[#715A5A] text-[#715A5A] font-semibold rounded-xl hover:bg-[#715A5A] hover:text-white transition-all duration-200 shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 ltr:mr-2 rtl:ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                @Localizer["GoBack"]
            </button>
            
            <a href="/" 
               class="inline-flex items-center px-6 py-3 bg-[#715A5A] text-white font-semibold rounded-xl hover:bg-[#5d4848] transition-all duration-200 shadow-md hover:shadow-lg">
                <svg class="w-5 h-5 ltr:mr-2 rtl:ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                @Localizer["GoToHomePage"]
            </a>
        </div>

        <!-- Popular Links -->
        <div class="mt-12 pt-8 border-t border-gray-200">
            <p class="text-sm text-gray-500 mb-4">@Localizer["PopularPages"]</p>
            <div class="flex flex-wrap gap-3 justify-center">
                <a href="/products" class="text-sm text-gray-600 hover:text-[#715A5A] transition-colors">
                    @Localizer["Products"]
                </a>
                <span class="text-gray-300">•</span>
                <a href="/about" class="text-sm text-gray-600 hover:text-[#715A5A] transition-colors">
                    @Localizer["AboutUs"]
                </a>
                <span class="text-gray-300">•</span>
                <a href="/contact" class="text-sm text-gray-600 hover:text-[#715A5A] transition-colors">
                    @Localizer["ContactUs"]
                </a>
                <span class="text-gray-300">•</span>
                <a href="/cart" class="text-sm text-gray-600 hover:text-[#715A5A] transition-colors">
                    @Localizer["Cart"]
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("/", forceLoad: false);
        // Try to go back if possible
        try 
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: false);
        }
        catch
        {
            Navigation.NavigateTo("/");
        }
    }
}
