@page "/payment-success"
@page "/checkout/payment-success"
@using SpirithubCafe.Application.Interfaces
@using SpirithubCafe.Application.Services
@using SpirithubCafe.Web.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IPaymentGatewayService PaymentGatewayService
@inject IPaymentService PaymentService
@inject ICheckoutService CheckoutService
@inject NavigationManager Navigation
@inject ILogger<PaymentSuccess> Logger
@inject IJSRuntime JSRuntime
@inject TranslationLocalizer Localizer



<div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
            @if (isLoading)
            {
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-600 mx-auto mb-4"></div>
                <p class="text-lg text-gray-600">@Localizer["VerifyingPayment"]...</p>
            }
            else if (paymentVerified)
            {
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                
                <h1 class="text-3xl font-bold text-gray-900 mb-4">@Localizer["PaymentSuccessful"]!</h1>
                <p class="text-lg text-gray-600 mb-6">@Localizer["ThankYouForOrder"]</p>
                
                @if (order != null)
                {
                    <div class="bg-gray-50 rounded-lg p-6 mb-6">
                        <h2 class="text-xl font-semibold text-gray-900 mb-4">@Localizer["OrderDetails"]</h2>
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["OrderNumber"]:</span>
                                <span class="text-gray-900">@order.OrderNumber</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["TotalAmount"]:</span>
                                <span class="text-gray-900">@order.TotalAmount.ToString("F3") OMR</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["PaymentStatus"]:</span>
                                <span class="text-green-600 font-medium">@order.PaymentStatus</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["OrderStatus"]:</span>
                                <span class="text-blue-600 font-medium">@order.Status</span>
                            </div>
                        </div>
                    </div>
                }
                
                @if (payment != null)
                {
                    <div class="bg-gray-50 rounded-lg p-6 mb-6">
                        <h2 class="text-xl font-semibold text-gray-900 mb-4">@Localizer["PaymentDetails"]</h2>
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["PaymentReference"]:</span>
                                <span class="text-gray-900">@payment.PaymentReference</span>
                            </div>
                            @if (!string.IsNullOrEmpty(payment.TransactionId))
                            {
                                <div>
                                    <span class="font-medium text-gray-700">@Localizer["TransactionId"]:</span>
                                    <span class="text-gray-900">@payment.TransactionId</span>
                                </div>
                            }
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["PaymentMethod"]:</span>
                                <span class="text-gray-900">@(payment.PaymentMethod ?? @Localizer["NotSpecified"])</span>
                            </div>
                            <div>
                                <span class="font-medium text-gray-700">@Localizer["Date"]:</span>
                                <span class="text-gray-900">@payment.CompletedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                }
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/products" 
                       class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors text-center">
                        @Localizer["ContinueShopping"]
                    </a>
                    <a href="/account/orders" 
                       class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors text-center">
                        @Localizer["ViewOrders"]
                    </a>
                </div>
            }
            else
            {
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
                
                <h1 class="text-3xl font-bold text-gray-900 mb-4">Payment Verification Failed</h1>
                <p class="text-lg text-gray-600 mb-6">We couldn't verify your payment. Please contact support if you believe this is an error.</p>
                
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/checkout" 
                       class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors text-center">
                        Try Again
                    </a>
                    <a href="/contact" 
                       class="bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors text-center">
                        Contact Support
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? PaymentRef { get; set; }
    
    private bool isLoading = true;
    private bool paymentVerified = false;
    private Domain.Entities.Payment? payment;
    private Domain.Entities.Order? order;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get query parameters from the current URL like PHP $_REQUEST
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

            // Convert to simple dictionary like PHP does
            var parameters = new Dictionary<string, string>();
            foreach (var kvp in queryParams)
            {
                parameters[kvp.Key] = kvp.Value.ToString();
            }

            // Process the payment callback like PHP CompletePurchaseResponse
            var callback = await PaymentGatewayService.ProcessCallbackAsync(parameters);
            
            // Update payment status
            if (!string.IsNullOrEmpty(callback.PaymentReference))
            {
                payment = await PaymentService.UpdatePaymentStatusAsync(callback.PaymentReference, callback);
                if (payment != null)
                {
                    order = await CheckoutService.GetOrderByIdAsync(payment.OrderId);
                }
            }

            paymentVerified = callback.Status == "Completed";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing payment callback");
            paymentVerified = false;
        }
        finally
        {
            isLoading = false;
        }
    }
}