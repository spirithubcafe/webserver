@page "/text-editor-demo"
@rendermode InteractiveServer
@using SpirithubCafe.Web.Components.Shared

<div class="min-h-screen bg-gray-100 py-8">
    <div class="max-w-6xl mx-auto px-4">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Professional Text Editor</h1>
                <p class="text-gray-600">A powerful, professional text editor component built entirely in C# with preview functionality.</p>
            </div>
            
            <div class="space-y-6">
                <!-- Main Editor -->
                <div class="bg-gray-50 p-4 rounded-lg">
                    <h2 class="text-xl font-semibold mb-4">Rich Text Editor</h2>
                    <TextEditor @bind-Content="@editorContent" 
                               Placeholder="Start writing your content here..."
                               MinHeight="400"
                               DefaultMode="TextEditor.EditorMode.Split" />
                </div>
                
                <!-- Additional Examples -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Read-only Preview -->
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <h3 class="text-lg font-semibold mb-3">Read-only Preview</h3>
                        <TextEditor Content="@sampleContent" 
                                   ReadOnly="true"
                                   MinHeight="200"
                                   DefaultMode="TextEditor.EditorMode.Preview" />
                    </div>
                    
                    <!-- Compact Editor -->
                    <div class="bg-gray-50 p-4 rounded-lg">
                        <h3 class="text-lg font-semibold mb-3">Compact Editor</h3>
                        <TextEditor @bind-Content="@compactContent" 
                                   Placeholder="Write a short note..."
                                   MinHeight="150"
                                   DefaultMode="TextEditor.EditorMode.Edit" />
                    </div>
                </div>
                
                <!-- Features List -->
                <div class="bg-blue-50 p-6 rounded-lg">
                    <h3 class="text-lg font-semibold mb-4 text-blue-900">Features</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        <ul class="space-y-2">
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                100% C# - No JavaScript required
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Rich text formatting (Bold, Italic, Underline)
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Lists support (Ordered & Unordered)
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Link insertion
                            </li>
                        </ul>
                        <ul class="space-y-2">
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Multiple view modes (Edit, Preview, Split)
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Real-time statistics (Lines, Words, Characters)
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Keyboard shortcuts (Ctrl+B, Ctrl+I, Ctrl+U)
                            </li>
                            <li class="flex items-center text-blue-800">
                                <svg class="w-4 h-4 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodet" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
                                </svg>
                                Responsive design with Tailwind CSS
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- Usage Example -->
                <div class="bg-gray-50 p-6 rounded-lg">
                    <h3 class="text-lg font-semibold mb-4">Usage Example</h3>
                    <pre class="bg-gray-800 text-gray-100 p-4 rounded text-sm overflow-x-auto"><code>@@using SpirithubCafe.Web.Components.Shared

&lt;TextEditor @@bind-Content="@@myContent" 
           Placeholder="Start writing..."
           MinHeight="400"
           DefaultMode="TextEditor.EditorMode.Split" /&gt;

@@code {
    private string myContent = "";
}</code></pre>
                </div>
                
                <!-- Current Content Display -->
                @if (!string.IsNullOrEmpty(editorContent))
                {
                    <div class="bg-yellow-50 p-6 rounded-lg">
                        <h3 class="text-lg font-semibold mb-4 text-yellow-900">Current Editor Content (Raw)</h3>
                        <pre class="bg-white p-4 rounded border text-sm text-gray-700 whitespace-pre-wrap">@editorContent</pre>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string editorContent = @"# Welcome to TextEditor!

This is a **professional text editor** component built entirely in *C#* without any JavaScript dependencies.

## Features:
- **Bold text** formatting
- *Italic text* support  
- <u>Underlined text</u> capability
- [Link insertion](https://github.com)

### Lists Support:
- Unordered lists
- With multiple items
- Easy to create

1. Ordered lists
2. Numbered automatically
3. Professional appearance

Try switching between **Edit**, **Preview**, and **Split** modes using the toolbar buttons!";

    private string sampleContent = @"## Sample Content

This editor supports **markdown-like** formatting and renders it beautifully in preview mode.

### Key Features:
- Real-time preview
- Professional toolbar
- Status bar with statistics
- Responsive design

[Visit our website](https://spirithubcafe.com) for more information.";

    private string compactContent = "";
}