@page "/"
@namespace SpirithubCafe.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using SpirithubCafe.Web.Components
@using Microsoft.AspNetCore.Components.Web
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="Server" />
    
    <style>
        /* Loading Screen Styles */
        #blazor-loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #ffffff 0%, #f5f5f5 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease-out;
        }
        
        #blazor-loading-screen.fade-out {
            opacity: 0;
            pointer-events: none;
        }
        
        .loading-logo {
            width: 120px;
            height: 120px;
            margin-bottom: 30px;
            animation: logoFloat 3s ease-in-out infinite;
        }
        
        .loading-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        
        @@keyframes logoFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        
        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #715A5A;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 30px;
        }
        
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .loading-text {
            font-size: 28px;
            color: #715A5A;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }
        
        .loading-subtext {
            font-size: 16px;
            color: #999;
            font-weight: 400;
        }

    </style>
</head>
<body>
    <!-- Loading Screen -->
    <div id="blazor-loading-screen">
        <div class="loading-logo">
            <img src="/images/logo-s.png" alt="Spirithub Logo" onerror="this.style.display='none'" />
        </div>
        <div class="loading-spinner"></div>
        <div class="loading-text">Welcome to Spirithub</div>
        <div class="loading-subtext">Brewing your experience...</div>
    </div>

    <component type="typeof(App)" render-mode="Server" />

    <script>
        // Check for preferred language in localStorage and set HTML attributes
        (function() {
            try {
                var preferredLang = localStorage.getItem('preferredLanguage');
                if (preferredLang) {
                    document.documentElement.lang = preferredLang;
                    document.documentElement.dir = preferredLang === 'ar' ? 'rtl' : 'ltr';
                }
            } catch (e) {
                console.warn('Could not access localStorage:', e);
            }
        })();
        
        // Make hideLoadingScreen function globally accessible for JSRuntime
        window.hideLoadingScreen = function() {
            var loadingScreen = document.getElementById('blazor-loading-screen');
            if (loadingScreen) {
                loadingScreen.classList.add('fade-out');
                setTimeout(function() {
                    loadingScreen.style.display = 'none';
                }, 500);
            }
        };
    </script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
