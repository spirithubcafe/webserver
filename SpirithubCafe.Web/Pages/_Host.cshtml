@page "/"
@namespace SpirithubCafe.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using SpirithubCafe.Web.Components
@using Microsoft.AspNetCore.Components.Web
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    
    <!-- Preload Critical CSS -->
    <link rel="preload" href="~/dist.css" as="style" />
    <link rel="preload" href="~/SpirithubCafe.Web.styles.css" as="style" />
    
    <!-- Critical CSS - Load first -->
    <link rel="stylesheet" href="~/dist.css" />
    <link rel="stylesheet" href="~/SpirithubCafe.Web.styles.css" />
    
    <!-- Preload Blazor Framework -->
    <link rel="modulepreload" href="_framework/blazor.server.js" />
    
    <!-- Load fonts with display=swap for faster rendering -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100;200;300;400;500;600;700;800;900&family=Tajawal:wght@200;300;400;500;700;800;900&family=Almarai:wght@300;400;700;800&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100;200;300;400;500;600;700;800;900&family=Tajawal:wght@200;300;400;500;700;800;900&family=Almarai:wght@300;400;700;800&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>
    
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="Server" />
    
    <style>
        /* Prevent white screen flash */
        body {
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }
        
        /* Loading Screen Styles */
        #blazor-loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 1;
            transition: opacity 0.3s ease-out;
        }
        
        #blazor-loading-screen.hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .loading-logo {
            width: 80px;
            height: 80px;
            margin-bottom: 20px;
            animation: logoFloat 2s ease-in-out infinite;
        }
        
        .loading-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        
        @@keyframes logoFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(113, 90, 90, 0.1);
            border-top: 3px solid #715A5A;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 16px;
        }
        
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .loading-text {
            font-size: 18px;
            color: #715A5A;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

    </style>
</head>
<body>
    <!-- Loading Screen -->
    <div id="blazor-loading-screen">
        <div class="loading-logo">
            <img src="/images/logo-s.png" alt="Spirithub Logo" onerror="this.style.display='none'" />
        </div>
        <div class="loading-spinner"></div>
        <div class="loading-text">Welcome to Spirithub</div>
    </div>

    <component type="typeof(App)" render-mode="Server" />

    <script>
        // Check for preferred language in localStorage and set HTML attributes
        (function() {
            try {
                var preferredLang = localStorage.getItem('preferredLanguage');
                if (preferredLang) {
                    document.documentElement.lang = preferredLang;
                    document.documentElement.dir = preferredLang === 'ar' ? 'rtl' : 'ltr';
                }
            } catch (e) {
                console.warn('Could not access localStorage:', e);
            }
        })();
        
        // Loading screen management
        (function() {
            var loadingScreen = document.getElementById('blazor-loading-screen');
            var isHidden = false;
            var blazorReady = false;
            
            function hideLoadingScreen() {
                if (isHidden || !loadingScreen) return;
                
                isHidden = true;
                loadingScreen.classList.add('hidden');
                
                // Remove from DOM after animation
                setTimeout(function() {
                    if (loadingScreen && loadingScreen.parentNode) {
                        loadingScreen.parentNode.removeChild(loadingScreen);
                        loadingScreen = null;
                    }
                }, 350);
            }
            
            // Make globally accessible
            window.hideLoadingScreen = hideLoadingScreen;
            window.markBlazorReady = function() {
                blazorReady = true;
                // Minimal delay to ensure first render is visible
                setTimeout(hideLoadingScreen, 150);
            };
            
            // Fallback timeout - hide after 10 seconds max (increased for slow connections)
            setTimeout(function() {
                console.warn('Loading screen timeout reached');
                hideLoadingScreen();
            }, 10000);
        })();
    </script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        // Start Blazor with optimized settings
        Blazor.start({
            configureSignalR: function (builder) {
                // Optimize SignalR for faster connection
                builder.withAutomaticReconnect({
                    nextRetryDelayInMilliseconds: function (retryContext) {
                        return Math.min(1000 * Math.pow(2, retryContext.previousRetryCount), 30000);
                    }
                });
            }
        }).then(function() {
            console.log('Blazor started successfully');
            // Wait for the first render to complete
            if (window.markBlazorReady) {
                window.markBlazorReady();
            }
        }).catch(function(error) {
            console.error('Blazor failed to start:', error);
            if (window.hideLoadingScreen) {
                window.hideLoadingScreen();
            }
        });
    </script>
</body>
</html>
