
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    
    <!-- Title will be set by Blazor components using HeadContent/PageTitle -->
    <title>SpirithubCafe</title>
     
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="dist.css" />
    <link rel="stylesheet" href="SpirithubCafe.Web.styles.css" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    
    <!-- Blazor HeadOutlet for dynamic head content -->
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
</head>

<body>
    @RenderBody()
    
    <!-- Error UI for connection issues -->
    <div id="blazor-error-ui">
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <environment exclude="Development">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <style>
        /* Hide Blazor's default reconnection UI */
        #components-reconnect-modal {
            display: none !important;
        }
        
        /* Hide any Blazor error UI */
        #blazor-error-ui {
            display: none !important;
        }
    </style>

    <script>
        window.blazorCulture = {
            get: () => window.localStorage['BlazorCulture'],
            set: (value) => window.localStorage['BlazorCulture'] = value
        };
    </script>
    
    <!-- Dropdown Helper - For mobile-friendly dropdowns -->
    <script src="/js/dropdown-helper.js"></script>
    
    <!-- Blazor Connection Manager -->
    <script src="/js/blazor-connection-manager.js"></script>
    
    <!-- Blazor Server JavaScript -->
    <script src="_framework/blazor.server.js"></script>
</body>

</html>