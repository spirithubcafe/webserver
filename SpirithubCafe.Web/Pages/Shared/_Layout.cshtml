
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    
    <!-- Title will be set by Blazor components using HeadContent/PageTitle -->
    <title>SpirithubCafe</title>
     
    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="dist.css" />
    <link rel="stylesheet" href="SpirithubCafe.Web.styles.css" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    
    <!-- Blazor HeadOutlet for dynamic head content -->
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
</head>

<body>
    @RenderBody()
    
    <!-- Loading Screen -->
    <div id="blazor-loading" style="position: fixed; inset: 0; background: #ffffff; display: flex; align-items: center; justify-content: center; z-index: 999999;">
        <div style="text-align: center;">
            <!-- Simple Spinning Circle -->
            <div style="width: 48px; height: 48px; margin: 0 auto 16px; border: 3px solid #f0f0f0; border-top-color: #715A5A; border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <!-- Loading Text -->
            <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #666; margin: 0;">Loading...</p>
        </div>
    </div>
    
    <style>
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
    
    <!-- Error UI for connection issues -->
    <div id="blazor-error-ui">
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <environment exclude="Development">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script>
        window.blazorCulture = {
            get: () => window.localStorage['BlazorCulture'],
            set: (value) => window.localStorage['BlazorCulture'] = value
        };
        
        // Global function to hide loading screen (can be called from Blazor)
        window.hideLoadingScreen = function() {
            const loadingScreen = document.getElementById('blazor-loading');
            if (loadingScreen && loadingScreen.style.display !== 'none') {
                loadingScreen.style.transition = 'opacity 0.3s ease-out';
                loadingScreen.style.opacity = '0';
                setTimeout(() => {
                    loadingScreen.style.display = 'none';
                }, 300);
            }
        };
    </script>
    
    <!-- Pure Server JavaScript -->
    <script src="_framework/blazor.server.js" autostart="false"></script>
    
    <script>
        // Professional loading screen management for Blazor Server
        let loadingHidden = false;
        
        function hideLoadingScreen() {
            if (loadingHidden) return;
            loadingHidden = true;
            
            const loadingScreen = document.getElementById('blazor-loading');
            if (loadingScreen) {
                loadingScreen.style.transition = 'opacity 0.3s ease-out';
                loadingScreen.style.opacity = '0';
                setTimeout(() => {
                    loadingScreen.style.display = 'none';
                }, 300);
            }
        }
        
        // Multiple fallback mechanisms for Blazor Server
        document.addEventListener('DOMContentLoaded', function() {
            // Method 1: Check for Blazor elements periodically
            const checkBlazorReady = setInterval(() => {
                if (document.querySelector('[data-blazor-loaded]') || 
                    document.querySelector('.blazor-error-boundary') ||
                    document.querySelector('main') ||
                    document.body.children.length > 2) {
                    clearInterval(checkBlazorReady);
                    hideLoadingScreen();
                }
            }, 100);
            
            // Method 2: Timeout fallback (failsafe)
            setTimeout(() => {
                clearInterval(checkBlazorReady);
                hideLoadingScreen();
            }, 5000);
            
            // Method 3: MutationObserver for DOM changes
            const observer = new MutationObserver(() => {
                if (document.body.children.length > 2) {
                    observer.disconnect();
                    hideLoadingScreen();
                }
            });
            
            observer.observe(document.body, { childList: true, subtree: true });
        });
        
        // Method 4: Window load event as additional fallback
        window.addEventListener('load', () => {
            setTimeout(hideLoadingScreen, 100);
        });
        
        // Start Blazor Server
        Blazor.start();
    </script>
</body>

</html>