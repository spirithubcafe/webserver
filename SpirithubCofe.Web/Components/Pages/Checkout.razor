@page "/checkout"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout SpirithubCofe.Web.Components.Layout.PublicLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using SpirithubCofe.Web.Services
@inject CartService CartService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SpirithubCofe.Langs.Resources> Localizer
@attribute [Authorize]

<PageTitle>Checkout - SpirithubCofe</PageTitle>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Checkout</h1>
    
    @if (isLoading)
    {
        <div class="text-center py-12">
            <div class="text-gray-500">Loading...</div>
        </div>
    }
    else if (CartService.Items?.Any() != true)
    {
        <div class="text-center py-12">
            <h2 class="text-xl text-gray-500 mb-4">Your cart is empty</h2>
            <a href="/products" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Cart Summary -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold mb-4">Your Cart</h2>
                
                @foreach (var item in CartService.Items)
                {
                    <div class="flex items-center justify-between py-3 border-b">
                        <div>
                            <h3 class="font-medium">@item.Name</h3>
                            <p class="text-sm text-gray-500">Qty: @item.Quantity</p>
                        </div>
                        <span class="font-medium">@((item.Price * item.Quantity).ToString("F3")) OMR</span>
                    </div>
                }
                
                <div class="pt-4">
                    <div class="flex justify-between font-semibold text-lg">
                        <span>Total:</span>
                        <span>@CartService.TotalPrice.ToString("F3") OMR</span>
                    </div>
                </div>
            </div>
            
            <!-- Simple Order Confirmation -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold mb-4">Order Summary</h2>
                
                <div class="space-y-4">
                    <p class="text-gray-600">
                        Thank you for your interest! Your cart contains @CartService.ItemCount items.
                    </p>
                    
                    <div class="border-t pt-4">
                        <div class="flex justify-between text-lg font-semibold">
                            <span>Total Amount:</span>
                            <span>@CartService.TotalPrice.ToString("F3") OMR</span>
                        </div>
                    </div>
                    
                    <div class="pt-4">
                        <button @onclick="CompleteOrder" disabled="@isProcessing" 
                                class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed">
                            @if (isProcessing)
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Complete Order - @CartService.TotalPrice.ToString("F3") OMR</span>
                            }
                        </button>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="mt-4 p-3 bg-green-100 text-green-800 rounded-lg">
                            @message
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(100); // Small delay to show loading
        isLoading = false;
    }

    private async Task CompleteOrder()
    {
        if (CartService.Items?.Any() != true) return;
        
        isProcessing = true;
        try
        {
            // Simulate order processing
            await Task.Delay(1000);
            
            message = $"Order completed successfully! Total: {CartService.TotalPrice:F3} OMR";
            
            // Clear cart after successful order
            await CartService.ClearCart();
            
            // Redirect to products page after a short delay
            await Task.Delay(2000);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            message = $"Error processing order: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
