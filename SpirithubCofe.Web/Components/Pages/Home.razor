@page "/"
@inject IStringLocalizer<Resources> Localizer
@inject CategoryService CategoryService
@inject HomePageSettingsService HomePageSettingsService
@inject ProductService ProductService
@using SpirithubCofe.Web.Components.Shared
@using SpirithubCofe.Domain.Entities
@using SpirithubCofe.Web.Services

<PageTitle>@Localizer["Home"] - @Localizer["SiteTitle"]</PageTitle>

<!-- Dynamic Sections based on Order -->
@{
    var orderedSections = GetOrderedSections();
}

@foreach (var section in orderedSections.Where(s => s.IsEnabled))
{
    @if (section.Name == "Slideshow")
    {
        <HeroSlideshow />
    }
    else if (section.Name == "Categories" && homepageCategories.Any())
    {
        <section class="py-16 @GetCategoriesSectionStyle()" style="@GetCategoriesBackgroundStyle()">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-gray-900 mb-4">@GetCategoriesTitle()</h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                        @GetCategoriesSubtitle()
                    </p>
                </div>

                <div class="flex justify-center">
                    <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-5 gap-4">
                        @foreach (var category in homepageCategories)
                        {
                            <a href="/products/@category.Slug" class="block text-center">
                                <div class="aspect-square bg-gray-50 rounded-xl shadow-sm border border-gray-100 hover:shadow-md mb-3">
                                    @if (!string.IsNullOrEmpty(category.ImagePath))
                                    {
                                        <img src="@category.ImagePath" 
                                             alt="@GetCategoryName(category)" 
                                             class="w-full h-full object-cover rounded-xl" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center rounded-xl">
                                            <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                            </svg>
                                        </div>
                                    }
                                </div>
                                <h3 class="font-medium text-gray-900 text-sm hover:text-amber-600">
                                    @GetCategoryName(category)
                                </h3>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section.Name == "Mission")
    {
        <section class="relative py-24 overflow-hidden">
            <!-- Background with fixed attachment -->
            <div class="absolute inset-0 @GetMissionBackgroundClass()" style="@GetMissionBackgroundStyle()">
                <!-- Overlay for better text readability -->
                <div class="absolute inset-0 bg-opacity-40"></div>
            </div>
            
            <!-- Content -->
            <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <div class="bg-white bg-opacity-95 backdrop-blur-sm rounded-2xl p-12 shadow-2xl">
                    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                        @GetMissionTitle()
                    </h2>
                    <p class="text-xl text-gray-700 mb-8 leading-relaxed">
                        @GetMissionSubtitle()
                    </p>
                    @if (!string.IsNullOrEmpty(GetMissionText()))
                    {
                        <div class="prose prose-lg mx-auto text-gray-600 leading-relaxed">
                            @((MarkupString)GetMissionText().Replace("\n", "<br>"))
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (section.Name == "LatestProducts")
    {
        <section class="py-16 @GetLatestProductsSectionStyle()" style="@GetLatestProductsBackgroundStyle()">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-gray-900 mb-4">@GetLatestProductsTitle()</h2>
                    <p class="text-lg text-gray-600">@GetLatestProductsSubtitle()</p>
                </div>

                @if (latestProducts.Any())
                {
                    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-4 md:gap-6">
                        @foreach (var product in latestProducts)
                        {
                            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md hover:border-stone-200 transition-all duration-300 transform hover:-translate-y-1">
                                <div class="aspect-square bg-gray-50 relative overflow-hidden">
                                    @if (product.MainImage?.ImagePath != null)
                                    {
                                        <img src="@product.MainImage.ImagePath" 
                                             alt="@GetProductName(product)" 
                                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-stone-50 to-stone-100 flex items-center justify-center">
                                            <svg class="w-8 h-8 md:w-10 md:h-10 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                                      d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                            </svg>
                                        </div>
                                    }
                                </div>
                                <div class="p-3 md:p-4">
                                    <h3 class="text-sm md:text-base font-semibold mb-1 md:mb-2 line-clamp-1 text-gray-900">@GetProductName(product)</h3>
                                    <p class="text-gray-500 text-xs md:text-sm mb-2 md:mb-3 line-clamp-1">@GetProductNotes(product)</p>
                                    <div class="flex flex-col gap-2">
                                        <span class="text-lg md:text-xl font-bold text-stone-700">@GetProductPrice(product)</span>
                                        <a href="/product/@product.Slug" class="bg-stone-600 hover:bg-stone-700 text-white px-3 py-2 rounded-lg text-xs md:text-sm font-medium transition-colors text-center">
                                            @Localizer["ViewProduct"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-12">
                        <div class="text-stone-400 mb-4">
                            <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                      d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                        </div>
                        <p class="text-stone-500 text-lg">@Localizer["NoProductsAvailable"]</p>
                    </div>
                }

                <div class="text-center mt-8">
                    <a href="/products" class="bg-amber-600 hover:bg-amber-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors">
                        @Localizer["ViewAllProducts"]
                    </a>
                </div>
            </div>
        </section>
    }
    else if (section.Name == "Newsletter")
    {
        <section class="py-16 @GetNewsletterBackgroundClass()" style="@GetNewsletterBackgroundStyle()">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <!-- Newsletter Image -->
                    @if (!string.IsNullOrEmpty(homePageSettings.NewsletterImage))
                    {
                        <div class="order-2 lg:order-1">
                            <img src="@homePageSettings.NewsletterImage" 
                                 alt="@GetNewsletterTitle()" 
                                 class="w-full h-auto rounded-lg shadow-lg object-cover" />
                        </div>
                    }
                    
                    <!-- Newsletter Content -->
                    <div class="order-1 lg:order-2 @(string.IsNullOrEmpty(homePageSettings.NewsletterImage) ? "col-span-2 text-center max-w-4xl mx-auto" : "")">
                        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">@GetNewsletterTitle()</h2>
                        <p class="text-xl text-gray-600 mb-8">
                            @GetNewsletterSubtitle()
                        </p>
                        <div class="max-w-md @(string.IsNullOrEmpty(homePageSettings.NewsletterImage) ? "mx-auto" : "")">
                            <div class="flex flex-col sm:flex-row gap-3">
                                <input type="email" 
                                       placeholder="@Localizer["EnterYourEmail"]" 
                                       class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-transparent bg-white/90" />
                                <button class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors">
                                    @Localizer["Subscribe"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section.Name == "AboutUs")
    {
        <section class="py-16 @GetAboutUsBackgroundClass()" style="@GetAboutUsBackgroundStyle()">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <!-- About Us Content -->
                    <div class="@(string.IsNullOrEmpty(homePageSettings.AboutUsImage) ? "col-span-2 text-center max-w-4xl mx-auto" : "")">
                        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">@GetAboutUsTitle()</h2>
                        <p class="text-xl text-gray-600 mb-6">
                            @GetAboutUsSubtitle()
                        </p>
                        @if (!string.IsNullOrEmpty(GetAboutUsText()))
                        {
                            <div class="prose prose-lg max-w-none text-gray-700">
                                @((MarkupString)GetAboutUsText().Replace("\n", "<br>"))
                            </div>
                        }
                    </div>
                    
                    <!-- About Us Image -->
                    @if (!string.IsNullOrEmpty(homePageSettings.AboutUsImage))
                    {
                        <div class="order-first lg:order-last">
                            <img src="@homePageSettings.AboutUsImage" 
                                 alt="@GetAboutUsTitle()" 
                                 class="w-full h-auto rounded-lg shadow-lg object-cover" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}
@code {
    private List<Category> homepageCategories = new();
    private List<Product> latestProducts = new();
    private HomePageSettings? homePageSettings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            homePageSettings = await HomePageSettingsService.GetSettingsAsync();
            
            if (homePageSettings?.ShowCategories == true)
            {
                homepageCategories = await CategoryService.GetHomepageCategoriesAsync();
                
                // Limit categories based on settings
                if (homePageSettings.CategoriesDisplayCount > 0)
                {
                    homepageCategories = homepageCategories.Take(homePageSettings.CategoriesDisplayCount).ToList();
                }
            }

            if (homePageSettings?.ShowLatestProducts == true)
            {
                // Load latest products based on settings count
                var productCount = homePageSettings.LatestProductsCount > 0 ? homePageSettings.LatestProductsCount : 6;
                latestProducts = await ProductService.GetLatestProductsAsync(productCount);
            }
        }
        catch (Exception ex)
        {
            // Log error in production
            Console.WriteLine($"Error loading homepage data: {ex.Message}");
            homepageCategories = new();
            latestProducts = new();
            homePageSettings = null;
        }
    }

    private string GetCategoryName(Category category)
    {
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        return currentCulture.StartsWith("ar") && !string.IsNullOrEmpty(category.NameAr) 
            ? category.NameAr 
            : category.Name;
    }

    private bool IsArabic => System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");

    // Categories Section Methods
    private string GetCategoriesTitle()
    {
        if (homePageSettings == null) return Localizer["ExploreCategories"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.CategoriesTitleAr) 
            ? homePageSettings.CategoriesTitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.CategoriesTitle) ? homePageSettings.CategoriesTitle : Localizer["ExploreCategories"]);
    }

    private string GetCategoriesSubtitle()
    {
        if (homePageSettings == null) return Localizer["DiscoverCoffeeCategories"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.CategoriesSubtitleAr) 
            ? homePageSettings.CategoriesSubtitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.CategoriesSubtitle) ? homePageSettings.CategoriesSubtitle : Localizer["DiscoverCoffeeCategories"]);
    }

    private string GetCategoriesSectionStyle()
    {
        if (homePageSettings?.CategoriesBgType == "color" && !string.IsNullOrEmpty(homePageSettings.CategoriesBgValue))
            return "";
        return "bg-white border-b border-gray-100";
    }

    private string GetCategoriesBackgroundStyle()
    {
        if (homePageSettings == null) return "";
        
        return homePageSettings.CategoriesBgType switch
        {
            "color" when !string.IsNullOrEmpty(homePageSettings.CategoriesBgValue) => 
                $"background-color: {homePageSettings.CategoriesBgValue};",
            "image" when !string.IsNullOrEmpty(homePageSettings.CategoriesBgValue) => 
                $"background-image: url('{homePageSettings.CategoriesBgValue}'); background-size: cover; background-position: center;",
            "video" when !string.IsNullOrEmpty(homePageSettings.CategoriesBgValue) => 
                $"background: url('{homePageSettings.CategoriesBgValue}') center/cover;",
            _ => ""
        };
    }

    // Mission Section Methods
    private string GetMissionTitle()
    {
        if (homePageSettings == null) return Localizer["WhyChoose"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.MissionTitleAr) 
            ? homePageSettings.MissionTitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.MissionTitle) ? homePageSettings.MissionTitle : Localizer["WhyChoose"]);
    }

    private string GetMissionSubtitle()
    {
        if (homePageSettings == null) return Localizer["PerfectCoffeeExperience"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.MissionSubtitleAr) 
            ? homePageSettings.MissionSubtitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.MissionSubtitle) ? homePageSettings.MissionSubtitle : Localizer["PerfectCoffeeExperience"]);
    }

    private string GetMissionSectionStyle()
    {
        if (homePageSettings?.MissionBgType == "color" && !string.IsNullOrEmpty(homePageSettings.MissionBgValue))
            return "";
        return "bg-white";
    }

    private string GetMissionBackgroundStyle()
    {
        if (homePageSettings == null) return "";
        
        return homePageSettings.MissionBgType switch
        {
            "color" when !string.IsNullOrEmpty(homePageSettings.MissionBgValue) => 
                $"background-color: {homePageSettings.MissionBgValue};",
            "image" when !string.IsNullOrEmpty(homePageSettings.MissionBgValue) => 
                $"background-image: url('{homePageSettings.MissionBgValue}'); background-size: cover; background-position: center; background-attachment: fixed;",
            "video" when !string.IsNullOrEmpty(homePageSettings.MissionBgValue) => 
                $"background: url('{homePageSettings.MissionBgValue}') center/cover fixed;",
            _ => ""
        };
    }

    private string GetMissionBackgroundClass()
    {
        if (homePageSettings?.MissionBgType == "image" || homePageSettings?.MissionBgType == "video")
        {
            return "bg-fixed bg-cover bg-center bg-no-repeat";
        }
        return "";
    }

    private string GetMissionText()
    {
        if (homePageSettings == null) return "";
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.MissionTextAr) 
            ? homePageSettings.MissionTextAr 
            : (!string.IsNullOrEmpty(homePageSettings.MissionText) ? homePageSettings.MissionText : "");
    }

    // Latest Products Section Methods
    private string GetLatestProductsTitle()
    {
        if (homePageSettings == null) return Localizer["FeaturedCoffee"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.LatestProductsTitleAr) 
            ? homePageSettings.LatestProductsTitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.LatestProductsTitle) ? homePageSettings.LatestProductsTitle : Localizer["FeaturedCoffee"]);
    }

    private string GetLatestProductsSubtitle()
    {
        if (homePageSettings == null) return Localizer["DiscoverPopularSelections"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.LatestProductsSubtitleAr) 
            ? homePageSettings.LatestProductsSubtitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.LatestProductsSubtitle) ? homePageSettings.LatestProductsSubtitle : Localizer["DiscoverPopularSelections"]);
    }

    private string GetLatestProductsSectionStyle()
    {
        if (homePageSettings?.LatestProductsBgType == "color" && !string.IsNullOrEmpty(homePageSettings.LatestProductsBgValue))
            return "";
        return "bg-gray-50";
    }

    private string GetLatestProductsBackgroundStyle()
    {
        if (homePageSettings == null) return "";
        
        return homePageSettings.LatestProductsBgType switch
        {
            "color" when !string.IsNullOrEmpty(homePageSettings.LatestProductsBgValue) => 
                $"background-color: {homePageSettings.LatestProductsBgValue};",
            "image" when !string.IsNullOrEmpty(homePageSettings.LatestProductsBgValue) => 
                $"background-image: url('{homePageSettings.LatestProductsBgValue}'); background-size: cover; background-position: center;",
            "video" when !string.IsNullOrEmpty(homePageSettings.LatestProductsBgValue) => 
                $"background: url('{homePageSettings.LatestProductsBgValue}') center/cover;",
            _ => ""
        };
    }

    // Newsletter Section Methods
    private string GetNewsletterTitle()
    {
        if (homePageSettings == null) return Localizer["Newsletter"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.NewsletterTitleAr) 
            ? homePageSettings.NewsletterTitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.NewsletterTitle) ? homePageSettings.NewsletterTitle : Localizer["Newsletter"]);
    }

    private string GetNewsletterSubtitle()
    {
        if (homePageSettings == null) return Localizer["StayUpdated"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.NewsletterSubtitleAr) 
            ? homePageSettings.NewsletterSubtitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.NewsletterSubtitle) ? homePageSettings.NewsletterSubtitle : Localizer["StayUpdated"]);
    }

    private string GetNewsletterBackgroundClass()
    {
        if (homePageSettings?.NewsletterBgType == "color")
        {
            return "";
        }
        return "bg-gray-100";
    }

    private string GetNewsletterBackgroundStyle()
    {
        if (homePageSettings == null) return "";
        
        return homePageSettings.NewsletterBgType switch
        {
            "color" when !string.IsNullOrEmpty(homePageSettings.NewsletterBgValue) => 
                $"background-color: {homePageSettings.NewsletterBgValue};",
            "image" when !string.IsNullOrEmpty(homePageSettings.NewsletterBgValue) => 
                $"background-image: url('{homePageSettings.NewsletterBgValue}'); background-size: cover; background-position: center;",
            "video" when !string.IsNullOrEmpty(homePageSettings.NewsletterBgValue) => 
                $"background: url('{homePageSettings.NewsletterBgValue}') center/cover;",
            _ => ""
        };
    }

    // About Us Section Methods
    private string GetAboutUsTitle()
    {
        if (homePageSettings == null) return Localizer["AboutUs"];
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.AboutUsTitleAr) 
            ? homePageSettings.AboutUsTitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.AboutUsTitle) ? homePageSettings.AboutUsTitle : Localizer["AboutUs"]);
    }

    private string GetAboutUsSubtitle()
    {
        if (homePageSettings == null) return "";
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.AboutUsSubtitleAr) 
            ? homePageSettings.AboutUsSubtitleAr 
            : (!string.IsNullOrEmpty(homePageSettings.AboutUsSubtitle) ? homePageSettings.AboutUsSubtitle : "");
    }

    private string GetAboutUsText()
    {
        if (homePageSettings == null) return "";
        return IsArabic && !string.IsNullOrEmpty(homePageSettings.AboutUsTextAr) 
            ? homePageSettings.AboutUsTextAr 
            : (!string.IsNullOrEmpty(homePageSettings.AboutUsText) ? homePageSettings.AboutUsText : "");
    }

    private string GetAboutUsBackgroundClass()
    {
        if (homePageSettings?.AboutUsBgType == "color")
        {
            return "";
        }
        return "bg-gray-100";
    }

    private string GetAboutUsBackgroundStyle()
    {
        if (homePageSettings == null) return "";
        
        return homePageSettings.AboutUsBgType switch
        {
            "color" when !string.IsNullOrEmpty(homePageSettings.AboutUsBgValue) => 
                $"background-color: {homePageSettings.AboutUsBgValue};",
            "image" when !string.IsNullOrEmpty(homePageSettings.AboutUsBgValue) => 
                $"background-image: url('{homePageSettings.AboutUsBgValue}'); background-size: cover; background-position: center;",
            "video" when !string.IsNullOrEmpty(homePageSettings.AboutUsBgValue) => 
                $"background: url('{homePageSettings.AboutUsBgValue}') center/cover;",
            _ => ""
        };
    }

    // Product Helper Methods
    private string GetProductName(Product product)
    {
        return IsArabic && !string.IsNullOrEmpty(product.NameAr) 
            ? product.NameAr 
            : product.Name;
    }

    private string GetProductDescription(Product product)
    {
        return IsArabic && !string.IsNullOrEmpty(product.DescriptionAr) 
            ? product.DescriptionAr 
            : (!string.IsNullOrEmpty(product.Description) ? product.Description : "");
    }

    private string GetProductNotes(Product product)
    {
        return IsArabic && !string.IsNullOrEmpty(product.NotesAr) 
            ? product.NotesAr 
            : (!string.IsNullOrEmpty(product.Notes) ? product.Notes : "");
    }

    private string GetProductPrice(Product product)
    {
        var activeVariant = product.Variants?.FirstOrDefault(v => v.IsActive);
        if (activeVariant != null)
        {
            return $"{activeVariant.Price:F3} OMR";
        }
        return Localizer["PriceNotAvailable"];
    }

    private List<(string Name, int Order, bool IsEnabled)> GetOrderedSections()
    {
        if (homePageSettings == null) return new List<(string, int, bool)>();

        var sections = new List<(string Name, int Order, bool IsEnabled)>
        {
            ("Slideshow", homePageSettings.SlideshowOrder, homePageSettings.ShowSlideshow),
            ("Categories", homePageSettings.CategoriesOrder, homePageSettings.ShowCategories),
            ("Mission", homePageSettings.MissionOrder, homePageSettings.ShowMission),
            ("LatestProducts", homePageSettings.LatestProductsOrder, homePageSettings.ShowLatestProducts),
            ("Newsletter", homePageSettings.NewsletterOrder, homePageSettings.ShowNewsletter),
            ("AboutUs", homePageSettings.AboutUsOrder, homePageSettings.ShowAboutUs)
        };

        return sections.OrderBy(s => s.Order).ToList();
    }


}
