@page "/admin/nool-rates"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using SpirithubCofe.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using SpirithubCofe.Web.Components.Shared
@inject ShippingMethodService ShippingMethodService
@inject ShippingService ShippingService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Nool Rates Management - SpirithubCofe</PageTitle>

<Toast />

<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Page Header -->
        <div class="bg-white shadow-sm rounded-lg mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">Nool Oman Rates</h1>
                        <p class="mt-1 text-sm text-gray-600">Manage shipping rates for Nool Oman delivery service</p>
                    </div>
                    <div class="mt-4 sm:mt-0 flex space-x-3">
                        <a href="/admin/shipping-methods" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Back to Shipping Methods
                        </a>
                        <button type="button" @onclick="ShowAddRateModal" 
                                class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                            </svg>
                            Add New Rate
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Stats -->
            <div class="px-6 py-4 grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="bg-blue-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-blue-600">Total Cities</dt>
                            <dd class="text-2xl font-bold text-blue-900">@noolRates.Count</dd>
                        </div>
                    </div>
                </div>
                
                <div class="bg-green-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-green-600">Active Rates</dt>
                            <dd class="text-2xl font-bold text-green-900">@noolRates.Count(r => r.IsActive)</dd>
                        </div>
                    </div>
                </div>
                
                <div class="bg-yellow-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-yellow-600">Avg Rate</dt>
                            <dd class="text-2xl font-bold text-yellow-900">@(noolRates.Any() ? noolRates.Where(r => r.IsActive).Average(r => r.Rate).ToString("F3") : "0.000") OMR</dd>
                        </div>
                    </div>
                </div>
                
                <div class="bg-purple-50 p-4 rounded-lg">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <dt class="text-sm font-medium text-purple-600">Khasab Rate</dt>
                            <dd class="text-2xl font-bold text-purple-900">@(noolRates.FirstOrDefault(r => r.City.Name.Contains("Khasab"))?.Rate.ToString("F3") ?? "3.000") OMR</dd>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rates Table -->
        <div class="bg-white shadow-sm rounded-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-medium text-gray-900">Nool Shipping Rates</h2>
                    <div class="flex items-center space-x-3">
                        <input type="text" @bind="searchTerm" @oninput="FilterRates" 
                               placeholder="Search cities..." 
                               class="px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-green-500 focus:border-green-500 text-sm" />
                    </div>
                </div>
            </div>
            
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">City</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Arabic Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rate (OMR)</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Updated</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (filteredRates?.Any() == true)
                        {
                            @foreach (var rate in filteredRates.OrderBy(r => r.City.Name))
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                </svg>
                                            </div>
                                            <div class="ml-3">
                                                <div class="text-sm font-medium text-gray-900">@rate.City.Name</div>
                                                <div class="text-sm text-gray-500">@rate.City.Country.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900" dir="rtl">
                                        @rate.City.NameAr
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="text-lg font-bold text-green-600">@rate.Rate.ToString("F3")</div>
                                        <div class="text-xs text-gray-500">OMR</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="@(rate.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") inline-flex px-2 py-1 text-xs font-semibold rounded-full">
                                            @(rate.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @rate.UpdatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                        <button type="button" @onclick="() => EditRate(rate)"
                                                class="text-blue-600 hover:text-blue-900 inline-flex items-center">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                            Edit
                                        </button>
                                        <button type="button" @onclick="() => DeleteRate(rate.Id)"
                                                class="text-red-600 hover:text-red-900 inline-flex items-center ml-3">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center">
                                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                                    </svg>
                                    <h3 class="mt-2 text-sm font-medium text-gray-900">No rates found</h3>
                                    <p class="mt-1 text-sm text-gray-500">
                                        @(string.IsNullOrEmpty(searchTerm) ? "Get started by adding a new rate." : "Try adjusting your search terms.")
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Rate Modal -->
@if (showRateModal)
{
    <div class="fixed inset-0 backdrop-blur-sm bg-black/20 overflow-y-auto h-full w-full z-50 flex items-center justify-center p-4" @onclick="CloseRateModal">
        <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full border border-gray-100 transform transition-all" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-green-50 to-emerald-50">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">@(currentRate.Id == 0 ? "Add New Rate" : "Edit Rate")</h3>
                            <p class="text-sm text-gray-600">@(currentRate.Id == 0 ? "Set shipping rate for Nool Oman" : "Update existing rate")</p>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseRateModal" class="p-2 hover:bg-white/50 rounded-lg transition-colors">
                        <svg class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Form Content -->
            <div class="px-6 py-6">
                <EditForm Model="currentRate" OnValidSubmit="SaveRate" id="rate-form">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-6">
                        @if (currentRate.Id == 0)
                        {
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        </svg>
                                        Select City
                                    </span>
                                </label>
                                <select @bind="selectedCityId" class="w-full px-4 py-3 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200 bg-white text-gray-900">
                                    <option value="">Choose a city...</option>
                                    @foreach (var city in availableCities.OrderBy(c => c.Name))
                                    {
                                        <option value="@city.Id">@city.Name (@city.NameAr)</option>
                                    }
                                </select>
                                @if (selectedCityId == 0)
                                {
                                    <div class="flex items-center mt-2 text-red-600 text-sm">
                                        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                        </svg>
                                        Please select a city
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    <span class="flex items-center">
                                        <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                        </svg>
                                        City
                                    </span>
                                </label>
                                <div class="px-4 py-3 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-lg">
                                    <div class="font-semibold text-gray-900">@currentRate.City?.Name</div>
                                    <div class="text-sm text-gray-600 mt-1" dir="rtl">@currentRate.City?.NameAr</div>
                                </div>
                            </div>
                        }
                        
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>
                                    </svg>
                                    Shipping Rate (OMR)
                                </span>
                            </label>
                            <div class="relative">
                                <InputNumber @bind-Value="currentRate.Rate" class="w-full px-4 py-3 pr-12 border border-gray-200 rounded-lg shadow-sm focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200" step="0.001" placeholder="0.000" />
                                <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    <span class="text-gray-500 text-sm font-medium">OMR</span>
                                </div>
                            </div>
                            <ValidationMessage For="() => currentRate.Rate" class="text-red-600 text-sm mt-1" />
                        </div>
                        
                        <div class="flex items-center p-4 bg-gray-50 rounded-lg">
                            <InputCheckbox @bind-Value="currentRate.IsActive" class="w-5 h-5 text-green-600 border-gray-300 rounded focus:ring-green-500 focus:ring-2" />
                            <label class="ml-3 flex items-center text-sm font-medium text-gray-900">
                                <span>Active Rate</span>
                                <span class="ml-2 text-xs text-gray-500">Enable this rate for shipping calculations</span>
                            </label>
                        </div>
                    </div>
                </EditForm>
            </div>
            
            <!-- Footer -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 rounded-b-xl flex justify-end space-x-3">
                <button type="button" @onclick="CloseRateModal" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400 transition duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Cancel
                </button>
                <button type="submit" form="rate-form" class="inline-flex items-center px-6 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-200">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    @(currentRate.Id == 0 ? "Add Rate" : "Update Rate")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<NoolShippingRate> noolRates = new();
    private List<NoolShippingRate> filteredRates = new();
    private List<City> availableCities = new();
    private NoolShippingRate currentRate = new();
    private bool showRateModal = false;
    private string searchTerm = string.Empty;
    private int selectedCityId = 0;
    private ShippingMethod? noolMethod;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Get Nool Oman method
        noolMethod = await ShippingMethodService.GetShippingMethodByTypeAsync("NoolOman");
        if (noolMethod != null)
        {
            noolRates = await ShippingMethodService.GetNoolRatesAsync(noolMethod.Id);
            filteredRates = noolRates;
        }

        // Get all Oman cities for adding new rates
        var omanCountries = await ShippingService.GetAllCountriesAsync();
        var oman = omanCountries.FirstOrDefault(c => c.Code == "OM");
        if (oman != null)
        {
            var allCities = await ShippingService.GetCitiesByCountryAsync(oman.Id);
            // Only show cities that don't have rates yet
            var usedCityIds = noolRates.Select(r => r.CityId).ToHashSet();
            availableCities = allCities.Where(c => !usedCityIds.Contains(c.Id)).ToList();
        }
    }

    private void FilterRates()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredRates = noolRates;
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredRates = noolRates.Where(r => 
                r.City.Name.ToLower().Contains(term) || 
                (r.City.NameAr?.Contains(term) ?? false)
            ).ToList();
        }
    }

    private void ShowAddRateModal()
    {
        currentRate = new NoolShippingRate
        {
            ShippingMethodId = noolMethod?.Id ?? 0,
            Rate = 2.000m,
            IsActive = true
        };
        selectedCityId = 0;
        showRateModal = true;
    }

    private void EditRate(NoolShippingRate rate)
    {
        currentRate = new NoolShippingRate
        {
            Id = rate.Id,
            ShippingMethodId = rate.ShippingMethodId,
            CityId = rate.CityId,
            Rate = rate.Rate,
            IsActive = rate.IsActive,
            City = rate.City
        };
        showRateModal = true;
    }

    private async Task SaveRate()
    {
        try
        {
            if (currentRate.Id == 0)
            {
                // Adding new rate
                if (selectedCityId == 0)
                {
                    ToastService.ShowError("Please select a city");
                    return;
                }
                
                await ShippingMethodService.CreateOrUpdateNoolRateAsync(
                    noolMethod!.Id, 
                    selectedCityId, 
                    currentRate.Rate
                );
                ToastService.ShowSuccess("New rate added successfully!");
            }
            else
            {
                // Updating existing rate
                await ShippingMethodService.CreateOrUpdateNoolRateAsync(
                    currentRate.ShippingMethodId, 
                    currentRate.CityId, 
                    currentRate.Rate
                );
                ToastService.ShowSuccess("Rate updated successfully!");
            }

            await LoadData();
            showRateModal = false;
            FilterRates();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving rate: {ex.Message}");
        }
    }

    private async Task DeleteRate(int rateId)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this rate?"))
        {
            try
            {
                await ShippingMethodService.DeleteNoolRateAsync(rateId);
                await LoadData();
                FilterRates();
                ToastService.ShowSuccess("Rate deleted successfully!");
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error deleting rate: {ex.Message}");
            }
        }
    }

    private void CloseRateModal()
    {
        showRateModal = false;
        currentRate = new NoolShippingRate();
        selectedCityId = 0;
    }
}