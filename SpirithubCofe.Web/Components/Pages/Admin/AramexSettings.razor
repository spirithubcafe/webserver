@page "/admin/aramex-settings"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using SpirithubCofe.Web.Data
@using System.Globalization
@using AramexSettingsEntity = SpirithubCofe.Domain.Entities.AramexSettings
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Aramex Settings - Admin</PageTitle>

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="bg-white rounded-lg shadow mb-6">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl font-bold text-gray-900">
                            @if (isArabic)
                            {
                                <span>إعدادات أرامكس</span>
                            }
                            else
                            {
                                <span>Aramex Settings</span>
                            }
                        </h1>
                        <p class="text-gray-600 mt-1">
                            @if (isArabic)
                            {
                                <span>إدارة إعدادات شحن أرامكس</span>
                            }
                            else
                            {
                                <span>Manage Aramex shipping configuration</span>
                            }
                        </p>
                    </div>
                    <div class="flex gap-2">
                        <button @onclick="ToggleLanguage" 
                                class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                            @(isArabic ? "English" : "عربي")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (settings != null)
        {
            <EditForm Model="settings" OnValidSubmit="SaveSettings" class="space-y-6">
                <DataAnnotationsValidator />

                <!-- API Credentials Card -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">
                            @if (isArabic)
                            {
                                <span>بيانات اعتماد API</span>
                            }
                            else
                            {
                                <span>API Credentials</span>
                            }
                        </h2>
                        <p class="text-sm text-gray-600 mt-1">
                            @if (isArabic)
                            {
                                <span>أدخل بيانات اعتماد Aramex API الخاصة بك أدناه</span>
                            }
                            else
                            {
                                <span>Enter your Aramex API credentials below</span>
                            }
                        </p>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Test Mode -->
                        <div class="md:col-span-2">
                            <label class="flex items-center space-x-3">
                                <InputCheckbox @bind-Value="settings.TestMode" class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                <span class="text-sm font-medium text-gray-700">
                                    @if (isArabic)
                                    {
                                        <span>وضع الاختبار - فعل وضع الاختبار لاستخدام بيئة أرامكس التجريبية</span>
                                    }
                                    else
                                    {
                                        <span>Test Mode - Enable test mode to use Aramex sandbox environment</span>
                                    }
                                </span>
                            </label>
                        </div>

                        <!-- Username -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>اسم المستخدم *</span>
                                }
                                else
                                {
                                    <span>Username *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.Username" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.Username)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Password -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>كلمة المرور *</span>
                                }
                                else
                                {
                                    <span>Password *</span>
                                }
                            </label>
                            <InputText type="password" @bind-Value="settings.Password" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.Password)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Account Number -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>رقم الحساب *</span>
                                }
                                else
                                {
                                    <span>Account Number *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AccountNumber" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.AccountNumber)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Account PIN -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>رقم PIN للحساب *</span>
                                }
                                else
                                {
                                    <span>Account PIN *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AccountPin" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.AccountPin)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Account Entity -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>كيان الحساب *</span>
                                }
                                else
                                {
                                    <span>Account Entity *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AccountEntity" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="@(isArabic ? "مثل: MCT" : "e.g., MCT")" />
                            <ValidationMessage For="@(() => settings.AccountEntity)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Account Country Code -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>رمز البلد للحساب *</span>
                                }
                                else
                                {
                                    <span>Account Country Code *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AccountCountryCode" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="@(isArabic ? "مثل: OM" : "e.g., OM")" />
                            <ValidationMessage For="@(() => settings.AccountCountryCode)" class="text-red-500 text-sm" />
                        </div>

                        <!-- API Version -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>إصدار API</span>
                                }
                                else
                                {
                                    <span>API Version</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.ApiVersion" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <!-- Source -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>المصدر</span>
                                }
                                else
                                {
                                    <span>Source</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.Source" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>

                <!-- Shipper Information Card -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">
                            @if (isArabic)
                            {
                                <span>معلومات المرسل</span>
                            }
                            else
                            {
                                <span>Shipper Information</span>
                            }
                        </h2>
                        <p class="text-sm text-gray-600 mt-1">
                            @if (isArabic)
                            {
                                <span>تكوين معلومات منشأ الشحن الخاصة بك</span>
                            }
                            else
                            {
                                <span>Configure your shipping origin information</span>
                            }
                        </p>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Company Name -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>اسم الشركة *</span>
                                }
                                else
                                {
                                    <span>Company Name *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.CompanyName" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.CompanyName)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Contact Name -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>اسم جهة الاتصال *</span>
                                }
                                else
                                {
                                    <span>Contact Name *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.ContactName" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.ContactName)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Phone Number -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>رقم الهاتف *</span>
                                }
                                else
                                {
                                    <span>Phone Number *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.PhoneNumber" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.PhoneNumber)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Address Line 1 -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>السطر الأول من العنوان *</span>
                                }
                                else
                                {
                                    <span>Address Line 1 *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AddressLine1" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.AddressLine1)" class="text-red-500 text-sm" />
                        </div>

                        <!-- Address Line 2 -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>السطر الثاني من العنوان</span>
                                }
                                else
                                {
                                    <span>Address Line 2</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.AddressLine2" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <!-- City -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>المدينة *</span>
                                }
                                else
                                {
                                    <span>City *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.City" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <ValidationMessage For="@(() => settings.City)" class="text-red-500 text-sm" />
                        </div>

                        <!-- State/Province -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>الولاية/المحافظة</span>
                                }
                                else
                                {
                                    <span>State/Province</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.StateProvince" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <!-- Postal Code -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>الرمز البريدي</span>
                                }
                                else
                                {
                                    <span>Postal Code</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.PostalCode" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <!-- Country Code -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>رمز البلد *</span>
                                }
                                else
                                {
                                    <span>Country Code *</span>
                                }
                            </label>
                            <InputText @bind-Value="settings.CountryCode" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="@(isArabic ? "مثل: OM" : "e.g., OM")" />
                            <ValidationMessage For="@(() => settings.CountryCode)" class="text-red-500 text-sm" />
                        </div>
                    </div>
                </div>

                <!-- Services Configuration Card -->
                <div class="bg-white rounded-lg shadow">
                    <div class="px-6 py-4 border-b border-gray-200">
                        <h2 class="text-lg font-semibold text-gray-900">
                            @if (isArabic)
                            {
                                <span>تكوين الخدمات</span>
                            }
                            else
                            {
                                <span>Services Configuration</span>
                            }
                        </h2>
                        <p class="text-sm text-gray-600 mt-1">
                            @if (isArabic)
                            {
                                <span>تكوين خدمات أرامكس التي تريد تقديمها وتسمياتها</span>
                            }
                            else
                            {
                                <span>Configure which Aramex services to offer and their display labels</span>
                            }
                        </p>
                    </div>
                    <div class="p-6 space-y-6">
                        <!-- Domestic Services -->
                        <div class="space-y-3">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>الخدمات المحلية</span>
                                }
                                else
                                {
                                    <span>Domestic Services</span>
                                }
                            </label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <label class="flex items-center space-x-3">
                                    <input type="checkbox" @onchange="@((e) => UpdateDomesticService("OND", (bool)e.Value!))" 
                                           checked="@(domesticServices.Contains("OND"))"
                                           class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                    <span class="text-sm text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>أرامكس محلي (OND)</span>
                                        }
                                        else
                                        {
                                            <span>Aramex Domestic (OND)</span>
                                        }
                                    </span>
                                </label>
                                <label class="flex items-center space-x-3">
                                    <input type="checkbox" @onchange="@((e) => UpdateDomesticService("CDS", (bool)e.Value!))" 
                                           checked="@(domesticServices.Contains("CDS"))"
                                           class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                    <span class="text-sm text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>الدفع عند الاستلام (CDS)</span>
                                        }
                                        else
                                        {
                                            <span>Cash on Delivery (CDS)</span>
                                        }
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- International Services -->
                        <div class="space-y-3">
                            <label class="block text-sm font-semibold text-gray-700">
                                @if (isArabic)
                                {
                                    <span>الخدمات الدولية</span>
                                }
                                else
                                {
                                    <span>International Services</span>
                                }
                            </label>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <label class="flex items-center space-x-3">
                                    <input type="checkbox" @onchange="@((e) => UpdateInternationalService("EPX", (bool)e.Value!))" 
                                           checked="@(internationalServices.Contains("EPX"))"
                                           class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                    <span class="text-sm text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>أرامكس إكسبرس (EPX)</span>
                                        }
                                        else
                                        {
                                            <span>Aramex Express (EPX)</span>
                                        }
                                    </span>
                                </label>
                                <label class="flex items-center space-x-3">
                                    <input type="checkbox" @onchange="@((e) => UpdateInternationalService("PPX", (bool)e.Value!))" 
                                           checked="@(internationalServices.Contains("PPX"))"
                                           class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                    <span class="text-sm text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>أرامكس أولوية (PPX)</span>
                                        }
                                        else
                                        {
                                            <span>Aramex Priority (PPX)</span>
                                        }
                                    </span>
                                </label>
                                <label class="flex items-center space-x-3">
                                    <input type="checkbox" @onchange="@((e) => UpdateInternationalService("GRD", (bool)e.Value!))" 
                                           checked="@(internationalServices.Contains("GRD"))"
                                           class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50" />
                                    <span class="text-sm text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>أرامكس أرضي (GRD)</span>
                                        }
                                        else
                                        {
                                            <span>Aramex Ground (GRD)</span>
                                        }
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Service Labels -->
                        <div class="space-y-4">
                            <h3 class="text-md font-semibold text-gray-900">
                                @if (isArabic)
                                {
                                    <span>تسميات الخدمات</span>
                                }
                                else
                                {
                                    <span>Service Labels</span>
                                }
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- OND Labels -->
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية OND (إنجليزي)</span>
                                        }
                                        else
                                        {
                                            <span>OND Label (English)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.OndLabel" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية OND (عربي)</span>
                                        }
                                        else
                                        {
                                            <span>OND Label (Arabic)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.OndLabelAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>

                                <!-- CDS Labels -->
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية CDS (إنجليزي)</span>
                                        }
                                        else
                                        {
                                            <span>CDS Label (English)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.CdsLabel" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية CDS (عربي)</span>
                                        }
                                        else
                                        {
                                            <span>CDS Label (Arabic)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.CdsLabelAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>

                                <!-- EPX Labels -->
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية EPX (إنجليزي)</span>
                                        }
                                        else
                                        {
                                            <span>EPX Label (English)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.EpxLabel" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية EPX (عربي)</span>
                                        }
                                        else
                                        {
                                            <span>EPX Label (Arabic)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.EpxLabelAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>

                                <!-- PPX Labels -->
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية PPX (إنجليزي)</span>
                                        }
                                        else
                                        {
                                            <span>PPX Label (English)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.PpxLabel" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية PPX (عربي)</span>
                                        }
                                        else
                                        {
                                            <span>PPX Label (Arabic)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.PpxLabelAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>

                                <!-- GRD Labels -->
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية GRD (إنجليزي)</span>
                                        }
                                        else
                                        {
                                            <span>GRD Label (English)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.GrdLabel" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                                <div class="space-y-2">
                                    <label class="block text-sm font-semibold text-gray-700">
                                        @if (isArabic)
                                        {
                                            <span>تسمية GRD (عربي)</span>
                                        }
                                        else
                                        {
                                            <span>GRD Label (Arabic)</span>
                                        }
                                    </label>
                                    <InputText @bind-Value="settings.GrdLabelAr" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Save Button -->
                <div class="flex justify-end">
                    <button type="submit" disabled="@isLoading" 
                            class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (isLoading)
                        {
                            <span class="flex items-center">
                                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                @(isArabic ? "جاري الحفظ..." : "Saving...")
                            </span>
                        }
                        else
                        {
                            @(isArabic ? "حفظ الإعدادات" : "Save Settings")
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@if (showToast)
{
    <Toast Message="@toastMessage" Type="@toastType" OnClose="@(() => showToast = false)" />
}

@code {
    private AramexSettingsEntity? settings;
    private bool isLoading = false;
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";
    private bool isArabic = false;
    private List<string> domesticServices = new();
    private List<string> internationalServices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        settings = await DbContext.AramexSettings.FirstOrDefaultAsync();
        
        if (settings == null)
        {
            // Create default settings if none exist
            settings = new AramexSettingsEntity
            {
                TestMode = false,
                Username = "info@spirithubcafe.com",
                Password = "ChemicalShared@33",
                AccountNumber = "71925275",
                AccountPin = "617333",
                AccountEntity = "MCT",
                AccountCountryCode = "OM",
                ApiVersion = "v1.0",
                Source = "24",
                CompanyName = "Spirit Hub",
                ContactName = "Said",
                PhoneNumber = "92506030",
                AddressLine1 = "Al Hail",
                AddressLine2 = "",
                City = "Muscat",
                StateProvince = "Muscat",
                PostalCode = "111",
                CountryCode = "OM",
                DomesticServices = "OND,CDS",
                InternationalServices = "EPX,PPX,GRD",
                OndLabel = "Aramex Domestic (OND)",
                CdsLabel = "Cash on Delivery (CDS)",
                EpxLabel = "Aramex Express (EPX)",
                PpxLabel = "Aramex Priority (PPX)",
                GrdLabel = "Aramex Ground (GRD)"
            };
        }

        // Parse services
        domesticServices = settings.DomesticServices?.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
        internationalServices = settings.InternationalServices?.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
    }

    private void UpdateDomesticService(string service, bool enabled)
    {
        if (enabled && !domesticServices.Contains(service))
        {
            domesticServices.Add(service);
        }
        else if (!enabled && domesticServices.Contains(service))
        {
            domesticServices.Remove(service);
        }
        
        if (settings != null)
        {
            settings.DomesticServices = string.Join(",", domesticServices);
        }
    }

    private void UpdateInternationalService(string service, bool enabled)
    {
        if (enabled && !internationalServices.Contains(service))
        {
            internationalServices.Add(service);
        }
        else if (!enabled && internationalServices.Contains(service))
        {
            internationalServices.Remove(service);
        }
        
        if (settings != null)
        {
            settings.InternationalServices = string.Join(",", internationalServices);
        }
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;

        isLoading = true;
        try
        {
            settings.UpdatedAt = DateTime.UtcNow;
            
            var existingSettings = await DbContext.AramexSettings.FirstOrDefaultAsync();
            if (existingSettings == null)
            {
                DbContext.AramexSettings.Add(settings);
            }
            else
            {
                DbContext.Entry(existingSettings).CurrentValues.SetValues(settings);
                settings.Id = existingSettings.Id;
                settings.CreatedAt = existingSettings.CreatedAt;
            }

            await DbContext.SaveChangesAsync();
            
            toastMessage = isArabic ? "تم حفظ الإعدادات بنجاح" : "Settings saved successfully";
            toastType = "success";
            showToast = true;
        }
        catch (Exception)
        {
            toastMessage = isArabic ? "حدث خطأ أثناء حفظ الإعدادات" : "Error saving settings";
            toastType = "error";
            showToast = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleLanguage()
    {
        isArabic = !isArabic;
    }
}