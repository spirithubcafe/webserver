@using SpirithubCofe.Domain.Entities
@using Microsoft.JSInterop
@inject IStringLocalizer<SpirithubCofe.Langs.Resources> Localizer

@if (IsVisible)
{
    <!-- Modal Overlay -->
    <div class="fixed inset-0 z-50 overflow-y-auto quick-view-modal" role="dialog" aria-labelledby="quick-view-title" aria-modal="true">
        <!-- Background overlay -->
        <div class="fixed inset-0 bg-opacity-50 modal-backdrop" @onclick="CloseModal"></div>
        
        <!-- Modal Content -->
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative transform overflow-hidden rounded-xl bg-white shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto modal-content">
                
                <!-- Close Button -->
                <button @onclick="CloseModal" 
                        class="absolute top-4 right-4 z-10 p-2 rounded-full bg-white/80 backdrop-blur-sm hover:bg-white transition-colors duration-200 shadow-lg">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                @if (Product != null)
                {
                    <div class="flex flex-col lg:flex-row">
                        <!-- Product Image Section -->
                        <div class="lg:w-1/2 p-6">
                            <div class="aspect-square rounded-lg overflow-hidden bg-gray-100 shadow-inner">
                                @if (!string.IsNullOrEmpty(Product.MainImage?.ImagePath))
                                {
                                    <img src="@Product.MainImage.ImagePath" 
                                         alt="@Product.Name" 
                                         class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg class="w-20 h-20 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                }
                            </div>

                            <!-- Gallery Thumbnails -->
                            @if (Product.GalleryImages != null && Product.GalleryImages.Any())
                            {
                                <div class="flex space-x-2 mt-4 overflow-x-auto">
                                    @foreach (var image in Product.GalleryImages.Take(4))
                                    {
                                        <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-gray-100">
                                            <img src="@image.ImagePath" 
                                                 alt="@Product.Name" 
                                                 class="w-full h-full object-cover" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Product Details Section -->
                        <div class="lg:w-1/2 p-6 lg:pl-0">
                            <!-- Product Header -->
                            <div class="mb-6">
                                <div class="flex items-center space-x-2 mb-2">
                                    <span class="text-sm text-gray-500">@Product.Sku</span>
                                    @if (Product.IsOrganic)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            🌱 Organic
                                        </span>
                                    }
                                    @if (Product.IsFairTrade)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            🤝 Fair Trade
                                        </span>
                                    }
                                </div>
                                
                                <h2 id="quick-view-title" class="text-2xl font-bold text-gray-900 mb-2">@Product.Name</h2>
                                
                                @if (!string.IsNullOrEmpty(Product.Category?.Name))
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                                        @Product.Category.Name
                                    </span>
                                }
                            </div>

                            <!-- Rating -->
                            <div class="flex items-center space-x-2 mb-4">
                                <div class="flex items-center space-x-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <svg class="w-4 h-4 @(i <= Product.AverageRating ? "text-yellow-400" : "text-gray-300")" 
                                             fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                        </svg>
                                    }
                                </div>
                                <span class="text-sm text-gray-600">@Product.AverageRating.ToString("F1") (@Product.ReviewCount reviews)</span>
                            </div>

                            <!-- Price -->
                            <div class="mb-6">
                                @if (Product.Variants != null && Product.Variants.Any())
                                {
                                    var minPrice = Product.Variants.Min(v => v.Price);
                                    var maxPrice = Product.Variants.Max(v => v.Price);
                                    if (minPrice == maxPrice)
                                    {
                                        <div class="text-3xl font-bold text-blue-600">@minPrice.ToString("F3") OMR</div>
                                    }
                                    else
                                    {
                                        <div class="text-3xl font-bold text-blue-600">@minPrice.ToString("F3") - @maxPrice.ToString("F3") OMR</div>
                                    }
                                }
                                else
                                {
                                    <div class="text-lg text-gray-500">Price not available</div>
                                }
                            </div>

                            <!-- Status -->
                            <div class="mb-6">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @(Product.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                    @(Product.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                                </span>
                            </div>

                            <!-- Product Information Grid -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                                @if (!string.IsNullOrEmpty(Product.Origin))
                                {
                                    <div class="bg-gray-50 p-3 rounded-lg">
                                        <div class="text-sm font-medium text-gray-700 mb-1">Origin</div>
                                        <div class="text-sm text-gray-900">@Product.Origin</div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Product.RoastLevel))
                                {
                                    <div class="bg-gray-50 p-3 rounded-lg">
                                        <div class="text-sm font-medium text-gray-700 mb-1">Roast Level</div>
                                        <div class="text-sm text-gray-900">@Product.RoastLevel</div>
                                    </div>
                                }

                                @if (Product.Intensity.HasValue)
                                {
                                    <div class="bg-gray-50 p-3 rounded-lg">
                                        <div class="text-sm font-medium text-gray-700 mb-1">Intensity</div>
                                        <div class="flex items-center space-x-2">
                                            <div class="flex space-x-1">
                                                @for (int i = 1; i <= 10; i++)
                                                {
                                                    <div class="w-2 h-2 rounded-full @(i <= Product.Intensity ? "bg-red-500" : "bg-gray-300")"></div>
                                                }
                                            </div>
                                            <span class="text-sm text-gray-900">@Product.Intensity/10</span>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Product.Process))
                                {
                                    <div class="bg-gray-50 p-3 rounded-lg">
                                        <div class="text-sm font-medium text-gray-700 mb-1">Process</div>
                                        <div class="text-sm text-gray-900">@Product.Process</div>
                                    </div>
                                }
                            </div>

                            <!-- Variants -->
                            @if (Product.Variants != null && Product.Variants.Any())
                            {
                                <div class="mb-6">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Available Variants</h3>
                                    <div class="space-y-2">
                                        @foreach (var variant in Product.Variants.Take(3))
                                        {
                                            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                                <div>
                                                    <div class="text-sm font-medium text-gray-900">@variant.Weight @variant.WeightUnit</div>
                                                    @if (!string.IsNullOrEmpty(variant.VariantSku))
                                                    {
                                                        <div class="text-xs text-gray-600">SKU: @variant.VariantSku</div>
                                                    }
                                                    @if (variant.HasDiscount)
                                                    {
                                                        <div class="text-xs text-green-600">@variant.DiscountPercentage.ToString("F0")% OFF</div>
                                                    }
                                                </div>
                                                <div class="text-right">
                                                    @if (variant.HasDiscount)
                                                    {
                                                        <div class="text-sm font-bold text-blue-600">@variant.EffectivePrice.ToString("F3") OMR</div>
                                                        <div class="text-xs text-gray-500 line-through">@variant.Price.ToString("F3") OMR</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-sm font-bold text-blue-600">@variant.Price.ToString("F3") OMR</div>
                                                    }
                                                    <div class="text-xs @(variant.IsInStock ? "text-green-600" : "text-red-600")">
                                                        @if (variant.IsInStock)
                                                        {
                                                            <span>@variant.StockQuantity in stock</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Out of stock</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (Product.Variants.Count > 3)
                                        {
                                            <div class="text-center">
                                                <span class="text-sm text-gray-500">+@(Product.Variants.Count - 3) more variants</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Description -->
                            @if (!string.IsNullOrEmpty(Product.Description))
                            {
                                <div class="mb-6">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Description</h3>
                                    <div class="text-sm text-gray-700 leading-relaxed">
                                        @((MarkupString)Product.Description.Replace("\n", "<br>"))
                                    </div>
                                </div>
                            }

                            <!-- Tasting Notes -->
                            @if (!string.IsNullOrEmpty(Product.TastingNotes))
                            {
                                <div class="mb-6">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Tasting Notes</h3>
                                    <div class="text-sm text-gray-700 leading-relaxed">
                                        @((MarkupString)Product.TastingNotes.Replace("\n", "<br>"))
                                    </div>
                                </div>
                            }

                            <!-- Actions -->
                            <div class="flex space-x-3 pt-4 border-t border-gray-200">
                                @if (IsAdminContext)
                                {
                                    <!-- Admin Actions -->
                                    <a href="/admin/products/@Product.Id/edit" 
                                       class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                        @Localizer["Edit"]
                                    </a>
                                }
                                else
                                {
                                    <!-- Customer Actions -->
                                    <button @onclick="GoToProductPage" 
                                            class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-200">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2M7 13l3 3 7-7"></path>
                                        </svg>
                                        @Localizer["ViewDetails"]
                                    </button>
                                }
                                <button @onclick="CloseModal" 
                                        class="flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200">
                                    @Localizer["Close"]
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Product? Product { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool IsAdminContext { get; set; } = false;
    
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private async Task CloseModal()
    {
        IsVisible = false;
        await RemoveBodyScrollLock();
        await OnClose.InvokeAsync();
    }
    
    private async Task GoToProductPage()
    {
        if (Product != null)
        {
            await CloseModal();
            Navigation.NavigateTo($"/product/{Product.Id}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await AddBodyScrollLock();
        }
        else
        {
            await RemoveBodyScrollLock();
        }
    }
    
    private async Task AddBodyScrollLock()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.body.classList.add('modal-open')");
        }
        catch
        {
            // Ignore JS errors during prerendering
        }
    }
    
    private async Task RemoveBodyScrollLock()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.body.classList.remove('modal-open')");
        }
        catch
        {
            // Ignore JS errors during prerendering
        }
    }
}

<style>
    .modal-enter {
        opacity: 0;
        transform: scale(0.95);
    }
    
    .modal-enter-active {
        opacity: 1;
        transform: scale(1);
        transition: opacity 300ms ease-out, transform 300ms ease-out;
    }
    
    .modal-exit {
        opacity: 1;
        transform: scale(1);
    }
    
    .modal-exit-active {
        opacity: 0;
        transform: scale(0.95);
        transition: opacity 200ms ease-in, transform 200ms ease-in;
    }

    /* Custom scrollbar for modal content */
    .modal-content::-webkit-scrollbar {
        width: 6px;
    }
    
    .modal-content::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }
    
    .modal-content::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }
    
    .modal-content::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
    }
</style>